{
  "name": "game1",
  "serveAddress": "127.0.0.1",
  "servePort": 34882,
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "PlayerScriptsUseInputActionSystem": {
          "Enum": 2
        }
      },
      "$ignoreUnknownInstances": true
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Game1Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Game1Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CreateDefaultPlayerModule": false
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Game1Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
