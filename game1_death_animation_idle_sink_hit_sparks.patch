diff --git a/src/client/combat/HitEffectController.luau b/src/client/combat/HitEffectController.luau
new file mode 100644
index 0000000..7886438
--- /dev/null
+++ b/src/client/combat/HitEffectController.luau
@@ -0,0 +1,58 @@
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local Workspace = game:GetService("Workspace")
+
+local Shared = ReplicatedStorage:WaitForChild("Game1Shared")
+local CombatShared = Shared:WaitForChild("combat")
+local HitEffectConfig = require(CombatShared:WaitForChild("HitEffectConfig"))
+local Effects = script.Parent:WaitForChild("effects")
+local HitEffectPool = require(Effects:WaitForChild("HitEffectPool"))
+
+local HitEffectController = {}
+local started = false
+local pool: any = nil
+local tokens = HitEffectConfig.BurstCapacity
+local lastRefillAt = os.clock()
+
+local function consumeBurstBudget(): boolean
+    local now = os.clock()
+    local elapsed = math.max(0, now - lastRefillAt)
+    lastRefillAt = now
+    tokens = math.min(HitEffectConfig.BurstCapacity, tokens + elapsed * HitEffectConfig.MaxBurstsPerSecond)
+    if tokens < 1 then return false end
+    tokens -= 1
+    return true
+end
+
+local function renderCamera(position: Vector3): Camera?
+    local camera = Workspace.CurrentCamera
+    if not camera then return nil end
+    local delta = camera.CFrame.Position - position
+    if delta:Dot(delta) > HitEffectConfig.ClientRenderRadius * HitEffectConfig.ClientRenderRadius then
+        return nil
+    end
+    return camera
+end
+
+local function onHit(position: any, sourcePosition: any, critical: any)
+    if typeof(position) ~= "Vector3" then return end
+    if typeof(sourcePosition) ~= "Vector3" then sourcePosition = position end
+    local camera = renderCamera(position)
+    if not camera or not consumeBurstBudget() then return end
+    pool:Emit(position, sourcePosition, critical == true, camera.CFrame)
+end
+
+function HitEffectController.Start()
+    if started then return end
+    started = true
+    pool = HitEffectPool.new(HitEffectConfig)
+    local remotes = ReplicatedStorage:WaitForChild("Game1Remotes")
+    local remote = remotes:WaitForChild(HitEffectConfig.RemoteName)
+    if not remote:IsA("UnreliableRemoteEvent") then
+        warn("[game1][HIT_FX] CombatHitEffect has wrong class; hit sparks disabled")
+        return
+    end
+    remote.OnClientEvent:Connect(onHit)
+    print(("[game1][HIT_FX] pooled client renderer ready · pool %d"):format(HitEffectConfig.PoolSize))
+end
+
+return table.freeze(HitEffectController)
diff --git a/src/client/combat/effects/HitEffectPool.luau b/src/client/combat/effects/HitEffectPool.luau
new file mode 100644
index 0000000..6ded9da
--- /dev/null
+++ b/src/client/combat/effects/HitEffectPool.luau
@@ -0,0 +1,49 @@
+local RunService = game:GetService("RunService")
+local Workspace = game:GetService("Workspace")
+
+local HitSparkBurst = require(script.Parent:WaitForChild("HitSparkBurst"))
+local HitFrontFlash = require(script.Parent:WaitForChild("HitFrontFlash"))
+
+local HitEffectPool = {}
+HitEffectPool.__index = HitEffectPool
+
+local function makeSlot(parent: Instance, config: any, index: number): any
+    return {
+        sparks = HitSparkBurst.Create(parent, config, index),
+        flash = HitFrontFlash.Create(parent, config, index),
+    }
+end
+
+function HitEffectPool.new(config: any): any
+    local folder = Instance.new("Folder")
+    folder.Name = "_Game1LocalHitEffects"
+    folder.Archivable = false
+    folder.Parent = Workspace
+
+    local slots = table.create(config.PoolSize)
+    for index = 1, config.PoolSize do
+        slots[index] = makeSlot(folder, config, index)
+    end
+
+    local self = setmetatable({
+        _config = config,
+        _folder = folder,
+        _slots = slots,
+        _cursor = 0,
+    }, HitEffectPool)
+    RunService.RenderStepped:Connect(function(dt)
+        for _, slot in ipairs(slots) do
+            HitSparkBurst.Step(slot.sparks, dt)
+        end
+    end)
+    return self
+end
+
+function HitEffectPool:Emit(position: Vector3, sourcePosition: Vector3, critical: boolean, cameraCFrame: CFrame)
+    self._cursor = (self._cursor % #self._slots) + 1
+    local slot = self._slots[self._cursor]
+    HitSparkBurst.Emit(slot.sparks, self._config, position, cameraCFrame, critical)
+    HitFrontFlash.Emit(slot.flash, self._config, position, sourcePosition, cameraCFrame, critical)
+end
+
+return HitEffectPool
diff --git a/src/client/combat/effects/HitFrontFlash.luau b/src/client/combat/effects/HitFrontFlash.luau
new file mode 100644
index 0000000..1cb86b4
--- /dev/null
+++ b/src/client/combat/effects/HitFrontFlash.luau
@@ -0,0 +1,49 @@
+local HitFrontFlash = {}
+
+function HitFrontFlash.Create(parent: Instance, config: any, index: number): any
+    local part = Instance.new("Part")
+    part.Name = ("HitFrontFlashSlot%02d"):format(index)
+    part.Size = Vector3.new(0.05, 0.05, 0.05)
+    part.Transparency = 1
+    part.Anchored = true
+    part.CanCollide = false
+    part.CanTouch = false
+    part.CanQuery = false
+    part.CastShadow = false
+    part.Parent = parent
+
+    local light = Instance.new("SpotLight")
+    light.Name = "ImpactFrontLight"
+    light.Enabled = false
+    light.Face = Enum.NormalId.Front
+    light.Color = Color3.fromRGB(255, 219, 139)
+    light.Brightness = config.FrontFlashBrightness
+    light.Range = config.FrontFlashRange
+    light.Angle = config.FrontFlashAngle
+    light.Shadows = false
+    light.Parent = part
+
+    return { part = part, light = light, generation = 0 }
+end
+
+function HitFrontFlash.Emit(slot: any, config: any, position: Vector3, sourcePosition: Vector3, cameraCFrame: CFrame, critical: boolean)
+    local incoming = sourcePosition - position
+    if incoming.Magnitude < 0.01 then
+        incoming = cameraCFrame.Position - position
+    end
+    if incoming.Magnitude < 0.01 then return end
+
+    local lightPosition = position + incoming.Unit * config.FrontFlashOffset
+    slot.part.CFrame = CFrame.lookAt(lightPosition, position)
+    slot.light.Brightness = config.FrontFlashBrightness * (if critical then config.FrontFlashCriticalMultiplier else 1)
+    slot.generation += 1
+    local generation = slot.generation
+    slot.light.Enabled = true
+    task.delay(config.FrontFlashDuration, function()
+        if slot.generation == generation and slot.light.Parent then
+            slot.light.Enabled = false
+        end
+    end)
+end
+
+return table.freeze(HitFrontFlash)
diff --git a/src/client/combat/effects/HitSparkBurst.luau b/src/client/combat/effects/HitSparkBurst.luau
new file mode 100644
index 0000000..34ed3ef
--- /dev/null
+++ b/src/client/combat/effects/HitSparkBurst.luau
@@ -0,0 +1,150 @@
+local HitSparkBurst = {}
+
+local BASE_ANGLES_DEGREES = table.freeze({ -144, -72, 0, 72, 144, 36, 108, -108 })
+local rng = Random.new()
+
+local function makeBeam(config: any, parent: Instance, index: number): any
+    local tail = Instance.new("Attachment")
+    tail.Name = ("SparkTail%02d"):format(index)
+    tail.Parent = parent
+
+    local head = Instance.new("Attachment")
+    head.Name = ("SparkHead%02d"):format(index)
+    head.Parent = parent
+
+    local beam = Instance.new("Beam")
+    beam.Name = ("ImpactSpark%02d"):format(index)
+    beam.Attachment0 = tail
+    beam.Attachment1 = head
+    beam.Enabled = false
+    beam.FaceCamera = true
+    beam.Segments = 1
+    beam.Width0 = config.SparkWidthTail
+    beam.Width1 = config.SparkWidthHead
+    beam.CurveSize0 = 0
+    beam.CurveSize1 = 0
+    beam.LightEmission = 1
+    beam.LightInfluence = 0
+    beam.Brightness = config.SparkBrightness
+    beam.ZOffset = 0.05
+    beam.Color = ColorSequence.new({
+        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 245, 194)),
+        ColorSequenceKeypoint.new(0.45, Color3.fromRGB(255, 184, 63)),
+        ColorSequenceKeypoint.new(1, Color3.fromRGB(224, 96, 24)),
+    })
+    beam.Transparency = NumberSequence.new({
+        NumberSequenceKeypoint.new(0, 0.03),
+        NumberSequenceKeypoint.new(0.68, 0.10),
+        NumberSequenceKeypoint.new(1, 0.72),
+    })
+    beam.Parent = parent
+
+    return {
+        tail = tail,
+        head = head,
+        beam = beam,
+        origin = Vector3.zero,
+        direction = Vector3.new(1, 0, 0),
+        segmentLength = config.SparkLengthMin,
+        speed = config.SparkTravelSpeedMin,
+        baseWidthTail = config.SparkWidthTail,
+        baseWidthHead = config.SparkWidthHead,
+    }
+end
+
+function HitSparkBurst.Create(parent: Instance, config: any, index: number): any
+    local part = Instance.new("Part")
+    part.Name = ("HitSparkSlot%02d"):format(index)
+    part.Size = Vector3.new(0.05, 0.05, 0.05)
+    part.Transparency = 1
+    part.Anchored = true
+    part.CanCollide = false
+    part.CanTouch = false
+    part.CanQuery = false
+    part.CastShadow = false
+    part.Parent = parent
+
+    local streaks = table.create(config.CriticalSparkCount)
+    for sparkIndex = 1, config.CriticalSparkCount do
+        streaks[sparkIndex] = makeBeam(config, part, sparkIndex)
+    end
+
+    return {
+        part = part,
+        streaks = streaks,
+        age = 0,
+        duration = 0,
+        active = false,
+        activeCount = 0,
+    }
+end
+
+local function configureStreak(streak: any, config: any, sparkIndex: number)
+    local angle = BASE_ANGLES_DEGREES[sparkIndex]
+        + rng:NextNumber(-config.SparkDirectionJitterDegrees, config.SparkDirectionJitterDegrees)
+    local radians = math.rad(angle)
+    local depth = rng:NextNumber(-config.SparkDepthJitter, config.SparkDepthJitter)
+    local direction = Vector3.new(math.cos(radians), math.sin(radians), depth).Unit
+    local origin = Vector3.new(
+        rng:NextNumber(-config.SparkOriginSpreadX, config.SparkOriginSpreadX),
+        rng:NextNumber(-config.SparkOriginSpreadY, config.SparkOriginSpreadY),
+        rng:NextNumber(-config.SparkOriginDepth, config.SparkOriginDepth)
+    )
+    local length = rng:NextNumber(config.SparkLengthMin, config.SparkLengthMax)
+
+    streak.origin = origin
+    streak.direction = direction
+    streak.segmentLength = length
+    streak.speed = rng:NextNumber(config.SparkTravelSpeedMin, config.SparkTravelSpeedMax)
+    streak.tail.Position = origin
+    streak.head.Position = origin + direction * length
+    streak.beam.Width0 = streak.baseWidthTail
+    streak.beam.Width1 = streak.baseWidthHead
+    streak.beam.Enabled = true
+end
+
+function HitSparkBurst.Emit(slot: any, config: any, position: Vector3, cameraCFrame: CFrame, critical: boolean)
+    slot.part.CFrame = CFrame.lookAt(position, position + cameraCFrame.LookVector, cameraCFrame.UpVector)
+    slot.age = 0
+    slot.duration = if critical then config.CriticalSparkDuration else config.NormalSparkDuration
+    slot.activeCount = if critical then config.CriticalSparkCount else config.NormalSparkCount
+    slot.active = true
+
+    for sparkIndex, streak in ipairs(slot.streaks) do
+        if sparkIndex <= slot.activeCount then
+            configureStreak(streak, config, sparkIndex)
+        else
+            streak.beam.Enabled = false
+        end
+    end
+end
+
+function HitSparkBurst.Step(slot: any, dt: number)
+    if not slot.active then return end
+    slot.age += dt
+    if slot.age >= slot.duration then
+        slot.active = false
+        for _, streak in ipairs(slot.streaks) do
+            streak.beam.Enabled = false
+        end
+        return
+    end
+
+    local fadeStart = slot.duration * 0.62
+    local widthScale = 1
+    if slot.age > fadeStart then
+        widthScale = math.max(0.2, 1 - (slot.age - fadeStart) / math.max(0.001, slot.duration - fadeStart))
+    end
+
+    for sparkIndex = 1, slot.activeCount do
+        local streak = slot.streaks[sparkIndex]
+        local travel = streak.speed * slot.age
+        local tail = streak.origin + streak.direction * travel
+        streak.tail.Position = tail
+        streak.head.Position = tail + streak.direction * streak.segmentLength
+        streak.beam.Width0 = math.max(0.012, streak.baseWidthTail * widthScale)
+        streak.beam.Width1 = math.max(0.006, streak.baseWidthHead * widthScale)
+    end
+end
+
+return table.freeze(HitSparkBurst)
