diff --git a/src/shared/combat/DeathAnimationPolicy.luau b/src/shared/combat/DeathAnimationPolicy.luau
index 837fec4..4dfc7a7 100644
--- a/src/shared/combat/DeathAnimationPolicy.luau
+++ b/src/shared/combat/DeathAnimationPolicy.luau
@@ -1,13 +1,16 @@
--- Canonical death playback contract, adapted from RobloxLineage monster playback.
--- Death is a one-shot authored at 1x speed. We keep the track alive until the
--- last evaluable instant immediately before AnimationTrack naturally stops,
--- then freeze that pose for DeathIdle. Do not subtract an authored-frame size:
--- different clips have different source frame rates and monster clips do not
--- contain the character-specific synthetic 24 FPS loop-closure tail.
+-- Canonical death playback contract.
+--
+-- Do not infer an animation "last frame" from 24/30/60 FPS and do not stop at
+-- Length - epsilon. For a KeyframeSequence Roblox defines the sequence length
+-- from the Keyframe with the greatest Keyframe.Time, so AnimationTrack.Length
+-- is the authored final key time once the track is loaded.
+--
+-- We let the one-shot run normally. PreAnimation only intercepts the animation
+-- step that would cross the end: while the track is still playing, freeze its
+-- speed and evaluate TimePosition == Length exactly. That applies the actual
+-- final authored key and keeps that pose alive for DeathIdle.
 local DeathAnimationPolicy = {}
 
-DeathAnimationPolicy.EndEpsilonSeconds = 1 / 240
-
 function DeathAnimationPolicy.Start(track: AnimationTrack)
 	track.Looped = false
 	track.Priority = Enum.AnimationPriority.Action4
@@ -16,34 +19,29 @@ function DeathAnimationPolicy.Start(track: AnimationTrack)
 	track:AdjustWeight(1, 0)
 end
 
-function DeathAnimationPolicy.AdvanceToTerminal(track: AnimationTrack, deltaTimeSim: number): (boolean, number?)
+function DeathAnimationPolicy.AdvanceToFinalKey(track: AnimationTrack, deltaTimeSim: number): (boolean, number?)
 	if not track.IsPlaying then
 		return false, nil
 	end
 
-	local length = tonumber(track.Length) or 0
+	local finalKeyTime = tonumber(track.Length) or 0
 	local speed = tonumber(track.Speed) or 0
-	if length <= DeathAnimationPolicy.EndEpsilonSeconds or speed <= 0 then
+	if finalKeyTime <= 0 or speed <= 0 then
 		return false, nil
 	end
 
-	-- This is the RobloxLineage monster rule: PreAnimation executes before the
-	-- Animator advances the track. Freeze only when the next evaluation would
-	-- cross the natural end, and hold a tiny epsilon before Length so the track
-	-- remains active. For a 2.100000s clip this resolves to ~2.095833s, not the
-	-- incorrect 2.058333s produced by subtracting a whole 24 FPS frame.
-	local step = math.max(0, tonumber(deltaTimeSim) or 0) * speed
-	local endEpsilon = math.max(DeathAnimationPolicy.EndEpsilonSeconds, step * 0.05)
-	local terminalTime = math.max(0, length - endEpsilon)
 	local current = math.max(0, tonumber(track.TimePosition) or 0)
-	if current + step < terminalTime then
-		return false, terminalTime
+	local step = math.max(0, tonumber(deltaTimeSim) or 0) * speed
+	if current + step < finalKeyTime then
+		return false, finalKeyTime
 	end
 
+	-- TimePosition can only be changed while the track is playing. Freeze first,
+	-- then evaluate the exact final key instead of an FPS-derived approximation.
 	track:AdjustSpeed(0)
-	track.TimePosition = terminalTime
+	track.TimePosition = finalKeyTime
 	track:AdjustWeight(1, 0)
-	return true, terminalTime
+	return true, finalKeyTime
 end
 
 return table.freeze(DeathAnimationPolicy)
