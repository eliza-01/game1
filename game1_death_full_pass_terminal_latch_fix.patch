+local function playDeathToTerminalPose(model: Model, track: AnimationTrack): boolean
+    -- Death must cross its real end before DeathIdle starts. Keeping the track
+    -- looped for one pass avoids Roblox deactivating it at Length before we can
+    -- preserve the authored terminal pose.
+    local startedAt = os.clock()
+    local terminalHeld = false
+    local terminalTime = 0
+    local loopConnection
+
+    loopConnection = track.DidLoop:Connect(function()
+        if terminalHeld or not model.Parent then
+            return
+        end
+        local length = tonumber(track.Length) or 0
+        if length <= 0.01 then
+            return
+        end
+        terminalTime = math.max(0, length - EntityLifecycleConfig.DeathTerminalFrameEpsilonSeconds)
+        local ok = pcall(function()
+            track.Looped = false
+            track:AdjustSpeed(0)
+            track.TimePosition = terminalTime
+        end)
+        terminalHeld = ok
+    end)
+
+    local played = pcall(function()
+        track.Looped = true
+        track:Play(0, 1, 1)
+    end)
+    if not played then
+        loopConnection:Disconnect()
+        return false
+    end
+
+    local loadDeadline = startedAt + EntityLifecycleConfig.DeathTrackLoadTimeoutSeconds
+    while track.Length <= 0.01 and os.clock() < loadDeadline and model.Parent do
+        task.wait()
     end
     local length = tonumber(track.Length) or 0
     if length <= 0.01 then
+        loopConnection:Disconnect()
         return false
     end
+    terminalTime = math.max(0, length - EntityLifecycleConfig.DeathTerminalFrameEpsilonSeconds)
 
-    local terminalTime = math.max(0, length - EntityLifecycleConfig.DeathTerminalFrameEpsilonSeconds)
-    while model.Parent and track.IsPlaying and track.TimePosition < terminalTime do
-        task.wait(0.005)
+    local completionDeadline = startedAt + length + EntityLifecycleConfig.DeathPlaybackSafetySeconds
+    while model.Parent and not terminalHeld and os.clock() < completionDeadline do
+        task.wait()
     end
+    loopConnection:Disconnect()
     if not model.Parent then
         return false
     end
 
-    local ok = pcall(function()
-        -- Re-prime if Roblox naturally stopped on the same scheduler slice, then
-        -- seek to the final authored pose and hold it for the whole DeathIdle state.
-        if not track.IsPlaying then
-            track:Play(0, 1, 0)
-        end
-        track.TimePosition = terminalTime
-        track:AdjustSpeed(0)
-    end)
-    return ok
+    if not terminalHeld then
+        warn("[game1][monster-spawn] death DidLoop was not observed; forcing terminal pose after full-length safety window")
+        pcall(function()
+            if not track.IsPlaying then
+                track.Looped = true
+                track:Play(0, 1, 0)
+            end
+            track.Looped = false
+            track:AdjustSpeed(0)
+            track.TimePosition = terminalTime
+        end)
+    end
+    -- Let Animator evaluate the seek before entering DeathIdle/sink.
+    task.wait()
+    return true
 end
 
