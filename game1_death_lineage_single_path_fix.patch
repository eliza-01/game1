diff --git a/src/shared/combat/DeathAnimationPolicy.luau b/src/shared/combat/DeathAnimationPolicy.luau
new file mode 100644
index 0000000..3c508e5
--- /dev/null
+++ b/src/shared/combat/DeathAnimationPolicy.luau
@@ -0,0 +1,51 @@
+-- Canonical death playback contract, adapted from RobloxLineage.
+-- Studio-exported RBXM clips are baked at 24 FPS and include a terminal End
+-- sample one baked frame after the final authored pose. The final authored
+-- death pose is therefore Length - 1/24, not the engine's natural Stop edge.
+local DeathAnimationPolicy = {}
+
+DeathAnimationPolicy.RobloxBakedAnimationRate = 24
+DeathAnimationPolicy.TerminalFrameSeconds = 1 / DeathAnimationPolicy.RobloxBakedAnimationRate
+
+function DeathAnimationPolicy.Start(track: AnimationTrack)
+	track.Looped = false
+	track.Priority = Enum.AnimationPriority.Action4
+	track:Play(0, 1, 1)
+	track.TimePosition = 0
+	track:AdjustWeight(1, 0)
+end
+
+function DeathAnimationPolicy.TerminalTime(track: AnimationTrack): number?
+	local length = tonumber(track.Length) or 0
+	if length <= DeathAnimationPolicy.TerminalFrameSeconds then
+		return nil
+	end
+	return math.max(0, length - DeathAnimationPolicy.TerminalFrameSeconds)
+end
+
+function DeathAnimationPolicy.AdvanceToTerminal(track: AnimationTrack, deltaTimeSim: number): (boolean, number?)
+	local terminalTime = DeathAnimationPolicy.TerminalTime(track)
+	if terminalTime == nil or not track.IsPlaying then
+		return false, terminalTime
+	end
+
+	local speed = tonumber(track.Speed) or 0
+	if speed <= 0 then
+		return false, terminalTime
+	end
+
+	local current = math.max(0, tonumber(track.TimePosition) or 0)
+	local step = math.max(0, tonumber(deltaTimeSim) or 0) * speed
+	if current + step < terminalTime then
+		return false, terminalTime
+	end
+
+	-- PreAnimation runs before Animator evaluates this frame. Seek to the final
+	-- authored sample and freeze it now, so that exact pose is what gets evaluated.
+	track.TimePosition = terminalTime
+	track:AdjustWeight(1, 0)
+	track:AdjustSpeed(0)
+	return true, terminalTime
+end
+
+return table.freeze(DeathAnimationPolicy)
