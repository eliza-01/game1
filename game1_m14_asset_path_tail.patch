 .monster-spawn-workflow{display:grid;grid-template-columns:minmax(360px,.9fr) minmax(560px,1.35fr);gap:14px;margin-top:14px}.monster-spawn-position-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.monster-spawn-settings-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.spawn-enabled{display:flex!important;align-items:center;gap:8px;margin-top:25px!important}.spawn-enabled input{width:auto!important;margin:0!important}.monster-spawn-records{display:grid;gap:7px}.monster-spawn-record{display:grid;grid-template-columns:minmax(190px,.75fr) minmax(300px,1.3fr) auto;gap:12px;align-items:center;width:100%;text-align:left;background:var(--panel2)}.monster-spawn-record.active{border-color:var(--mint);background:#42d6b112}.monster-spawn-record span{min-width:0}.monster-spawn-record strong,.monster-spawn-record small,.monster-spawn-record b{display:block;overflow-wrap:anywhere}.monster-spawn-record small{margin-top:3px;color:var(--muted);font-size:10px}.monster-spawn-record i{font-style:normal;font-size:10px;letter-spacing:.06em;border:1px solid var(--line);border-radius:999px;padding:4px 7px}.monster-spawn-record i.synced{color:var(--mint);border-color:#42d6b166}.monster-spawn-record i.stale{color:var(--orange);border-color:#ff9f4366}.monster-spawn-record i.error{color:var(--danger);border-color:#ff657766}#monster-spawn-readiness span,#monster-spawn-operation span{display:block}.blocked{color:var(--danger)!important}@media(max-width:1150px){.monster-spawn-workflow{grid-template-columns:1fr}}@media(max-width:700px){.monster-spawn-position-grid,.monster-spawn-settings-grid{grid-template-columns:1fr}.monster-spawn-record{grid-template-columns:1fr}.spawn-enabled{margin-top:5px!important}}
