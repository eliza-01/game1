+local function fingerprintFeedBytes(state: any, value: string)
+    local crc = state.crc
+    for index = 1, #value do
+        local slot = bit32.band(bit32.bxor(crc, string.byte(value, index)), 0xFF)
+        crc = bit32.bxor(bit32.rshift(crc, 8), CRC32_TABLE[slot + 1])
+    end
+    state.crc = crc
+end
