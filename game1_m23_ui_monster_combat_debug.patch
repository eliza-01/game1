+-- Roblox Studio: StarterPlayer.StarterPlayerScripts.game1Client.MonsterAnimation.MonsterAnimationCompositionConfig (ModuleScript)
+-- Client-only limits for monster upper-body-over-locomotion composition.
+local Config = {
+	MaxComposedMonsters = 32,
+	MaxDistance = 140,
+	EntryBlendSeconds = 0.10,
+	ExitBlendSeconds = 0.08,
+	SamplerIdleTtlSeconds = 8,
+	SamplerAnchorInterval = 0.50,
+	BottomLeafBandFraction = 0.28,
+	MaxLowerBodyFraction = 0.62,
+	MovementDirectionMinSpeed = 0.35,
+}
+
+return table.freeze(Config)
diff --git a/src/client/monster/MonsterAttackLocomotionController.luau b/src/client/monster/MonsterAttackLocomotionController.luau
new file mode 100644
index 0000000..a48d2bd
--- /dev/null
+++ b/src/client/monster/MonsterAttackLocomotionController.luau
@@ -0,0 +1,333 @@
+-- Roblox Studio: StarterPlayer.StarterPlayerScripts.game1Client.MonsterAnimation.MonsterAttackLocomotionController (ModuleScript)
+-- Keeps monster legs in authored Run while the server-owned attack continues on the upper body.
+-- Samplers are pooled by rig/run identity but leased exclusively so nearby monsters keep independent phases.
+local RunService = game:GetService("RunService")
+local Workspace = game:GetService("Workspace")
+
+local Config = require(script.Parent:WaitForChild("MonsterAnimationCompositionConfig"))
+local MonsterSkeletonMap = require(script.Parent:WaitForChild("MonsterSkeletonMap"))
+local MonsterLocomotionSampler = require(script.Parent:WaitForChild("MonsterLocomotionSampler"))
+
+local Controller = {}
+local started = false
+local entries = {}
+local activeEntries = {}
+local samplers = {}
+local samplerSerial = 0
+local warned = {}
+local lastCleanupAt = 0
+
+local function warnOnce(key: string, message: string)
+	if warned[key] then
+		return
+	end
+	warned[key] = true
+	warn("[game1][MONSTER_ANIM] " .. message)
+end
+
+local function approach(current: number, target: number, delta: number): number
+	if current < target then
+		return math.min(target, current + delta)
+	end
+	return math.max(target, current - delta)
+end
+
+local function parentTransformedWorldCFrame(bone: Bone): CFrame?
+	local parent = bone.Parent
+	if not parent then
+		return nil
+	end
+	if parent:IsA("Bone") then
+		return parent.TransformedWorldCFrame
+	end
+	if parent:IsA("BasePart") then
+		return parent.CFrame
+	end
+	return nil
+end
+
+local function horizontalDirection(vector: Vector3): Vector3?
+	local flat = Vector3.new(vector.X, 0, vector.Z)
+	if flat.Magnitude <= Config.MovementDirectionMinSpeed then
+		return nil
+	end
+	return flat.Unit
+end
+
+local function movementDirection(entry): Vector3?
+	return horizontalDirection(entry.root.AssemblyLinearVelocity)
+		or horizontalDirection(entry.root.CFrame.LookVector)
+end
+
+local function alignLowerBodyRootsToMovement(entry)
+	if not entry.sampler or entry.weight <= 0 or #entry.lowerRootPaths == 0 then
+		return
+	end
+	local direction = movementDirection(entry)
+	if not direction then
+		return
+	end
+
+	-- The wrapper/root is owned by Humanoid.AutoRotate and therefore follows the
+	-- actual travel direction. Map the authored Run lower-body branches into that
+	-- movement frame instead of inheriting any large yaw authored into Atk01.
+	-- Only independent leg subtrees are compensated; pelvis/spine ownership stays
+	-- with the attack so the torso can still twist naturally above the hips.
+	local movementRoot = CFrame.lookAlong(Vector3.zero, direction, Vector3.yAxis)
+	local desiredVisualRotation = (movementRoot * entry.visualRootOffsetRotation).Rotation
+	for _, path in entry.lowerRootPaths do
+		local targetBone = entry.targetBones[path]
+		local sourceRelative = entry.sampler:GetBoneRelativeToPivot(path)
+		if targetBone and targetBone.Parent and sourceRelative then
+			local parentWorld = parentTransformedWorldCFrame(targetBone)
+			if parentWorld then
+				local currentTransform = targetBone.Transform
+				local currentWorld = targetBone.TransformedWorldCFrame
+				local currentLocal = parentWorld:ToObjectSpace(currentWorld)
+				local effectiveBase = currentLocal * currentTransform:Inverse()
+				local desiredRotation = (desiredVisualRotation * sourceRelative.Rotation).Rotation
+				local desiredWorld = CFrame.new(currentWorld.Position) * desiredRotation
+				local desiredLocal = parentWorld:ToObjectSpace(desiredWorld)
+				local alignedTransform = effectiveBase:Inverse() * desiredLocal
+				targetBone.Transform = currentTransform:Lerp(alignedTransform, entry.weight)
+			end
+		end
+	end
+end
+
+local function samplerBaseKey(model: Model): string
+	return table.concat({
+		tostring(model:GetAttribute("MonsterVisualKey") or ""),
+		tostring(model:GetAttribute("MonsterRunAnimationId") or ""),
+		string.format("%.3f", tonumber(model:GetAttribute("MonsterAttackPursuitPlaybackSpeed")) or 1),
+	}, "|")
+end
+
+local function setEntryActive(entry, active: boolean)
+	if active and not entry.disabled then
+		activeEntries[entry] = true
+	else
+		activeEntries[entry] = nil
+	end
+end
+
+local function releaseSampler(entry)
+	local sampler = entry.sampler
+	if not sampler then
+		return
+	end
+	sampler.users = math.max(0, sampler.users - 1)
+	sampler:Touch()
+	entry.sampler = nil
+	entry.samplerKey = nil
+end
+
+local function acquireSampler(entry): boolean
+	if entry.sampler then
+		return true
+	end
+	local runId = tostring(entry.model:GetAttribute("MonsterRunAnimationId") or "")
+	if not string.match(runId, "^%d+$") or runId == "0" then
+		entry.disabled = true
+		setEntryActive(entry, false)
+		return false
+	end
+	local baseKey = samplerBaseKey(entry.model)
+	local sampler = nil
+	local cacheKey = nil
+	for key, candidate in samplers do
+		if candidate.baseKey == baseKey and candidate.users <= 0 then
+			sampler = candidate
+			cacheKey = key
+			break
+		end
+	end
+	local phase = tonumber(entry.model:GetAttribute("MonsterAnimationPhase")) or 0
+	if not sampler then
+		local playbackSpeed = tonumber(entry.model:GetAttribute("MonsterAttackPursuitPlaybackSpeed")) or 1
+		local created, errorMessage = MonsterLocomotionSampler.new(entry.visual, runId, playbackSpeed, phase)
+		if not created then
+			warnOnce(baseKey, errorMessage or "could not create monster locomotion sampler")
+			entry.disabled = true
+			setEntryActive(entry, false)
+			return false
+		end
+		sampler = created
+		sampler.baseKey = baseKey
+		samplerSerial += 1
+		cacheKey = baseKey .. "#" .. tostring(samplerSerial)
+		samplers[cacheKey] = sampler
+	else
+		sampler:SetPhase(phase)
+	end
+	sampler.users = 1
+	sampler:Touch()
+	entry.sampler = sampler
+	entry.samplerKey = cacheKey
+	return true
+end
+
+local function unbind(model: Model)
+	local entry = entries[model]
+	if not entry then
+		return
+	end
+	for _, connection in entry.connections do
+		connection:Disconnect()
+	end
+	releaseSampler(entry)
+	setEntryActive(entry, false)
+	entries[model] = nil
+end
+
+local function bindMonster(model: Model)
+	if entries[model] or model:GetAttribute("Game1MonsterRuntime") ~= true then
+		return
+	end
+	task.spawn(function()
+		local visual = model:FindFirstChild("ImportedRig") or model
+		local root = model:FindFirstChild("HumanoidRootPart") or model:WaitForChild("HumanoidRootPart", 5)
+		if not visual or not visual:IsA("Model") or not root or not root:IsA("BasePart") or not model.Parent or entries[model] then
+			return
+		end
+		local lowerPaths = MonsterSkeletonMap.ResolveLowerBodyPaths(visual)
+		local lowerRootPaths = MonsterSkeletonMap.ResolveIndependentLowerBodyRoots(visual, lowerPaths)
+		if #lowerPaths == 0 then
+			warnOnce(tostring(model:GetAttribute("MonsterVisualKey") or model.Name), "no lower-body bone branches resolved; attack locomotion composition disabled for this rig")
+			return
+		end
+		local entry = {
+			model = model,
+			visual = visual,
+			root = root,
+			targetBones = MonsterSkeletonMap.BuildBonePathMap(visual),
+			lowerPaths = lowerPaths,
+			lowerRootPaths = lowerRootPaths,
+			visualRootOffsetRotation = root.CFrame:ToObjectSpace(visual:GetPivot()).Rotation,
+			weight = 0,
+			sampler = nil,
+			samplerKey = nil,
+			connections = {},
+			disabled = false,
+		}
+		entries[model] = entry
+		table.insert(entry.connections, model:GetAttributeChangedSignal("MonsterAttackPursuitActive"):Connect(function()
+			if model:GetAttribute("MonsterAttackPursuitActive") == true then
+				setEntryActive(entry, true)
+			end
+		end))
+		table.insert(entry.connections, model:GetAttributeChangedSignal("MonsterAttackPursuitPlaybackSpeed"):Connect(function()
+			releaseSampler(entry)
+			if model:GetAttribute("MonsterAttackPursuitActive") == true then
+				setEntryActive(entry, true)
+			end
+		end))
+		table.insert(entry.connections, model.Destroying:Connect(function()
+			unbind(model)
+		end))
+		if model:GetAttribute("MonsterAttackPursuitActive") == true then
+			setEntryActive(entry, true)
+		end
+	end)
+end
+
+local function bindFolder(folder: Folder)
+	for _, child in folder:GetChildren() do
+		if child:IsA("Model") then
+			bindMonster(child)
+		end
+	end
+	folder.ChildAdded:Connect(function(child)
+		if child:IsA("Model") then
+			bindMonster(child)
+		end
+	end)
+end
+
+local function cleanupSamplers(now: number)
+	if now - lastCleanupAt < 1 then
+		return
+	end
+	lastCleanupAt = now
+	for key, sampler in samplers do
+		if sampler.users <= 0 and now - sampler.lastUsedAt >= Config.SamplerIdleTtlSeconds then
+			sampler:Destroy()
+			samplers[key] = nil
+		end
+	end
+end
+
+local function step(deltaTime: number)
+	local camera = Workspace.CurrentCamera
+	if not camera then
+		return
+	end
+	local now = os.clock()
+	local activeCount = 0
+	local maxDistanceSquared = Config.MaxDistance * Config.MaxDistance
+	for entry in activeEntries do
+		local model = entry.model
+		if not model.Parent or not entry.root.Parent or not entry.visual.Parent then
+			unbind(model)
+			continue
+		end
+		local cameraDelta = entry.root.Position - camera.CFrame.Position
+		local distanceSquared = cameraDelta:Dot(cameraDelta)
+		local pursuitActive = model:GetAttribute("MonsterAttackPursuitActive") == true
+			and tostring(model:GetAttribute("LifeState")) == "Alive"
+		local wantsComposition = pursuitActive and distanceSquared <= maxDistanceSquared
+		if wantsComposition and not entry.sampler and activeCount < Config.MaxComposedMonsters then
+			acquireSampler(entry)
+		end
+		if entry.sampler then
+			activeCount += 1
+			entry.sampler:AnchorNear(camera.CFrame, now, Config.SamplerAnchorInterval)
+			local targetWeight = if wantsComposition then 1 else 0
+			local duration = if targetWeight > entry.weight then Config.EntryBlendSeconds else Config.ExitBlendSeconds
+			local stepSize = if duration > 0 then math.max(0, deltaTime) / duration else 1
+			entry.weight = approach(entry.weight, targetWeight, stepSize)
+			if entry.weight > 0 and entry.sampler:IsReady() then
+				for _, path in entry.lowerPaths do
+					local targetBone = entry.targetBones[path]
+					local sourceBone = entry.sampler:GetBone(path)
+					if targetBone and targetBone.Parent and sourceBone and sourceBone.Parent then
+						targetBone.Transform = targetBone.Transform:Lerp(sourceBone.Transform, entry.weight)
+					end
+				end
+				alignLowerBodyRootsToMovement(entry)
+			end
+			if entry.weight <= 0 and not wantsComposition then
+				releaseSampler(entry)
+				if not pursuitActive then
+					setEntryActive(entry, false)
+				end
+			end
+		elseif not pursuitActive then
+			setEntryActive(entry, false)
+		end
+	end
+	cleanupSamplers(now)
+end
+
+function Controller.Start()
+	if started then
+		return
+	end
+	started = true
+	local current = Workspace:FindFirstChild("Monsters")
+	if current and current:IsA("Folder") then
+		bindFolder(current)
+	end
+	Workspace.ChildAdded:Connect(function(child)
+		if child.Name == "Monsters" and child:IsA("Folder") then
+			bindFolder(child)
+		end
+	end)
+	RunService.PreSimulation:Connect(step)
+	print(("[game1][MONSTER_ANIM] attack locomotion composition ready · max %d · radius %d"):format(
+		Config.MaxComposedMonsters,
+		Config.MaxDistance
+	))
+end
+
+return table.freeze(Controller)
diff --git a/src/client/monster/MonsterLocomotionSampler.luau b/src/client/monster/MonsterLocomotionSampler.luau
new file mode 100644
index 0000000..fec8d36
--- /dev/null
+++ b/src/client/monster/MonsterLocomotionSampler.luau
@@ -0,0 +1,151 @@
+-- Roblox Studio: StarterPlayer.StarterPlayerScripts.game1Client.MonsterAnimation.MonsterLocomotionSampler (ModuleScript)
+-- Pooled invisible locomotion pose source. A sampler is leased exclusively while a monster is composed so individual phase offsets never synchronize visible legs.
+local Workspace = game:GetService("Workspace")
+
+local MonsterSkeletonMap = require(script.Parent:WaitForChild("MonsterSkeletonMap"))
+
+local MonsterLocomotionSampler = {}
+MonsterLocomotionSampler.__index = MonsterLocomotionSampler
+
+local function prepareProxy(visual: Model): (Model?, Animator?, string?)
+	local oldArchivable = visual.Archivable
+	visual.Archivable = true
+	local okClone, cloneOrError = pcall(function()
+		return visual:Clone()
+	end)
+	visual.Archivable = oldArchivable
+	if not okClone or not cloneOrError then
+		return nil, nil, "could not clone monster visual: " .. tostring(cloneOrError)
+	end
+	local proxy = cloneOrError :: Model
+	proxy.Name = "__game1MonsterLocomotionSampler"
+	for _, object in proxy:GetDescendants() do
+		if object:IsA("Bone") then
+			object.Transform = CFrame.identity
+		elseif object:IsA("BasePart") then
+			object.Anchored = true
+			object.CanCollide = false
+			object.CanTouch = false
+			object.CanQuery = false
+			object.CastShadow = false
+			object.Transparency = 1
+			object.LocalTransparencyModifier = 1
+		elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam") then
+			object.Enabled = false
+		elseif object:IsA("Script") or object:IsA("LocalScript") then
+			object:Destroy()
+		end
+	end
+	local controller = proxy:FindFirstChildWhichIsA("AnimationController", true)
+	if not controller then
+		controller = Instance.new("AnimationController")
+		controller.Name = "AnimationController"
+		controller.Parent = proxy
+	end
+	local animator = controller:FindFirstChildWhichIsA("Animator")
+	if not animator then
+		animator = Instance.new("Animator")
+		animator.Parent = controller
+	end
+	proxy.Parent = Workspace
+	return proxy, animator, nil
+end
+
+function MonsterLocomotionSampler.new(visual: Model, animationId: string, playbackSpeed: number, startPhase: number?)
+	local proxy, animator, errorMessage = prepareProxy(visual)
+	if not proxy or not animator then
+		return nil, errorMessage
+	end
+	local animation = Instance.new("Animation")
+	animation.Name = "MonsterAttackPursuitRunSource"
+	animation.AnimationId = "rbxassetid://" .. animationId
+	local okLoad, trackOrError = pcall(function()
+		return animator:LoadAnimation(animation)
+	end)
+	animation:Destroy()
+	if not okLoad then
+		proxy:Destroy()
+		return nil, "could not load monster run source: " .. tostring(trackOrError)
+	end
+	local track = trackOrError :: AnimationTrack
+	track.Looped = true
+	track.Priority = Enum.AnimationPriority.Movement
+	local okPlay, playError = pcall(function()
+		track:Play(0, 1, math.max(0.01, playbackSpeed))
+	end)
+	if not okPlay then
+		track:Destroy()
+		proxy:Destroy()
+		return nil, "could not play monster run source: " .. tostring(playError)
+	end
+	local sampler = setmetatable({
+		proxy = proxy,
+		track = track,
+		bones = MonsterSkeletonMap.BuildBonePathMap(proxy),
+		users = 0,
+		lastUsedAt = os.clock(),
+		lastAnchorAt = 0,
+		phase = 0,
+		phasePending = false,
+	}, MonsterLocomotionSampler)
+	sampler:SetPhase(startPhase or 0)
+	return sampler, nil
+end
+
+function MonsterLocomotionSampler:SetPhase(phase: number)
+	self.phase = math.clamp(tonumber(phase) or 0, 0, 0.999999)
+	self.phasePending = true
+	local length = tonumber(self.track and self.track.Length) or 0
+	if length > 0.01 and self.track and self.track.IsPlaying then
+		self.track.TimePosition = self.phase * length
+		self.phasePending = false
+	end
+end
+
+function MonsterLocomotionSampler:GetBone(path: string): Bone?
+	return self.bones[path]
+end
+
+function MonsterLocomotionSampler:GetBoneRelativeToPivot(path: string): CFrame?
+	local bone = self.bones[path]
+	if not bone or not bone.Parent or not self.proxy.Parent then
+		return nil
+	end
+	return self.proxy:GetPivot():ToObjectSpace(bone.TransformedWorldCFrame)
+end
+
+function MonsterLocomotionSampler:IsReady(): boolean
+	local ready = self.track ~= nil and self.track.Length > 0.01
+	if ready and self.phasePending then
+		self.track.TimePosition = self.phase * self.track.Length
+		self.phasePending = false
+	end
+	return ready
+end
+
+function MonsterLocomotionSampler:Touch()
+	self.lastUsedAt = os.clock()
+end
+
+function MonsterLocomotionSampler:AnchorNear(cameraCFrame: CFrame, now: number, interval: number)
+	if now - self.lastAnchorAt < interval or not self.proxy.Parent then
+		return
+	end
+	self.lastAnchorAt = now
+	self.proxy:PivotTo(CFrame.new(cameraCFrame.Position + Vector3.new(0, -24, 0)))
+end
+
+function MonsterLocomotionSampler:Destroy()
+	if self.track then
+		pcall(function()
+			self.track:Stop(0)
+			self.track:Destroy()
+		end)
+	end
+	if self.proxy then
+		self.proxy:Destroy()
+	end
+	self.bones = {}
+end
+
+return MonsterLocomotionSampler
diff --git a/src/client/monster/MonsterSkeletonMap.luau b/src/client/monster/MonsterSkeletonMap.luau
new file mode 100644
index 0000000..23d09e6
--- /dev/null
+++ b/src/client/monster/MonsterSkeletonMap.luau
@@ -0,0 +1,209 @@
+-- Roblox Studio: StarterPlayer.StarterPlayerScripts.game1Client.MonsterAnimation.MonsterSkeletonMap (ModuleScript)
+-- Pure skeleton topology helpers used by the monster locomotion compositor.
+local Config = require(script.Parent:WaitForChild("MonsterAnimationCompositionConfig"))
+
+local MonsterSkeletonMap = {}
+
+local LOWER_NAME_TOKENS = table.freeze({
+	"pelvis", "hip", "thigh", "calf", "shin", "foot", "toe", "leg", "paw", "hoof",
+})
+
+local function bonePath(bone: Bone, visual: Model): string
+	local parts = { bone.Name }
+	local current = bone.Parent
+	while current and current ~= visual do
+		table.insert(parts, 1, current.Name)
+		current = current.Parent
+	end
+	return table.concat(parts, "/")
+end
+
+function MonsterSkeletonMap.BuildBonePathMap(visual: Model): { [string]: Bone }
+	local result = {}
+	for _, object in visual:GetDescendants() do
+		if object:IsA("Bone") then
+			result[bonePath(object, visual)] = object
+		end
+	end
+	return result
+end
+
+local function commonAncestorPath(paths: { string }): string?
+	if #paths == 0 then
+		return nil
+	end
+	local split = {}
+	for index, path in ipairs(paths) do
+		split[index] = string.split(path, "/")
+	end
+	local common = {}
+	local cursor = 1
+	while true do
+		local value = split[1][cursor]
+		if not value then
+			break
+		end
+		for index = 2, #split do
+			if split[index][cursor] ~= value then
+				return if #common > 0 then table.concat(common, "/") else nil
+			end
+		end
+		table.insert(common, value)
+		cursor += 1
+	end
+	return if #common > 0 then table.concat(common, "/") else nil
+end
+
+local function fallbackLowerPaths(pathMap: { [string]: Bone }): { string }
+	local result = {}
+	for path, bone in pathMap do
+		local lowered = string.lower(bone.Name)
+		for _, token in LOWER_NAME_TOKENS do
+			if string.find(lowered, token, 1, true) then
+				table.insert(result, path)
+				break
+			end
+		end
+	end
+	table.sort(result)
+	return result
+end
+
+
+local function parentBonePath(pathMap: { [string]: Bone }, bone: Bone, visual: Model): string?
+	local parent = bone.Parent
+	if parent and parent:IsA("Bone") then
+		local path = bonePath(parent, visual)
+		if pathMap[path] then
+			return path
+		end
+	end
+	return nil
+end
+
+function MonsterSkeletonMap.ResolveIndependentLowerBodyRoots(visual: Model, lowerPaths: { string }): { string }
+	local pathMap = MonsterSkeletonMap.BuildBonePathMap(visual)
+	local selected = {}
+	for _, path in lowerPaths do
+		if pathMap[path] then
+			selected[path] = true
+		end
+	end
+
+	local childrenByPath = {}
+	for path in pathMap do
+		childrenByPath[path] = {}
+	end
+	for path, bone in pathMap do
+		local parentPath = parentBonePath(pathMap, bone, visual)
+		if parentPath then
+			table.insert(childrenByPath[parentPath], path)
+		end
+	end
+
+	local pureMemo = {}
+	local function isIndependentLowerSubtree(path: string): boolean
+		local cached = pureMemo[path]
+		if cached ~= nil then
+			return cached
+		end
+		if not selected[path] then
+			pureMemo[path] = false
+			return false
+		end
+		for _, childPath in childrenByPath[path] or {} do
+			if not isIndependentLowerSubtree(childPath) then
+				pureMemo[path] = false
+				return false
+			end
+		end
+		pureMemo[path] = true
+		return true
+	end
+
+	local result = {}
+	for path, bone in pathMap do
+		if isIndependentLowerSubtree(path) then
+			local parentPath = parentBonePath(pathMap, bone, visual)
+			if not parentPath or not isIndependentLowerSubtree(parentPath) then
+				table.insert(result, path)
+			end
+		end
+	end
+	table.sort(result)
+	return result
+end
+
+function MonsterSkeletonMap.ResolveLowerBodyPaths(visual: Model): { string }
+	local pathMap = MonsterSkeletonMap.BuildBonePathMap(visual)
+	local boneCount = 0
+	local childrenByPath = {}
+	for path, bone in pathMap do
+		boneCount += 1
+		childrenByPath[path] = childrenByPath[path] or {}
+		local parent = bone.Parent
+		if parent and parent:IsA("Bone") then
+			local parentPath = bonePath(parent, visual)
+			childrenByPath[parentPath] = childrenByPath[parentPath] or {}
+			table.insert(childrenByPath[parentPath], path)
+		end
+	end
+	if boneCount == 0 then
+		return {}
+	end
+
+	local boundsCFrame, boundsSize = visual:GetBoundingBox()
+	local minimumY = boundsCFrame.Position.Y - boundsSize.Y * 0.5
+	local bandTop = minimumY + boundsSize.Y * Config.BottomLeafBandFraction
+	local lowLeaves = {}
+	for path, bone in pathMap do
+		if #(childrenByPath[path] or {}) == 0 and bone.TransformedWorldCFrame.Position.Y <= bandTop then
+			table.insert(lowLeaves, path)
+		end
+	end
+
+	if #lowLeaves < 2 then
+		return fallbackLowerPaths(pathMap)
+	end
+	local lca = commonAncestorPath(lowLeaves)
+	if not lca or not pathMap[lca] then
+		return fallbackLowerPaths(pathMap)
+	end
+
+	local branchRoots = {}
+	local lcaDepth = #string.split(lca, "/")
+	for _, leafPath in lowLeaves do
+		local segments = string.split(leafPath, "/")
+		if #segments > lcaDepth then
+			local root = table.concat(segments, "/", 1, lcaDepth + 1)
+			branchRoots[root] = true
+		end
+	end
+
+	local selected = {}
+	for path in pathMap do
+		for branchRoot in branchRoots do
+			if path == branchRoot or string.sub(path, 1, #branchRoot + 1) == branchRoot .. "/" then
+				selected[path] = true
+				break
+			end
+		end
+	end
+
+	local lcaName = string.lower(pathMap[lca].Name)
+	if string.find(lcaName, "pelvis", 1, true) or string.find(lcaName, "hip", 1, true) then
+		selected[lca] = true
+	end
+
+	local result = {}
+	for path in selected do
+		table.insert(result, path)
+	end
+	if #result == 0 or #result > math.floor(boneCount * Config.MaxLowerBodyFraction) then
+		return fallbackLowerPaths(pathMap)
+	end
+	table.sort(result)
+	return result
+end
+
+return table.freeze(MonsterSkeletonMap)
diff --git a/src/server/combat/CombatFeedbackService.luau b/src/server/combat/CombatFeedbackService.luau
