+async function request(url, options){
+  const response = await fetch(url, options);
+  const data = await response.json();
+  if(!response.ok) throw new Error(data.error || `http ${response.status}`);
+  return data;
+}
+
+async function load(){
+  try{
+    const data = await request('/api/characters');
+    rows.innerHTML = '';
+    for(const item of data.items){
+      const active = data.activeArchetypeId === item.id;
+      const tr = document.createElement('tr');
+      tr.className = active ? 'active' : '';
+      tr.innerHTML = `<td>${active ? 'yes' : ''}</td><td>${esc(item.id)}</td><td>${esc(item.display_name)}</td><td>${esc(item.model_asset_id || '')}</td><td>${esc(item.status)}</td><td>${esc(item.revision)}</td><td class="actions"><button data-action="activate">activate</button><button data-action="delete">delete</button></td>`;
+      tr.querySelector('[data-action="activate"]').onclick = () => activate_character(item.id);
+      tr.querySelector('[data-action="delete"]').onclick = () => delete_character(item.id);
+      rows.appendChild(tr);
+    }
+    const r = data.runtime;
+    if(r.mode === 'registered'){
+      runtime.className = 'runtime ok';
+      runtime.textContent = `registered · ${r.activeArchetypeId} · asset ${r.modelAssetId}`;
+    } else {
+      runtime.className = 'runtime warn';
+      runtime.textContent = `bootstrap · ${r.reason}${r.activeArchetypeId ? ' · selected '+r.activeArchetypeId : ''}`;
+    }
+  } catch(error){
+    runtime.className = 'runtime warn';
+    runtime.textContent = error.message;
+  }
+}
+
+async function save_character(){
