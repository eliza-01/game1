+        displayName:display_name.value,
+        modelAssetId:asset_id.value,
+        sourcePath:source_path.value
+      })
+    });
+    message.textContent = ' saved';
+    await load();
+  } catch(error){
+    message.textContent = ' ' + error.message;
+  }
+}
+
+async function activate_character(id){
+  try{
+    await request('/api/characters/'+encodeURIComponent(id)+'/activate',{method:'POST'});
+    await load();
+  } catch(error){ alert(error.message); }
+}
+
+async function delete_character(id){
+  if(!confirm('delete archetype '+id+'?')) return;
+  try{
+    await request('/api/characters/'+encodeURIComponent(id),{method:'DELETE'});
+    await load();
+  } catch(error){ alert(error.message); }
+}
+
