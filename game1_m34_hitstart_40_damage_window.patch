+# m34 authored melee damage window. 1HS attacks are windup until 40%, damaging
+# only from HitStart=40% through terminal Hit=50%. Client pose traffic is also
+# confined to that same window; server phase validation independently enforces it.
+attack_timeline_m34 = (ROOT / "src/shared/combat/AttackTimelineConfig.luau").read_text(encoding="utf-8")
+for clip_id in [
+    "human_female__weapon__1hs__attack__01",
+    "human_female__weapon__1hs__attack__02",
+    "human_female__weapon__1hs__attack__03",
+]:
+    start = attack_timeline_m34.find(f'["{clip_id}"]')
+    if start < 0:
+        err(f"m34 timeline clip missing {clip_id}")
+        continue
+    block = attack_timeline_m34[start: start + 420]
+    if 'HitStart = table.freeze({ normalizedTime = 0.40 })' not in block:
+        err(f"m34 {clip_id} must open melee damage at normalized 0.40")
+    if 'Hit = table.freeze({ normalizedTime = 0.50, result = "melee_damage" })' not in block:
+        err(f"m34 {clip_id} must keep terminal Hit at normalized 0.50")
+
+attack_controller_m34 = (ROOT / "src/client/combat/AttackController.luau").read_text(encoding="utf-8")
+for required in [
+    "activePoseFrom",
+    "timelineEvents and timelineEvents.HitStart",
+    "damagePoseStart",
+    "damagePoseEnd",
+    "activePoseFrom = activePoseStartedAt + damagePoseStart",
+    "activePoseUntil = activePoseStartedAt + damagePoseEnd",
+    "if now < activePoseFrom then",
+]:
+    if required not in attack_controller_m34:
+        err(f"m34 client 40%-50% pose window missing {required}")
+
+attack_service_m34 = (ROOT / "src/server/combat/AttackService.luau").read_text(encoding="utf-8")
+for required in [
+    "activeDamageStartElapsed",
+    "meleeDamageWindow",
+    "events and events.HitStart",
+    'SetAttribute("AttackDamageStartsAt"',
+    "elapsed + 1e-4 < damageStartElapsed",
+    "elapsed + 1e-4 >= damageStartElapsed",
+    "activeDamageStartElapsed[player] = hitStartTime",
+]:
+    if required not in attack_service_m34:
+        err(f"m34 server 40%-50% damage gate missing {required}")
+
+
