+        timelineEditor.selectedEvent = "Hit"
+
+        local preview, animator = loadTimelinePreviewModel(modelAssetId)
+        timelineEditor.preview = preview
+        local animation = Instance.new("Animation")
+        animation.AnimationId = "rbxassetid://" .. tostring(math.floor(animationAssetId))
+        local track = animator:LoadAnimation(animation)
+        animation:Destroy()
+        track.Looped = false
+        track:Play(0, 1, 1)
+        local deadline = os.clock() + 8
+        while track.Length <= 0 and os.clock() < deadline do
+            task.wait(0.05)
+        end
+        track:AdjustSpeed(0)
+        if track.Length > 0 then
+            timelineEditor.duration = track.Length
+        end
+        if timelineEditor.duration <= 0 then
+            error("Roblox did not expose a duration for the selected animation")
+        end
+        timelineEditor.track = track
+
+        timelineTitle.Text = timelineEditor.subjectName .. " · " .. timelineEditor.clipName
+        timelineHint.Text = "Scrub the pose, choose an event, then Confirm point. Save remains in Asset Manager."
