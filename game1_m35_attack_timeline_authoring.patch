+local function loadTimelinePreviewModel(assetId: number): (Model, Animator)
+    local loaded: Instance? = nil
+    local lastError = ""
+    for _ = 1, 8 do
+        local loadedOk, value = pcall(function()
+            return AssetService:LoadAssetAsync(assetId)
+        end)
+        if loadedOk and value ~= nil then
+            loaded = value
+            break
+        end
+        lastError = tostring(value)
+        task.wait(1)
+    end
+    if loaded == nil then
+        error("could not load preview model asset " .. tostring(assetId) .. ": " .. lastError)
+    end
+
+    local imported: Instance = loaded
+    local children = loaded:GetChildren()
+    if loaded:IsA("Model") and #children == 1 then
+        imported = children[1]
+        imported.Parent = nil
+        loaded:Destroy()
+    end
+
+    local preview = Instance.new("Model")
+    preview.Name = TIMELINE_PREVIEW_NAME
+    preview:SetAttribute("Game1TimelinePreview", true)
+    imported.Name = "ImportedRig"
+    imported.Parent = preview
+    local animator = ensureCharacterHost(preview, imported)
+    for _, descendant in ipairs(preview:GetDescendants()) do
+        if descendant:IsA("BasePart") then
+            descendant.Anchored = true
+            descendant.CanCollide = false
+            descendant.CanTouch = false
+            descendant.CanQuery = false
+        elseif descendant:IsA("Script") or descendant:IsA("LocalScript") then
+            descendant.Enabled = false
+        end
+    end
+    preview.Parent = Workspace
+
+    local boundsCFrame, boundsSize = preview:GetBoundingBox()
+    local targetCenter = Vector3.new(0, math.max(1, boundsSize.Y) * 0.5, 0)
+    preview:PivotTo(preview:GetPivot() + (targetCenter - boundsCFrame.Position))
+    boundsCFrame, boundsSize = preview:GetBoundingBox()
+    local camera = Workspace.CurrentCamera
+    if camera then
+        local center = boundsCFrame.Position
+        local distance = math.max(6, boundsSize.Magnitude * 0.85)
+        camera.CFrame = CFrame.lookAt(center + Vector3.new(0, boundsSize.Y * 0.1, distance), center)
+        camera.Focus = CFrame.new(center)
+    end
+    Selection:Set({ preview })
+    return preview, animator
+end
