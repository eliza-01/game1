+local function timelineFreezeTrackAt(track: AnimationTrack, timePosition: number)
+    -- TimePosition only affects the evaluated pose while an AnimationTrack is playing.
+    -- Short attack clips could finish while m35 was waiting for Length, leaving the
+    -- scrubber attached to a stopped track and the rig permanently in rest pose.
+    if not track.IsPlaying then
+        track:Play(0, 1, 1)
+    end
+    track.Priority = Enum.AnimationPriority.Action4
+    track:AdjustWeight(1, 0)
+    track:AdjustSpeed(0)
+    track.TimePosition = math.clamp(timePosition, 0, math.max(0, track.Length - 0.0001))
+end
