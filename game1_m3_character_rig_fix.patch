+def prepare_character_fbx(project_root: Path, source: Path, output: Path) -> dict:
+    source = source.resolve()
+    output = output.resolve()
+    if not source.is_file() or source.suffix.lower() != ".fbx":
+        raise CharacterAnalysisError("character preparation requires an FBX file")
+
+    preparer = project_root / "system" / "asset-manager" / "prepare_character_fbx.py"
+    if not preparer.is_file():
+        raise CharacterAnalysisError(f"character preparer is missing: {preparer}")
+
+    blender = blender_executable()
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix="game1-character-prepare-report-") as tmp:
+        report = Path(tmp) / "prepare.json"
+        command = [
+            str(blender),
+            "--background",
+            "--factory-startup",
+            "--python",
+            str(preparer),
+            "--",
+            str(source),
+            str(output),
+            str(report),
+        ]
+        completed = subprocess.run(command, capture_output=True, text=True, timeout=240)
+        if completed.returncode != 0 or not output.is_file():
+            detail = (completed.stderr or completed.stdout or "blender character preparation failed").strip()
+            raise CharacterAnalysisError(detail[-5000:])
+        value = json.loads(report.read_text(encoding="utf-8")) if report.is_file() else {}
+    if not isinstance(value, dict):
+        raise CharacterAnalysisError("character preparer returned invalid output")
+    return value
+
