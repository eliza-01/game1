diff --git a/system/asset-manager/prepare_character_fbx.py b/system/asset-manager/prepare_character_fbx.py
new file mode 100644
index 0000000..3ca3b76
--- /dev/null
+++ b/system/asset-manager/prepare_character_fbx.py
@@ -0,0 +1,99 @@
+"""blender background entry point for game1 character fbx canonicalization."""
+
+import bpy
+import json
+import math
+import sys
+from pathlib import Path
+
+
+def clean_scene():
+    bpy.ops.object.select_all(action="SELECT")
+    bpy.ops.object.delete(use_global=False)
+    for collection in (bpy.data.armatures, bpy.data.meshes, bpy.data.materials):
+        for item in list(collection):
+            collection.remove(item)
+
+
+def vec3(value):
+    return [round(float(value.x), 7), round(float(value.y), 7), round(float(value.z), 7)]
+
+
+def linked_meshes(armature):
+    result = []
+    for obj in bpy.context.scene.objects:
+        if obj.type != "MESH":
+            continue
+        linked = obj.parent == armature
+        if not linked:
+            linked = any(mod.type == "ARMATURE" and getattr(mod, "object", None) == armature for mod in obj.modifiers)
+        if linked:
+            result.append(obj)
+    return sorted(result, key=lambda obj: obj.name.casefold())
+
+
+def main(source: Path, output: Path, report_path: Path):
+    clean_scene()
+    bpy.ops.import_scene.fbx(filepath=str(source), use_anim=False)
+
+    armatures = sorted((obj for obj in bpy.context.scene.objects if obj.type == "ARMATURE"), key=lambda obj: obj.name.casefold())
+    if not armatures:
+        raise RuntimeError("FBX contains no armature.")
+    armature = max(armatures, key=lambda obj: len(obj.data.bones))
+    meshes = linked_meshes(armature)
+    if not meshes:
+        raise RuntimeError("FBX armature has no linked skinned mesh.")
+
+    targets = [armature, *meshes]
+    before = {
+        obj.name: {
+            "rotationDegrees": [round(math.degrees(float(v)), 7) for v in obj.rotation_euler],
+            "scale": vec3(obj.scale),
+        }
+        for obj in targets
+    }
+
+    bpy.ops.object.select_all(action="DESELECT")
+    for obj in targets:
+        obj.select_set(True)
+    bpy.context.view_layer.objects.active = armature
+    bpy.ops.object.transform_apply(location=False, rotation=True, scale=True)
+
+    after = {
+        obj.name: {
+            "rotationDegrees": [round(math.degrees(float(v)), 7) for v in obj.rotation_euler],
+            "scale": vec3(obj.scale),
+        }
+        for obj in targets
+    }
+
+    bpy.ops.object.select_all(action="SELECT")
+    output.parent.mkdir(parents=True, exist_ok=True)
+    bpy.ops.export_scene.fbx(
+        filepath=str(output),
+        use_selection=True,
+        use_anim=False,
+        add_leaf_bones=False,
+        axis_forward="-Z",
+        axis_up="Y",
+        apply_unit_scale=True,
+        use_space_transform=True,
+        bake_space_transform=False,
+    )
+    if not output.is_file() or output.stat().st_size <= 0:
+        raise RuntimeError("prepared FBX was not written")
+
+    report_path.write_text(json.dumps({
+        "schemaVersion": 1,
+        "armature": armature.name,
+        "meshNames": [obj.name for obj in meshes],
+        "before": before,
+        "after": after,
+    }, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+
+args = sys.argv[sys.argv.index("--") + 1:]
+if len(args) != 3:
+    raise RuntimeError("usage: blender --background --python prepare_character_fbx.py -- input.fbx output.fbx report.json")
+source, output, report = map(Path, args)
+main(source.resolve(), output.resolve(), report.resolve())
