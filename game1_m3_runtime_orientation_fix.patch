+local Service = {}
+local started = false
+local cache = ServerStorage:FindFirstChild("game1CharacterCache") or Instance.new("Folder")
+cache.Name = "game1CharacterCache"; cache.Parent = ServerStorage
+
+local function findArchetype(archetypeId: string?): any?
+    if not archetypeId or archetypeId == "" then return nil end
+    for _, row in ipairs(CharacterRegistry.archetypes or {}) do
+        if tostring(row.id) == archetypeId then return row end
+    end
+    return nil
+end
+local function registeredAssetId(row: any?): number?
+    if not row then return nil end
+    if type(row.model) == "table" then return tonumber(row.model.assetId) end
+    return tonumber(row.modelAssetId) -- m1 compatibility during live sync
+end
+local function selectedCharacter(): (any?, number?, string, string, string?, string?, string?)
+    local requestedId = tostring(CharacterRegistry.activeArchetypeId or "")
+    local row = findArchetype(requestedId)
+    local id = registeredAssetId(row)
+    if row and id then
+        return row, id, tostring(row.id), tostring(row.displayName or row.id), requestedId, tostring(row.race or ""), tostring(row.gender or "")
+    end
+    return nil, tonumber(BootstrapConfig.CharacterModelAssetId), "bootstrap", BootstrapConfig.CharacterLabel, requestedId ~= "" and requestedId or nil, nil, nil
+end
+
+local function getAssetTemplate(assetId: number, cacheKey: string): Model?
+    local cached = cache:FindFirstChild(cacheKey)
+    if cached and cached:IsA("Model") then return cached end
+
+    local ok, bundle = pcall(InsertService.LoadAsset, InsertService, assetId)
+    if not ok or not bundle then
+        warn("[game1] Cannot load character asset", assetId, bundle)
+        return nil
+    end
+
+    local imported: Instance = bundle
+    local children = bundle:GetChildren()
+    if bundle:IsA("Model") and #children == 1 then
+        imported = children[1]
+        imported.Parent = nil
+        bundle:Destroy()
+    end
+
+    local template: Model
+    if imported:IsA("Model") then
+        template = imported
+    else
+        template = Instance.new("Model")
+        imported.Parent = template
+    end
+    template.Name = cacheKey
+    template.Parent = cache
+    return template
+end
+
+local function getBootstrapTemplate(assetId: number): Model?
+    return getAssetTemplate(assetId, "bootstrap-" .. tostring(assetId))
+end
+
+local function getPublishedTemplate(assetId: number): Model?
+    return getAssetTemplate(assetId, "registered-" .. tostring(assetId))
+end
+
+local function findRegisteredTemplate(row: any): Model?
+    local node: Instance = ServerStorage
+    local segments = {
+        "characters",
+        tostring(row.race or ""),
+        tostring(row.gender or ""),
+        tostring(row.id or ""),
+        "model",
+    }
+    local canonical = true
+    for _, segment in ipairs(segments) do
+        if segment == "" then canonical = false; break end
+        local child = node:FindFirstChild(segment)
+        if not child then canonical = false; break end
+        node = child
+    end
+    if canonical then
+        local named = node:FindFirstChild(tostring(row.id or ""))
+        if named and named:IsA("Model") then return named end
+        local model = node:FindFirstChildWhichIsA("Model")
+        if model then return model end
+    end
+
+    -- game1 m3 originally stored the published wrapper directly under ServerStorage.
+    -- Keep accepting that saved-place layout while new Studio syncs use the canonical tree.
+    for _, name in ipairs({ tostring(row.displayName or ""), tostring(row.id or "") }) do
+        if name ~= "" then
+            local direct = ServerStorage:FindFirstChild(name)
+            if direct and direct:IsA("Model") then return direct end
+        end
+    end
+    return nil
+end
+
+local function prepareVisual(visual: Model): (BasePart?, boolean)
+    for _, object in visual:GetDescendants() do
+        if object:IsA("Humanoid") then object:Destroy()
+        elseif object:IsA("BasePart") then object.Anchored=false; object.CanCollide=false; object.CanTouch=false; object.CanQuery=false; object.Massless=true end
+    end
+    local host = visual:FindFirstChildOfClass("AnimationController") or visual:FindFirstChildWhichIsA("AnimationController", true)
+    if not host then host=Instance.new("AnimationController"); host.Name="AnimationController"; host.Parent=visual end
+    if not host:FindFirstChildOfClass("Animator") then local a=Instance.new("Animator"); a.Parent=host end
+    local root = visual:FindFirstChild("RootPart", true)
+    if root and root:IsA("BasePart") then return root, true end
+
+    if visual.PrimaryPart then
+        return visual.PrimaryPart, false
+    end
+
+    local skinned = {}
+    for _, object in visual:GetDescendants() do
+        if object:IsA("MeshPart") and object:FindFirstChildWhichIsA("Bone", true) then
+            table.insert(skinned, object)
+        end
+    end
+    table.sort(skinned, function(left, right) return left:GetFullName() < right:GetFullName() end)
+    if skinned[1] then
+        warn("[game1] Visual has no authored RootPart; using the skinned MeshPart as a weld anchor without resizing it")
+        return skinned[1], false
+    end
+
+    warn("[game1] Visual has no RootPart or skinned MeshPart anchor")
+    return nil, false
+end
