index 0000000..5a7af60
--- /dev/null
+++ b/system/control-center/location_asset_source_only_migration.py
@@ -0,0 +1,248 @@
+from __future__ import annotations
+
+from datetime import datetime, timezone
+from pathlib import Path
+import hashlib
+import json
+import shutil
+import sqlite3
+
+MIGRATION_ID = "location-assets-source-only-v1"
+LEGACY_PREFIX = "assets/prepared/location-assets/"
+SOURCE_PREFIX = "assets/source/location-assets/"
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _utc_stamp() -> str:
+    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+
+
+def _canonical_path(source_value: object, prepared_value: object) -> str:
+    source = str(source_value or "").strip().replace("\\", "/")
+    prepared = str(prepared_value or "").strip().replace("\\", "/")
+    value = source or prepared
+    if not value:
+        return ""
+    if value.startswith(LEGACY_PREFIX):
+        value = SOURCE_PREFIX + value[len(LEGACY_PREFIX):]
+    if not value.startswith(SOURCE_PREFIX):
+        raise RuntimeError(f"Location Asset path is outside canonical source storage: {value}")
+    return value
+
+
+def _plan_file_migration(root: Path) -> list[tuple[Path, Path, str]]:
+    legacy_root = root / "assets/prepared/location-assets"
+    source_root = root / "assets/source/location-assets"
+    if not legacy_root.exists():
+        return []
+
+    actions: list[tuple[Path, Path, str]] = []
+    conflicts: list[str] = []
+    for old in sorted((path for path in legacy_root.rglob("*") if path.is_file()), key=lambda path: path.as_posix().casefold()):
+        relative = old.relative_to(legacy_root)
+        new = source_root / relative
+        if new.exists():
+            if not new.is_file():
+                conflicts.append(f"destination is not a file: {new.relative_to(root).as_posix()}")
+            elif _sha256(old) != _sha256(new):
+                conflicts.append(f"different bytes at canonical path: {relative.as_posix()}")
+            else:
+                actions.append((old, new, "dedupe"))
+        else:
+            actions.append((old, new, "move"))
+    if conflicts:
+        raise RuntimeError("Location Asset source-only migration aborted before changes:\n- " + "\n- ".join(conflicts))
+    return actions
+
+
+def _table_columns(connection: sqlite3.Connection) -> set[str]:
+    exists = connection.execute(
+        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='location_assets'"
+    ).fetchone()
+    if not exists:
+        return set()
+    return {str(row[1]) for row in connection.execute("PRAGMA table_info(location_assets)").fetchall()}
+
+
+def _needs_db_migration(db: Path) -> bool:
+    if not db.is_file():
+        return False
+    with sqlite3.connect(db) as connection:
+        columns = _table_columns(connection)
+    if not columns:
+        return False
+    if {"model_path", "texture_path"}.issubset(columns):
+        return False
+    legacy = {"model_source_path", "model_prepared_path", "texture_source_path", "texture_prepared_path"}
+    if legacy.intersection(columns):
+        return True
+    raise RuntimeError("Location Asset database uses an unknown storage schema; migration stopped without changes.")
+
+
+def _value(row: sqlite3.Row, columns: set[str], name: str, default=None):
+    return row[name] if name in columns else default
+
+
+def _migrate_database(db: Path) -> int:
+    if not db.is_file():
+        return 0
+    connection = sqlite3.connect(db)
+    connection.row_factory = sqlite3.Row
+    try:
+        columns = _table_columns(connection)
+        if not columns or {"model_path", "texture_path"}.issubset(columns):
+            return 0
+        legacy = {"model_source_path", "model_prepared_path", "texture_source_path", "texture_prepared_path"}
+        if not legacy.intersection(columns):
+            raise RuntimeError("Location Asset database cannot be migrated: legacy path columns are missing.")
+
+        rows = connection.execute("SELECT * FROM location_assets ORDER BY slug").fetchall()
+        with connection:
+            connection.execute("DROP TABLE IF EXISTS location_assets_source_only_v4")
+            connection.execute(
+                """CREATE TABLE location_assets_source_only_v4(
+                    slug TEXT PRIMARY KEY,
+                    name_en TEXT NOT NULL,
+                    category TEXT NOT NULL,
+                    model_path TEXT NOT NULL DEFAULT '',
+                    model_sha256 TEXT NOT NULL DEFAULT '',
+                    model_asset_id TEXT,
+                    model_published_sha256 TEXT NOT NULL DEFAULT '',
+                    model_moderation_state TEXT NOT NULL DEFAULT '',
+                    texture_path TEXT NOT NULL DEFAULT '',
+                    texture_sha256 TEXT NOT NULL DEFAULT '',
+                    texture_asset_id TEXT,
+                    texture_published_sha256 TEXT NOT NULL DEFAULT '',
+                    texture_moderation_state TEXT NOT NULL DEFAULT '',
+                    texture_reference_slug TEXT NOT NULL DEFAULT '',
+                    destructible INTEGER NOT NULL DEFAULT 0,
+                    revision INTEGER NOT NULL DEFAULT 1,
+                    created_at REAL NOT NULL,
+                    updated_at REAL NOT NULL,
+                    published_at REAL
+                )"""
+            )
+            for row in rows:
+                connection.execute(
+                    """INSERT INTO location_assets_source_only_v4(
+                        slug,name_en,category,
+                        model_path,model_sha256,model_asset_id,model_published_sha256,model_moderation_state,
+                        texture_path,texture_sha256,texture_asset_id,texture_published_sha256,texture_moderation_state,
+                        texture_reference_slug,destructible,revision,created_at,updated_at,published_at
+                    ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
+                    (
+                        str(_value(row, columns, "slug", "")),
+                        str(_value(row, columns, "name_en", "")),
+                        str(_value(row, columns, "category", "")),
+                        _canonical_path(
+                            _value(row, columns, "model_source_path", ""),
+                            _value(row, columns, "model_prepared_path", ""),
+                        ),
+                        str(_value(row, columns, "model_sha256", "")),
+                        _value(row, columns, "model_asset_id"),
+                        str(_value(row, columns, "model_published_sha256", "")),
+                        str(_value(row, columns, "model_moderation_state", "")),
+                        _canonical_path(
+                            _value(row, columns, "texture_source_path", ""),
+                            _value(row, columns, "texture_prepared_path", ""),
+                        ),
+                        str(_value(row, columns, "texture_sha256", "")),
+                        _value(row, columns, "texture_asset_id"),
+                        str(_value(row, columns, "texture_published_sha256", "")),
+                        str(_value(row, columns, "texture_moderation_state", "")),
+                        str(_value(row, columns, "texture_reference_slug", "")),
+                        int(_value(row, columns, "destructible", 0) or 0),
+                        int(_value(row, columns, "revision", 1) or 1),
+                        float(_value(row, columns, "created_at", 0) or 0),
+                        float(_value(row, columns, "updated_at", 0) or 0),
+                        _value(row, columns, "published_at"),
+                    ),
+                )
+            connection.execute("DROP TABLE location_assets")
+            connection.execute("ALTER TABLE location_assets_source_only_v4 RENAME TO location_assets")
+        return len(rows)
+    finally:
+        connection.close()
+
+
+def _remove_empty_legacy_tree(root: Path) -> None:
+    legacy_root = root / "assets/prepared/location-assets"
+    if not legacy_root.exists():
+        return
+    for path in sorted(legacy_root.rglob("*"), key=lambda item: len(item.parts), reverse=True):
+        if path.is_dir():
+            try:
+                path.rmdir()
+            except OSError:
+                pass
+    try:
+        legacy_root.rmdir()
+    except OSError:
+        pass
+
+
+def migrate_location_assets_source_only(root: Path, db: Path) -> dict:
+    root = root.resolve()
+    db = db.resolve()
+    actions = _plan_file_migration(root)
+    db_migration = _needs_db_migration(db)
+    if not actions and not db_migration:
+        return {"migration": MIGRATION_ID, "changed": False, "migratedRows": 0, "moved": 0, "deduped": 0}
+
+    stamp = _utc_stamp()
+    backup_root = root / "assets/reimported/location-assets/source-only-migration" / stamp
+    db_backup = backup_root / "game1.db.before"
+    if db.is_file():
+        backup_root.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(db, db_backup)
+
+    applied: list[tuple[Path, Path, str]] = []
+    try:
+        for old, new, mode in actions:
+            new.parent.mkdir(parents=True, exist_ok=True)
+            if mode == "move":
+                shutil.move(str(old), str(new))
+            else:
+                old.unlink()
+            applied.append((old, new, mode))
+
+        migrated_rows = _migrate_database(db) if db_migration else 0
+        _remove_empty_legacy_tree(root)
+
+        report = {
+            "schemaVersion": 1,
+            "project": "game1",
+            "migration": MIGRATION_ID,
+            "completedAtUtc": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
+            "changed": True,
+            "migratedRows": migrated_rows,
+            "movedPreparedOnlyFiles": sum(1 for _old, _new, mode in applied if mode == "move"),
+            "removedIdentityDuplicates": sum(1 for _old, _new, mode in applied if mode == "dedupe"),
+            "backupPath": db_backup.relative_to(root).as_posix() if db_backup.is_file() else "",
+        }
+        reports = root / "assets/reports"
+        reports.mkdir(parents=True, exist_ok=True)
+        (reports / f"location-assets-source-only-migration-{stamp}.json").write_text(
+            json.dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
+        )
+        return report
+    except Exception:
+        for old, new, mode in reversed(applied):
+            try:
+                old.parent.mkdir(parents=True, exist_ok=True)
+                if mode == "move" and new.is_file() and not old.exists():
+                    shutil.move(str(new), str(old))
+                elif mode == "dedupe" and new.is_file() and not old.exists():
+                    shutil.copy2(new, old)
+            except Exception:
+                pass
+        if db_backup.is_file():
+            shutil.copy2(db_backup, db)
+        raise
