diff --git a/src/server/npc/NpcSpawnerService.luau b/src/server/npc/NpcSpawnerService.luau
new file mode 100644
--- /dev/null
+++ b/src/server/npc/NpcSpawnerService.luau
@@ -0,0 +1,221 @@
+-- Population + lifecycle orchestration for passive NPCs. AI/interaction/navigation belong to future services.
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local ServerStorage = game:GetService("ServerStorage")
+local RunService = game:GetService("RunService")
+local Workspace = game:GetService("Workspace")
+local Shared = ReplicatedStorage:WaitForChild("Game1Shared")
+local NpcShared = Shared:WaitForChild("npc")
+local NpcRegistry = require(NpcShared:WaitForChild("NpcRegistry"))
+local NpcAnimationRegistry = require(NpcShared:WaitForChild("NpcAnimationRegistry"))
+local NpcSpawnRegistry = require(script.Parent:WaitForChild("NpcSpawnRegistry"))
+local CombatRoot = script.Parent.Parent:WaitForChild("combat")
+local EntityHitboxService = require(CombatRoot:WaitForChild("EntityHitboxService"))
+local DeathLifecycleService = require(CombatRoot:WaitForChild("DeathLifecycleService"))
+local NpcRigFactory = require(script.Parent:WaitForChild("NpcRigFactory"))
+local NpcAnimationService = require(script.Parent:WaitForChild("NpcAnimationService"))
+
+local NpcSpawnerService = {}
+local started = false
+local states: {[string]: any} = {}
+local random = Random.new()
+
+local function folder(): Folder
+    local current = Workspace:FindFirstChild("NPCs")
+    if current and not current:IsA("Folder") then
+        error("Workspace.NPCs must be a Folder")
+    end
+    if not current then
+        current = Instance.new("Folder")
+        current.Name = "NPCs"
+        current.Parent = Workspace
+    end
+    return current :: Folder
+end
+
+local function modelAtPath(path: string): Model?
+    local parts = string.split(path, ".")
+    if parts[1] ~= "ServerStorage" then
+        return nil
+    end
+    local instance: Instance? = ServerStorage
+    for index = 2, #parts do
+        instance = if instance then instance:FindFirstChild(parts[index]) else nil
+        if not instance then
+            return nil
+        end
+    end
+    return if instance and instance:IsA("Model") then instance else nil
+end
+
+local function finite(value: any, fallback: number): number
+    local n = tonumber(value)
+    return if n and n == n and n > -math.huge and n < math.huge then n else fallback
+end
+
+local function spawnSurface(record: any): Vector3
+    local point = record.position or {}
+    local center = Vector3.new(finite(point.x, 0), finite(point.y, 0), finite(point.z, 0))
+    local radius = math.max(0, finite(record.spawnRadius, 0))
+    if radius > 0 then
+        local angle = random:NextNumber(0, 2 * math.pi)
+        local distance = radius * math.sqrt(random:NextNumber())
+        center += Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
+    end
+    local params = RaycastParams.new()
+    params.FilterType = Enum.RaycastFilterType.Exclude
+    local ignore: {Instance} = { folder() }
+    local authoring = Workspace:FindFirstChild("Game1Authoring")
+    if authoring then
+        table.insert(ignore, authoring)
+    end
+    local monsters = Workspace:FindFirstChild("Monsters")
+    if monsters then
+        table.insert(ignore, monsters)
+    end
+    params.FilterDescendantsInstances = ignore
+    params.RespectCanCollide = true
+    local hit = Workspace:Raycast(center + Vector3.new(0, 96, 0), Vector3.new(0, -384, 0), params)
+    return if hit then hit.Position else center
+end
+
+local function release(state: any, entity: Model, scheduleRespawn: boolean)
+    local entry = state.instances[entity]
+    if not entry then
+        return
+    end
+    state.instances[entity] = nil
+    DeathLifecycleService.Cancel(entity)
+    EntityHitboxService.Detach(entity)
+    if entity.Parent then
+        entity:Destroy()
+    end
+    if scheduleRespawn then
+        task.delay(math.max(0, finite(state.record.respawnSeconds, 10)), function()
+            if state.active then
+                state.fill()
+            end
+        end)
+    end
+end
+
+local function spawnOne(state: any): boolean
+    local record = state.record
+    local slug = tostring(record.monsterSlug or "") -- internal spawn serialization is shared with monsters
+    local definition = (NpcRegistry.npcs or {})[slug]
+    if not definition or definition.status ~= "PUBLISHED" then
+        warn("[game1][npc] NPC is missing or unpublished: " .. slug)
+        return false
+    end
+    local template = modelAtPath(tostring(definition.serverStoragePath or ""))
+    if not template then
+        warn("[game1][npc] NPC template is not synced to ServerStorage: " .. slug)
+        return false
+    end
+    local entity = template:Clone()
+    entity.Name = slug .. "_" .. tostring(random:NextInteger(100000, 999999))
+    entity.Parent = folder()
+    local visual, root = NpcRigFactory.Create(entity, spawnSurface(record), finite(record.yawDegrees, 0))
+    if not visual or not root then
+        entity:Destroy()
+        warn("[game1][npc] published model has no usable visual rig: " .. slug)
+        return false
+    end
+    local stats = definition.stats or {}
+    local hp = math.max(1, finite(stats.MaxHP, 100))
+    entity:SetAttribute("Game1NpcRuntime", true)
+    entity:SetAttribute("NpcSlug", slug)
+    entity:SetAttribute("NpcWeaponSet", "1hs")
+    entity:SetAttribute("SpawnId", tostring(record.spawnId or ""))
+    entity:SetAttribute("Damageable", true)
+    entity:SetAttribute("LifeState", "Alive")
+    entity:SetAttribute("InCombat", false)
+    entity:SetAttribute("CombatState", "Peace")
+    entity:SetAttribute("CombatUntilServerTime", 0)
+    entity:SetAttribute("HP", hp)
+    entity:SetAttribute("MaxHP", hp)
+    entity:SetAttribute("Damage", math.max(0, finite(stats.Damage, 10)))
+    entity:SetAttribute("Defense", math.max(0, finite(stats.Defense, 0)))
+    entity:SetAttribute("CritChance", math.clamp(finite(stats.CritChance, 0), 0, 100))
+    entity:SetAttribute("AttackSpeed", math.max(1, finite(stats.AttackSpeed, 100)))
+    entity:SetAttribute("RunSpeed", math.max(0, finite(stats.RunSpeed, 50)))
+    local hitbox = EntityHitboxService.Attach(entity, visual)
+    entity:SetAttribute("CombatHitboxCount", hitbox.count)
+    local profile = (NpcAnimationRegistry.profiles or {})[slug]
+    local presentation = NpcAnimationService.Create(entity, visual, profile)
+    local entry = { root = root, visual = visual, presentation = presentation, dying = false }
+    state.instances[entity] = entry
+    entity:GetAttributeChangedSignal("LifeState"):Connect(function()
+        if state.instances[entity] ~= entry then
+            return
+        end
+        if entity:GetAttribute("LifeState") == "Dying" and not entry.dying then
+            entry.dying = true
+            entity:SetAttribute("Damageable", false)
+            presentation.BeginDeath()
+        end
+    end)
+    entity.Destroying:Connect(function()
+        -- External removals still restore the authored population cap.
+        if state.instances[entity] == entry then
+            release(state, entity, true)
+        end
+    end)
+    return true
+end
+
+local function fill(state: any)
+    if not state.active or state.filling then
+        return
+    end
+    state.filling = true
+    local count = 0
+    for entity in pairs(state.instances) do
+        if entity.Parent then
+            count += 1
+        end
+    end
+    local target = math.clamp(math.floor(finite(state.record.maxAlive, 1)), 1, 1000)
+    while count < target and spawnOne(state) do
+        count += 1
+    end
+    state.filling = false
+end
+
+function NpcSpawnerService.Start()
+    if started then
+        return
+    end
+    started = true
+    folder()
+    local authoring = Workspace:FindFirstChild("Game1Authoring")
+    local markers = authoring and authoring:FindFirstChild("NpcSpawns")
+    if markers then
+        markers:Destroy()
+    end
+    RunService.PreAnimation:Connect(function(delta)
+        for _, state in pairs(states) do
+            for entity, entry in pairs(state.instances) do
+                if entry.dying and entry.presentation.Step(delta) then
+                    entity:SetAttribute("NpcAnimationState", "death_idle")
+                    DeathLifecycleService.BeginDeathIdle(entity, entry.root, entry.visual, function()
+                        release(state, entity, true)
+                    end)
+                end
+            end
+        end
+    end)
+    local count = 0
+    for _, record in ipairs(NpcSpawnRegistry.records or {}) do
+        local placeId = math.floor(finite(record.placeId, 0))
+        if record.enabled ~= false and (placeId == 0 or game.PlaceId == 0 or placeId == game.PlaceId) then
+            local state = { record = record, active = true, filling = false, instances = {} }
+            state.fill = function() fill(state) end
+            states[tostring(record.spawnId or count + 1)] = state
+            fill(state)
+            count += 1
+        end
+    end
+    print(("[game1][npc] %d spawn record(s) active"):format(count))
+end
+
+return table.freeze(NpcSpawnerService)
diff --git a/src/server/npc/NpcRigFactory.luau b/src/server/npc/NpcRigFactory.luau
new file mode 100644
--- /dev/null
+++ b/src/server/npc/NpcRigFactory.luau
@@ -0,0 +1,130 @@
+-- One responsibility: turn a published articulated FBX into a stationary, combat-queryable world actor.
+-- The visual is never used as a physics collider. Later navigation may replace the anchored world root.
+local NpcRigFactory = {}
+
+local function visibleBounds(model: Model): (CFrame, Vector3)
+    local low = Vector3.new(math.huge, math.huge, math.huge)
+    local high = Vector3.new(-math.huge, -math.huge, -math.huge)
+    local found = false
+    for _, item in ipairs(model:GetDescendants()) do
+        if item:IsA("BasePart") and item.Name ~= "RootPart" and item.Name ~= "RootCollider" then
+            found = true
+            local h = item.Size * 0.5
+            for x = -1, 1, 2 do
+                for y = -1, 1, 2 do
+                    for z = -1, 1, 2 do
+                        local v = item.CFrame:PointToWorldSpace(Vector3.new(h.X * x, h.Y * y, h.Z * z))
+                        low = Vector3.new(math.min(low.X, v.X), math.min(low.Y, v.Y), math.min(low.Z, v.Z))
+                        high = Vector3.new(math.max(high.X, v.X), math.max(high.Y, v.Y), math.max(high.Z, v.Z))
+                    end
+                end
+            end
+        end
+    end
+    if not found then
+        return model:GetBoundingBox()
+    end
+    return CFrame.new((low + high) * 0.5), high - low
+end
+
+local function bridgeRootBones(visual: Model): number
+    -- The Studio FBX animation export expects a synthetic RootBone above the authored roots.
+    local count = 0
+    for _, item in ipairs(visual:GetDescendants()) do
+        if item:IsA("MeshPart") then
+            local topBones = {}
+            local rootBone: Bone? = nil
+            for _, child in ipairs(item:GetChildren()) do
+                if child:IsA("Bone") then
+                    if child.Name == "RootBone" then
+                        rootBone = child
+                    else
+                        table.insert(topBones, child)
+                    end
+                end
+            end
+            if #topBones > 0 then
+                if not rootBone then
+                    rootBone = Instance.new("Bone")
+                    rootBone.Name = "RootBone"
+                    rootBone.CFrame = CFrame.identity
+                    rootBone.Parent = item
+                    count += 1
+                end
+                for _, bone in ipairs(topBones) do
+                    local relative = bone.CFrame
+                    bone.Parent = rootBone
+                    bone.CFrame = rootBone.CFrame:Inverse() * relative
+                end
+            end
+        end
+    end
+    return count
+end
+
+function NpcRigFactory.Create(model: Model, surface: Vector3, yawDegrees: number): (Model?, BasePart?)
+    local visual = model:FindFirstChild("ImportedRig")
+    if not visual or not visual:IsA("Model") then
+        visual = model
+    end
+    for _, item in ipairs(model:GetDescendants()) do
+        if item:IsA("BasePart") then
+            item.Anchored = false
+            item.CanCollide = false
+            item.CanTouch = false
+            item.CanQuery = false
+            item.Massless = true
+        elseif item:IsA("Humanoid") then
+            item:Destroy()
+        end
+    end
+    local visualRoot = visual:FindFirstChild("RootPart", true)
+        or visual.PrimaryPart
+        or visual:FindFirstChildWhichIsA("MeshPart", true)
+        or visual:FindFirstChildWhichIsA("BasePart", true)
+    if not visualRoot or not visualRoot:IsA("BasePart") then
+        return nil, nil
+    end
+    model:PivotTo(CFrame.new(surface) * CFrame.Angles(0, math.rad(yawDegrees), 0) * model:GetPivot().Rotation)
+    local boundsFrame, boundsSize = visibleBounds(visual)
+    model:PivotTo(model:GetPivot() + Vector3.new(0, surface.Y - (boundsFrame.Position.Y - boundsSize.Y * 0.5), 0))
+    boundsFrame, boundsSize = visibleBounds(visual)
+
+    local root = Instance.new("Part")
+    root.Name = "NavigationRoot"
+    root.Size = Vector3.new(2, 2, 1)
+    root.CFrame = CFrame.new(surface + Vector3.new(0, 2.8, 0)) * CFrame.Angles(0, math.rad(yawDegrees), 0)
+    root.Anchored = true -- NPCs do not move autonomously in the initial 1hs phase.
+    root.Transparency = 1
+    root.CanCollide = false
+    root.CanQuery = false
+    root.CanTouch = false
+    root.CastShadow = false
+    root.Parent = model
+
+    local collider = Instance.new("Part")
+    collider.Name = "RootCollider"
+    collider.Size = Vector3.new(math.max(0.5, boundsSize.X), math.max(0.5, boundsSize.Y), math.max(0.5, boundsSize.Z))
+    collider.CFrame = boundsFrame
+    collider.Anchored = false
+    collider.Transparency = 1
+    collider.CanCollide = false
+    collider.CanQuery = true -- bone-aligned hitbox cache uses this stable root space.
+    collider.CanTouch = false
+    collider.Massless = true
+    collider.Parent = model
+
+    local colliderWeld = Instance.new("WeldConstraint")
+    colliderWeld.Part0 = root
+    colliderWeld.Part1 = collider
+    colliderWeld.Parent = root
+    local visualWeld = Instance.new("WeldConstraint")
+    visualWeld.Part0 = collider
+    visualWeld.Part1 = visualRoot
+    visualWeld.Parent = collider
+    model.PrimaryPart = root
+    model:SetAttribute("RuntimeAnimationRootBridgeCount", bridgeRootBones(visual))
+    return visual, root
+end
+
+return table.freeze(NpcRigFactory)
diff --git a/src/server/npc/NpcAnimationService.luau b/src/server/npc/NpcAnimationService.luau
new file mode 100644
--- /dev/null
+++ b/src/server/npc/NpcAnimationService.luau
@@ -0,0 +1,132 @@
+-- Actor presentation only. Does not know about spawn quotas, damage calculations or authoring.
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local Shared = ReplicatedStorage:WaitForChild("Game1Shared")
+local DeathAnimationPolicy = require(Shared:WaitForChild("combat"):WaitForChild("DeathAnimationPolicy"))
+local AnimationSpeedScaling = require(Shared:WaitForChild("animation"):WaitForChild("AnimationSpeedScaling"))
+
+local NpcAnimationService = {}
+
+local function pick(profile: any?, slot: string): any?
+    local slots = profile and profile.slots
+    local rows = slots and slots[slot]
+    if typeof(rows) ~= "table" then
+        return nil
+    end
+    for _, row in ipairs(rows) do
+        if tostring(row.weaponSet or "1hs") == "1hs"
+            and tostring(row.animationId or ""):match("^rbxassetid://%d+$") then
+            return row
+        end
+    end
+    return nil
+end
+
+local function loadTrack(animator: Animator, row: any?, looped: boolean): AnimationTrack?
+    if not row then
+        return nil
+    end
+    local asset = Instance.new("Animation")
+    asset.AnimationId = tostring(row.animationId)
+    local success, track = pcall(function()
+        return animator:LoadAnimation(asset)
+    end)
+    asset:Destroy()
+    if not success then
+        warn("[game1][npc] animation could not load: " .. tostring(track))
+        return nil
+    end
+    track.Looped = looped
+    track.Priority = if looped then Enum.AnimationPriority.Idle else Enum.AnimationPriority.Action
+    return track
+end
+
+function NpcAnimationService.Create(entity: Model, visual: Model, profile: any?): any
+    local controller = visual:FindFirstChildOfClass("AnimationController")
+        or visual:FindFirstChildWhichIsA("AnimationController", true)
+    if not controller then
+        controller = Instance.new("AnimationController")
+        controller.Name = "AnimationController"
+        controller.Parent = visual
+    end
+    for _, child in ipairs(entity:GetDescendants()) do
+        if child:IsA("AnimationController") and child ~= controller then
+            child:Destroy()
+        end
+    end
+    local animator = controller:FindFirstChildOfClass("Animator")
+    if not animator then
+        animator = Instance.new("Animator")
+        animator.Parent = controller
+    end
+    local idle = loadTrack(animator, pick(profile, "idle"), true)
+    local combatIdle = loadTrack(animator, pick(profile, "combat_idle"), true)
+    local death = loadTrack(animator, pick(profile, "death"), false)
+    local current: AnimationTrack? = nil
+    local dying = false
+    local finished = false
+    local deathStartedAt = 0
+    local function stop(track: AnimationTrack?)
+        if track and track.IsPlaying then
+            track:Stop(0.1)
+        end
+    end
+    local function playIdle()
+        if dying then
+            return
+        end
+        local nextTrack = if entity:GetAttribute("InCombat") == true then (combatIdle or idle) else idle
+        if current == nextTrack then
+            return
+        end
+        stop(current)
+        current = nextTrack
+        entity:SetAttribute("NpcAnimationState", if nextTrack == combatIdle and combatIdle then "combat_idle" else "idle")
+        if nextTrack then
+            local speed = AnimationSpeedScaling.ResolveForModel(entity, "idle") / 100
+            nextTrack:Play(0.12, 1, speed)
+        end
+    end
+    local function beginDeath()
+        if dying then
+            return
+        end
+        dying = true
+        deathStartedAt = os.clock()
+        stop(current)
+        current = nil
+        entity:SetAttribute("NpcAnimationState", "death")
+        entity:SetAttribute("DeathAnimationStartedAt", os.clock())
+        if death then
+            DeathAnimationPolicy.Start(death, AnimationSpeedScaling.ResolveForModel(entity, "death") / 100)
+        end
+    end
+    local function step(delta: number): boolean
+        if not dying or finished then
+            return false
+        end
+        if not death then
+            finished = true
+            return true
+        end
+        local reached, terminalTime = DeathAnimationPolicy.LatchVisibleTerminalPose(death, delta)
+        -- A failed Roblox asset load must never monopolize a population slot forever.
+        if not reached and death.Length <= 0 and os.clock() - deathStartedAt >= 8 then
+            warn("[game1][npc] death animation failed to resolve within 8s; releasing corpse lifecycle: " .. entity.Name)
+            finished = true
+            return true
+        end
+        if reached then
+            finished = true
+            entity:SetAttribute("DeathAnimationLength", death.Length)
+            entity:SetAttribute("DeathAnimationTerminalTime", terminalTime)
+            entity:SetAttribute("DeathTerminalPoseHeld", true)
+            return true
+        end
+        return false
+    end
+    entity:GetAttributeChangedSignal("InCombat"):Connect(playIdle)
+    playIdle()
+    return { BeginDeath = beginDeath, Step = step }
+end
+
+return table.freeze(NpcAnimationService)
