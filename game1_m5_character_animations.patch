diff --git a/docs/character-animation-system.md b/docs/character-animation-system.md
new file mode 100644
index 0000000..98d4f9f
--- /dev/null
+++ b/docs/character-animation-system.md
@@ -0,0 +1,88 @@
+# game1 character animation system
+
+## canonical contract
+
+one studio-exported `.rbxm`/`.rbxmx` clip maps to one permanent roblox animation asset id.
+
+runtime never resolves an animation by filename. the chain is:
+
+`character state/action -> semantic slot -> character animation profile -> binding -> clip -> roblox asset id`
+
+character animation profiles are attached to a registered character archetype and record that archetype's skeleton signature. a changed skeleton is surfaced as incompatible until the profile is reviewed/rescanned.
+
+## scopes
+
+base scope is character-wide and independent of equipped weapon:
+
+- `idle`, `walk`, `run`
+- `jump_start`, `jump_loop`, `fall`, `land`
+- `seated.enter`, `seated.loop`, `seated.exit`
+
+weapon scope is a context overlay. m5 starts with `1hs` and `bow`:
+
+- `idle`, `combat_idle`, `walk`, `run`
+- `attack` with variants `01..n`
+- `special_attack` with variants `01..n`
+- `equip`, `unequip`
+- `bow` additionally supports `aim`
+
+variants are alternate visuals of the same gameplay action. for example `1hs_attack_01` and `1hs_attack_02` both bind to slot `attack`; the resolver chooses by weight.
+
+## canonical files
+
+registered clips are copied into both recoverable source and publication-ready prepared trees:
+
+`assets/source/characters/<race>/<gender>/<character>/animations/...`
+
+`assets/prepared/characters/<race>/<gender>/<character>/animations/...`
+
+examples:
+
+- `base/base_idle.rbxm`
+- `base/base_seated_enter.rbxm`
+- `weapons/1hs/1hs_attack_01.rbxm`
+- `weapons/bow/bow_run.rbxm`
+
+## scan naming
+
+preferred new-project names:
+
+- `idle.rbxm`, `base_idle.rbxm`, `sitdown.rbxm`, `sit.rbxm`, `situp.rbxm`
+- `1hs_idle.rbxm`, `1hs_walk.rbxm`, `1hs_run.rbxm`
+- `1hs_attack_01.rbxm`, `1hs_attack_02.rbxm`
+- `bow_idle.rbxm`, `bow_run.rbxm`, `bow_attack_01.rbxm`, `bow_aim.rbxm`
+
+scanner also accepts the proven reference naming forms such as `Wait_1HS_*`, `AtkWait_1HS_*`, `Atk01_1HS_*`, `Run_Bow_*`, and `SpAtk02_Bow_*` without importing the old game's taxonomy into runtime.
+
+## publication
+
+`publish missing` publishes local-only clips sequentially. already-published clips keep their permanent asset id. if their local bytes change, status becomes `changed`; m5 does not create a duplicate id. animation content-version updates remain a separate studio-bridge operation because open cloud content update does not currently support animation rbxm content.
+
+## m5 runtime boundary
+
+m5 deliberately keeps gameplay and presentation separate. the existing movement controller remains the owner of physics and publishes `MovementState`; the animation controller consumes that presentation state.
+
+wired now:
+
+- base/weapon `idle`, `walk`, `run`
+- weapon `attack` variants through the existing lmb attack input
+- reverse playback of `walk` while the existing backpedal presentation flag is active
+- character/skeleton compatibility checks and track prewarm
+
+registered now but reserved for their gameplay/state owner:
+
+- airborne (`jump_start`, `jump_loop`, `fall`, `land`)
+- seated transitions (`seated.enter`, `seated.loop`, `seated.exit`)
+- combat stance (`combat_idle`), special attack, equip/unequip and bow aim
+
+this keeps the semantic contract stable without pretending that an animation clip itself owns physics, posture or combat state.
+
+## subsystem layout
+
+control-center animation code is split by responsibility instead of growing one service file:
+
+- `animation_core/common.py` — canonical slots, weapon sets and filename classification
+- `animation_core/storage.py` — sqlite profiles/clips/bindings and scan/import
+- `animation_core/publication.py` — sequential publication rules
+- `animation_core/registry.py` — portable manifest and generated luau registry
+- `animation_store.py` — small compatibility facade used by the host agent
diff --git a/src/client/character/animation/AnimationResolver.luau b/src/client/character/animation/AnimationResolver.luau
new file mode 100644
index 0000000..9aa53c7
--- /dev/null
+++ b/src/client/character/animation/AnimationResolver.luau
@@ -0,0 +1,104 @@
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Game1Shared = ReplicatedStorage:WaitForChild("Game1Shared")
+local CharacterShared = Game1Shared:WaitForChild("character")
+local Registry = require(CharacterShared:WaitForChild("CharacterAnimationRegistry"))
+
+local AnimationResolver = {}
+local random = Random.new()
+
+local function weightedChoice(rows)
+	if type(rows) ~= "table" or #rows == 0 then
+		return nil
+	end
+	if #rows == 1 then
+		return rows[1]
+	end
+	local total = 0
+	for _, row in ipairs(rows) do
+		total += math.max(1, tonumber(row.weight) or 1)
+	end
+	local cursor = random:NextNumber(0, total)
+	for _, row in ipairs(rows) do
+		cursor -= math.max(1, tonumber(row.weight) or 1)
+		if cursor <= 0 then
+			return row
+		end
+	end
+	return rows[#rows]
+end
+
+local function profileFor(character: Model)
+	local profileId = tostring(character:GetAttribute("AnimationProfileId") or character:GetAttribute("CharacterArchetype") or "")
+	local profile = Registry.profiles[profileId]
+	if not profile then
+		return nil
+	end
+	local expected = tostring(profile.skeletonSignature or "")
+	local actual = tostring(character:GetAttribute("CharacterSkeletonSignature") or "")
+	if expected ~= "" and actual ~= "" and expected ~= actual then
+		warn(string.format("[game1][animation] skeleton mismatch for %s", profileId))
+		return nil
+	end
+	return profile
+end
+
+function AnimationResolver.Resolve(character: Model, scope: string, weaponSet: string?, slot: string)
+	local profile = profileFor(character)
+	if not profile then
+		return nil
+	end
+	local rows = nil
+	if scope == "weapon" then
+		local weapon = profile.weapons and profile.weapons[tostring(weaponSet or "")]
+		rows = weapon and weapon[slot]
+	else
+		rows = profile.base and profile.base[slot]
+	end
+	return weightedChoice(rows)
+end
+
+function AnimationResolver.ListForCharacter(character: Model)
+	local profile = profileFor(character)
+	if not profile then
+		return {}
+	end
+	local rows = {}
+	for _, slotRows in pairs(profile.base or {}) do
+		for _, row in ipairs(slotRows) do
+			table.insert(rows, row)
+		end
+	end
+	for _, weapon in pairs(profile.weapons or {}) do
+		for _, slotRows in pairs(weapon) do
+			for _, row in ipairs(slotRows) do
+				table.insert(rows, row)
+			end
+		end
+	end
+	return rows
+end
+
+function AnimationResolver.ResolveLocomotion(character: Model, slot: string)
+	local weaponSet = tostring(character:GetAttribute("AnimationWeaponSet") or "")
+	if weaponSet ~= "" and weaponSet ~= "base" and weaponSet ~= "unarmed" then
+		local weaponRow = AnimationResolver.Resolve(character, "weapon", weaponSet, slot)
+		if weaponRow then
+			return weaponRow
+		end
+	end
+	return AnimationResolver.Resolve(character, "base", nil, slot)
+end
+
+function AnimationResolver.ResolveAction(character: Model, slot: string)
+	local weaponSet = tostring(character:GetAttribute("AnimationWeaponSet") or "")
+	if weaponSet ~= "" and weaponSet ~= "base" and weaponSet ~= "unarmed" then
+		local weaponRow = AnimationResolver.Resolve(character, "weapon", weaponSet, slot)
+		if weaponRow then
+			return weaponRow
+		end
+	end
+	return AnimationResolver.Resolve(character, "base", nil, slot)
+end
+
+return AnimationResolver
diff --git a/src/client/character/animation/AnimationTrackCache.luau b/src/client/character/animation/AnimationTrackCache.luau
new file mode 100644
index 0000000..63110be
--- /dev/null
+++ b/src/client/character/animation/AnimationTrackCache.luau
@@ -0,0 +1,158 @@
+local ContentProvider = game:GetService("ContentProvider")
+local RunService = game:GetService("RunService")
+
+local AnimationTrackCache = {}
+AnimationTrackCache.__index = AnimationTrackCache
+
+local PRIORITIES = {
+	Idle = Enum.AnimationPriority.Idle,
+	Movement = Enum.AnimationPriority.Movement,
+	Action = Enum.AnimationPriority.Action,
+	Action2 = Enum.AnimationPriority.Action2,
+	Action3 = Enum.AnimationPriority.Action3,
+	Action4 = Enum.AnimationPriority.Action4,
+}
+
+local function priorityFromName(name: string): Enum.AnimationPriority
+	return PRIORITIES[name] or Enum.AnimationPriority.Movement
+end
+
+local function applyDescriptor(track: AnimationTrack, descriptor)
+	track.Looped = descriptor.looped == true
+	track.Priority = priorityFromName(tostring(descriptor.priority or "Movement"))
+end
+
+function AnimationTrackCache.new(animator: Animator)
+	return setmetatable({
+		animator = animator,
+		entries = {},
+		destroyed = false,
+	}, AnimationTrackCache)
+end
+
+function AnimationTrackCache:Get(descriptor)
+	if self.destroyed or not descriptor then
+		return nil
+	end
+	local clipId = tostring(descriptor.clipId or descriptor.animationId or "")
+	local animationId = tostring(descriptor.animationId or "")
+	if clipId == "" or animationId == "" then
+		return nil
+	end
+	local cached = self.entries[clipId]
+	if cached then
+		applyDescriptor(cached.track, descriptor)
+		return cached.track
+	end
+	local animation = Instance.new("Animation")
+	animation.Name = clipId
+	animation.AnimationId = animationId
+	local ok, trackOrError = pcall(function()
+		return self.animator:LoadAnimation(animation)
+	end)
+	if not ok then
+		animation:Destroy()
+		warn(("[game1][animation] failed to load %s: %s"):format(clipId, tostring(trackOrError)))
+		return nil
+	end
+	local track = trackOrError :: AnimationTrack
+	applyDescriptor(track, descriptor)
+	self.entries[clipId] = { animation = animation, track = track }
+	return track
+end
+
+function AnimationTrackCache:IsLoaded(track: AnimationTrack?): boolean
+	return track ~= nil and (tonumber(track.Length) or 0) > 0.01
+end
+
+function AnimationTrackCache:WaitUntilLoaded(track: AnimationTrack?, timeoutSeconds: number?): boolean
+	if not track then
+		return false
+	end
+	if self:IsLoaded(track) then
+		return true
+	end
+	local deadline = os.clock() + math.max(0, tonumber(timeoutSeconds) or 0)
+	while not self.destroyed and os.clock() < deadline do
+		RunService.Heartbeat:Wait()
+		if self:IsLoaded(track) then
+			return true
+		end
+	end
+	return self:IsLoaded(track)
+end
+
+function AnimationTrackCache:Prewarm(descriptors, timeoutSeconds: number?)
+	if self.destroyed then
+		return { total = 0, ready = 0, failed = 0, elapsed = 0 }
+	end
+	local startedAt = os.clock()
+	local tracks = {}
+	local animations = {}
+	local failed = 0
+	for _, descriptor in ipairs(descriptors or {}) do
+		local track = self:Get(descriptor)
+		local clipId = tostring(descriptor.clipId or descriptor.animationId or "")
+		local entry = self.entries[clipId]
+		if track and entry then
+			table.insert(tracks, track)
+			table.insert(animations, entry.animation)
+		else
+			failed += 1
+		end
+	end
+	if #animations > 0 then
+		pcall(function()
+			ContentProvider:PreloadAsync(animations)
+		end)
+	end
+	local deadline = os.clock() + math.max(0, tonumber(timeoutSeconds) or 0)
+	while not self.destroyed and os.clock() < deadline do
+		local allLoaded = true
+		for _, track in ipairs(tracks) do
+			if not self:IsLoaded(track) then
+				allLoaded = false
+				break
+			end
+		end
+		if allLoaded then
+			break
+		end
+		RunService.Heartbeat:Wait()
+	end
+	local ready = 0
+	for _, track in ipairs(tracks) do
+		if self:IsLoaded(track) then
+			ready += 1
+		end
+	end
+	return {
+		total = #tracks + failed,
+		ready = ready,
+		failed = failed + (#tracks - ready),
+		elapsed = os.clock() - startedAt,
+	}
+end
+
+function AnimationTrackCache:StopAll(fadeTime: number?)
+	for _, entry in pairs(self.entries) do
+		if entry.track.IsPlaying then
+			entry.track:Stop(fadeTime or 0.1)
+		end
+	end
+end
+
+function AnimationTrackCache:Destroy()
+	if self.destroyed then
+		return
+	end
+	self.destroyed = true
+	self:StopAll(0)
+	for _, entry in pairs(self.entries) do
+		entry.track:Destroy()
+		entry.animation:Destroy()
+	end
+	table.clear(self.entries)
+end
+
+return AnimationTrackCache
diff --git a/src/client/character/animation/CharacterAnimationController.luau b/src/client/character/animation/CharacterAnimationController.luau
new file mode 100644
index 0000000..1022264
--- /dev/null
+++ b/src/client/character/animation/CharacterAnimationController.luau
@@ -0,0 +1,195 @@
+local Players = game:GetService("Players")
+local RunService = game:GetService("RunService")
+
+local AnimationResolver = require(script.Parent:WaitForChild("AnimationResolver"))
+local AnimationTrackCache = require(script.Parent:WaitForChild("AnimationTrackCache"))
+
+local CharacterAnimationController = {}
+
+local localPlayer = Players.LocalPlayer
+local started = false
+local character: Model? = nil
+local animator: Animator? = nil
+local cache = nil
+local currentLoop = nil
+local currentLoopClipId = ""
+local currentAction = nil
+local connections = {}
+
+local function disconnectAll()
+	for _, connection in ipairs(connections) do
+		connection:Disconnect()
+	end
+	table.clear(connections)
+end
+
+local function clearCharacter()
+	disconnectAll()
+	if cache then
+		cache:Destroy()
+	end
+	cache = nil
+	character = nil
+	animator = nil
+	currentLoop = nil
+	currentLoopClipId = ""
+	currentAction = nil
+end
+
+local function findAnimator(model: Model): Animator?
+	local visual = model:FindFirstChild("Visual")
+	if not visual then
+		return nil
+	end
+	local host = visual:FindFirstChildWhichIsA("AnimationController", true)
+	if not host then
+		return nil
+	end
+	local found = host:FindFirstChildOfClass("Animator")
+	return if found and found:IsA("Animator") then found else nil
+end
+
+local function movementSlot(): string
+	if not character then
+		return "idle"
+	end
+	local state = string.lower(tostring(character:GetAttribute("MovementState") or "idle"))
+	if state == "walk" then
+		return "walk"
+	elseif state == "run" then
+		return "run"
+	end
+	return "idle"
+end
+
+local function applyBackwardPlayback(track: AnimationTrack, slot: string)
+	if not character then
+		return
+	end
+	local backward = tostring(character:GetAttribute("AnimationMovementDirection") or "Forward") == "Backward"
+	if not backward or slot ~= "walk" then
+		track:AdjustSpeed(1)
+		return
+	end
+	task.spawn(function()
+		local deadline = os.clock() + 1
+		while track.IsPlaying and track.Length <= 0 and os.clock() < deadline do
+			RunService.Heartbeat:Wait()
+		end
+		if track.IsPlaying and track.Length > 0 then
+			track.TimePosition = math.max(0, track.Length - 0.001)
+			track:AdjustSpeed(-1)
+		end
+	end)
+end
+
+local function refreshLoop()
+	if not character or not cache then
+		return
+	end
+	local slot = movementSlot()
+	local descriptor = AnimationResolver.ResolveLocomotion(character, slot)
+	if not descriptor then
+		if currentLoop then
+			currentLoop:Stop(0.12)
+		end
+		currentLoop = nil
+		currentLoopClipId = ""
+		character:SetAttribute("AnimationResolvedSlot", slot)
+		character:SetAttribute("AnimationResolvedClip", "")
+		return
+	end
+	local clipId = tostring(descriptor.clipId or "")
+	if currentLoop and currentLoopClipId == clipId then
+		applyBackwardPlayback(currentLoop, slot)
+		return
+	end
+	local nextTrack = cache:Get(descriptor)
+	if not nextTrack then
+		return
+	end
+	if currentLoop and currentLoop.IsPlaying then
+		currentLoop:Stop(0.15)
+	end
+	currentLoop = nextTrack
+	currentLoopClipId = clipId
+	nextTrack:Play(0.15, 1, 1)
+	applyBackwardPlayback(nextTrack, slot)
+	character:SetAttribute("AnimationResolvedSlot", slot)
+	character:SetAttribute("AnimationResolvedClip", clipId)
+end
+
+local function bindCharacter(newCharacter: Model)
+	clearCharacter()
+	character = newCharacter
+	animator = findAnimator(newCharacter)
+	if not animator then
+		warn("[game1][animation] Animator is missing from Visual")
+		return
+	end
+	cache = AnimationTrackCache.new(animator)
+	local boundCache = cache
+	local descriptors = AnimationResolver.ListForCharacter(newCharacter)
+	task.spawn(function()
+		local result = boundCache:Prewarm(descriptors, 4)
+		if character ~= newCharacter or cache ~= boundCache then
+			return
+		end
+		print(("[game1][animation] prewarm %d/%d ready in %.3fs"):format(result.ready, result.total, result.elapsed))
+	end)
+	for _, attribute in ipairs({ "MovementState", "AnimationMovementDirection", "AnimationWeaponSet" }) do
+		table.insert(connections, newCharacter:GetAttributeChangedSignal(attribute):Connect(refreshLoop))
+	end
+	refreshLoop()
+	print("[game1][animation] character animation profile bound")
+end
+
+function CharacterAnimationController.PlayAction(slot: string)
+	if not character or not cache then
+		return nil
+	end
+	local descriptor = AnimationResolver.ResolveAction(character, slot)
+	if not descriptor then
+		return nil
+	end
+	local track = cache:Get(descriptor)
+	if not track then
+		return nil
+	end
+	if currentAction and currentAction.IsPlaying then
+		currentAction:Stop(0.06)
+	end
+	currentAction = track
+	track:Play(0.06, 1, 1)
+	character:SetAttribute("AnimationActionSlot", slot)
+	character:SetAttribute("AnimationActionClip", tostring(descriptor.clipId or ""))
+	return track
+end
+
+function CharacterAnimationController.SetWeaponSet(weaponSet: string?)
+	if character then
+		character:SetAttribute("AnimationWeaponSet", string.lower(tostring(weaponSet or "")))
+	end
+end
+
+function CharacterAnimationController.Refresh()
+	refreshLoop()
+end
+
+function CharacterAnimationController.Start()
+	if started then
+		return
+	end
+	started = true
+	localPlayer.CharacterAdded:Connect(bindCharacter)
+	localPlayer.CharacterRemoving:Connect(function(removing)
+		if removing == character then
+			clearCharacter()
+		end
+	end)
+	if localPlayer.Character then
+		task.spawn(bindCharacter, localPlayer.Character)
+	end
+end
+
+return CharacterAnimationController
