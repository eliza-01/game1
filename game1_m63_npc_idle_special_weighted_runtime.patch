diff --git a/src/server/npc/NpcAnimationTracks.luau b/src/server/npc/NpcAnimationTracks.luau
new file mode 100644
--- /dev/null
+++ b/src/server/npc/NpcAnimationTracks.luau
@@ -0,0 +1,119 @@
+-- Animation registry adapter: loading, priority, playback speed and runtime seam.
+-- Does not decide which animation to play or when to transition actor state.
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local Shared = ReplicatedStorage:WaitForChild("Game1Shared")
+local AnimationShared = Shared:WaitForChild("animation")
+local NpcConfig = require(Shared:WaitForChild("npc"):WaitForChild("NpcAnimationConfig"))
+local AnimationSpeedScaling = require(AnimationShared:WaitForChild("AnimationSpeedScaling"))
+local AnimationFirstFrameSeam = require(AnimationShared:WaitForChild("AnimationFirstFrameSeam"))
+
+local NpcAnimationTracks = {}
+
+local priorities = {
+    Idle = Enum.AnimationPriority.Idle,
+    Movement = Enum.AnimationPriority.Movement,
+    Action = Enum.AnimationPriority.Action,
+    Action2 = Enum.AnimationPriority.Action2,
+    Action3 = Enum.AnimationPriority.Action3,
+    Action4 = Enum.AnimationPriority.Action4,
+}
+
+function NpcAnimationTracks.PublishedRows(profile: any?, slot: string): {any}
+    local slots = profile and profile.slots
+    local rows = slots and slots[slot]
+    local result = {}
+    if typeof(rows) ~= "table" then
+        return result
+    end
+    for _, row in ipairs(rows) do
+        if tostring(row.weaponSet or NpcConfig.WeaponSet) == NpcConfig.WeaponSet
+            and tostring(row.animationId or ""):match("^rbxassetid://%d+$") then
+            table.insert(result, row)
+        end
+    end
+    return result
+end
+
+local function load(animator: Animator, animationId: string): AnimationTrack?
+    local animation = Instance.new("Animation")
+    animation.AnimationId = animationId
+    local success, result = pcall(function()
+        return animator:LoadAnimation(animation)
+    end)
+    animation:Destroy()
+    if not success then
+        warn("[game1][npc] animation load failed: " .. tostring(result))
+        return nil
+    end
+    return result :: AnimationTrack
+end
+
+function NpcAnimationTracks.Load(animator: Animator, row: any?, looped: boolean, allowSeam: boolean?): any?
+    if not row then
+        return nil
+    end
+    local animationId = tostring(row.animationId)
+    local track = load(animator, animationId)
+    if not track then
+        return nil
+    end
+    track.Looped = looped
+    track.Priority = priorities[tostring(row.priority or "")] or (if looped then Enum.AnimationPriority.Idle else Enum.AnimationPriority.Action)
+    local seam = nil
+    if row.duplicateFirstFrameAtEnd == true and allowSeam ~= false then
+        local companion = load(animator, animationId)
+        if companion then
+            companion.Priority = track.Priority
+            seam = AnimationFirstFrameSeam.new(track, companion, looped)
+        end
+    end
+    return { row = row, track = track, seam = seam }
+end
+
+function NpcAnimationTracks.Play(entity: Model, clip: any?, channel: string, fade: number?): boolean
+    if not clip then
+        return false
+    end
+    local percent = AnimationSpeedScaling.ResolveForModel(entity, channel)
+    entity:SetAttribute("AnimationPlaybackSpeedPercent", percent)
+    local speed = percent / 100
+    local success, failure = pcall(function()
+        if clip.seam then
+            clip.seam:Play(fade or NpcConfig.TransitionSeconds, speed)
+        elseif clip.track.IsPlaying then
+            clip.track:AdjustSpeed(speed)
+        else
+            clip.track:Play(fade or NpcConfig.TransitionSeconds, 1, speed)
+        end
+    end)
+    if not success then
+        warn("[game1][npc] animation playback failed: " .. tostring(failure))
+        return false
+    end
+    return true
+end
+
+function NpcAnimationTracks.Stop(clip: any?, fade: number?)
+    if not clip then
+        return
+    end
+    local success, failure = pcall(function()
+        if clip.seam then
+            clip.seam:Stop(fade or NpcConfig.TransitionSeconds)
+        elseif clip.track.IsPlaying then
+            clip.track:Stop(fade or NpcConfig.TransitionSeconds)
+        end
+    end)
+    if not success then
+        warn("[game1][npc] animation stop failed: " .. tostring(failure))
+    end
+end
+
+function NpcAnimationTracks.Step(clip: any?, delta: number): (boolean, boolean)
+    if clip and clip.seam then
+        return clip.seam:Step(delta)
+    end
+    return false, false
+end
+
+return table.freeze(NpcAnimationTracks)
diff --git a/src/server/npc/NpcIdlePresentation.luau b/src/server/npc/NpcIdlePresentation.luau
new file mode 100644
--- /dev/null
+++ b/src/server/npc/NpcIdlePresentation.luau
@@ -0,0 +1,182 @@
+-- One responsibility: peaceful NPC idle presentation and weighted special cycles.
+-- Population, combat AI, death and asset publication are not owned here.
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local Shared = ReplicatedStorage:WaitForChild("Game1Shared")
+local WeightedAnimationChoice = require(Shared:WaitForChild("animation"):WaitForChild("WeightedAnimationChoice"))
+local Config = require(Shared:WaitForChild("npc"):WaitForChild("NpcAnimationConfig"))
+local Tracks = require(script.Parent:WaitForChild("NpcAnimationTracks"))
+
+local NpcIdlePresentation = {}
+NpcIdlePresentation.__index = NpcIdlePresentation
+local selectionRandom = Random.new()
+
+local function roleOf(row: any): string
+    local role = tostring(row.role or "")
+    if role == "special" or role == "base" then
+        return role
+    end
+    if tostring(row.sourceSlot or "") == "idle_special" or (tonumber(row.variant) or 0) > 0 then
+        return "special"
+    end
+    return "base"
+end
+
+function NpcIdlePresentation.new(entity: Model, animator: Animator, profile: any?): any
+    local self = setmetatable({
+        entity = entity,
+        base = nil,
+        choices = {},
+        activeSpecial = nil,
+        active = false,
+        elapsedWithoutBase = 0,
+        specialStarted = 0,
+        connections = {},
+    }, NpcIdlePresentation)
+
+    for _, row in ipairs(Tracks.PublishedRows(profile, "idle")) do
+        local role = roleOf(row)
+        local clip = Tracks.Load(animator, row, role == "base")
+        if clip then
+            clip.role = role
+            if role == "base" and not self.base then
+                self.base = clip
+            end
+            table.insert(self.choices, clip)
+            if role == "special" and not clip.seam then
+                table.insert(self.connections, clip.track.Ended:Connect(function()
+                    if self.active and self.activeSpecial == clip then
+                        self:_finishSpecial()
+                    end
+                end))
+            end
+        end
+    end
+    if self.base and not self.base.seam then
+        table.insert(self.connections, self.base.track.DidLoop:Connect(function()
+            if self.active and not self.activeSpecial then
+                self:_rollAtIdleBoundary()
+            end
+        end))
+    end
+    return self
+end
+
+function NpcIdlePresentation:_playBase()
+    if not self.active then
+        return
+    end
+    self.entity:SetAttribute("NpcAnimationState", "idle")
+    self.entity:SetAttribute("NpcIdleVariant", "base")
+    self.elapsedWithoutBase = 0
+    if self.base then
+        Tracks.Play(self.entity, self.base, "idle", Config.TransitionSeconds)
+    end
+end
+
+function NpcIdlePresentation:_finishSpecial()
+    if not self.activeSpecial then
+        return
+    end
+    local finished = self.activeSpecial
+    self.activeSpecial = nil
+    Tracks.Stop(finished, 0.04)
+    if self.base and (tonumber(self.base.row.weight) or 100) > 0 then
+        self:_playBase()
+    else
+        self.entity:SetAttribute("NpcAnimationState", "idle")
+        self.entity:SetAttribute("NpcIdleVariant", nil)
+        self.elapsedWithoutBase = 0
+    end
+end
+
+function NpcIdlePresentation:_rollAtIdleBoundary()
+    if not self.active or self.activeSpecial then
+        return
+    end
+    local selected = WeightedAnimationChoice.Select(self.choices, selectionRandom)
+    if not selected or selected.role == "base" then
+        -- Native idle keeps looping, but recover if the asset stopped unexpectedly.
+        if self.base and selected and not self.base.track.IsPlaying then
+            self:_playBase()
+        end
+        return
+    end
+    self.activeSpecial = selected
+    self.specialStarted = os.clock()
+    Tracks.Stop(self.base, 0.08)
+    self.entity:SetAttribute("NpcAnimationState", "idle")
+    self.entity:SetAttribute("NpcIdleVariant", ("special_%02d"):format(math.max(1, math.floor(tonumber(selected.row.variant) or 1))))
+    if not Tracks.Play(self.entity, selected, "idle", 0.08) then
+        self:_finishSpecial()
+    end
+end
+
+function NpcIdlePresentation:Start()
+    if self.active then
+        return
+    end
+    self.active = true
+    self.entity:SetAttribute("NpcAnimationState", "idle")
+    self.entity:SetAttribute("NpcIdleVariant", nil)
+    if self.base and (tonumber(self.base.row.weight) or 100) > 0 then
+        self:_playBase()
+    else
+        -- Special-only profiles work without an idle clip. A disabled base
+        -- (weight 0) is never played just to make selection possible.
+        self:_rollAtIdleBoundary()
+    end
+end
+
+function NpcIdlePresentation:Stop()
+    self.active = false
+    self.activeSpecial = nil
+    self.elapsedWithoutBase = 0
+    Tracks.Stop(self.base)
+    for _, clip in ipairs(self.choices) do
+        if clip.role == "special" then
+            Tracks.Stop(clip)
+        end
+    end
+    self.entity:SetAttribute("NpcIdleVariant", nil)
+end
+
+function NpcIdlePresentation:Step(delta: number)
+    if not self.active then
+        return
+    end
+    local special = self.activeSpecial
+    if special then
+        local completed = Tracks.Step(special, delta)
+        if completed then
+            self:_finishSpecial()
+        elseif special.track.Length <= 0 and os.clock() - self.specialStarted >= Config.UnresolvedSpecialTimeoutSeconds then
+            warn("[game1][npc] special idle asset did not resolve: " .. tostring(special.row.animationId))
+            self:_finishSpecial()
+        end
+        return
+    end
+    if self.base and self.base.track.IsPlaying and self.base.track.Length > 0 then
+        local _, wrapped = Tracks.Step(self.base, delta)
+        if wrapped then
+            self:_rollAtIdleBoundary()
+        end
+        return
+    end
+    -- No usable base loop: attempt weighted selection at a bounded interval.
+    -- This also handles Roblox animation assets whose Length never resolves.
+    self.elapsedWithoutBase += math.max(0, delta)
+    if self.elapsedWithoutBase >= Config.MissingBaseIdleCycleSeconds then
+        self.elapsedWithoutBase = 0
+        self:_rollAtIdleBoundary()
+    end
+end
+
+function NpcIdlePresentation:Destroy()
+    self:Stop()
+    for _, connection in ipairs(self.connections) do
+        connection:Disconnect()
+    end
+    table.clear(self.connections)
+end
+
+return table.freeze(NpcIdlePresentation)
