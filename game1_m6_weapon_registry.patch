diff --git a/src/shared/character/CharacterMovementConfig.luau b/src/shared/character/CharacterMovementConfig.luau
index c7f969a..586473e 100644
--- a/src/shared/character/CharacterMovementConfig.luau
+++ b/src/shared/character/CharacterMovementConfig.luau
@@ -1,14 +1,31 @@
 local CharacterMovementConfig = {}
-CharacterMovementConfig.DefaultRunSpeed = 16
-CharacterMovementConfig.DefaultWalkSpeed = 9
+
+-- gameplay movement stat. 50 preserves the current game1 baseline movement feel.
+CharacterMovementConfig.DefaultRunStat = 50
+CharacterMovementConfig.DefaultRobloxRunSpeed = 16
+CharacterMovementConfig.DefaultRobloxWalkSpeed = 9
