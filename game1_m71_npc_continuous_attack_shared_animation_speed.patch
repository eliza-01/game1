+            defaults["rules"] = [deepcopy(authored.get(r["channel"], r)) for r in defaults["rules"]]
+        former = [p for p in profiles if p.get("targetType") == "character"]
+        if former:
+            payload.setdefault("legacyProfiles", []).extend(deepcopy(former))
