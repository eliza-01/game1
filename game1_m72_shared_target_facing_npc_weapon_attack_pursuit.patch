+-- Roblox Studio: StarterPlayer.StarterPlayerScripts.game1Client.MonsterAnimation.ActorAnimationCompositionConfig (ModuleScript)
+-- Client-only limits for monster upper-body-over-locomotion composition.
+local Config = {
+	MaxComposedMonsters = 32, -- legacy name for shared actor budget
+	MaxComposedActors = 32,
+	MaxDistance = 140,
+	EntryBlendSeconds = 0.10,
+	ExitBlendSeconds = 0.08,
+	SamplerIdleTtlSeconds = 8,
+	SamplerAnchorInterval = 0.50,
+	BottomLeafBandFraction = 0.28,
+	MaxLowerBodyFraction = 0.62,
+	MovementDirectionMinSpeed = 0.35,
+}
+
+return table.freeze(Config)
diff --git a/src/client/actor/ActorLocomotionSampler.luau b/src/client/actor/ActorLocomotionSampler.luau
new file mode 100644
--- /dev/null
+++ b/src/client/actor/ActorLocomotionSampler.luau
@@ -0,0 +1,162 @@
+-- Roblox Studio: StarterPlayer.StarterPlayerScripts.game1Client.MonsterAnimation.ActorLocomotionSampler (ModuleScript)
+-- Pooled invisible locomotion pose source. A sampler is leased exclusively while an actor is composed so individual phase offsets never synchronize visible legs.
+local Workspace = game:GetService("Workspace")
+
+local ActorSkeletonMap = require(script.Parent:WaitForChild("ActorSkeletonMap"))
+
+local ActorLocomotionSampler = {}
+ActorLocomotionSampler.__index = ActorLocomotionSampler
+
+local function prepareProxy(visual: Model): (Model?, Animator?, string?)
+	local oldArchivable = visual.Archivable
+	visual.Archivable = true
+	local okClone, cloneOrError = pcall(function()
+		return visual:Clone()
+	end)
+	visual.Archivable = oldArchivable
+	if not okClone or not cloneOrError then
+		return nil, nil, "could not clone actor visual: " .. tostring(cloneOrError)
+	end
+	local proxy = cloneOrError :: Model
+	proxy.Name = "__game1ActorLocomotionSampler"
+	for _, object in proxy:GetDescendants() do
+		if object:IsA("Bone") then
+			object.Transform = CFrame.identity
+		elseif object:IsA("BasePart") then
+			object.Anchored = true
+			object.CanCollide = false
+			object.CanTouch = false
+			object.CanQuery = false
+			object.CastShadow = false
+			object.Transparency = 1
+			object.LocalTransparencyModifier = 1
+		elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam") then
+			object.Enabled = false
+		elseif object:IsA("Script") or object:IsA("LocalScript") then
+			object:Destroy()
+		end
+	end
+	local controller = proxy:FindFirstChildWhichIsA("AnimationController", true)
+	if not controller then
+		controller = Instance.new("AnimationController")
+		controller.Name = "AnimationController"
+		controller.Parent = proxy
+	end
+	local animator = controller:FindFirstChildWhichIsA("Animator")
+	if not animator then
+		animator = Instance.new("Animator")
+		animator.Parent = controller
+	end
+	proxy.Parent = Workspace
+	return proxy, animator, nil
+end
+
+function ActorLocomotionSampler.new(visual: Model, animationId: string, playbackSpeed: number, startPhase: number?)
+	local proxy, animator, errorMessage = prepareProxy(visual)
+	if not proxy or not animator then
+		return nil, errorMessage
+	end
+	local animation = Instance.new("Animation")
+	animation.Name = "ActorAttackPursuitLocomotionSource"
+	animation.AnimationId = "rbxassetid://" .. animationId
+	local okLoad, trackOrError = pcall(function()
+		return animator:LoadAnimation(animation)
+	end)
+	animation:Destroy()
+	if not okLoad then
+		proxy:Destroy()
+		return nil, "could not load actor locomotion source: " .. tostring(trackOrError)
+	end
+	local track = trackOrError :: AnimationTrack
+	track.Looped = true
+	track.Priority = Enum.AnimationPriority.Movement
+	local okPlay, playError = pcall(function()
+		track:Play(0, 1, math.max(0.01, playbackSpeed))
+	end)
+	if not okPlay then
+		track:Destroy()
+		proxy:Destroy()
+		return nil, "could not play actor locomotion source: " .. tostring(playError)
+	end
+	local sampler = setmetatable({
+		proxy = proxy,
+		track = track,
+		bones = ActorSkeletonMap.BuildBonePathMap(proxy),
+		users = 0,
+		lastUsedAt = os.clock(),
+		lastAnchorAt = 0,
+		phase = 0,
+		phasePending = false,
+	}, ActorLocomotionSampler)
+	sampler:SetPhase(startPhase or 0)
+	return sampler, nil
+end
+
+
+function ActorLocomotionSampler:SetPlaybackSpeed(playbackSpeed: number)
+	if not self.track then
+		return
+	end
+	local speed = math.max(0.01, tonumber(playbackSpeed) or 1)
+	pcall(function()
+		self.track:AdjustSpeed(speed)
+	end)
+end
+
+function ActorLocomotionSampler:SetPhase(phase: number)
+	self.phase = math.clamp(tonumber(phase) or 0, 0, 0.999999)
+	self.phasePending = true
+	local length = tonumber(self.track and self.track.Length) or 0
+	if length > 0.01 and self.track and self.track.IsPlaying then
+		self.track.TimePosition = self.phase * length
+		self.phasePending = false
+	end
+end
+
+function ActorLocomotionSampler:GetBone(path: string): Bone?
+	return self.bones[path]
+end
+
+function ActorLocomotionSampler:GetBoneRelativeToPivot(path: string): CFrame?
+	local bone = self.bones[path]
+	if not bone or not bone.Parent or not self.proxy.Parent then
+		return nil
+	end
+	return self.proxy:GetPivot():ToObjectSpace(bone.TransformedWorldCFrame)
+end
+
+function ActorLocomotionSampler:IsReady(): boolean
+	local ready = self.track ~= nil and self.track.Length > 0.01
+	if ready and self.phasePending then
+		self.track.TimePosition = self.phase * self.track.Length
+		self.phasePending = false
+	end
+	return ready
+end
+
+function ActorLocomotionSampler:Touch()
+	self.lastUsedAt = os.clock()
+end
+
+function ActorLocomotionSampler:AnchorNear(cameraCFrame: CFrame, now: number, interval: number)
+	if now - self.lastAnchorAt < interval or not self.proxy.Parent then
+		return
+	end
+	self.lastAnchorAt = now
+	self.proxy:PivotTo(CFrame.new(cameraCFrame.Position + Vector3.new(0, -24, 0)))
+end
+
+function ActorLocomotionSampler:Destroy()
+	if self.track then
+		pcall(function()
+			self.track:Stop(0)
+			self.track:Destroy()
+		end)
+	end
+	if self.proxy then
+		self.proxy:Destroy()
+	end
+	self.bones = {}
+end
+
+return ActorLocomotionSampler
diff --git a/src/client/actor/ActorLowerBodyPose.luau b/src/client/actor/ActorLowerBodyPose.luau
new file mode 100644
--- /dev/null
+++ b/src/client/actor/ActorLowerBodyPose.luau
@@ -0,0 +1,70 @@
+-- Shared lower-body leg-root orientation for actors with full-body attack clips.
+-- Keeps the authored weapon/torso attack while independently walking/running.
+local Config = require(script.Parent:WaitForChild("ActorAnimationCompositionConfig"))
+local ActorLowerBodyPose = {}
+
+local function parentTransformedWorldCFrame(bone: Bone): CFrame?
+	local parent = bone.Parent
+	if not parent then
+		return nil
+	end
+	if parent:IsA("Bone") then
+		return parent.TransformedWorldCFrame
+	end
+	if parent:IsA("BasePart") then
+		return parent.CFrame
+	end
+	return nil
+end
+
+local function horizontalDirection(vector: Vector3): Vector3?
+	local flat = Vector3.new(vector.X, 0, vector.Z)
+	if flat.Magnitude <= Config.MovementDirectionMinSpeed then
+		return nil
+	end
+	return flat.Unit
+end
+
+local function movementDirection(entry): Vector3?
+	return horizontalDirection(entry.root.AssemblyLinearVelocity)
+		or horizontalDirection(entry.root.CFrame.LookVector)
+end
+
+function ActorLowerBodyPose.AlignToMovement(entry)
+	if not entry.sampler or entry.weight <= 0 or #entry.lowerRootPaths == 0 then
+		return
+	end
+	local direction = movementDirection(entry)
+	if not direction then
+		return
+	end
+
+	-- The wrapper/root is owned by Humanoid.AutoRotate and therefore follows the
+	-- actual travel direction. Map the authored Run lower-body branches into that
+	-- movement frame instead of inheriting any large yaw authored into Atk01.
+	-- Only independent leg subtrees are compensated; pelvis/spine ownership stays
+	-- with the attack so the torso can still twist naturally above the hips.
+	local movementRoot = CFrame.lookAlong(Vector3.zero, direction, Vector3.yAxis)
+	local desiredVisualRotation = (movementRoot * entry.visualRootOffsetRotation).Rotation
+	for _, path in entry.lowerRootPaths do
+		local targetBone = entry.targetBones[path]
+		local sourceRelative = entry.sampler:GetBoneRelativeToPivot(path)
+		if targetBone and targetBone.Parent and sourceRelative then
+			local parentWorld = parentTransformedWorldCFrame(targetBone)
+			if parentWorld then
+				local currentTransform = targetBone.Transform
+				local currentWorld = targetBone.TransformedWorldCFrame
+				local currentLocal = parentWorld:ToObjectSpace(currentWorld)
+				local effectiveBase = currentLocal * currentTransform:Inverse()
+				local desiredRotation = (desiredVisualRotation * sourceRelative.Rotation).Rotation
+				local desiredWorld = CFrame.new(currentWorld.Position) * desiredRotation
+				local desiredLocal = parentWorld:ToObjectSpace(desiredWorld)
+				local alignedTransform = effectiveBase:Inverse() * desiredLocal
+				targetBone.Transform = currentTransform:Lerp(alignedTransform, entry.weight)
+			end
+		end
+	end
+end
+
+
+return table.freeze(ActorLowerBodyPose)
diff --git a/src/client/actor/ActorSkeletonMap.luau b/src/client/actor/ActorSkeletonMap.luau
new file mode 100644
--- /dev/null
+++ b/src/client/actor/ActorSkeletonMap.luau
@@ -0,0 +1,209 @@
+-- Roblox Studio: StarterPlayer.StarterPlayerScripts.game1Client.MonsterAnimation.ActorSkeletonMap (ModuleScript)
+-- Actor-agnostic skeleton topology helpers for upper/lower body composition.
+local Config = require(script.Parent:WaitForChild("ActorAnimationCompositionConfig"))
+
+local ActorSkeletonMap = {}
+
+local LOWER_NAME_TOKENS = table.freeze({
+	"pelvis", "hip", "thigh", "calf", "shin", "foot", "toe", "leg", "paw", "hoof",
+})
+
+local function bonePath(bone: Bone, visual: Model): string
+	local parts = { bone.Name }
+	local current = bone.Parent
+	while current and current ~= visual do
+		table.insert(parts, 1, current.Name)
+		current = current.Parent
+	end
+	return table.concat(parts, "/")
+end
+
+function ActorSkeletonMap.BuildBonePathMap(visual: Model): { [string]: Bone }
+	local result = {}
+	for _, object in visual:GetDescendants() do
+		if object:IsA("Bone") then
+			result[bonePath(object, visual)] = object
+		end
+	end
+	return result
+end
+
+local function commonAncestorPath(paths: { string }): string?
+	if #paths == 0 then
+		return nil
+	end
+	local split = {}
+	for index, path in ipairs(paths) do
+		split[index] = string.split(path, "/")
+	end
+	local common = {}
+	local cursor = 1
+	while true do
+		local value = split[1][cursor]
+		if not value then
+			break
+		end
+		for index = 2, #split do
+			if split[index][cursor] ~= value then
+				return if #common > 0 then table.concat(common, "/") else nil
+			end
+		end
+		table.insert(common, value)
+		cursor += 1
+	end
+	return if #common > 0 then table.concat(common, "/") else nil
+end
+
+local function fallbackLowerPaths(pathMap: { [string]: Bone }): { string }
+	local result = {}
+	for path, bone in pathMap do
+		local lowered = string.lower(bone.Name)
+		for _, token in LOWER_NAME_TOKENS do
+			if string.find(lowered, token, 1, true) then
+				table.insert(result, path)
+				break
+			end
+		end
+	end
+	table.sort(result)
+	return result
+end
+
+
+local function parentBonePath(pathMap: { [string]: Bone }, bone: Bone, visual: Model): string?
+	local parent = bone.Parent
+	if parent and parent:IsA("Bone") then
+		local path = bonePath(parent, visual)
+		if pathMap[path] then
+			return path
+		end
+	end
+	return nil
+end
+
+function ActorSkeletonMap.ResolveIndependentLowerBodyRoots(visual: Model, lowerPaths: { string }): { string }
+	local pathMap = ActorSkeletonMap.BuildBonePathMap(visual)
+	local selected = {}
+	for _, path in lowerPaths do
+		if pathMap[path] then
+			selected[path] = true
+		end
+	end
+
+	local childrenByPath = {}
+	for path in pathMap do
+		childrenByPath[path] = {}
+	end
+	for path, bone in pathMap do
+		local parentPath = parentBonePath(pathMap, bone, visual)
+		if parentPath then
+			table.insert(childrenByPath[parentPath], path)
+		end
+	end
+
+	local pureMemo = {}
+	local function isIndependentLowerSubtree(path: string): boolean
+		local cached = pureMemo[path]
+		if cached ~= nil then
+			return cached
+		end
+		if not selected[path] then
+			pureMemo[path] = false
+			return false
+		end
+		for _, childPath in childrenByPath[path] or {} do
+			if not isIndependentLowerSubtree(childPath) then
+				pureMemo[path] = false
+				return false
+			end
+		end
+		pureMemo[path] = true
+		return true
+	end
+
+	local result = {}
+	for path, bone in pathMap do
+		if isIndependentLowerSubtree(path) then
+			local parentPath = parentBonePath(pathMap, bone, visual)
+			if not parentPath or not isIndependentLowerSubtree(parentPath) then
+				table.insert(result, path)
+			end
+		end
+	end
+	table.sort(result)
+	return result
+end
+
+function ActorSkeletonMap.ResolveLowerBodyPaths(visual: Model): { string }
+	local pathMap = ActorSkeletonMap.BuildBonePathMap(visual)
+	local boneCount = 0
+	local childrenByPath = {}
+	for path, bone in pathMap do
+		boneCount += 1
+		childrenByPath[path] = childrenByPath[path] or {}
+		local parent = bone.Parent
+		if parent and parent:IsA("Bone") then
+			local parentPath = bonePath(parent, visual)
+			childrenByPath[parentPath] = childrenByPath[parentPath] or {}
+			table.insert(childrenByPath[parentPath], path)
+		end
+	end
+	if boneCount == 0 then
+		return {}
+	end
+
+	local boundsCFrame, boundsSize = visual:GetBoundingBox()
+	local minimumY = boundsCFrame.Position.Y - boundsSize.Y * 0.5
+	local bandTop = minimumY + boundsSize.Y * Config.BottomLeafBandFraction
+	local lowLeaves = {}
+	for path, bone in pathMap do
+		if #(childrenByPath[path] or {}) == 0 and bone.TransformedWorldCFrame.Position.Y <= bandTop then
+			table.insert(lowLeaves, path)
+		end
+	end
+
+	if #lowLeaves < 2 then
+		return fallbackLowerPaths(pathMap)
+	end
+	local lca = commonAncestorPath(lowLeaves)
+	if not lca or not pathMap[lca] then
+		return fallbackLowerPaths(pathMap)
+	end
+
+	local branchRoots = {}
+	local lcaDepth = #string.split(lca, "/")
+	for _, leafPath in lowLeaves do
+		local segments = string.split(leafPath, "/")
+		if #segments > lcaDepth then
+			local root = table.concat(segments, "/", 1, lcaDepth + 1)
+			branchRoots[root] = true
+		end
+	end
+
+	local selected = {}
+	for path in pathMap do
+		for branchRoot in branchRoots do
+			if path == branchRoot or string.sub(path, 1, #branchRoot + 1) == branchRoot .. "/" then
+				selected[path] = true
+				break
+			end
+		end
+	end
+
+	local lcaName = string.lower(pathMap[lca].Name)
+	if string.find(lcaName, "pelvis", 1, true) or string.find(lcaName, "hip", 1, true) then
+		selected[lca] = true
+	end
+
+	local result = {}
+	for path in selected do
+		table.insert(result, path)
+	end
+	if #result == 0 or #result > math.floor(boneCount * Config.MaxLowerBodyFraction) then
+		return fallbackLowerPaths(pathMap)
+	end
+	table.sort(result)
+	return result
+end
+
+return table.freeze(ActorSkeletonMap)
diff --git a/src/client/actor/NpcAttackLocomotionController.luau b/src/client/actor/NpcAttackLocomotionController.luau
new file mode 100644
--- /dev/null
+++ b/src/client/actor/NpcAttackLocomotionController.luau
@@ -0,0 +1,191 @@
+-- NPC client compositor: same lower-body attack locomotion as monsters,
+-- but with the weapon-type movement policy supplied by the server.
+-- No hit, pathfinding or animation-state authority on the client.
+local RunService = game:GetService("RunService")
+local Workspace = game:GetService("Workspace")
+local Config = require(script.Parent:WaitForChild("ActorAnimationCompositionConfig"))
+local Skeleton = require(script.Parent:WaitForChild("ActorSkeletonMap"))
+local Sampler = require(script.Parent:WaitForChild("ActorLocomotionSampler"))
+local LowerBodyPose = require(script.Parent:WaitForChild("ActorLowerBodyPose"))
+
+local Controller = {}
+local started = false
+local entries = {}
+local active = {}
+local recycled = {}
+local serial = 0
+local lastCleanup = 0
+local warned = {}
+
+local function warnOnce(key: string, message: string)
+    if warned[key] then return end
+    warned[key] = true
+    warn("[game1][npc-locomotion] " .. message)
+end
+
+local function release(entry)
+    if not entry.sampler then return end
+    entry.sampler.users = math.max(0, entry.sampler.users - 1)
+    entry.sampler:Touch()
+    entry.sampler = nil
+end
+
+local function unbind(model: Model)
+    local entry = entries[model]
+    if not entry then return end
+    for _, conn in ipairs(entry.connections) do conn:Disconnect() end
+    release(entry)
+    entries[model] = nil
+    active[entry] = nil
+end
+
+local function acquire(entry): boolean
+    if entry.sampler then return true end
+    local animationId = tostring(entry.model:GetAttribute("NpcAttackPursuitAnimationId") or "")
+    if not animationId:match("^%d+$") or animationId == "0" then return false end
+    local key = tostring(entry.model:GetAttribute("NpcSlug")) .. "|" .. animationId
+    local sampler
+    for _, candidate in pairs(recycled) do
+        if candidate.baseKey == key and candidate.users == 0 then
+            sampler = candidate
+            break
+        end
+    end
+    local phase = tonumber(entry.model:GetAttribute("NpcAttackPursuitPhase")) or 0
+    local speed = tonumber(entry.model:GetAttribute("NpcAttackPursuitPlaybackSpeed")) or 1
+    if not sampler then
+        local created, err = Sampler.new(entry.visual, animationId, speed, phase)
+        if not created then
+            warnOnce(key, tostring(err or "cannot sample locomotion"))
+            return false
+        end
+        sampler = created
+        sampler.baseKey = key
+        serial += 1
+        recycled[key .. "#" .. tostring(serial)] = sampler
+    else
+        sampler:SetPhase(phase)
+        sampler:SetPlaybackSpeed(speed)
+    end
+    sampler.users = 1
+    sampler:Touch()
+    entry.sampler = sampler
+    return true
+end
+
+local function bind(model: Model)
+    if entries[model] or model:GetAttribute("Game1NpcRuntime") ~= true then return end
+    local visual = model:FindFirstChild("ImportedRig") or model
+    local root = model:FindFirstChild("HumanoidRootPart")
+    if not visual:IsA("Model") or not root or not root:IsA("BasePart") then return end
+    local lower = Skeleton.ResolveLowerBodyPaths(visual)
+    if #lower == 0 then return end
+    local entry = {
+        model = model, visual = visual, root = root,
+        targetBones = Skeleton.BuildBonePathMap(visual),
+        lowerPaths = lower,
+        lowerRootPaths = Skeleton.ResolveIndependentLowerBodyRoots(visual, lower),
+        visualRootOffsetRotation = root.CFrame:ToObjectSpace(visual:GetPivot()).Rotation,
+        weight = 0, sampler = nil, connections = {},
+    }
+    entries[model] = entry
+    table.insert(entry.connections, model:GetAttributeChangedSignal("NpcAttackPursuitActive"):Connect(function()
+        if model:GetAttribute("NpcAttackPursuitActive") == true then active[entry] = true end
+    end))
+    table.insert(entry.connections, model:GetAttributeChangedSignal("NpcAttackPursuitPlaybackSpeed"):Connect(function()
+        if entry.sampler then
