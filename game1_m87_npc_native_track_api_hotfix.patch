@@ -0,0 +1,52 @@
+"""M87: prevent stale NPC animation-track API calls after playback refactors.
+
+M81 removed per-frame seam servicing, but the NPC state machine kept calling
+Tracks.Step() from PreAnimation. That caused a runtime nil-call as soon as a
+NPC entered combat or returned home. Catch this kind of public-contract drift.
+"""
+
+import re
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+NPC = ROOT / "src" / "server" / "npc"
+
+
+class NpcAnimationTrackApiTests(unittest.TestCase):
+    def test_all_npc_track_adapter_calls_resolve_to_public_methods(self):
+        adapter = (NPC / "NpcAnimationTracks.luau").read_text(encoding="utf-8")
+        methods = set(re.findall(r"function\s+NpcAnimationTracks\.(\w+)\s*\(", adapter))
+        self.assertTrue({"Load", "Play", "Stop", "PublishedRows", "SecondsRemaining"} <= methods)
+        for path in sorted(NPC.glob("*.luau")):
+            if path.name == "NpcAnimationTracks.luau":
+                continue
+            body = path.read_text(encoding="utf-8")
+            if not re.search(r"local\s+Tracks\s*=\s*require\(", body):
+                continue
+            invoked = set(re.findall(r"\bTracks\.(\w+)\s*\(", body))
+            self.assertFalse(invoked - methods, f"{path.name}: missing API {invoked - methods}")
+
+    def test_native_tracks_do_not_need_per_frame_seam_servicing(self):
+        presentation = (NPC / "NpcAnimationService.luau").read_text(encoding="utf-8")
+        self.assertNotIn("Tracks.Step(", presentation)
+        self.assertIn("idle:Step(delta)", presentation)
+        self.assertIn("DeathAnimationPolicy.LatchVisibleTerminalPose(death, delta)", presentation)
+        self.assertIn("RunService.PreAnimation:Connect", (NPC / "NpcSpawnerService.luau").read_text(encoding="utf-8"))
+
+    def test_peaceful_idle_cannot_select_combat_idle(self):
+        service = (NPC / "NpcAnimationService.luau").read_text(encoding="utf-8")
+        idle = (NPC / "NpcIdlePresentation.luau").read_text(encoding="utf-8")
+        self.assertIn('Tracks.PublishedRows(profile, "idle", weaponSet)', idle)
+        self.assertIn('return Tracks.PublishedRows(profile, slot, weaponSet)[1]', service)
+        self.assertIn('first("combat_idle")', service)
+        self.assertIn('local combatActive = false', service)
+        peaceful = service.split('        else\n            attacking = false', 1)[1].split('    end\n\n    local function setCombatActive', 1)[0]
+        self.assertIn('idle:Start(true)', peaceful)
+        self.assertNotIn('Tracks.Play(entity, combatIdle', peaceful)
+        combat = service.split('elseif combatActive then', 1)[1].split('        else\n            attacking = false', 1)[0]
+        self.assertIn('Tracks.Play(entity, combatIdle, "combat_idle")', combat)
+
+
+if __name__ == "__main__":
+    unittest.main()
