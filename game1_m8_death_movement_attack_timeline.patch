+    track:Play(0, 1, 1)
+    track.TimePosition = 0
+    track:AdjustWeight(1, 0)
+    startedAt[track] = os.clock()
+end
+
+local function holdTerminalPose(track: AnimationTrack, terminalTime: number)
+    track.Looped = true
+    if not track.IsPlaying then
+        track:Play(0, 1, 1)
+    end
+    track.TimePosition = terminalTime
+    track:AdjustWeight(1, 0)
+    track:AdjustSpeed(0)
 end
 
