diff --git a/src/server/weapon/WeaponEquipService.luau b/src/server/weapon/WeaponEquipService.luau
index ba75cd2..f552ed8 100644
--- a/src/server/weapon/WeaponEquipService.luau
+++ b/src/server/weapon/WeaponEquipService.luau
@@ -52,18 +52,43 @@ local function findWeaponGrip(model: Model): Attachment?
     return if found and found:IsA("Attachment") then found else nil
 end
 
+local function canonicalizeWeaponGrip(grip: Attachment)
+    local parent = grip.Parent
+    if not parent or not parent:IsA("BasePart") then
+        return
+    end
+
+    -- Older Studio-sync revisions could persist a per-weapon grip rotation. Strip
+    -- that rotation on the runtime clone before the first alignment while keeping
+    -- the exact grip point. The resulting Attachment has canonical world axes in
+    -- the untouched template pose and then behaves as a normal rigid frame.
+    local gripPosition = grip.WorldPosition
+    grip.CFrame = parent.CFrame:ToObjectSpace(CFrame.new(gripPosition))
+    grip:SetAttribute("RotationX", nil)
+    grip:SetAttribute("RotationY", nil)
+    grip:SetAttribute("RotationZ", nil)
+end
+
+local function targetSocketCFrame(targetBone: Bone): CFrame
+    local parent = targetBone.Parent
+    if parent and parent:IsA("Bone") then
+        return parent.TransformedWorldCFrame * targetBone.CFrame
+    end
+    return targetBone.WorldCFrame
+end
+
 local function alignWeaponToSocket(weapon: Model, socketFrame: CFrame)
     local grip = findWeaponGrip(weapon)
     if grip then
-        -- Grip orientation is intentionally ignored. The attachment persists the
-        -- grip point only; every weapon uses the same global Studio/runtime basis.
-        local gripPointFrame = CFrame.new(grip.WorldPosition)
-        local delta = socketFrame * gripPointFrame:Inverse()
+        canonicalizeWeaponGrip(grip)
+        -- Solve an absolute rigid delta from the CURRENT full grip frame to the
+        -- desired socket frame. This is idempotent: once aligned, delta is identity
+        -- until the animated socket moves, so rotation can never accumulate.
+        local delta = socketFrame * grip.WorldCFrame:Inverse()
         weapon:PivotTo(delta * weapon:GetPivot())
         return
     end
-    -- Compatibility for old Studio templates. Re-syncing the weapon creates the
-    -- replicated grip attachment and removes this Model-pivot dependency.
+    -- Compatibility for old Studio templates without the replicated grip.
     weapon:PivotTo(socketFrame)
 end
 
