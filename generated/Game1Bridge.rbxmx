      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">DecoAssetLoader</string>
          <string name="Source"><![CDATA[local StudioTextureAppearance = require(script.Parent.StudioTextureAppearance)
local DecoAssetLoader = {}
DecoAssetLoader.__index = DecoAssetLoader

local function canonicalModel(loaded: Instance): Model
    local imported: Instance = loaded
    local children = loaded:GetChildren()
    if loaded:IsA("Model") and #children == 1 then
        imported = children[1]
        imported.Parent = nil
        loaded:Destroy()
    end
    if imported:IsA("Model") then
        return imported
    end
    local model = Instance.new("Model")
    model.Name = "ImportedDeco"
    imported.Parent = model
    return model
end

local function sanitize(model: Model)
    -- Location assets are static decoration. Animation runtime objects and the
    -- importer-generated InitialPoses cache are not part of the authored asset
    -- and make transient placement clones unnecessarily fragile. Keep Bones,
    -- because a skinned MeshPart can still need its bind skeleton for rendering.
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("AnimationController") or descendant:IsA("Animator") then
            descendant:Destroy()
        elseif descendant:IsA("Folder") and descendant.Name == "InitialPoses" then
            descendant:Destroy()
        elseif descendant:IsA("BasePart") then
            descendant.Anchored = true
            descendant.CanTouch = false
        end
    end
end

local function applyTexture(model: Model, textureAssetId: string, usesAlpha: any)
    local numericId = tonumber(textureAssetId)
    if numericId == nil or numericId <= 0 then
        return 0
    end
    local uri = "rbxassetid://" .. tostring(math.floor(numericId))
    local applied = 0
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("MeshPart") then
            StudioTextureAppearance.Apply(descendant, uri, usesAlpha)
            applied += 1
        end
    end
    return applied
end

function DecoAssetLoader.new(config: any)
    return setmetatable({
        HttpService = config.HttpService,
        AssetService = config.AssetService,
        agentBaseUrl = config.agentBaseUrl,
        agentToken = config.agentToken,
    }, DecoAssetLoader)
end

function DecoAssetLoader:fetchRegistry(): any
    local response = self.HttpService:RequestAsync({
        Url = self.agentBaseUrl .. "/api/location-assets",
        Method = "GET",
        Headers = { ["X-Control-Token"] = self.agentToken },
    })
    if not response.Success then
        error(("Location Assets registry HTTP %d: %s"):format(response.StatusCode, response.Body))
    end
    local decoded = self.HttpService:JSONDecode(response.Body)
    if type(decoded) ~= "table" or type(decoded.items) ~= "table" then
        error("Location Assets registry returned an invalid payload")
    end
    return decoded
end

function DecoAssetLoader:loadPublished(row: any): Model
    if type(row) ~= "table" or tostring(row.status or "") ~= "PUBLISHED" then
        error("DecoManager can load only PUBLISHED location assets")
    end
    local assetId = tonumber(row.model_asset_id)
    if assetId == nil or assetId <= 0 then
        error("selected location asset has no published model Asset ID")
    end

    local loaded: Instance? = nil
    local lastError = ""
    for _ = 1, 6 do
        local ok, value = pcall(function()
            return self.AssetService:LoadAssetAsync(assetId)
        end)
        if ok and value ~= nil then
            loaded = value
            break
        end
        lastError = tostring(value)
        task.wait(0.4)
    end
    if loaded == nil then
        error("could not load location asset " .. tostring(assetId) .. ": " .. lastError)
    end

    local model = canonicalModel(loaded)
    model.Name = tostring(row.slug or "deco_asset")
    sanitize(model)
    applyTexture(model, tostring(row.texture_asset_id or ""), row.textureUsesAlpha)
    return model
end

return DecoAssetLoader
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">DecoAssetPreparation</string>
          <string name="Source"><![CDATA[-- Applied only to initial decoration placement. Studio Sync never changes
-- physical-part policy or replaces already placed geometry.
local DecoAssetPreparation = {}

function DecoAssetPreparation.PreparePlaced(model: Model)
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            -- The placement ghost is anchored; placed decorations are not.
            -- Collision and query properties remain authored by the model.
            descendant.Anchored = false
            descendant.CanTouch = false
        end
    end
end

return table.freeze(DecoAssetPreparation)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">DecoManager</string>
          <string name="Source"><![CDATA[local DecoAssetLoader = require(script.Parent.DecoAssetLoader)
local DecoPlacement = require(script.Parent.DecoPlacement)
local DecoTransform = require(script.Parent.DecoTransform)
local DecoPlacedAssetSync = require(script.Parent.DecoPlacedAssetSync)

local DecoManager = {}
DecoManager.__index = DecoManager

local CATEGORY_ORDER = { "tree", "bush", "rock", "light", "fence", "decoration", "ladder", "flower", "building", "prop" }
local CATEGORY_LABELS = {
    tree = "Trees",
    bush = "Bushes",
    rock = "Rocks",
    light = "Lights",
    fence = "Fences",
    decoration = "Decorations",
    ladder = "Ladders",
    flower = "Flowers",
    building = "Buildings",
    prop = "Props",
}

local function newLabel(parent: Instance, text: string, size: UDim2, position: UDim2, textSize: number, bold: boolean?): TextLabel
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(232, 239, 244)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Font = if bold then Enum.Font.GothamBold else Enum.Font.Gotham
    label.TextSize = textSize
    label.Text = text
    label.Size = size
    label.Position = position
    label.Parent = parent
    return label
end

local function newButton(parent: Instance, text: string, size: UDim2, position: UDim2): TextButton
    local button = Instance.new("TextButton")
    button.AutoButtonColor = true
    button.BackgroundColor3 = Color3.fromRGB(37, 45, 55)
    button.BorderSizePixel = 0
    button.TextColor3 = Color3.fromRGB(232, 239, 244)
    button.Font = Enum.Font.GothamSemibold
    button.TextSize = 13
    button.Text = text
    button.Size = size
    button.Position = position
    button.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = button
    return button
end

local function prepareViewportModel(model: Model)
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.Anchored = true
            descendant.CanCollide = false
            descendant.CanTouch = false
            descendant.CanQuery = false
        end
    end
end

function DecoManager.new(config: any)
    local self = setmetatable({}, DecoManager)
    self.plugin = config.plugin
    self.toolbar = config.toolbar
    self.HttpService = config.HttpService
    self.AssetService = config.AssetService
    self.Workspace = config.Workspace
    self.ServerStorage = config.ServerStorage
    self.ChangeHistoryService = config.ChangeHistoryService
    self.UserInputService = config.UserInputService
    self.registry = nil
    self.category = "tree"
    self.index = 1
    self.currentRow = nil
    self.template = nil
    self.preview = nil
    self.loader = DecoAssetLoader.new({
        HttpService = self.HttpService,
        AssetService = self.AssetService,
        agentBaseUrl = config.agentBaseUrl,
        agentToken = config.agentToken,
    })
    self.placement = DecoPlacement.new({
        plugin = self.plugin,
        Workspace = self.Workspace,
        HttpService = self.HttpService,
        ChangeHistoryService = self.ChangeHistoryService,
    })
    self.agentBaseUrl = config.agentBaseUrl
    self.agentToken = config.agentToken
    self:_buildUI()
    self:_wire()
    return self
end

function DecoManager:_buildUI()
    local info = DockWidgetPluginGuiInfo.new(
        Enum.InitialDockState.Right,
        false,
        false,
        390,
        720,
        330,
        690
    )
    self.widget = self.plugin:CreateDockWidgetPluginGui("Game1DecoManager_v1", info)
    self.widget.Title = "game1 · DecoManager"

    local root = Instance.new("Frame")
    root.BackgroundColor3 = Color3.fromRGB(17, 24, 33)
    root.BorderSizePixel = 0
    root.Size = UDim2.fromScale(1, 1)
    root.Parent = self.widget

    newLabel(root, "DECOMANAGER", UDim2.new(1, -24, 0, 22), UDim2.new(0, 12, 0, 10), 11, true).TextColor3 = Color3.fromRGB(66, 214, 177)
    self.title = newLabel(root, "Location assets", UDim2.new(1, -24, 0, 28), UDim2.new(0, 12, 0, 31), 18, true)

    local categoryHost = Instance.new("Frame")
    categoryHost.BackgroundTransparency = 1
    categoryHost.Size = UDim2.new(1, -24, 0, 106)
    categoryHost.Position = UDim2.new(0, 12, 0, 68)
    categoryHost.Parent = root
    self.categoryButtons = {}
    for index, category in ipairs(CATEGORY_ORDER) do
        local column = (index - 1) % 4
        local row = math.floor((index - 1) / 4)
        local button = newButton(categoryHost, CATEGORY_LABELS[category], UDim2.new(1 / 4, -5, 0, 32), UDim2.new(column / 4, 0, 0, row * 36))
        button.TextSize = 11
        self.categoryButtons[category] = button
    end

    local navHost = Instance.new("Frame")
    navHost.BackgroundTransparency = 1
    navHost.Size = UDim2.new(1, -24, 0, 40)
    navHost.Position = UDim2.new(0, 12, 0, 181)
    navHost.Parent = root
    self.previous = newButton(navHost, "‹", UDim2.new(0, 44, 1, 0), UDim2.new(0, 0, 0, 0))
    self.next = newButton(navHost, "›", UDim2.new(0, 44, 1, 0), UDim2.new(1, -44, 0, 0))
    self.counter = newLabel(navHost, "0 / 0", UDim2.new(1, -100, 1, 0), UDim2.new(0, 50, 0, 0), 12, false)
    self.counter.TextXAlignment = Enum.TextXAlignment.Center

    self.viewport = Instance.new("ViewportFrame")
    self.viewport.BackgroundColor3 = Color3.fromRGB(11, 16, 22)
    self.viewport.BorderSizePixel = 0
    self.viewport.Size = UDim2.new(1, -24, 0, 276)
    self.viewport.Position = UDim2.new(0, 12, 0, 229)
    self.viewport.Ambient = Color3.fromRGB(180, 180, 180)
    self.viewport.LightColor = Color3.fromRGB(255, 255, 255)
    self.viewport.LightDirection = Vector3.new(-1, -1, -1)
    self.viewport.Parent = root
    local viewportCorner = Instance.new("UICorner")
    viewportCorner.CornerRadius = UDim.new(0, 8)
    viewportCorner.Parent = self.viewport
    self.world = Instance.new("WorldModel")
    self.world.Name = "DecoPreviewWorld"
    self.world.Parent = self.viewport
    self.camera = Instance.new("Camera")
    self.camera.Name = "DecoPreviewCamera"
    self.camera.FieldOfView = 35
    self.camera.Parent = self.viewport
    self.viewport.CurrentCamera = self.camera
    self.empty = newLabel(self.viewport, "No published assets in this category", UDim2.new(1, -28, 0, 30), UDim2.new(0, 14, 0.5, -15), 12, false)
    self.empty.TextColor3 = Color3.fromRGB(143, 161, 173)
    self.empty.TextXAlignment = Enum.TextXAlignment.Center
    self.cameraTarget = Vector3.zero
    self.cameraDistance = 8
    self.cameraMinDistance = 1
    self.cameraMaxDistance = 40
    self.cameraYaw = math.rad(35)
    self.cameraPitch = math.rad(18)
    self.previewDragging = false

    self.assetName = newLabel(root, "—", UDim2.new(1, -24, 0, 24), UDim2.new(0, 12, 0, 514), 14, true)
    self.assetMeta = newLabel(root, "published registry", UDim2.new(1, -24, 0, 20), UDim2.new(0, 12, 0, 538), 10, false)
    self.assetMeta.TextColor3 = Color3.fromRGB(143, 161, 173)

    self.place = newButton(root, "Place", UDim2.new(0.5, -17, 0, 38), UDim2.new(0, 12, 0, 568))
    self.place.BackgroundColor3 = Color3.fromRGB(66, 214, 177)
    self.place.TextColor3 = Color3.fromRGB(6, 39, 31)
    self.save = newButton(root, "Save Assets Data", UDim2.new(0.5, -17, 0, 38), UDim2.new(0.5, 5, 0, 568))
    self.refresh = newButton(root, "Refresh registry", UDim2.new(1, -24, 0, 32), UDim2.new(0, 12, 0, 614))
    self.status = newLabel(root, "Open DecoManager to load published assets.", UDim2.new(1, -24, 0, 38), UDim2.new(0, 12, 0, 650), 10, false)
    self.status.TextColor3 = Color3.fromRGB(143, 161, 173)
    self.status.TextWrapped = true

    self.widget:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        -- Dock widgets can be shorter than the preferred height. Keep the status visible at the bottom.
        local height = self.widget.AbsoluteSize.Y
        if height > 0 then
            self.status.Position = UDim2.new(0, 12, 1, -42)
        end
    end)
end

function DecoManager:_rows(): { any }
    local rows = {}
    if self.registry and type(self.registry.items) == "table" then
        for _, row in ipairs(self.registry.items) do
            if tostring(row.category or "") == self.category and tostring(row.status or "") == "PUBLISHED" then
                if tonumber(row.model_asset_id) and tonumber(row.texture_asset_id) then
                    table.insert(rows, row)
                end
            end
        end
    end
    table.sort(rows, function(left, right)
        return tostring(left.name_en or left.slug) < tostring(right.name_en or right.slug)
    end)
    return rows
end

function DecoManager:_setStatus(message: string)
    self.status.Text = message
end

function DecoManager:_clearPreview()
    if self.preview then
        self.preview:Destroy()
        self.preview = nil
    end
    if self.template then
        self.template:Destroy()
        self.template = nil
    end
    for _, child in ipairs(self.world:GetChildren()) do
        child:Destroy()
    end
    self.currentRow = nil
    self.empty.Visible = true
    self.assetName.Text = "—"
    self.assetMeta.Text = CATEGORY_LABELS[self.category]
    self.place.Active = false
    self.place.AutoButtonColor = false
    self.place.BackgroundColor3 = Color3.fromRGB(49, 57, 67)
    self.place.TextColor3 = Color3.fromRGB(143, 161, 173)
end

function DecoManager:_updatePreviewCamera()
    self.cameraDistance = math.clamp(self.cameraDistance, self.cameraMinDistance, self.cameraMaxDistance)
    self.cameraPitch = math.clamp(self.cameraPitch, math.rad(-70), math.rad(70))
    local cosPitch = math.cos(self.cameraPitch)
    local offset = Vector3.new(
        math.sin(self.cameraYaw) * cosPitch,
        math.sin(self.cameraPitch),
        math.cos(self.cameraYaw) * cosPitch
    ) * self.cameraDistance
    self.camera.CFrame = CFrame.lookAt(self.cameraTarget + offset, self.cameraTarget, Vector3.yAxis)
end

function DecoManager:_framePreview(model: Model)
    model:PivotTo(DecoTransform.previewPivot(model))
    local boundsCFrame, boundsSize = model:GetBoundingBox()
    local radius = math.max(boundsSize.X, boundsSize.Y, boundsSize.Z, 1)
    self.cameraTarget = boundsCFrame.Position
    self.cameraMinDistance = math.max(radius * 0.55, 0.75)
    self.cameraMaxDistance = math.max(radius * 5, self.cameraMinDistance + 1)
    self.cameraDistance = math.clamp(radius * 1.9, self.cameraMinDistance, self.cameraMaxDistance)
    self.cameraYaw = math.rad(35)
    self.cameraPitch = math.rad(15)
    self:_updatePreviewCamera()
end

function DecoManager:_showCurrent()
    self.placement:cancel()
    local rows = self:_rows()
    if #rows == 0 then
        self.index = 1
        self.counter.Text = "0 / 0"
        self:_clearPreview()
        self:_setStatus("No published " .. string.lower(CATEGORY_LABELS[self.category]) .. ". Publish one in Asset Manager.")
        return
    end
    self.index = math.clamp(self.index, 1, #rows)
    local row = rows[self.index]
    self.counter.Text = tostring(self.index) .. " / " .. tostring(#rows)
    self:_clearPreview()
    self:_setStatus("Loading " .. tostring(row.name_en or row.slug) .. "…")
    local ok, result = pcall(function()
        return self.loader:loadPublished(row)
    end)
    if not ok then
        self:_setStatus("Preview failed · " .. tostring(result))
        warn("[game1 DecoManager] " .. tostring(result))
        return
    end
    self.template = result
    self.currentRow = row
    self.preview = result:Clone()
    prepareViewportModel(self.preview)
    self.preview.Parent = self.world
    self:_framePreview(self.preview)
    self.empty.Visible = false
    self.assetName.Text = tostring(row.name_en or row.slug)
    self.assetMeta.Text = CATEGORY_LABELS[self.category] .. " · model " .. tostring(row.model_asset_id) .. " · texture " .. tostring(row.texture_asset_id)
    self.place.Active = true
    self.place.AutoButtonColor = true
    self.place.BackgroundColor3 = Color3.fromRGB(66, 214, 177)
    self.place.TextColor3 = Color3.fromRGB(6, 39, 31)
    self:_setStatus("Ready · Place starts surface-snapped placement in the 3D viewport.")
end

function DecoManager:_setCategory(category: string)
    if CATEGORY_LABELS[category] == nil then
        return
    end
    self.category = category
    self.index = 1
    for key, button in pairs(self.categoryButtons) do
        button.BackgroundColor3 = if key == category then Color3.fromRGB(49, 112, 96) else Color3.fromRGB(37, 45, 55)
    end
    self:_showCurrent()
end

function DecoManager:refreshRegistry(targetSlug: string?, applyIds: boolean?, expectedModelId: string?, expectedAtlasId: string?)
    self:_setStatus("Refreshing Location Assets registry…")
    local ok, result = pcall(function()
        return self.loader:fetchRegistry()
    end)
    if not ok then
        self.registry = nil
        self:_clearPreview()
        self:_setStatus("Asset Manager unavailable · " .. tostring(result))
        return nil, tostring(result)
    end
    self.registry = result
    -- Catalog browsing never alters any placed Model. Explicit Studio Sync
    -- requires exactly one slug and two publication IDs verified by the plugin.
    local syncResult = { models = 0, parts = 0, matchedModels = 0,
        modelReferences = 0, pendingGeometry = 0, geometryUpdated = 0,
        meshPartsUpdated = 0, replacedModels = 0,
        changes = {}, instances = {} }
    if applyIds == true then
        if not targetSlug or not expectedModelId or not expectedAtlasId then
            error("scoped Model + Atlas Studio Sync requires an explicit slug and published IDs")
        end
        -- A waypoint BEFORE the update makes Undo possible even for an error.
        self.ChangeHistoryService:SetWaypoint("Before Location Asset Model + Atlas Sync: " .. targetSlug)
        syncResult = DecoPlacedAssetSync.RefreshIds(
            self.Workspace, result, targetSlug, self.HttpService, expectedModelId, expectedAtlasId, self.loader)
        self.ChangeHistoryService:SetWaypoint("Location Asset Model + Atlas Sync: " .. targetSlug)
    end
    self:_setCategory(self.category)
    self:_setStatus(("Registry refreshed · %d placed, %d atlas IDs, %d updated meshes, %d model references, %d stale FBX"):format(
        syncResult.matchedModels, syncResult.parts, syncResult.meshPartsUpdated,
        syncResult.modelReferences, syncResult.pendingGeometry))
    return { models = syncResult.models, parts = syncResult.parts,
        replacedModels = 0, matchedModels = syncResult.matchedModels,
        modelReferences = syncResult.modelReferences, pendingGeometry = syncResult.pendingGeometry,
        geometryUpdated = syncResult.geometryUpdated, meshPartsUpdated = syncResult.meshPartsUpdated,
        changes = syncResult.changes, instances = syncResult.instances,
        registryItems = #result.items }
end

function DecoManager:_placeCurrent()
    if self.template == nil or self.currentRow == nil then
        return
    end
    self.placement:start(self.template, self.currentRow, function(message)
        self:_setStatus(message)
    end)
end

function DecoManager:_postLayout(records: { any }): any
    local response = self.HttpService:RequestAsync({
        Url = self.agentBaseUrl .. "/api/location-assets/layout",
        Method = "POST",
        Headers = {
            ["X-Control-Token"] = self.agentToken,
            ["Content-Type"] = "application/json",
        },
        Body = self.HttpService:JSONEncode({
            schemaVersion = 1,
            project = "game1",
            placeId = game.PlaceId,
            placeName = game.Name,
            records = records,
        }),
    })
    if not response.Success then
        error(("Asset Manager backup HTTP %d: %s"):format(response.StatusCode, response.Body))
    end
    return self.HttpService:JSONDecode(response.Body)
end

function DecoManager:_saveAssetsData()
    self.placement:cancel()
    local records = self.placement:serialize()
    self:_setStatus(("Saving %d placed asset(s)…"):format(#records))
    local ok, backup = pcall(function()
        return self:_postLayout(records)
    end)
    if not ok then
        self:_setStatus("Assets data save failed · " .. tostring(backup))
        warn("[game1 DecoManager] " .. tostring(backup))
        return
    end
    local studioSave = backup.studioSave or {}
    if studioSave.requested == true then
        self:_setStatus(("Saved · %d asset(s) · %s · Studio save requested"):format(#records, tostring(backup.backupPath or "backup")))
    else
        self:_setStatus(("Backup saved (%s), but Studio save was not requested"):format(tostring(backup.backupPath or "backup")))
    end
end

function DecoManager:_wire()
    self.button = self.toolbar:CreateButton(
        "Game1DecoManager",
        "Browse and place published game1 location assets",
        "",
        "DecoManager"
    )
    self.button.ClickableWhenViewportHidden = true
    self.button.Click:Connect(function()
        self.widget.Enabled = not self.widget.Enabled
    end)
    self.widget:GetPropertyChangedSignal("Enabled"):Connect(function()
        self.button:SetActive(self.widget.Enabled)
        if self.widget.Enabled then
            task.defer(function()
                self:refreshRegistry()
            end)
        else
            self.placement:cancel()
        end
    end)
    for category, categoryButton in pairs(self.categoryButtons) do
        categoryButton.MouseButton1Click:Connect(function()
            self:_setCategory(category)
        end)
    end
    self.previous.MouseButton1Click:Connect(function()
        local rows = self:_rows()
        if #rows == 0 then return end
        self.index = ((self.index - 2) % #rows) + 1
        self:_showCurrent()
    end)
    self.next.MouseButton1Click:Connect(function()
        local rows = self:_rows()
        if #rows == 0 then return end
        self.index = (self.index % #rows) + 1
        self:_showCurrent()
    end)
    self.viewport.MouseLeave:Connect(function()
        self.previewDragging = false
    end)
    self.viewport.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and self.preview ~= nil then
            self.previewDragging = true
        end
    end)
    self.viewport.InputChanged:Connect(function(input)
        if self.preview == nil then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement and self.previewDragging then
            self.cameraYaw -= input.Delta.X * 0.010
            self.cameraPitch -= input.Delta.Y * 0.008
            self:_updatePreviewCamera()
        elseif input.UserInputType == Enum.UserInputType.MouseWheel then
            local wheel = input.Position.Z
            if math.abs(wheel) > 0.001 then
                local step = math.max(self.cameraDistance * 0.12, 0.15)
                self.cameraDistance -= wheel * step
                self:_updatePreviewCamera()
            end
        end
    end)
    self.viewport.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self.previewDragging = false
        end
    end)
    self.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self.previewDragging = false
        end
    end)
    self.place.MouseButton1Click:Connect(function()
        self:_placeCurrent()
    end)
    self.refresh.MouseButton1Click:Connect(function()
        self:refreshRegistry()
    end)
    self.save.MouseButton1Click:Connect(function()
        self:_saveAssetsData()
    end)
    self.plugin.Deactivation:Connect(function()
        self.placement:cancel(false)
    end)
    self.plugin.Unloading:Connect(function()
        self.placement:cancel(false)
        self:_clearPreview()
    end)
    self:_setCategory("tree")
end

return DecoManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">DecoPlacedAssetSync</string>
          <string name="Source"><![CDATA[-- Location Assets adapter for the same child-rig replacement transaction used
-- by Real Estate. Only this adapter knows the Location slug, publication and
-- audit attributes; the replacement mechanism has no domain-specific rules.
local StudioTextureAppearance = require(script.Parent.StudioTextureAppearance)
local RigSwap = require(script.Parent.StudioManagedRigSwap)
local Placement = require(script.Parent.DecoAssetPreparation)
local DecoPlacedAssetSync = {}

local SLUG = "Game1DecoAssetSlug"
local INSTANCE = "Game1DecoInstanceId"
local HISTORY = "Game1DecoSyncHistory"
local REFERENCE = "Game1DecoRegistryModelAssetId"

local function id(value: any): string
    local n = tonumber(value)
    if not n or n <= 0 or n ~= math.floor(n) then error("invalid published asset ID") end
    return tostring(math.floor(n))
end

local function rowFor(registry: any, slug: string): any
    if type(registry) ~= "table" or type(registry.items) ~= "table" then
        error("invalid Location Assets registry")
    end
    for _, row in ipairs(registry.items) do
        if tostring(row.slug or "") == slug then
            if row.status ~= "PUBLISHED" then error("Location Asset is not published: " .. slug) end
            return row
        end
    end
    error("Location Asset not registered: " .. slug)
end

local function targets(workspace: Workspace, slug: string): {Model}
    local found = {}
    local authoring = workspace:FindFirstChild("Game1Authoring")
    local camera = workspace.CurrentCamera
    for _, descendant in ipairs(workspace:GetDescendants()) do
        if descendant:IsA("Model") and descendant:GetAttribute(SLUG) == slug
            and tostring(descendant:GetAttribute(INSTANCE) or "") ~= ""
            and (not authoring or not descendant:IsDescendantOf(authoring))
            and (not camera or not descendant:IsDescendantOf(camera)) then
            local ancestor: Instance? = descendant.Parent
            local nested = false
            while ancestor and ancestor ~= workspace do
                if ancestor:IsA("Model") and ancestor:GetAttribute(SLUG) ~= nil then
                    nested = true
                    break
                end
                ancestor = ancestor.Parent
            end
            if not nested then table.insert(found, descendant) end
        end
    end
    return found
end

local function meshParts(model: Model): {MeshPart}
    local parts = {}
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("MeshPart") then table.insert(parts, obj) end
    end
    return parts
end

-- A stable published MeshPart pivot, rather than the import-dependent Model
-- bounding-box pivot, is used exactly like Real Estate's authored house anchor.
-- Accept a unique mesh, or one uniquely matching Name across the revisions.
local function anchors(old: Model, candidate: Model): (MeshPart, MeshPart)
    local before, after = meshParts(old), meshParts(candidate)
    if #before == 1 and #after == 1 then return before[1], after[1] end
    local byName = {}
    for _, part in ipairs(after) do
        if byName[part.Name] then byName[part.Name] = false
        else byName[part.Name] = part end
    end
    local pairsFound = {}
    for _, part in ipairs(before) do
        if byName[part.Name] then
            table.insert(pairsFound, {old = part, new = byName[part.Name]})
        end
    end
    if #pairsFound ~= 1 then
        error("ambiguous Location Asset authoring anchor: unique MeshPart name required")
    end
    return pairsFound[1].old, pairsFound[1].new
end

local function rigChildren(model: Model): {Instance}
    local result = {}
    for _, child in ipairs(model:GetChildren()) do
        if child:IsA("BasePart") then
            table.insert(result, child)
        elseif child:IsA("Model") or child:IsA("Folder") then
            if child:FindFirstChildWhichIsA("BasePart", true) then
                table.insert(result, child)
            end
        end
    end
    if #result == 0 then error("Location Asset contains no managed geometry children") end
    return result
end

function DecoPlacedAssetSync.StampPublishedModel(model: Model, row: any)
    if not model:IsA("Model") or model.Parent ~= nil then
        error("published identity may only be stamped on a fresh placement clone")
    end
    local modelId = id(row.model_asset_id)
    local sha = tostring(row.model_published_sha256 or "")
    if sha == "" then error("Location Asset published SHA is required") end
    model:SetAttribute("Game1DecoPublishedModelAssetId", modelId)
    model:SetAttribute("Game1DecoPublishedModelSha256", sha)
    model:SetAttribute(REFERENCE, modelId)
end

local function oldHistory(model: Model, http: any): {any}
    local encoded = model:GetAttribute(HISTORY)
    if encoded == nil then return {} end
    if type(encoded) ~= "string" then error("invalid Studio asset history") end
    local ok, decoded = pcall(http.JSONDecode, http, encoded)
    if not ok or type(decoded) ~= "table" then error("corrupt Studio asset history") end
    return decoded
end

local function textureId(uri: string): string
    return uri:match("(%d+)$") or ""
end

function DecoPlacedAssetSync.RefreshIds(workspace: Workspace, registry: any, slug: string, http: any,
    expectedModelId: string, expectedAtlasId: string, loader: any): any
    if type(slug) ~= "string" or slug == "" then
        error("one explicitly selected Location Asset slug is required")
    end
    local row = rowFor(registry, slug)
    local modelId, atlasId = id(row.model_asset_id), id(row.texture_asset_id)
    if modelId ~= expectedModelId or atlasId ~= expectedAtlasId then
        error("Location Asset publication changed during Studio Sync; retry")
    end
    local publishedSha = tostring(row.model_published_sha256 or "")
    if publishedSha == "" then error("missing published FBX SHA") end
    local placed = targets(workspace, slug)
    if #placed > 1000 then error("more than 1000 placed instances of one slug") end
    local needsGeometry = false
    for _, model in ipairs(placed) do
        if tostring(model:GetAttribute("Game1DecoPublishedModelSha256") or "") ~= publishedSha then
            needsGeometry = true
            break
        end
    end
    local published: Model? = nil
    if needsGeometry then published = loader:loadPublished(row) end
    local plans = {}
    local staging = {}
    local totalMeshes = 0
    local function disposeStages()
        for _, stage in ipairs(staging) do stage:Destroy() end
        if published then published:Destroy() end
    end
    -- PREPARE EVERY INSTANCE FIRST. A bad skinned rig, anchor, or model layout
    -- must fail before any placed root or texture is modified.
    local prepared, issue = pcall(function()
        for _, model in ipairs(placed) do
            local geometry = tostring(model:GetAttribute("Game1DecoPublishedModelSha256") or "") ~= publishedSha
            local oldId = tostring(model:GetAttribute("Game1DecoPublishedModelAssetId") or "")
            local oldRef = tostring(model:GetAttribute(REFERENCE) or oldId)
            local changeRef = oldRef ~= modelId
            local stage, transaction = nil, nil
            local oldParts = meshParts(model)
            if geometry then
                stage = (published :: Model):Clone()
                table.insert(staging, stage)
                -- Mirror DecoPlacement's authored scale, then align via the
                -- MeshPart's stable Blender-authored pivot (Real Estate method).
                stage:ScaleTo(model:GetScale())
                local existingAnchor, freshAnchor = anchors(model, stage)
                RigSwap.AlignToAnchor(stage, freshAnchor, existingAnchor:GetPivot(), "Location Asset " .. slug)
                Placement.PreparePlaced(stage)
                -- Unowned geometry added directly to a placed root must not be
                -- silently classified as an FBX rig and deleted. Published
                -- direct-child names/classes must match the legacy instance.
                local previousChildren, nextChildren = rigChildren(model), rigChildren(stage)
                if #previousChildren ~= #nextChildren then
                    error("placed/published rig count differs; refusing to remove unknown geometry")
                end
                local nextByName = {}
                for _, child in ipairs(nextChildren) do
                    if nextByName[child.Name] then error("duplicate published rig child " .. child.Name) end
                    nextByName[child.Name] = child
                end
                for _, child in ipairs(previousChildren) do
                    local nextChild = nextByName[child.Name]
                    if not nextChild or child.ClassName ~= nextChild.ClassName then
                        error("unmatched placed rig child " .. child.Name .. "; no Place changed")
                    end
                end
                transaction = RigSwap.Prepare(model, previousChildren, nextChildren)
                totalMeshes += #meshParts(stage)
                if totalMeshes > 4096 then error("more than 4096 MeshParts in scoped Sync") end
            end
            local atlasChanges = {}
            local uri = "rbxassetid://" .. atlasId
            for _, part in ipairs(oldParts) do
                local surface = part:FindFirstChildOfClass("SurfaceAppearance")
                if part.TextureID ~= uri or (surface and surface.ColorMap ~= uri) then
                    local previousUri = if part.TextureID == uri and surface then surface.ColorMap else part.TextureID
                    table.insert(atlasChanges, {part = part, oldId = textureId(previousUri),
                        texture = part.TextureID, surface = surface,
                        colorMap = if surface then surface.ColorMap else nil})
                end
            end
            local events, eventIndex = {}, {}
            local function add(kind: string, oldValue: string, newValue: string, count: number)
                local key = kind .. ":" .. oldValue .. ":" .. newValue
                if not eventIndex[key] then
                    eventIndex[key] = {kind = kind, oldId = oldValue, newId = newValue, count = 0}
                    table.insert(events, eventIndex[key])
                end
                eventIndex[key].count += count
            end
            if geometry then add("model", oldId, modelId, 1) end
            if changeRef then add("model_reference", oldRef, modelId, 1) end
            for _, change in ipairs(atlasChanges) do add("atlas", change.oldId, atlasId, 1) end
            local history = oldHistory(model, http)
            local historyJson = nil
            if #events > 0 then
                table.insert(history, {atUtc = os.time(), slug = slug,
                    instanceId = tostring(model:GetAttribute(INSTANCE) or ""), changes = events})
                while #history > 32 do table.remove(history, 1) end
                historyJson = http:JSONEncode(history)
                if #historyJson > 30000 then error("Studio history exceeded attribute limit") end
            end
            table.insert(plans, {model = model, stage = stage, swap = transaction,
                geometry = geometry, oldId = oldId, oldRef = oldRef,
                changeRef = changeRef, atlasChanges = atlasChanges,
                historyJson = historyJson, oldHistory = model:GetAttribute(HISTORY),
                oldSha = model:GetAttribute("Game1DecoPublishedModelSha256"),
                oldPublishedId = model:GetAttribute("Game1DecoPublishedModelAssetId"),
                oldReference = model:GetAttribute(REFERENCE), events = events})
        end
    end)
    if not prepared then
        disposeStages()
        error("no Place geometry modified; " .. tostring(issue))
    end
    local changedParts, geometryUpdated, changedReferences, changedModels = 0, 0, 0, 0
    local ok, problem = pcall(function()
        for _, item in ipairs(plans) do
            local model = item.model
            if model.Parent == nil or model:GetAttribute(SLUG) ~= slug then
                error("placed Location Asset changed during sync")
            end
            if item.swap then
                RigSwap.Commit(item.swap)
                geometryUpdated += 1
                model:SetAttribute("Game1DecoPublishedModelAssetId", modelId)
                model:SetAttribute("Game1DecoPublishedModelSha256", publishedSha)
            end
            if item.changeRef then
                model:SetAttribute(REFERENCE, modelId)
                changedReferences += 1
            end
            local uri = "rbxassetid://" .. atlasId
            for _, change in ipairs(item.atlasChanges) do
                if item.geometry then
                    -- Source rig is already textured by the central DecoAssetLoader.
                    changedParts += 1
                elseif StudioTextureAppearance.Apply(change.part, uri, nil, true) then
                    changedParts += 1
                end
            end
            if item.historyJson then model:SetAttribute(HISTORY, item.historyJson) end
            if #item.events > 0 then changedModels += 1 end
        end
    end)
    if not ok then
        for index = #plans, 1, -1 do
            local item = plans[index]
            local model = item.model
            pcall(function()
                model:SetAttribute("Game1DecoPublishedModelAssetId", item.oldPublishedId)
                model:SetAttribute("Game1DecoPublishedModelSha256", item.oldSha)
                model:SetAttribute(REFERENCE, item.oldReference)
                model:SetAttribute(HISTORY, item.oldHistory)
                for _, change in ipairs(item.atlasChanges) do
                    if not item.geometry then
                        change.part.TextureID = change.texture
                        if change.surface then change.surface.ColorMap = change.colorMap end
                    end
                end
            end)
            if item.swap then RigSwap.Rollback(item.swap) end
        end
        disposeStages()
        error("Location Asset rig sync failed; all managed child swaps rolled back: " .. tostring(problem))
    end
    for _, item in ipairs(plans) do
        if item.swap then RigSwap.Finalize(item.swap) end
    end
    disposeStages()
    local summary, grouped = {}, {}
    local instances = {}
    for _, item in ipairs(plans) do
        if #item.events > 0 then
            table.insert(instances, {instanceId = tostring(item.model:GetAttribute(INSTANCE) or ""),
                studioPath = item.model:GetFullName(), changes = item.events})
            for _, event in ipairs(item.events) do
                local key = event.kind .. ":" .. event.oldId .. ":" .. event.newId
                if not grouped[key] then
                    grouped[key] = {kind = event.kind, oldId = event.oldId,
                        newId = event.newId, count = 0}
                    table.insert(summary, grouped[key])
                end
                grouped[key].count += event.count
            end
        end
    end
    table.sort(summary, function(a,b) return a.kind .. a.oldId .. a.newId < b.kind .. b.oldId .. b.newId end)
    local pending = 0
    for _, model in ipairs(placed) do
        if tostring(model:GetAttribute("Game1DecoPublishedModelSha256") or "") ~= publishedSha then
            pending += 1
        end
    end
    return {models = changedModels, parts = changedParts, matchedModels = #placed,
        modelReferences = changedReferences, geometryUpdated = geometryUpdated,
        meshPartsUpdated = totalMeshes, pendingGeometry = pending, replacedModels = 0,
        changes = summary, instances = instances}
end

return DecoPlacedAssetSync
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">DecoPlacement</string>
          <string name="Source"><![CDATA[local DecoTransform = require(script.Parent.DecoTransform)
local DecoAssetPreparation = require(script.Parent.DecoAssetPreparation)
local DecoPlacedAssetSync = require(script.Parent.DecoPlacedAssetSync)

local DecoPlacement = {}
DecoPlacement.__index = DecoPlacement

local ROOT_NAME = "Game1DecoAssets"
local CATEGORY_FOLDERS = {
    tree = "Trees",
    bush = "Bushes",
    rock = "Rocks",
    light = "Lights",
    fence = "Fences",
    decoration = "Decorations",
    ladder = "Ladders",
    flower = "Flowers",
    building = "Buildings",
    prop = "Props",
}

local function prepareGhost(model: Model)
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.Anchored = true
            descendant.CanCollide = false
            descendant.CanTouch = false
            descendant.CanQuery = false
            descendant.CastShadow = false
            descendant.Transparency = math.max(descendant.Transparency, 0.45)
        end
    end
end

function DecoPlacement.new(config: any)
    local self = setmetatable({
        plugin = config.plugin,
        Workspace = config.Workspace,
        HttpService = config.HttpService,
        ChangeHistoryService = config.ChangeHistoryService,
        mouse = config.plugin:GetMouse(),
        sourceTemplate = nil,
        row = nil,
        ghost = nil,
        supportOffset = 0,
        authoredPivotRotation = CFrame.identity,
        moveConnection = nil,
        clickConnection = nil,
        statusCallback = nil,
        committing = false,
        ownsPluginMouse = false,
    }, DecoPlacement)
    return self
end

function DecoPlacement:_root(): Folder
    local root = self.Workspace:FindFirstChild(ROOT_NAME)
    if root and not root:IsA("Folder") then
        error("Workspace." .. ROOT_NAME .. " exists but is not a Folder")
    end
    if root == nil then
        root = Instance.new("Folder")
        root.Name = ROOT_NAME
        root.Parent = self.Workspace
    end
    return root :: Folder
end

function DecoPlacement:_categoryFolder(category: string): Folder
    local root = self:_root()
    local name = CATEGORY_FOLDERS[category]
    if name == nil then
        error("unsupported deco category: " .. category)
    end
    local folder = root:FindFirstChild(name)
    if folder and not folder:IsA("Folder") then
        error(root:GetFullName() .. "." .. name .. " exists but is not a Folder")
    end
    if folder == nil then
        folder = Instance.new("Folder")
        folder.Name = name
        folder.Parent = root
    end
    return folder :: Folder
end

function DecoPlacement:_status(message: string)
    if self.statusCallback then
        self.statusCallback(message)
    end
end

function DecoPlacement:_raycast(): RaycastResult?
    local unitRay = self.mouse.UnitRay
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = {}
    if self.ghost ~= nil then
        table.insert(excluded, self.ghost)
    end
    local authoring = self.Workspace:FindFirstChild("Game1Authoring")
    if authoring ~= nil then
        table.insert(excluded, authoring)
    end
    params.FilterDescendantsInstances = excluded
    params.IgnoreWater = false
    return self.Workspace:Raycast(unitRay.Origin, unitRay.Direction * 10000, params)
end

function DecoPlacement:_updateGhost()
    if self.ghost == nil then
        return
    end
    local hit = self:_raycast()
    if hit == nil then
        self:_status("Placement · point at a surface")
        return
    end
    local camera = self.Workspace.CurrentCamera
    local cameraLook = if camera then camera.CFrame.LookVector else Vector3.new(0, 0, -1)
    local normal = if hit.Normal.Magnitude > 0.001 then hit.Normal.Unit else Vector3.yAxis
    local targetPosition = hit.Position + normal * self.supportOffset
    self.ghost:PivotTo(DecoTransform.placementPivot(
        self.authoredPivotRotation,
        targetPosition,
        normal,
        cameraLook
    ))
    self:_status("Placement · click to place on " .. hit.Instance:GetFullName())
end

function DecoPlacement:_detachSession(): Model?
    if self.moveConnection then
        self.moveConnection:Disconnect()
        self.moveConnection = nil
    end
    if self.clickConnection then
        self.clickConnection:Disconnect()
        self.clickConnection = nil
    end
    local ghost = self.ghost
    self.ghost = nil
    self.sourceTemplate = nil
    self.row = nil
    self.supportOffset = 0
    self.authoredPivotRotation = CFrame.identity
    return ghost
end

function DecoPlacement:cancel(releasePluginMouse: boolean?)
    local ghost = self:_detachSession()
    if ghost ~= nil then
        ghost:Destroy()
    end
    self.committing = false
    local shouldDeactivate = self.ownsPluginMouse and releasePluginMouse ~= false
    self.ownsPluginMouse = false
    if shouldDeactivate then
        self.plugin:Deactivate()
    end
end

function DecoPlacement:_commit()
    if self.committing or self.ghost == nil or self.sourceTemplate == nil or self.row == nil then
        return
    end
    self.committing = true

    local ghost = self.ghost
    local sourceTemplate = self.sourceTemplate
    local row = self.row
    local statusCallback = self.statusCallback
    local pivot = ghost:GetPivot()

    local placed = sourceTemplate:Clone()
    DecoAssetPreparation.PreparePlaced(placed)
    DecoPlacedAssetSync.StampPublishedModel(placed, row)
    local instanceId = self.HttpService:GenerateGUID(false)
    placed.Name = tostring(row.slug or "deco") .. "__" .. string.sub(instanceId, 1, 8)
    -- Studio placement stores identity, not gameplay policy. Runtime resolves the
    -- current LocationAssetRegistry definition from this stable asset key.
    placed:SetAttribute("Game1DecoInstanceId", instanceId)
    placed:SetAttribute("Game1DecoAssetSlug", tostring(row.slug or ""))
    placed.Parent = self:_categoryFolder(tostring(row.category or ""))
    placed:PivotTo(pivot)

    -- Detach the session before deactivating the plugin. Deactivation is re-entrant
    -- and must never be able to destroy an instance that the active call still uses.
    local staleGhost = self:_detachSession()
    if staleGhost ~= nil then
        staleGhost:Destroy()
    end
    self.ownsPluginMouse = false
    self.plugin:Deactivate()
    self.ChangeHistoryService:SetWaypoint("Place Deco Asset")

    self.committing = false
    if statusCallback then
        statusCallback("Placed · " .. placed.Name)
    end
end

function DecoPlacement:start(template: Model, row: any, statusCallback: (string) -> ())
    self:cancel()

    -- Activate before creating the new transient session. Studio may fire
    -- Plugin.Deactivation while tool ownership changes; there is nothing fresh to
    -- destroy until Activate has completed.
    self.plugin:Activate(true)
    self.ownsPluginMouse = true

    self.sourceTemplate = template
    self.row = row
    self.statusCallback = statusCallback
    self.supportOffset = DecoTransform.supportOffset(template)
    self.authoredPivotRotation = DecoTransform.authoredPivotRotation(template)

    local ghost = template:Clone()
    ghost.Name = "Game1DecoPlacementGhost"
    prepareGhost(ghost)
    self.ghost = ghost

    -- Keep the placement preview out of the authored Workspace tree and change
    -- history. Camera descendants still render in Studio and use world CFrames.
    local camera = self.Workspace.CurrentCamera
    ghost.Parent = if camera ~= nil then camera else self.Workspace

    self:_updateGhost()
    self.moveConnection = self.mouse.Move:Connect(function()
        self:_updateGhost()
    end)
    self.clickConnection = self.mouse.Button1Down:Connect(function()
        if self:_raycast() ~= nil then
            self:_updateGhost()
            self:_commit()
        end
    end)
end

function DecoPlacement:serialize(): { any }
    local root = self.Workspace:FindFirstChild(ROOT_NAME)
    if root == nil then
        return {}
    end
    local records = {}
    for _, descendant in ipairs(root:GetDescendants()) do
        if descendant:IsA("Model") and tostring(descendant:GetAttribute("Game1DecoAssetSlug") or "") ~= "" then
            local pivot = descendant:GetPivot()
            local cframe = { pivot:GetComponents() }
            local scale = 1
            pcall(function()
                scale = descendant:GetScale()
            end)
            table.insert(records, {
                instanceId = tostring(descendant:GetAttribute("Game1DecoInstanceId") or ""),
                name = descendant.Name,
                locationAssetId = tostring(descendant:GetAttribute("Game1DecoAssetSlug") or ""),
                cframe = cframe,
                scale = scale,
            })
        end
    end
    table.sort(records, function(left, right)
        return tostring(left.instanceId) < tostring(right.instanceId)
    end)
    return records
end

return DecoPlacement
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">DecoTransform</string>
          <string name="Source"><![CDATA[local DecoTransform = {}

local WORLD_UP = Vector3.yAxis

local function rotationOnly(cframe: CFrame): CFrame
    return CFrame.fromMatrix(Vector3.zero, cframe.XVector, cframe.YVector, cframe.ZVector)
end

local function surfaceFrame(normal: Vector3, cameraLook: Vector3): CFrame
    local up = if normal.Magnitude > 0.001 then normal.Unit else WORLD_UP
    local forward = cameraLook - up * cameraLook:Dot(up)
    if forward.Magnitude < 0.01 then
        local fallback = if math.abs(up.Y) < 0.95 then WORLD_UP else Vector3.zAxis
        forward = fallback - up * fallback:Dot(up)
    end
    return CFrame.lookAt(Vector3.zero, forward.Unit, up)
end

function DecoTransform.authoredPivotRotation(model: Model): CFrame
    return rotationOnly(model:GetPivot())
end

function DecoTransform.previewPivot(model: Model): CFrame
    -- Re-center the model without replacing the imported FBX basis. Roblox can
    -- encode FBX axis conversion in the model/part pivot; forcing identity here
    -- makes otherwise-correct Z-up source assets appear rotated in the viewport.
    return DecoTransform.authoredPivotRotation(model)
end

function DecoTransform.supportOffset(model: Model): number
    -- Measure the lowest rendered part point against Roblox world-up in the
    -- asset's authored pose. This is independent of the model pivot's local axes.
    -- The same offset remains valid after surfaceFrame rotates the whole authored
    -- pose from world-up onto the hit normal.
    local pivot = model:GetPivot()
    local minimum = math.huge
    local hasPart = false

    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            hasPart = true
            local half = descendant.Size * 0.5
            for _, x in ipairs({ -1, 1 }) do
                for _, y in ipairs({ -1, 1 }) do
                    for _, z in ipairs({ -1, 1 }) do
                        local point = descendant.CFrame:PointToWorldSpace(Vector3.new(
                            half.X * x,
                            half.Y * y,
                            half.Z * z
                        ))
                        local height = (point - pivot.Position):Dot(WORLD_UP)
                        minimum = math.min(minimum, height)
                    end
                end
            end
        end
    end

    if not hasPart then
        error("location asset model contains no BasePart geometry")
    end
    return math.max(0, -minimum)
end

function DecoTransform.placementPivot(
    authoredPivotRotation: CFrame,
    targetPosition: Vector3,
    surfaceNormal: Vector3,
    cameraLook: Vector3
): CFrame
    -- surfaceFrame is a delta from canonical Roblox world-up to the requested
    -- surface. authoredPivotRotation is multiplied afterwards so importer-authored
    -- FBX basis compensation is preserved instead of overwritten.
    return CFrame.new(targetPosition) * surfaceFrame(surfaceNormal, cameraLook) * authoredPivotRotation
end

return DecoTransform
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">LocationCommands</string>
          <string name="Source"><![CDATA[-- Polygon Location authoring commands for game1 Asset Manager.
return function(Context)
    local HttpService = Context.HttpService
    local Selection = Context.Selection
    local Workspace = Context.Workspace
    local UserInputService = Context.UserInputService
    local BRIDGE_URL = Context.BRIDGE_URL
    local BRIDGE_TOKEN = Context.BRIDGE_TOKEN
    local plugin = Context.plugin

    local AUTHORING_ROOT = "Game1Authoring"
    local LOCATION_FOLDER = "Locations"

    local function postResult(payload: any)
        local response = HttpService:RequestAsync({
            Url = BRIDGE_URL .. "/location-authoring-result",
            Method = "POST",
            Headers = {
                ["X-Game1-Token"] = BRIDGE_TOKEN,
                ["Content-Type"] = "application/json",
            },
            Body = HttpService:JSONEncode(payload),
        })
        if not response.Success then
            error("game1 Location authoring result bridge rejected response: " .. tostring(response.StatusCode))
        end
    end

    local function locationFolder(): Folder
        local root = Workspace:FindFirstChild(AUTHORING_ROOT)
        if root and not root:IsA("Folder") then
            error("Workspace." .. AUTHORING_ROOT .. " exists but is not a Folder")
        end
        if not root then
            root = Instance.new("Folder")
            root.Name = AUTHORING_ROOT
            root:SetAttribute("Game1Authoring", true)
            root.Parent = Workspace
        end
        local folder = root:FindFirstChild(LOCATION_FOLDER)
        if folder and not folder:IsA("Folder") then
            error(root:GetFullName() .. "." .. LOCATION_FOLDER .. " exists but is not a Folder")
        end
        if not folder then
            folder = Instance.new("Folder")
            folder.Name = LOCATION_FOLDER
            folder.Parent = root
        end
        return folder :: Folder
    end

    local function findLocationMarker(locationId: string): Model?
        local root = Workspace:FindFirstChild(AUTHORING_ROOT)
        local folder = root and root:FindFirstChild(LOCATION_FOLDER)
        if not folder then
            return nil
        end
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") and tostring(child:GetAttribute("LocationId") or "") == locationId then
                return child
            end
        end
        return nil
    end

    local function safeName(value: any): string
        local name = tostring(value or "Location"):gsub("[^%w]+", "_"):gsub("^_+", ""):gsub("_+$", "")
        return name ~= "" and name or "Location"
    end

    local function markerName(data: any): string
        local shortId = tostring(data.locationId or "location"):gsub("^location%-", ""):sub(1, 8)
        return string.format("%s_%s", safeName(data.name), shortId)
    end

    local function pointFromData(value: any): Vector3
        if typeof(value) ~= "table" then
            error("Location point is invalid")
        end
        local x = tonumber(value.x)
        local y = tonumber(value.y)
        local z = tonumber(value.z)
        if not x or not y or not z then
            error("Location point coordinates are invalid")
        end
        return Vector3.new(x, y, z)
    end

    local function markerPart(
        parent: Instance,
        name: string,
        size: Vector3,
        cframe: CFrame,
        color: Color3,
        transparency: number
    ): Part
        local item = Instance.new("Part")
        item.Name = name
        item.Anchored = true
        item.CanCollide = false
        item.CanTouch = false
        item.CanQuery = false
        item.CastShadow = false
        item.Material = Enum.Material.Neon
        item.Color = color
        item.Transparency = transparency
        item.Size = size
        item.CFrame = cframe
        item.Parent = parent
        return item
    end

    local function linePart(
        parent: Instance,
        name: string,
        a: Vector3,
        b: Vector3,
        color: Color3,
        transparency: number
    ): Part?
        local delta = b - a
        local length = delta.Magnitude
        if length < 0.02 then
            return nil
        end
        return markerPart(
            parent,
            name,
            Vector3.new(0.16, 0.16, length),
            CFrame.lookAt((a + b) * 0.5, b),
            color,
            transparency
        )
    end

    local function addLabel(marker: Model, adornee: BasePart, data: any, preview: boolean)
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "Label"
        billboard.Adornee = adornee
        billboard.AlwaysOnTop = true
        billboard.LightInfluence = 0
        billboard.Size = UDim2.fromOffset(260, 52)
        billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.4, 0)
        billboard.Parent = marker

        local text = Instance.new("TextLabel")
        text.BackgroundColor3 = Color3.fromRGB(17, 22, 30)
        text.BackgroundTransparency = 0.1
        text.BorderSizePixel = 0
        text.Size = UDim2.fromScale(1, 1)
        text.Font = Enum.Font.GothamSemibold
        text.TextColor3 = Color3.fromRGB(246, 248, 251)
        text.TextSize = 14
        text.TextWrapped = true
        text.Text = string.format("%s\nLocation%s", tostring(data.name or "Location"), preview and " · DRAW" or "")
        text.Parent = billboard

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 7)
        corner.Parent = text
    end

    local function clearCopies(locationId: string, preview: boolean)
        for _, child in ipairs(locationFolder():GetChildren()) do
            if child:IsA("Model") then
                local registered = not preview and tostring(child:GetAttribute("LocationId") or "") == locationId
                local previewCopy = tostring(child:GetAttribute("PreviewForLocationId") or "") == locationId
                if registered or previewCopy then
                    child:Destroy()
                end
            end
        end
    end

    local function createLocationMarker(data: any, preview: boolean): Model
        local locationId = tostring(data.locationId or "")
        if not locationId:match("^location%-%w[%w%-]+$") then
            error("Location command has invalid locationId")
        end
        local values = typeof(data.points) == "table" and data.points or {}
        if #values < 3 then
            error("Registered Location polygon must contain at least 3 points")
        end
        clearCopies(locationId, preview)

        local marker = Instance.new("Model")
        marker.Name = markerName(data)
        marker:SetAttribute("Game1LocationMarker", true)
        marker:SetAttribute("LocationId", preview and "" or locationId)
        if preview then
            marker:SetAttribute("PreviewForLocationId", locationId)
        end
        marker:SetAttribute("LocationName", tostring(data.name or "Location"))
        marker:SetAttribute("PlaceId", tonumber(data.placeId) or game.PlaceId)
        marker.Parent = locationFolder()

        local color = preview and Color3.fromRGB(255, 161, 84) or Color3.fromRGB(66, 214, 177)
        local points = {}
        for index, raw in ipairs(values) do
            local world = pointFromData(raw)
            table.insert(points, world)
            local vertex = markerPart(
                marker,
                string.format("Point_%03d", index),
                Vector3.new(0.75, 0.75, 0.75),
                CFrame.new(world),
                color,
                0.08
            )
            vertex.Shape = Enum.PartType.Ball
            vertex:SetAttribute("LocationVertexIndex", index)
        end
        for index = 1, #points do
            local nextIndex = index == #points and 1 or index + 1
            linePart(marker, string.format("Edge_%03d", index), points[index], points[nextIndex], color, 0.08)
        end
        local first = marker:FindFirstChild("Point_001")
        if first and first:IsA("BasePart") then
            marker.PrimaryPart = first
            addLabel(marker, first, data, preview)
        end
        Selection:Set({ marker })
        return marker
    end

    local function createDrawPreview(data: any): (Model, Part)
        local locationId = tostring(data.locationId or "")
        clearCopies(locationId, true)
        local marker = Instance.new("Model")
        marker.Name = "DRAW_" .. markerName(data)
        marker:SetAttribute("Game1LocationMarker", true)
        marker:SetAttribute("PreviewForLocationId", locationId)
        marker:SetAttribute("LocationName", tostring(data.name or "Location"))
        marker.Parent = locationFolder()
        local liveEdge = markerPart(
            marker,
            "LiveEdge",
            Vector3.new(0.1, 0.1, 0.1),
            CFrame.new(),
            Color3.fromRGB(255, 161, 84),
            0.2
        )
        return marker, liveEdge
    end

    local function updateLiveEdge(liveEdge: Part, a: Vector3?, b: Vector3?)
        if not a or not b or (b - a).Magnitude < 0.02 then
            liveEdge.Transparency = 1
            return
        end
        local length = (b - a).Magnitude
        liveEdge.Size = Vector3.new(0.12, 0.12, length)
        liveEdge.CFrame = CFrame.lookAt((a + b) * 0.5, b)
        liveEdge.Transparency = 0.22
    end

    local function drawResult(data: any): any
        local mouse = plugin:GetMouse()
        local marker, liveEdge = createDrawPreview(data)
        local color = Color3.fromRGB(255, 161, 84)
        local points: { Vector3 } = {}
        local finished = false
        local cancelled = false
        local firstVertex: Part? = nil

        plugin:Activate(true)
        local moveConnection = mouse.Move:Connect(function()
            if #points > 0 and mouse.Target then
                updateLiveEdge(liveEdge, points[#points], mouse.Hit.Position)
            end
        end)
        local clickConnection = mouse.Button1Down:Connect(function()
            if not mouse.Target then
                return
            end
            if firstVertex and mouse.Target == firstVertex then
                if #points >= 3 then
                    finished = true
                end
                return
            end
            if mouse.Target:IsDescendantOf(marker) then
                return
            end
            local world = mouse.Hit.Position
            table.insert(points, world)
            local index = #points
            local vertex = markerPart(
                marker,
                string.format("Point_%03d", index),
                Vector3.new(1.05, 1.05, 1.05),
                CFrame.new(world),
                color,
                0.04
            )
            vertex.Shape = Enum.PartType.Ball
            vertex:SetAttribute("LocationVertexIndex", index)
            if index == 1 then
                firstVertex = vertex
                vertex.CanQuery = true
                addLabel(marker, vertex, data, true)
            elseif index > 1 then
                linePart(marker, string.format("Edge_%03d", index - 1), points[index - 1], world, color, 0.08)
            end
        end)
        local inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
            if not processed and input.KeyCode == Enum.KeyCode.Escape then
                cancelled = true
            end
        end)

        local deadline = os.clock() + 295
        repeat
            task.wait(0.05)
        until finished or cancelled or os.clock() >= deadline
        moveConnection:Disconnect()
        clickConnection:Disconnect()
        inputConnection:Disconnect()
        plugin:Deactivate()

        if not finished then
            marker:Destroy()
            error(cancelled and "Location drawing was cancelled" or "Location drawing timed out")
        end
        liveEdge:Destroy()
        if firstVertex then
            firstVertex.CanQuery = false
        end
        linePart(marker, string.format("Edge_%03d", #points), points[#points], points[1], color, 0.08)

        local resultPoints = {}
        for _, world in ipairs(points) do
            table.insert(resultPoints, { x = world.X, y = world.Y, z = world.Z })
        end
        Selection:Set({ marker })
        return {
            points = resultPoints,
            placeId = game.PlaceId,
            markerPath = marker:GetFullName(),
            closed = true,
        }
    end

    local function validatePlace(data: any)
        local expectedPlaceId = tonumber(data.placeId) or 0
        if expectedPlaceId > 0 and game.PlaceId > 0 and expectedPlaceId ~= game.PlaceId then
            error(string.format("Open PlaceId %d does not match Location PlaceId %d", game.PlaceId, expectedPlaceId))
        end
    end

    local function handle(data: any)
        local payload = {
            schemaVersion = 1,
            project = "game1",
            command = "location-authoring",
            action = tostring(data.action or ""),
            operationId = tostring(data.operationId or ""),
            locationId = tostring(data.locationId or ""),
            placeId = game.PlaceId,
            placeName = game.Name,
        }

        local ok, resultOrError = xpcall(function()
            if tostring(data.project or "") ~= "game1" or tonumber(data.schemaVersion) ~= 1 then
                error("invalid game1 Location command")
            end
            validatePlace(data)
            local action = tostring(data.action or "")
            if action == "draw" then
                return drawResult(data)
            elseif action == "upsert" then
                local marker = createLocationMarker(data, false)
                return { markerPath = marker:GetFullName(), synchronized = true }
            elseif action == "select" then
                local marker = findLocationMarker(tostring(data.locationId or ""))
                if not marker then
                    error("Registered Location marker was not found in Studio")
                end
                Selection:Set({ marker })
                local root = marker.PrimaryPart
                local camera = Workspace.CurrentCamera
                if root and camera then
                    camera.CFrame = CFrame.lookAt(root.Position + Vector3.new(18, 16, 18), root.Position)
                end
                return { markerPath = marker:GetFullName(), synchronized = true }
            elseif action == "delete" then
                local marker = findLocationMarker(tostring(data.locationId or ""))
                if marker then
                    marker:Destroy()
                end
                for _, child in ipairs(locationFolder():GetChildren()) do
                    if child:IsA("Model")
                        and tostring(child:GetAttribute("PreviewForLocationId") or "") == tostring(data.locationId or "") then
                        child:Destroy()
                    end
                end
                return { deleted = marker ~= nil, synchronized = true }
            elseif action == "sync" then
                local folder = locationFolder()
                for _, child in ipairs(folder:GetChildren()) do
                    if child:IsA("Model") and child:GetAttribute("Game1LocationMarker") == true then
                        child:Destroy()
                    end
                end
                local created = 0
                local skipped = 0
                local syncedLocationIds = {}
                for _, record in ipairs(typeof(data.records) == "table" and data.records or {}) do
                    local recordPlaceId = tonumber(record.placeId) or 0
                    if recordPlaceId == 0 or game.PlaceId == 0 or recordPlaceId == game.PlaceId then
                        createLocationMarker(record, false)
                        created += 1
                        table.insert(syncedLocationIds, tostring(record.locationId or ""))
                    else
                        skipped += 1
                    end
                end
                return {
                    synchronized = true,
                    created = created,
                    skipped = skipped,
                    syncedLocationIds = syncedLocationIds,
                }
            end
            error("Unsupported Location action: " .. action)
        end, debug.traceback)

        if ok then
            for key, value in pairs(resultOrError) do
                payload[key] = value
            end
        else
            payload.error = tostring(resultOrError)
        end

        local postOk, postError = pcall(postResult, payload)
        if not postOk then
            warn("[game1 plugin] failed to report Location result: " .. tostring(postError))
        end
    end

    return {
        handle = handle,
    }
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">NpcSpawnPlacement</string>
          <string name="Source"><![CDATA[-- NPC-only Studio placement gesture. Monster placement remains unchanged.
-- Hover to select the ground, press LMB to lock the point, drag horizontally
-- to rotate the published rig, release LMB to commit; Escape cancels.
local NpcSpawnPlacement = {}

local ROTATION_DEGREES_PER_PIXEL = 0.65
local TIMEOUT_SECONDS = 295

local function positionFromData(value: any): Vector3?
    if type(value) ~= "table" then
        return nil
    end
    local x, y, z = tonumber(value.x), tonumber(value.y), tonumber(value.z)
    if not x or not y or not z then
        return nil
    end
    return Vector3.new(x, y, z)
end

function NpcSpawnPlacement.Place(context: any): any
    local plugin = context.plugin
    local workspace = context.Workspace
    local userInput = context.UserInputService
    local mouse = plugin:GetMouse()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.RespectCanCollide = true
    local excluded: {Instance} = {}
    local authoring = workspace:FindFirstChild("Game1Authoring")
    if authoring then
        table.insert(excluded, authoring)
    end
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs then
        table.insert(excluded, npcs)
    end
    params.FilterDescendantsInstances = excluded

    local function groundHit(): RaycastResult?
        local ray = mouse.UnitRay
        return workspace:Raycast(ray.Origin, ray.Direction * 10000, params)
    end

    local connections: {RBXScriptConnection} = {}
    local marker: Model? = nil
    local finished = false
    local cancelled = false
    local dragging = false
    local initialX = 0
    local initialYaw = 0
    local yaw = (tonumber(context.data.yawDegrees) or context.cameraYaw()) % 360
    local selected = positionFromData(context.data.position) or Vector3.zero
    local hasGround = false
    local targetName = ""
    local deadline = os.clock() + TIMEOUT_SECONDS

    local ok, result = xpcall(function()
        plugin:Activate(true)
        local firstHit = groundHit()
        if firstHit then
            selected = firstHit.Position
            hasGround = true
        end
        context.data.position = {x = selected.X, y = selected.Y, z = selected.Z}
        context.data.yawDegrees = yaw
        context.data.placeId = game.PlaceId
        marker = context.createMarker(context.data, "preview", "npc")

        local function redraw()
            if marker then
                context.moveMarker(marker, selected, yaw)
            end
        end
        redraw()
        table.insert(connections, mouse.Move:Connect(function()
            if dragging then
                yaw = (initialYaw + (mouse.X - initialX) * ROTATION_DEGREES_PER_PIXEL) % 360
                redraw()
            else
                local hit = groundHit()
                if hit then
                    selected = hit.Position
                    hasGround = true
                    redraw()
                else
                    hasGround = false
                end
            end
        end))
        table.insert(connections, mouse.Button1Down:Connect(function()
            if dragging then
                return
            end
            local hit = groundHit()
            if not hit then
                return
            end
            selected = hit.Position
            targetName = hit.Instance:GetFullName()
            hasGround = true
            initialX = mouse.X
            initialYaw = yaw
            dragging = true
            redraw()
        end))
        local function release()
            if dragging then
                dragging = false
                finished = true
            end
        end
        table.insert(connections, mouse.Button1Up:Connect(release))
        -- Also handle releasing outside the viewport while Studio owns capture.
        table.insert(connections, userInput.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                release()
            end
        end))
        table.insert(connections, userInput.InputBegan:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.Escape then
                cancelled = true
            end
        end))
        table.insert(connections, plugin.Deactivation:Connect(function()
            cancelled = true
        end))

        repeat
            task.wait(0.05)
        until finished or cancelled or os.clock() >= deadline
        if not finished or cancelled then
            error(cancelled and "NPC Spawn placement cancelled" or "NPC Spawn placement timed out")
        end
        return {
            position = {x = selected.X, y = selected.Y, z = selected.Z},
            yawDegrees = yaw,
            target = targetName,
            markerPath = (marker :: Model):GetFullName(),
        }
    end, debug.traceback)

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    plugin:Deactivate()
    if not ok then
        if marker then
            marker:Destroy()
        end
        error(result)
    end
    return result
end

return table.freeze(NpcSpawnPlacement)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">NpcSpawnPreview</string>
          <string name="Source"><![CDATA[-- Studio-only representation of the published NPC while authoring a spawn point.
-- Runtime entities are created exclusively by NpcRigFactory/NpcSpawnerService.
local NpcSpawnPreview = {}

local function publishedTemplate(serverStorage: ServerStorage, slug: string): Model?
    local npcs = serverStorage:FindFirstChild("npcs")
    local actor = npcs and npcs:FindFirstChild(slug)
    local container = actor and actor:FindFirstChild("model")
    local source = container and container:FindFirstChild(slug)
    if source and source:IsA("Model") and source:GetAttribute("Game1NpcRig") == true then
        return source
    end
    return nil
end

local function geometryBounds(visual: Model): (CFrame, Vector3)
    -- Same support-surface convention as NpcRigFactory.visibleBounds.
    local low = Vector3.new(math.huge, math.huge, math.huge)
    local high = Vector3.new(-math.huge, -math.huge, -math.huge)
    local found = false
    for _, part in ipairs(visual:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "RootPart" and part.Name ~= "RootCollider" then
            found = true
            local half = part.Size * 0.5
            for x = -1, 1, 2 do
                for y = -1, 1, 2 do
                    for z = -1, 1, 2 do
                        local point = part.CFrame:PointToWorldSpace(Vector3.new(half.X * x, half.Y * y, half.Z * z))
                        low = Vector3.new(math.min(low.X, point.X), math.min(low.Y, point.Y), math.min(low.Z, point.Z))
                        high = Vector3.new(math.max(high.X, point.X), math.max(high.Y, point.Y), math.max(high.Z, point.Z))
                    end
                end
            end
        end
    end
    if not found then
        return visual:GetBoundingBox()
    end
    return CFrame.new((low + high) * 0.5), high - low
end

function NpcSpawnPreview.Attach(serverStorage: ServerStorage, marker: Model, slug: string): Model
    local template = publishedTemplate(serverStorage, slug)
    if not template then
        error("NPC preview template is missing from ServerStorage.npcs." .. slug .. ".model." .. slug .. "; synchronize the published rig first")
    end
    local ghost = template:Clone()
    if not ghost then
        error("NPC template cannot be cloned: " .. slug)
    end
    ghost.Name = "ActorPreview"
    local initialRotation = ghost:GetPivot().Rotation
    for _, instance in ipairs(ghost:GetDescendants()) do
        if instance:IsA("BasePart") then
            instance.Anchored = true
            instance.CanCollide = false
            instance.CanTouch = false
            instance.CanQuery = false
            instance.CastShadow = false
            if instance.Name == "RootPart" or instance.Name == "RootCollider" or instance.Name == "NavigationRoot" then
                instance.Transparency = 1
            else
                instance.Transparency = math.max(instance.Transparency, 0.28)
            end
        elseif instance:IsA("Script") or instance:IsA("LocalScript") or instance:IsA("ModuleScript") then
            instance:Destroy()
        elseif instance:IsA("Humanoid") then
            instance:Destroy()
        end
    end
    -- Normalize at yaw=0 before measuring the lowest visible vertex.
    ghost:PivotTo(initialRotation)
    local visual = ghost:FindFirstChild("ImportedRig")
    if not visual or not visual:IsA("Model") then
        visual = ghost
    end
    local bounds, size = geometryBounds(visual :: Model)
    local offset = size.Y * 0.5 - bounds.Position.Y
    ghost:SetAttribute("PreviewBaseRotation", initialRotation)
    ghost:SetAttribute("PreviewGroundOffset", offset)
    ghost:SetAttribute("Game1NpcPlacementVisual", true)
    ghost.Parent = marker
    return ghost
end

function NpcSpawnPreview.Move(marker: Model, position: Vector3, yawDegrees: number)
    local ghost = marker:FindFirstChild("ActorPreview")
    if not ghost or not ghost:IsA("Model") then
        return
    end
    local rotation = ghost:GetAttribute("PreviewBaseRotation")
    local offset = ghost:GetAttribute("PreviewGroundOffset")
    if typeof(rotation) ~= "CFrame" or type(offset) ~= "number" then
        return
    end
    ghost:PivotTo(CFrame.new(position + Vector3.new(0, offset, 0))
        * CFrame.Angles(0, math.rad(yawDegrees), 0) * rotation)
end

return table.freeze(NpcSpawnPreview)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">StudioActorSpawnCommands</string>
          <string name="Source"><![CDATA[-- Monster/NPC authored spawn commands and lightweight Studio marker placement.
-- Both kinds intentionally share marker lifecycle; NPC preview gesture remains in NpcSpawnPlacement.
local NpcSpawnPreview = require(script.Parent.NpcSpawnPreview)
local NpcSpawnPlacement = require(script.Parent.NpcSpawnPlacement)

return function(services)
    local plugin = services.plugin
    local HttpService = services.HttpService
    local Selection = services.Selection
    local ServerStorage = services.ServerStorage
    local UserInputService = services.UserInputService
    local Workspace = services.Workspace
    local BRIDGE_URL = services.bridgeUrl
    local BRIDGE_TOKEN = services.bridgeToken

    local MONSTER_SPAWN_AUTHORING_ROOT = "Game1Authoring"
    local MONSTER_SPAWN_MARKER_FOLDER = "MonsterSpawns"

    local function postMonsterSpawnResult(payload: any)
        local response = HttpService:RequestAsync({
            Url = BRIDGE_URL .. "/monster-spawn-result",
            Method = "POST",
            Headers = {
                ["X-Game1-Token"] = BRIDGE_TOKEN,
                ["Content-Type"] = "application/json",
            },
            Body = HttpService:JSONEncode(payload),
        })
        if not response.Success then
            error("game1 Monster Spawn result bridge rejected response: " .. tostring(response.StatusCode))
        end
    end

    local function monsterSpawnMarkerFolder(kind: string?): Folder
        local root = Workspace:FindFirstChild(MONSTER_SPAWN_AUTHORING_ROOT)
        if root and not root:IsA("Folder") then
            error("Workspace." .. MONSTER_SPAWN_AUTHORING_ROOT .. " exists but is not a Folder")
        end
        if not root then
            root = Instance.new("Folder")
            root.Name = MONSTER_SPAWN_AUTHORING_ROOT
            root:SetAttribute("Game1Authoring", true)
            root.Parent = Workspace
        end
        local markerFolderName = if kind == "npc" then "NpcSpawns" else MONSTER_SPAWN_MARKER_FOLDER
        local folder = root:FindFirstChild(markerFolderName)
        if folder and not folder:IsA("Folder") then
            error(root:GetFullName() .. "." .. markerFolderName .. " exists but is not a Folder")
        end
        if not folder then
            folder = Instance.new("Folder")
            folder.Name = markerFolderName
            folder.Parent = root
        end
        return folder :: Folder
    end

    local function findMonsterSpawnMarker(spawnId: string, kind: string?): Model?
        local root = Workspace:FindFirstChild(MONSTER_SPAWN_AUTHORING_ROOT)
        local folder = root and root:FindFirstChild(if kind == "npc" then "NpcSpawns" else MONSTER_SPAWN_MARKER_FOLDER)
        if not folder then
            return nil
        end
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") and tostring(child:GetAttribute("SpawnId") or "") == spawnId then
                return child
            end
        end
        return nil
    end

    local function safeMonsterSpawnMarkerPart(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, transparency: number): Part
        local part = Instance.new("Part")
        part.Name = name
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.CastShadow = false
        part.Material = Enum.Material.Neon
        part.Color = color
        part.Size = size
        part.CFrame = cframe
        part.Transparency = transparency
        part.Parent = parent
        return part
    end

    local function monsterSpawnMarkerCFrame(position: any, yawDegrees: any): CFrame
        if typeof(position) ~= "table" then
            error("Monster Spawn position is missing")
        end
        local x = tonumber(position.x)
        local y = tonumber(position.y)
        local z = tonumber(position.z)
        if x == nil or y == nil or z == nil then
            error("Monster Spawn position is invalid")
        end
        return CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(tonumber(yawDegrees) or 0), 0)
    end

    local function monsterSpawnMarkerName(data: any): string
        local name = tostring(data.monsterName or data.monsterSlug or "Monster")
            :gsub("[^%w]+", "_"):gsub("^_+", ""):gsub("_+$", "")
        if name == "" then
            name = "Monster"
        end
        local shortId = tostring(data.spawnId or "spawn"):gsub("^spawn%-", ""):sub(1, 8)
        return string.format("%s_%s", name, shortId)
    end

    local function createMonsterSpawnMarker(data: any, markerState: string, actorKind: string?): Model
        local spawnId = tostring(data.spawnId or "")
        if not spawnId:match("^spawn%-%w[%w%-]+$") then
            error("Monster Spawn command has invalid spawnId")
        end
        local preview = markerState == "preview"
        local kind = if actorKind == "npc" then "npc" else "monster"
        local folder = monsterSpawnMarkerFolder(kind)
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") then
                local registeredCopy = not preview and tostring(child:GetAttribute("SpawnId") or "") == spawnId
                local previewCopy = tostring(child:GetAttribute("PreviewForSpawnId") or "") == spawnId
                if registeredCopy or previewCopy then
                    child:Destroy()
                end
            end
        end

        local world = monsterSpawnMarkerCFrame(data.position, data.yawDegrees)
        local color = preview and Color3.fromRGB(255, 111, 97) or Color3.fromRGB(66, 214, 177)
        local marker = Instance.new("Model")
        marker.Name = monsterSpawnMarkerName(data)
        marker:SetAttribute(if kind == "npc" then "Game1NpcSpawnMarker" else "Game1MonsterSpawnMarker", true)
        marker:SetAttribute("EntityKind", kind)
        marker:SetAttribute("SpawnState", markerState)
        marker:SetAttribute("SpawnId", preview and "" or spawnId)
        if preview then
            marker:SetAttribute("PreviewForSpawnId", spawnId)
        end
        marker:SetAttribute(if kind == "npc" then "NpcSlug" else "MonsterSlug", tostring(data.monsterSlug or ""))
        marker:SetAttribute(if kind == "npc" then "NpcName" else "MonsterName", tostring(data.monsterName or ""))
        marker:SetAttribute("MapKey", tostring(data.mapKey or "main"))
        marker:SetAttribute("PlaceId", tonumber(data.placeId) or game.PlaceId)
        marker:SetAttribute("YawDegrees", tonumber(data.yawDegrees) or 0)
        if kind == "monster" then
            marker:SetAttribute("SpawnRadius", tonumber(data.spawnRadius) or 0)
            marker:SetAttribute("MaxAlive", tonumber(data.maxAlive) or 1)
        end
        marker:SetAttribute("Enabled", data.enabled ~= false)
        marker.Parent = folder

        local point = safeMonsterSpawnMarkerPart(marker, "Point", Vector3.new(0.12, 2.2, 2.2), world * CFrame.Angles(0, 0, math.rad(90)), color, 0.18)
        point.Shape = Enum.PartType.Cylinder
        safeMonsterSpawnMarkerPart(marker, "Direction", Vector3.new(0.22, 0.12, 3.2), world * CFrame.new(0, 0.18, -1.6), color, 0.12)
        local radius = math.max(0, tonumber(data.spawnRadius) or 0)
        if kind == "monster" and radius > 0.01 then
            local area = safeMonsterSpawnMarkerPart(marker, "Radius", Vector3.new(0.06, radius * 2, radius * 2), world * CFrame.Angles(0, 0, math.rad(90)), color, 0.84)
            area.Shape = Enum.PartType.Cylinder
        end

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "Label"
        billboard.Adornee = point
        billboard.AlwaysOnTop = true
        billboard.LightInfluence = 0
        billboard.Size = UDim2.fromOffset(250, 52)
        billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
        billboard.Parent = marker
        local text = Instance.new("TextLabel")
        text.BackgroundColor3 = Color3.fromRGB(17, 24, 33)
        text.BackgroundTransparency = 0.08
        text.BorderSizePixel = 0
        text.Size = UDim2.fromScale(1, 1)
        text.Font = Enum.Font.GothamSemibold
        text.TextColor3 = Color3.fromRGB(246, 248, 251)
        text.TextSize = 14
        text.TextWrapped = true
        if kind == "npc" then
            text.Text = string.format("%s\n%s%s", tostring(data.monsterName or data.monsterSlug or "NPC"), tostring(data.spawnId or ""), preview and " · PREVIEW" or "")
        else
            text.Text = string.format("%s\n%s · max %d%s", tostring(data.monsterName or data.monsterSlug or "Monster"), tostring(data.spawnId or ""), tonumber(data.maxAlive) or 1, preview and " · PREVIEW" or "")
        end
        text.Parent = billboard
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 7)
        corner.Parent = text

        marker.PrimaryPart = point
        if preview and kind == "npc" then
            -- Only the unregistered, short-lived draft holds a rendered NPC.
            -- Registered markers remain lightweight regardless of population size.
            local attached, attachError = pcall(function()
                NpcSpawnPreview.Attach(ServerStorage, marker, tostring(data.monsterSlug or ""))
                NpcSpawnPreview.Move(marker, world.Position, tonumber(data.yawDegrees) or 0)
            end)
            if not attached then
                marker:Destroy()
                error(attachError)
            end
        end
        Selection:Set({ marker })
        return marker
    end

    local function moveMonsterSpawnMarker(marker: Model, position: Vector3, yawDegrees: number)
        local world = monsterSpawnMarkerCFrame({ x = position.X, y = position.Y, z = position.Z }, yawDegrees)
        marker:SetAttribute("YawDegrees", yawDegrees)
        NpcSpawnPreview.Move(marker, position, yawDegrees)
        local point = marker:FindFirstChild("Point")
        if point and point:IsA("BasePart") then
            point.CFrame = world * CFrame.Angles(0, 0, math.rad(90))
        end
        local direction = marker:FindFirstChild("Direction")
        if direction and direction:IsA("BasePart") then
            direction.CFrame = world * CFrame.new(0, 0.18, -1.6)
        end
        local radius = marker:FindFirstChild("Radius")
        if radius and radius:IsA("BasePart") then
            radius.CFrame = world * CFrame.Angles(0, 0, math.rad(90))
        end
    end

    local function monsterSpawnCameraYaw(): number
        local camera = Workspace.CurrentCamera
        local look = camera and camera.CFrame.LookVector or Vector3.new(0, 0, -1)
        return math.deg(math.atan2(-look.X, -look.Z)) % 360
    end

    local function monsterSpawnPlacementResult(data: any): any
        local expectedPlaceId = tonumber(data.placeId) or 0
        if expectedPlaceId > 0 and game.PlaceId > 0 and expectedPlaceId ~= game.PlaceId then
            error(string.format("Open PlaceId %d does not match Spawn PlaceId %d", game.PlaceId, expectedPlaceId))
        end

        if tostring(data.entityKind or "monster") == "npc" then
            return NpcSpawnPlacement.Place({
                plugin = plugin,
                Workspace = Workspace,
                UserInputService = UserInputService,
                data = data,
                cameraYaw = monsterSpawnCameraYaw,
                createMarker = createMonsterSpawnMarker,
                moveMarker = moveMonsterSpawnMarker,
            })
        end

        local mouse = plugin:GetMouse()
        local initial = data.position
        local startPosition = Vector3.new(0, 0, 0)
        if typeof(initial) == "table" and tonumber(initial.x) and tonumber(initial.y) and tonumber(initial.z) then
            startPosition = Vector3.new(tonumber(initial.x), tonumber(initial.y), tonumber(initial.z))
        elseif mouse.Target then
            startPosition = mouse.Hit.Position
        end
        local yaw = monsterSpawnCameraYaw()
        data.position = { x = startPosition.X, y = startPosition.Y, z = startPosition.Z }
        data.yawDegrees = yaw
        data.placeId = game.PlaceId
        local preview = createMonsterSpawnMarker(data, "preview", tostring(data.entityKind or "monster"))
        local finished = false
        local cancelled = false
        local chosenPosition = startPosition
        local targetName = ""

        plugin:Activate(true)
        local moveConnection = mouse.Move:Connect(function()
            if mouse.Target then
                chosenPosition = mouse.Hit.Position
                yaw = monsterSpawnCameraYaw()
                moveMonsterSpawnMarker(preview, chosenPosition, yaw)
            end
        end)
        local clickConnection = mouse.Button1Down:Connect(function()
            if mouse.Target then
                chosenPosition = mouse.Hit.Position
                targetName = mouse.Target:GetFullName()
                moveMonsterSpawnMarker(preview, chosenPosition, yaw)
                finished = true
            end
        end)
        local inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
            if not processed and input.KeyCode == Enum.KeyCode.Escape then
                cancelled = true
            end
        end)
        local deadline = os.clock() + 295
        repeat
            task.wait(0.05)
        until finished or cancelled or os.clock() >= deadline
        moveConnection:Disconnect()
        clickConnection:Disconnect()
        inputConnection:Disconnect()
        plugin:Deactivate()
        if not finished then
            preview:Destroy()
            error(cancelled and "Monster Spawn placement was cancelled" or "Monster Spawn placement timed out")
        end
        return {
            position = { x = chosenPosition.X, y = chosenPosition.Y, z = chosenPosition.Z },
            yawDegrees = yaw,
            target = targetName,
            markerPath = preview:GetFullName(),
        }
    end

    local function handleMonsterSpawn(data: any)
        local kind = tostring(data.entityKind or "monster")
        local result = {
            command = "monster-spawn",
            project = "game1",
            schemaVersion = 1,
            action = tostring(data.action or ""),
            operationId = tostring(data.operationId or ""),
            spawnId = tostring(data.spawnId or ""),
            placeId = game.PlaceId,
            universeId = game.GameId,
            placeName = game.Name,
            mapKey = tostring(data.mapKey or "main"),
        }
        local ok, operationError = xpcall(function()
            if tostring(data.project or "") ~= "game1" or tonumber(data.schemaVersion) ~= 1 or (kind ~= "monster" and kind ~= "npc") then
                error("invalid game1 actor spawn command")
            end
            local action = tostring(data.action or "")
            if action == "place" then
                local placed = monsterSpawnPlacementResult(data)
                for key, value in pairs(placed) do
                    result[key] = value
                end
            elseif action == "upsert" then
                local expectedPlaceId = tonumber(data.placeId) or 0
                if expectedPlaceId > 0 and game.PlaceId > 0 and expectedPlaceId ~= game.PlaceId then
                    error(string.format("Open PlaceId %d does not match Spawn PlaceId %d", game.PlaceId, expectedPlaceId))
                end
                local marker = createMonsterSpawnMarker(data, "registered", kind)
                result.markerPath = marker:GetFullName()
                result.synchronized = true
            elseif action == "select" then
                local marker = findMonsterSpawnMarker(tostring(data.spawnId or ""), kind)
                if not marker then
                    error("registered Monster Spawn marker was not found in Studio")
                end
                Selection:Set({ marker })
                local root = marker.PrimaryPart
                local camera = Workspace.CurrentCamera
                if root and camera then
                    camera.CFrame = CFrame.lookAt(root.Position + Vector3.new(9, 7, 9), root.Position)
                end
                result.markerPath = marker:GetFullName()
                result.synchronized = true
            elseif action == "delete" then
                local spawnId = tostring(data.spawnId or "")
                local marker = findMonsterSpawnMarker(spawnId, kind)
                if marker then
                    marker:Destroy()
                end
                for _, child in ipairs(monsterSpawnMarkerFolder(kind):GetChildren()) do
                    if child:IsA("Model") and tostring(child:GetAttribute("PreviewForSpawnId") or "") == spawnId then
                        child:Destroy()
                    end
                end
                result.deleted = marker ~= nil
                result.synchronized = true
            elseif action == "sync" then
                local folder = monsterSpawnMarkerFolder(kind)
                for _, child in ipairs(folder:GetChildren()) do
                    if child:IsA("Model") and child:GetAttribute(if kind == "npc" then "Game1NpcSpawnMarker" else "Game1MonsterSpawnMarker") == true then
                        child:Destroy()
                    end
                end
                local created = 0
                local skipped = 0
                local syncedSpawnIds = {}
                for _, record in ipairs(typeof(data.records) == "table" and data.records or {}) do
                    local recordPlaceId = tonumber(record.placeId) or 0
                    if recordPlaceId == 0 or game.PlaceId == 0 or recordPlaceId == game.PlaceId then
                        createMonsterSpawnMarker(record, "registered", kind)
                        created += 1
                        table.insert(syncedSpawnIds, tostring(record.spawnId or ""))
                    else
                        skipped += 1
                    end
                end
                result.synchronized = true
                result.created = created
                result.skipped = skipped
                result.syncedSpawnIds = syncedSpawnIds
            else
                error("unsupported Monster Spawn action: " .. action)
            end
        end, debug.traceback)

        if not ok then
            result.error = tostring(operationError)
            warn("[game1 plugin] Monster Spawn command failed: " .. tostring(operationError))
        end
        local postOk, postError = pcall(postMonsterSpawnResult, result)
        if not postOk then
            warn("[game1 plugin] failed to report Monster Spawn result: " .. tostring(postError))
        end
    end


    return handleMonsterSpawn
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">StudioCharacterStandBuilder</string>
          <string name="Source"><![CDATA[-- Studio authoring adapter for the SAME published assembly recipe and Builder
-- used by CharacterService. No second bind/atlas/mesh pipeline is implemented here.
local Builder = {}

local function registryRoot()
    local shared = game:GetService("ReplicatedStorage"):FindFirstChild("Game1Shared")
    assert(shared, "Game1Shared is absent. Run Rojo sync before assembling a character stand.")
    local character = shared:FindFirstChild("character")
    assert(character, "Game1Shared.character is absent")
    return character
end

function Builder.Profiles(): {any}
    local character = registryRoot()
    local registry = require(character:WaitForChild("CharacterRegistry"))
    local result = {}
    for _, row in ipairs(registry.archetypes or {}) do
        if row.visualMode == "assembly" and row.assembly and row.assembly.ready == true then
            table.insert(result, {id = row.id, label = tostring(row.displayName or row.id), mode = "assembly", row = row})
        elseif row.visualMode == "model" and row.model and tonumber(row.model.assetId) then
            table.insert(result, {id = row.id, label = tostring(row.displayName or row.id), mode = "model", row = row})
        end
    end
    table.sort(result, function(a, b) return a.id < b.id end)
    return result
end

local function getBuilder()
    local server = nil
    for _, candidate in game:GetService("ServerScriptService"):GetChildren() do
        if candidate.Name == "Game1Server" and candidate:IsA("Script") then
            assert(server == nil, "multiple active Game1Server scripts")
            server = candidate
        end
    end
    assert(server, "active Game1Server Script is absent. Run Rojo sync before assembling a character stand.")
    local character = server:FindFirstChild("character")
    assert(character, "Game1Server.character is absent")
    local module = character:FindFirstChild("CharacterAssemblyBuilder")
    assert(module and module:IsA("ModuleScript"), "CharacterAssemblyBuilder is absent")
    return require(module)
end

local function loadPublished(assetService: any, id: number): Model
    assert(id > 0 and id == math.floor(id), "invalid published Model Asset ID")
    local loaded = assetService:LoadAssetAsync(id)
    assert(loaded and loaded:IsA("Model"), "published asset is not a Model: " .. id)
    return loaded
end

local function prepareLegacy(assetService: any, row: any): Model
    local assetId = assert(tonumber(row.model.assetId), "legacy character lacks Model Asset ID")
    local loaded = loadPublished(assetService, assetId)
    local imported: Instance = loaded
    if #loaded:GetChildren() == 1 then
        imported = loaded:GetChildren()[1]
        imported.Parent = nil
        loaded:Destroy()
    end
    local rig: Model
    if imported:IsA("Model") then
        rig = imported
    else
        rig = Instance.new("Model")
        rig.Name = "ImportedRig"
        imported.Parent = rig
    end
    local wrapper = Instance.new("Model")
    wrapper.Name = "assembled_character"
    rig.Name = "ImportedRig"
    rig.Parent = wrapper
    local template = require(script.Parent.CharacterTemplate)
    template.EnsureCanonicalRoot(wrapper, rig)
    local host = rig:FindFirstChildWhichIsA("AnimationController", true)
    if host then host.Parent = wrapper else
        host = Instance.new("AnimationController")
        host.Parent = wrapper
    end
    if not host:FindFirstChildOfClass("Animator") then
        Instance.new("Animator").Parent = host
    end
    return wrapper
end

function Builder.Build(assetService: any, profile: any): Model
    local row = profile.row
    local wrapper: Model
    if profile.mode == "assembly" then
        local cached = {}
        local loadedAssets = {}
        local ok, result = xpcall(function()
            local assemblyBuilder = getBuilder()
            return assemblyBuilder.Build(row.assembly, function(id: number): Model
                if not cached[id] then
                    local loaded = loadPublished(assetService, id)
                    cached[id] = loaded
                    table.insert(loadedAssets, loaded)
                end
                return cached[id]
            end)
        end, debug.traceback)
        for _, item in ipairs(loadedAssets) do item:Destroy() end
        if not ok then error(result, 2) end
        wrapper = result
    else
        wrapper = prepareLegacy(assetService, row)
    end
    wrapper:SetAttribute("Game1CharacterTestStand", true)
    wrapper:SetAttribute("Game1AnimationProfileId", tostring(profile.id))
    wrapper:SetAttribute("Game1CharacterArchetype", tostring(profile.id))
    wrapper:SetAttribute("Game1SkeletonSignature", tostring(row.skeleton and row.skeleton.signature or ""))
    wrapper:SetAttribute("Game1TestStandVersion", 1)
    return wrapper
end

return table.freeze(Builder)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">StudioCharacterStandPlacement</string>
          <string name="Source"><![CDATA[-- Edit-mode surface placement. Does not change the imported rig's orientation,
-- bones, bind matrices, or asset identities. One click creates one stand clone.
local Placement = {}

local FOLDER_NAME = "Game1CharacterTestStands"

local function standFolder(workspace: Workspace): Folder
    local existing = workspace:FindFirstChild(FOLDER_NAME)
    if existing then
        assert(existing:IsA("Folder"), FOLDER_NAME .. " must be a Folder")
        return existing
    end
    local folder = Instance.new("Folder")
    folder.Name = FOLDER_NAME
    folder.Parent = workspace
    return folder
end

local function nextName(folder: Folder, profileId: string): string
    local stem = tostring(profileId):gsub("[^%w_%-]", "_")
    for number = 1, 9999 do
        local name = string.format("%s_%02d", stem, number)
        if not folder:FindFirstChild(name) then return name end
    end
    error("character test stand name limit reached")
end

function Placement.Place(draft: Model, surfacePoint: Vector3, workspace: Workspace): Model
    local folder = standFolder(workspace)
    local clone = draft:Clone()
    clone.Name = nextName(folder, tostring(draft:GetAttribute("Game1AnimationProfileId") or "character"))
    local ok, result = pcall(function()
        -- Freeze the test mannequin; animation changes bones, not world physics.
        -- Explicitly disable touching to keep combat and other services isolated.
        for _, object in clone:GetDescendants() do
            if object:IsA("BasePart") then
                object.Anchored = true
                object.CanCollide = false
                object.CanTouch = false
                object.CanQuery = false
            end
        end
        local bounds, size = clone:GetBoundingBox()
        local lowest = bounds.Position.Y - size.Y / 2
        local current = clone:GetPivot()
        local delta = Vector3.new(
            surfacePoint.X - current.Position.X,
            surfacePoint.Y - lowest,
            surfacePoint.Z - current.Position.Z
        )
        clone:PivotTo(CFrame.new(delta) * current)

        local box, dimensions = clone:GetBoundingBox()
        local anchor = Instance.new("Part")
        anchor.Name = "TestStandInteractionAnchor"
        anchor.Size = Vector3.new(0.2, 0.2, 0.2)
        anchor.CFrame = CFrame.new(box.Position.X, box.Position.Y, box.Position.Z)
        anchor.Anchored = true
        anchor.CanCollide = false
        anchor.CanTouch = false
        anchor.CanQuery = false
        anchor.Transparency = 1
        anchor.Parent = clone

        local prompt = Instance.new("ProximityPrompt")
        prompt.Name = "Game1NextAnimation"
        prompt:SetAttribute("Game1CharacterTestStandPrompt", true)
        prompt.KeyboardKeyCode = Enum.KeyCode.E
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = math.max(8, math.min(14, dimensions.Y * 0.35))
        prompt.RequiresLineOfSight = false
        prompt.ActionText = "Следующая анимация"
        prompt.ObjectText = tostring(clone:GetAttribute("Game1AnimationProfileId") or clone.Name)
        prompt.Parent = anchor
        clone.Parent = folder
        return clone
    end)
    if not ok then clone:Destroy(); error(result, 2) end
    return result
end

return table.freeze(Placement)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">StudioCharacterStandWidget</string>
          <string name="Source"><![CDATA[-- Dock widget contains presentation only. No asset imports or Workspace writes.
local Widget = {}

function Widget.new(plugin: Plugin): any
    local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right, false, false, 340, 290, 300, 260)
    local dock = plugin:CreateDockWidgetPluginGui("Game1CharacterTestStand_v1", info)
    dock.Title = "game1 · Character Test Stand"

    local root = Instance.new("Frame")
    root.Name = "Root"
    root.BackgroundColor3 = Color3.fromRGB(28, 32, 39)
    root.Size = UDim2.fromScale(1, 1)
    root.BorderSizePixel = 0
    root.Parent = dock

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 9)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = root

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 14)
    padding.PaddingLeft = UDim.new(0, 12)
    padding.PaddingRight = UDim.new(0, 12)
    padding.Parent = root

    local function label(name: string, text: string, height: number): TextLabel
        local item = Instance.new("TextLabel")
        item.Name = name
        item.LayoutOrder = #root:GetChildren()
        item.Size = UDim2.new(1, 0, 0, height)
        item.BackgroundTransparency = 1
        item.Font = Enum.Font.SourceSans
        item.TextSize = 14
        item.TextColor3 = Color3.fromRGB(222, 228, 235)
        item.TextWrapped = true
        item.TextXAlignment = Enum.TextXAlignment.Left
        item.Text = text
        item.Parent = root
        return item
    end

    local function button(name: string, text: string): TextButton
        local item = Instance.new("TextButton")
        item.Name = name
        item.LayoutOrder = #root:GetChildren()
        item.Size = UDim2.new(1, 0, 0, 37)
        item.BackgroundColor3 = Color3.fromRGB(44, 75, 93)
        item.BorderSizePixel = 0
        item.Font = Enum.Font.SourceSansSemibold
        item.TextSize = 15
        item.TextColor3 = Color3.fromRGB(245, 248, 252)
        item.Text = text
        item.Parent = root
        return item
    end

    label("Description", "Профиль из опубликованного CharacterRegistry", 25)
    local profile = button("Profile", "Выбрать профиль")
    local build = button("Assemble", "1 · Собрать персонажа")
    local place = button("Place", "2 · Поставить на поверхность")
    local status = label("Status", "Выбери профиль и собери тестовую модель.", 67)
    return {dock = dock, profile = profile, build = build, place = place, status = status}
end

return table.freeze(Widget)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">StudioCharacterTestStand</string>
          <string name="Source"><![CDATA[-- Game1Bridge composition root for the Studio-only character assembly stand.
-- Build -> Place are explicit user actions; this module owns the draft lifetime.
local StudioCharacterStandBuilder = require(script.Parent.StudioCharacterStandBuilder)
local StudioCharacterStandPlacement = require(script.Parent.StudioCharacterStandPlacement)
local StudioCharacterStandWidget = require(script.Parent.StudioCharacterStandWidget)

local TestStand = {}
TestStand.__index = TestStand

function TestStand.new(services: any): any
    local self = setmetatable({
        plugin = services.plugin,
        workspace = services.Workspace,
        runService = services.RunService,
        assetService = services.AssetService,
        selection = services.Selection,
        history = services.ChangeHistoryService,
        mouse = services.plugin:GetMouse(),
        profiles = {},
        selectedIndex = 1,
        draft = nil,
        busy = false,
        placing = false,
        ownsPluginMouse = false,
        destroyed = false,
        connections = {},
    }, TestStand)
    self.ui = StudioCharacterStandWidget.new(services.plugin)
    self.button = services.toolbar:CreateButton("Game1CharacterStand", "Assemble & place test characters", "", "Character Stand")
    self.button.ClickableWhenViewportHidden = true

    table.insert(self.connections, self.button.Click:Connect(function()
        self.ui.dock.Enabled = not self.ui.dock.Enabled
        if self.ui.dock.Enabled then self:RefreshProfiles() end
    end))
    table.insert(self.connections, self.ui.profile.MouseButton1Click:Connect(function()
        if self.busy or self.placing then return end
        self.selectedIndex = self.selectedIndex % math.max(1, #self.profiles) + 1
        self:SelectProfile()
    end))
    table.insert(self.connections, self.ui.build.MouseButton1Click:Connect(function()
        self:Assemble()
    end))
    table.insert(self.connections, self.ui.place.MouseButton1Click:Connect(function()
        self:BeginPlacement()
    end))
    table.insert(self.connections, self.mouse.Button1Down:Connect(function()
        self:PlaceAtMouse()
    end))
    table.insert(self.connections, services.plugin.Deactivation:Connect(function()
        if self.placing then self:CancelPlacement("Размещение отменено.", false) end
    end))
    table.insert(self.connections, services.plugin.Unloading:Connect(function()
        self:Destroy()
    end))
    table.insert(self.connections, self.ui.dock:GetPropertyChangedSignal("Enabled"):Connect(function()
        if not self.ui.dock.Enabled and self.placing then self:CancelPlacement("Размещение отменено.") end
    end))
    return self
end

function TestStand:SetStatus(text: string)
    if not self.destroyed then self.ui.status.Text = text end
end

function TestStand:SelectProfile()
    local profile = self.profiles[self.selectedIndex]
    self.ui.profile.Text = if profile then profile.label .. "  ▾" else "Нет опубликованных профилей"
    if self.draft then
        self.draft:Destroy()
        self.draft = nil
    end
    if profile then self:SetStatus("Выбран: " .. profile.id .. ". Нажми «Собрать персонажа».") end
end

function TestStand:RefreshProfiles()
    if self.busy or self.placing then return end
    local old = self.profiles[self.selectedIndex]
    local oldId = old and old.id
    local ok, profiles = pcall(StudioCharacterStandBuilder.Profiles)
    if not ok then
        self:SetStatus("CharacterRegistry: " .. tostring(profiles))
        return
    end
    self.profiles = profiles
    self.selectedIndex = 1
    if oldId then
        for index, profile in ipairs(profiles) do
            if profile.id == oldId then self.selectedIndex = index; break end
        end
    end
    local selected = self.profiles[self.selectedIndex]
    self.ui.profile.Text = if selected then selected.label .. "  ▾" else "Нет опубликованных профилей"
    if self.draft and selected and tostring(self.draft:GetAttribute("Game1AnimationProfileId")) == selected.id then
        self:SetStatus("Собран: " .. selected.id .. ". Нажми «Поставить на поверхность».")
    else
        self:SelectProfile()
    end
end

function TestStand:Assemble()
    if self.destroyed or self.busy or self.placing or self.runService:IsRunning() then
        self:SetStatus("Сборка доступна только в режиме Edit.")
        return
    end
    local profile = self.profiles[self.selectedIndex]
    if not profile then self:SetStatus("Сначала выбери опубликованный профиль."); return end
    self.busy = true
    self.ui.build.Active = false
    self:SetStatus("Загружаю опубликованные Model Assets: " .. profile.id .. "…")
    task.spawn(function()
        local ok, result = xpcall(function()
            return StudioCharacterStandBuilder.Build(self.assetService, profile)
        end, debug.traceback)
        self.busy = false
        self.ui.build.Active = true
        if self.destroyed then
            if ok then result:Destroy() end
            return
        end
        if not ok then
            self:SetStatus("Сборка не удалась: " .. tostring(result))
            warn("[game1][character-stand] assembly failed", result)
            return
        end
        if self.draft then self.draft:Destroy() end
        self.draft = result
        self:SetStatus("Собран: " .. profile.id .. ". Нажми «Поставить», затем кликни по поверхности.")
    end)
end

function TestStand:BeginPlacement()
    if self.destroyed or self.busy or self.runService:IsRunning() or not self.draft then
        self:SetStatus("Сначала собери персонажа в режиме Edit.")
        return
    end
    self.placing = true
    self:SetStatus("Кликни по поверхности в Workspace. Esc отменяет. Можно ставить несколько копий.")
    self.plugin:Activate(true)
    self.ownsPluginMouse = true
end

function TestStand:CancelPlacement(text: string, releasePluginMouse: boolean?)
    local shouldDeactivate = self.ownsPluginMouse and releasePluginMouse ~= false
    self.placing = false
    self.ownsPluginMouse = false
    if shouldDeactivate then
        self.plugin:Deactivate()
    end
    if not self.destroyed then self:SetStatus(text) end
end

function TestStand:PlaceAtMouse()
    if not self.placing or self.busy or self.destroyed or self.runService:IsRunning() then return end
    local ray = self.mouse.UnitRay
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local stands = self.workspace:FindFirstChild("Game1CharacterTestStands")
    params.FilterDescendantsInstances = if stands then {stands} else {}
    local hit = self.workspace:Raycast(ray.Origin, ray.Direction * 2048, params)
    if not hit then
        self:SetStatus("Нет поверхности под курсором. Выбери Part или Terrain.")
        return
    end
    if hit.Normal.Y < 0.6 then
        self:SetStatus("Нужна горизонтальная поверхность (пол или Terrain).")
        return
    end
    local recordingOk, recording = pcall(function()
        return self.history:TryBeginRecording("Place Character Test Stand")
    end)
    if not recordingOk or not recording then
        self:SetStatus("Undo недоступен: завершить другое редактирование и повторить.")
        return
    end
    local ok, model = pcall(StudioCharacterStandPlacement.Place, self.draft, hit.Position, self.workspace)
    local finished, finishError = pcall(function()
        self.history:FinishRecording(recording, if ok then Enum.FinishRecordingOperation.Commit else Enum.FinishRecordingOperation.Cancel)
    end)
    if not finished then warn("[game1][character-stand] undo recording failed", finishError) end
    if not ok then
        self:SetStatus("Размещение не удалось: " .. tostring(model))
        warn("[game1][character-stand] placement failed", model)
        return
    end
    self.placing = false
    self.ownsPluginMouse = false
    self.plugin:Deactivate()
    self.selection:Set({model})
    self:SetStatus(model.Name .. " размещён. В Studio Play подойди к модели и нажми E.")
end

function TestStand:Destroy()
    if self.destroyed then return end
    self.destroyed = true
    self.placing = false
    if self.draft then self.draft:Destroy(); self.draft = nil end
    for _, connection in ipairs(self.connections) do connection:Disconnect() end
end

return table.freeze(TestStand)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">StudioDebugPreferenceBridge</string>
          <string name="Source"><![CDATA[-- Studio-only persistence bridge for Test Loadout preferences.
-- Owns plugin settings, replicated attributes and their connections.
return function(services)
    local plugin = services.plugin
    local ReplicatedStorage = services.ReplicatedStorage
    local RunService = services.RunService

    local STUDIO_DEBUG_PREFERENCES_SETTING = "Game1StudioDebugPreferences_v1"
    local STUDIO_DEBUG_PREFERENCES_FOLDER = "Game1StudioPreferences"
    local STUDIO_DEBUG_PREFERENCE_FIELDS = {
        LastLoadoutArchetype = { key = "lastLoadoutArchetype", valueType = "string" },
        LastLoadoutWeaponSlug = { key = "lastLoadoutWeaponSlug", valueType = "string" },
    }

    local studioPreferenceFolder: Folder? = nil
    local studioPreferenceConnections: { RBXScriptConnection } = {}
    local applyingStudioPreferences = false

    local function readStudioDebugPreferences(): any
        local ok, value = pcall(function()
            return plugin:GetSetting(STUDIO_DEBUG_PREFERENCES_SETTING)
        end)
        if ok and type(value) == "table" then
            return value
        end
        if not ok then
            warn("[game1 plugin] could not read Studio debug preferences: " .. tostring(value))
        end
        return {}
    end

    local function writeStudioDebugPreference(key: string, value: any)
        local preferences = readStudioDebugPreferences()
        preferences[key] = value
        local ok, err = pcall(function()
            plugin:SetSetting(STUDIO_DEBUG_PREFERENCES_SETTING, preferences)
        end)
        if not ok then
            warn("[game1 plugin] could not save Studio debug preference: " .. tostring(err))
        end
    end

    local function disconnectStudioPreferenceBridge()
        for _, connection in ipairs(studioPreferenceConnections) do
            connection:Disconnect()
        end
        table.clear(studioPreferenceConnections)
        studioPreferenceFolder = nil
    end

    local function attachStudioPreferenceBridge(folder: Folder)
        if studioPreferenceFolder == folder then
            return
        end
        disconnectStudioPreferenceBridge()
        studioPreferenceFolder = folder

        local preferences = readStudioDebugPreferences()
        applyingStudioPreferences = true
        for attributeName, field in pairs(STUDIO_DEBUG_PREFERENCE_FIELDS) do
            local value = preferences[field.key]
            if type(value) ~= field.valueType then
                value = ""
            end
            folder:SetAttribute(attributeName, value)
        end
        applyingStudioPreferences = false

        for attributeName, field in pairs(STUDIO_DEBUG_PREFERENCE_FIELDS) do
            table.insert(studioPreferenceConnections, folder:GetAttributeChangedSignal(attributeName):Connect(function()
                if applyingStudioPreferences then
                    return
                end
                local value = folder:GetAttribute(attributeName)
                if type(value) == field.valueType then
                    writeStudioDebugPreference(field.key, value)
                end
            end))
        end

        if RunService:IsClient() then
            folder:SetAttribute("ClientPreferencesReady", true)
        end
    end

    local function syncStudioPreferenceBridge()
        if not RunService:IsRunning() then
            disconnectStudioPreferenceBridge()
            return
        end

        local folder = ReplicatedStorage:FindFirstChild(STUDIO_DEBUG_PREFERENCES_FOLDER)
        if not folder and RunService:IsServer() then
            folder = Instance.new("Folder")
            folder.Name = STUDIO_DEBUG_PREFERENCES_FOLDER
            folder.Parent = ReplicatedStorage
        end
        if folder and folder:IsA("Folder") then
            attachStudioPreferenceBridge(folder)
        end
    end

    ReplicatedStorage.ChildAdded:Connect(function(child)
        if RunService:IsRunning() and child.Name == STUDIO_DEBUG_PREFERENCES_FOLDER and child:IsA("Folder") then
            attachStudioPreferenceBridge(child)
        end
    end)
    RunService:GetPropertyChangedSignal("RunState"):Connect(function()
        task.defer(syncStudioPreferenceBridge)
    end)
    task.defer(syncStudioPreferenceBridge)


end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">StudioDecoSyncCommands</string>
          <string name="Source"><![CDATA[-- M216: reject legacy global commands (including M215) before they can mutate.
return function(config: any)
    return function(command: any)
        if command.project ~= "game1" or command.schemaVersion ~= 5
            or type(command.operationId) ~= "string" or command.operationId == ""
            or type(command.targetSlug) ~= "string" or command.targetSlug == ""
            or type(command.bindingRevision) ~= "number" or command.bindingRevision < 1
            or type(command.modelAssetId) ~= "string" or command.modelAssetId == ""
            or type(command.atlasAssetId) ~= "string" or command.atlasAssetId == "" then
            warn("[game1] rejected unsafe/unscoped Location Asset sync command")
            return
        end
        local ok, report, refreshError = pcall(function()
            if config.RunService:IsRunning() then
                error("Studio Edit mode required")
            end
            return config.decoManager:refreshRegistry(
                command.targetSlug, true, command.modelAssetId, command.atlasAssetId)
        end)
        local payload = {
            project = "game1", command = "deco-refresh", schemaVersion = 5,
            operationId = command.operationId, targetSlug = command.targetSlug,
            bindingRevision = command.bindingRevision,
        }
        if ok and report ~= nil then
            for _, field in ipairs({ "models", "parts", "replacedModels", "matchedModels",
                "modelReferences", "pendingGeometry", "geometryUpdated", "meshPartsUpdated", "registryItems", "changes", "instances" }) do
                payload[field] = report[field]
            end
        else
            payload.error = tostring(if ok then refreshError else report)
        end
        local posted, response = pcall(config.HttpService.RequestAsync, config.HttpService, {
            Url = config.bridgeUrl .. "/deco-refresh-result", Method = "POST",
            Headers = { ["X-Game1-Token"] = config.bridgeToken,
                ["Content-Type"] = "application/json" },
            Body = config.HttpService:JSONEncode(payload),
        })
        if not posted or not response.Success then
            warn("[game1] Location Asset sync result could not be reported: " .. tostring(if posted then response.Body else response))
        end
    end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">StudioHousePlacementCapture</string>
          <string name="Source"><![CDATA[-- Read-only Studio authoring adapter. Selection and plot markers stay untouched.
-- No runtime ownership, no house assembly, no Workspace mutation.
local PlotsCatalog = require(script.Parent.StudioPlotsCatalog)
local HouseFrame = require(script.Parent.StudioRealEstateHouseFrame)

return function(context)
    local HttpService = context.HttpService
    local Selection = context.Selection
    local Workspace = context.Workspace
    local RunService = context.RunService
    local BRIDGE_URL = context.bridgeUrl
    local BRIDGE_TOKEN = context.bridgeToken

    local function components(cframe: CFrame): {number}
        return { cframe:GetComponents() }
    end

    local function capture(command)
        if RunService:IsRunning() then
            error("Stop Studio Play/Run before binding a house placement")
        end
        local houseSlug = tostring(command.houseSlug or "")
        local plotIndex = tonumber(command.plotIndex)
        if not plotIndex or plotIndex % 1 ~= 0 or plotIndex < 1 or plotIndex > 50 then
            error("Plot must be between 1 and 50")
        end
        if houseSlug == "" then
            error("Choose a registered house in Real Estate")
        end
        local chosen = Selection:Get()
        if #chosen ~= 1 or not chosen[1]:IsA("Model") then
            error("Select exactly one Model named " .. houseSlug .. " in Studio Explorer")
        end
        local model = chosen[1] :: Model
        if model.Name ~= houseSlug or not model:IsDescendantOf(Workspace) then
            error("Selected Model must be Workspace model named exactly " .. houseSlug)
        end
        if not model:FindFirstChildWhichIsA("BasePart", true) then
            error("Selected house Model has no BasePart geometry")
        end
        local entries = PlotsCatalog.Collect(Workspace)
        local volume = nil
        for _, entry in ipairs(entries) do
            if entry.index == plotIndex then
                volume = entry.volume
                break
            end
        end
        if not volume then
            error(string.format("Workspace.Plots/%02d/plot_%02d_volume not found", plotIndex, plotIndex))
        end
        -- The selected Model pivot can differ from the published wrapper pivot.
        -- The authored house MeshPart pivot is the stable visual frame shared
        -- with Real Estate Studio Sync; capture its offset from the Model pivot.
        local house = HouseFrame.Find(model)
        if not house then
            error("Selected Model must have exactly one MeshPart named house for rotation-safe Bind")
        end
        local world = model:GetPivot()
        local houseWorld = house:GetPivot()
        local plotFrame = volume.CFrame
        return {
            houseSlug = houseSlug,
            plotIndex = plotIndex,
            plotVolume = volume.Name,
            worldCFrame = components(world),
            plotCFrame = components(plotFrame),
            localCFrame = components(plotFrame:ToObjectSpace(world)),
            houseAnchorLocalCFrame = components(world:ToObjectSpace(houseWorld)),
            houseAnchorWorldCFrame = components(houseWorld),
            scale = model:GetScale(),
        }
    end

    return function(command)
        local response = {
            command = "house-placement-capture-v2", schemaVersion = 2,
            project = "game1", operationId = command.operationId,
            houseSlug = command.houseSlug, plotIndex = command.plotIndex,
        }
        local ok, result = pcall(function()
            if command.command ~= "house-placement-capture-v2" or command.schemaVersion ~= 2 then
                error("Incompatible Placement Bind protocol; reinstall Game1Bridge")
            end
            return capture(command)
        end)
        if ok then
            for field, value in pairs(result) do
                response[field] = value
            end
        else
            response.error = tostring(result)
        end
        local posted, answer = pcall(HttpService.RequestAsync, HttpService, {
            Url = BRIDGE_URL .. "/house-placement-result",
            Method = "POST",
            Headers = {
                ["X-Game1-Token"] = BRIDGE_TOKEN,
                ["Content-Type"] = "application/json",
            },
            Body = HttpService:JSONEncode(response),
        })
        if not posted or not answer.Success then
            warn("[game1][house placement] bridge failed: " .. tostring(posted and answer.StatusCode or answer))
        end
    end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">StudioHousePlacementPreview</string>
          <string name="Source"><![CDATA[-- Explicitly authored house preview in Workspace.Plots/NN/Houses.
-- The placed copy is distinct from ServerStorage templates and player-owned houses.
-- Refuses to modify any object it did not create and mark itself.
local PlotsCatalog = require(script.Parent.StudioPlotsCatalog)
local HouseFrame = require(script.Parent.StudioRealEstateHouseFrame)

return function(context)
    local HttpService = context.HttpService
    local Workspace = context.Workspace
    local ServerStorage = context.ServerStorage
    local RunService = context.RunService
    local ChangeHistoryService = context.ChangeHistoryService

    local function findPlot(index: number): (Folder, BasePart)
        local entries = PlotsCatalog.Collect(Workspace)
        for _, entry in ipairs(entries) do
            if entry.index == index then
                local folder = entry.volume.Parent
                if folder and folder:IsA("Folder") then
                    return folder, entry.volume
                end
            end
        end
        error(string.format("Workspace.Plots/%02d/plot_%02d_volume not found", index, index))
    end

    local function validateIdentity(command)
        if RunService:IsRunning() then
            error("House Place/Clear works only in Studio Edit Mode")
        end
        local slug = tostring(command.houseSlug or "")
        local index = command.plotIndex
        if slug == "" or slug:find("[^%w_%-]") then
            error("Invalid registered house slug")
        end
        if typeof(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > 50 then
            error("Plot must be between 1 and 50")
        end
        return slug, index
    end

    -- One anchoring policy for staged previews and already placed previews.
    -- Checking *after* parenting matters: no successful Place may report Free
    -- while a descendant BasePart is actually anchored in Workspace.
    local function setAndVerifyAnchored(model: Model, anchored: boolean): number
        local count = 0
        for _, part in ipairs(model:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = anchored
                count += 1
            end
        end
        if count == 0 then error("House preview has no BaseParts to anchor/free") end
        for _, part in ipairs(model:GetDescendants()) do
            if part:IsA("BasePart") and part.Anchored ~= anchored then
                error("House preview anchoring verification failed: " .. part:GetFullName())
            end
        end
        return count
    end

    -- Apply anchor state only to marked authored previews whose plot×house
    -- identities came from the server's saved binding snapshot.
    local function runAnchors(command)
        if RunService:IsRunning() then
            error("House Anchor/Free works only in Studio Edit Mode")
        end
        if typeof(command.anchored) ~= "boolean" or typeof(command.targets) ~= "table"
            or #command.targets > 250 then
            error("Invalid anchor command")
        end
        local wanted = {}
        local count = 0
        for _, item in ipairs(command.targets) do
            local slug = item.houseSlug
            local index = item.plotIndex
            if typeof(slug) ~= "string" or slug == "" or slug:find("[^%w_%-]")
                or typeof(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > 50 then
                error("Invalid house/plot anchor target")
            end
            local key = tostring(index) .. ":" .. slug
            if wanted[key] then error("Duplicate house/plot anchor target") end
            wanted[key] = true
            count += 1
        end
        if count ~= #command.targets then error("Invalid anchor target collection") end
        local models = {}
        local parts = {}
        local plots = PlotsCatalog.Collect(Workspace)
        for _, entry in ipairs(plots) do
            local plotFolder = entry.volume.Parent
            local houses = plotFolder and plotFolder:FindFirstChild("Houses")
            if houses and houses:IsA("Folder") then
                for _, model in ipairs(houses:GetChildren()) do
                    if model:IsA("Model") and model:GetAttribute("Game1PlotHousePreview") == true
                        and model:GetAttribute("Game1PlotIndex") == entry.index then
                        local slug = model:GetAttribute("Game1RealEstateSlug")
                        if typeof(slug) == "string" and wanted[tostring(entry.index) .. ":" .. slug] then
                            table.insert(models, model)
                            for _, descendant in ipairs(model:GetDescendants()) do
                                if descendant:IsA("BasePart") then table.insert(parts, descendant) end
                            end
                        end
                    end
                end
            end
        end
        -- All validation is complete before any Workspace mutation.
        local recording = ChangeHistoryService:TryBeginRecording("Set authored house anchoring")
        if not recording then error("Studio undo recording unavailable; no changes made") end
        local previousParts, previousModels = {}, {}
        local ok, problem = pcall(function()
            for _, part in ipairs(parts) do
                previousParts[part] = part.Anchored
                part.Anchored = command.anchored
            end
            for _, part in ipairs(parts) do
                if part.Anchored ~= command.anchored then
                    error("Anchor/Free verification failed: " .. part:GetFullName())
                end
            end
            for _, model in ipairs(models) do
                previousModels[model] = model:GetAttribute("Game1PlotHouseAnchored")
                model:SetAttribute("Game1PlotHouseAnchored", command.anchored)
            end
        end)
        if not ok then
            for part, old in pairs(previousParts) do pcall(function() part.Anchored = old end) end
            for model, old in pairs(previousModels) do
                pcall(function() model:SetAttribute("Game1PlotHouseAnchored", old) end)
            end
            ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Cancel)
            error("Anchor/Free failed (rolled back): " .. tostring(problem))
        end
        ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
        return {status = "anchored", changed = #models, partsChanged = #parts,
                anchored = command.anchored}
    end

    -- Both single-row and bulk Place/Clear use these same preparation and
    -- commit functions. No placed objects are destroyed before all requested
    -- plots, templates and staged clones pass preflight.
    local function isManagedPreview(model, index)
        return model:IsA("Model")
            and model:GetAttribute("Game1PlotHousePreview") == true
            and model:GetAttribute("Game1PlotIndex") == index
            and typeof(model:GetAttribute("Game1RealEstateSlug")) == "string"
            and model:GetAttribute("Game1RealEstateSlug") == model.Name
    end

    local function checkedHousesFolder(plotFolder)
        local folder = plotFolder:FindFirstChild("Houses")
        if folder and not folder:IsA("Folder") then
            error("Plot Houses exists but is not a Folder")
        end
        return folder
    end

    local function managedChildren(folder, index)
        local existing = {}
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                if isManagedPreview(child, index) then
                    table.insert(existing, child)
                end
            end
        end
        return existing
    end

    local function rejectUnmanagedNameConflict(folder, index, slug)
        if not folder then return end
        for _, child in ipairs(folder:GetChildren()) do
            if child.Name == slug and (not child:IsA("Model")
                or child:GetAttribute("Game1PlotHousePreview") ~= true
                or not isManagedPreview(child, index)) then
                error("Refusing to replace an unmanaged house in this plot")
            end
        end
    end

    local function stagePlace(binding, slug, index, plotFolder, volume)
        local folder = checkedHousesFolder(plotFolder)
        rejectUnmanagedNameConflict(folder, index, slug)
        if typeof(binding) ~= "table" or binding.houseSlug ~= slug or binding.plotIndex ~= index
            or typeof(binding.localCFrame) ~= "table" or #binding.localCFrame ~= 12
            or typeof(binding.scale) ~= "number" or binding.scale <= 0
            or typeof(binding.revision) ~= "number"
            or typeof(binding.anchored) ~= "boolean" then
            error("Missing or invalid saved Placement binding (anchored must be boolean)")
        end
        -- M208 bindings lack an explicit house MeshPart authoring pivot.
        -- Preserve the old Model-pivot placement semantics for these records;
        -- never mistake their original CFrame for a calibrated house anchor.
        local legacyPivot = binding.houseAnchorLocalCFrame == nil
        if not legacyPivot and (typeof(binding.houseAnchorLocalCFrame) ~= "table"
            or #binding.houseAnchorLocalCFrame ~= 12) then
            error("Invalid saved house-anchor CFrame")
        end
        local components = {}
        local anchorComponents = {}
        for i = 1, 12 do
            if not legacyPivot then
                local anchorValue = binding.houseAnchorLocalCFrame[i]
                if typeof(anchorValue) ~= "number" or anchorValue ~= anchorValue
                    or math.abs(anchorValue) > 1e7 then
                    error("Invalid placement house-anchor CFrame component")
                end
                anchorComponents[i] = anchorValue
            end
            local component = binding.localCFrame[i]
            if typeof(component) ~= "number" or component ~= component or math.abs(component) > 1e7 then
                error("Invalid placement CFrame component")
            end
            components[i] = component
        end
        local templateRoot = ServerStorage:FindFirstChild("real_estate")
        local houseFolder = templateRoot and templateRoot:FindFirstChild(slug)
        local modelFolder = houseFolder and houseFolder:FindFirstChild("model")
        local template = modelFolder and modelFolder:FindFirstChild(slug)
        if not template or not template:IsA("Model") or template:GetAttribute("Game1RealEstateTemplate") ~= true then
            error("Sync entire house to ServerStorage/real_estate/" .. slug .. "/model first")
        end
        local clone = template:Clone()
        clone.Name = slug
        local prepared, problem = pcall(function()
            clone:ScaleTo(binding.scale)
            local desiredRoot = volume.CFrame * CFrame.new(table.unpack(components))
            local house = HouseFrame.Find(clone)
            if not house then
                error("Published house template must contain exactly one MeshPart named house")
            end
            -- Align the exact visual house frame captured at Bind, NOT the
            -- template wrapper's independently computed Model pivot.
            -- Calibrated bindings use the measured original house anchor.
            -- Legacy M208 bindings use the published clone's *own* offset;
            -- algebraically this is the pre-M229 clone:PivotTo(desiredRoot),
            -- but executed through our existing centralized HouseFrame.Align.
            local houseOffset = if legacyPivot
                then clone:GetPivot():ToObjectSpace(house:GetPivot())
                else CFrame.new(table.unpack(anchorComponents))
            local desiredHouse = desiredRoot * houseOffset
            HouseFrame.Align(clone, house, desiredHouse, "authored plot house")
            clone:SetAttribute("Game1RealEstateTemplate", nil)
            clone:SetAttribute("Game1PlotHousePreview", true)
            clone:SetAttribute("Game1PlotIndex", index)
            clone:SetAttribute("Game1RealEstateSlug", slug)
            clone:SetAttribute("Game1PlacementRevision", binding.revision)
            setAndVerifyAnchored(clone, binding.anchored)
            clone:SetAttribute("Game1PlotHouseAnchored", binding.anchored)
            clone:SetAttribute("Game1PlacementRotationMode",
                if legacyPivot then "legacy-model-pivot" else "house-anchor-v2")
        end)
        if not prepared then
            clone:Destroy()
            error("Preparing house preview failed: " .. tostring(problem))
        end
        local previousPreviews = managedChildren(folder, index)
        return {kind = "place", plotFolder = plotFolder, folder = folder,
            previous = previousPreviews, clone = clone, binding = binding,
            rotationMode = if legacyPivot then "legacy-model-pivot" else "house-anchor-v2"}
    end

    local function cleanupStaged(plans)
        for _, plan in ipairs(plans) do
            if plan.clone and plan.clone.Parent == nil then
                plan.clone:Destroy()
            end
        end
    end

    local function executePlans(plans, action)
        if #plans == 0 then
            return {status = action == "clear_all" and "cleared_all" or "already_clear",
                changed = 0}
        end
        local recording = ChangeHistoryService:TryBeginRecording(
            action == "place_all" and "Place all authored house previews"
            or action == "clear_all" and "Clear all authored house previews"
            or action == "place" and "Place authored house preview"
            or "Clear authored house preview")
        if not recording then
            cleanupStaged(plans)
            error("Studio undo recording unavailable; no changes made")
        end
        local createdFolders = {}
        local totalVerifiedParts = 0
        local placed, placeError = pcall(function()
            for _, plan in ipairs(plans) do
                if plan.kind == "place" then
                    local folder = plan.folder
                    if not folder then
                        folder = Instance.new("Folder")
                        folder.Name = "Houses"
                        folder.Parent = plan.plotFolder
                        table.insert(createdFolders, folder)
                        plan.folder = folder
                    end
                    local clone = plan.clone
                    local binding = plan.binding
                    clone.Parent = folder
                    local verifiedParts = setAndVerifyAnchored(clone, binding.anchored)
                    totalVerifiedParts += verifiedParts
                    clone:SetAttribute("Game1PlotHouseAnchored", binding.anchored)
                end
            end
        end)
        if not placed then
            for _, plan in ipairs(plans) do
                if plan.clone then plan.clone:Destroy() end
            end
            for _, folder in ipairs(createdFolders) do folder:Destroy() end
            ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Cancel)
            error("House placement failed (no existing previews removed): " .. tostring(placeError))
        end
        local removed = 0
        for _, plan in ipairs(plans) do
            for _, previous in ipairs(plan.previous) do
                previous:Destroy()
                removed += 1
            end
        end
        ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
        local placedCount, legacyCount = 0, 0
        for _, plan in ipairs(plans) do
            if plan.kind == "place" then
                placedCount += 1
                if plan.rotationMode == "legacy-model-pivot" then legacyCount += 1 end
            end
        end
        if action == "place_all" then
            return {status = "placed_all", changed = placedCount,
                replaced = removed, anchoredPartsVerified = totalVerifiedParts,
                legacyPlacements = legacyCount}
        elseif action == "clear_all" then
            return {status = "cleared_all", changed = removed}
        elseif action == "place" then
            local plan = plans[1]
            local verifiedParts = totalVerifiedParts
            return {status = "placed", changed = placedCount,
                revision = plan.binding.revision,
                anchored = plan.binding.anchored, anchoredPartsVerified = verifiedParts,
                rotationMode = plan.rotationMode,
                destination = plan.clone:GetFullName()}
        end
        return {status = "cleared", changed = removed}
    end

    local function runBatch(command)
        if RunService:IsRunning() then
            error("House Place all / Clear all works only in Studio Edit Mode")
        end
        if command.plotIndex ~= 0 or typeof(command.targets) ~= "table" then
            error("Invalid house placement batch command")
        end
        if command.action == "clear_all" then
            if command.houseSlug ~= "*" or #command.targets ~= 0 then
                error("Invalid Clear all scope")
            end
            local plots = PlotsCatalog.Collect(Workspace)
            if #plots ~= 50 then
                error("Clear all requires all 50 authored plot volumes; Workspace unchanged")
            end
            local plans = {}
            for _, entry in ipairs(plots) do
                local folder = checkedHousesFolder(entry.volume.Parent)
                local previous = managedChildren(folder, entry.index)
                if #previous > 0 then
                    table.insert(plans, {kind = "clear", previous = previous})
                end
            end
            return executePlans(plans, "clear_all")
        end
        if command.action ~= "place_all" then error("Unknown bulk house placement action") end
        local slug = command.houseSlug
        if typeof(slug) ~= "string" or slug == "" or slug:find("[^%w_%-]")
            or #command.targets < 1 or #command.targets > 50 then
            error("Invalid Place all house or target list")
        end
        local plotsByIndex = {}
        for _, entry in ipairs(PlotsCatalog.Collect(Workspace)) do
            plotsByIndex[entry.index] = entry
        end
        local seen, plans = {}, {}
        local ok, problem = pcall(function()
            for _, binding in ipairs(command.targets) do
                if typeof(binding) ~= "table" or binding.houseSlug ~= slug then
                    error("Place all target house mismatch")
                end
                local index = binding.plotIndex
                if typeof(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > 50
                    or seen[index] then
                    error("Place all duplicate/invalid plot")
                end
                seen[index] = true
                local entry = plotsByIndex[index]
                if not entry or not entry.volume.Parent or not entry.volume.Parent:IsA("Folder") then
                    error(string.format("Workspace.Plots/%02d/plot_%02d_volume not found", index, index))
                end
                table.insert(plans, stagePlace(binding, slug, index, entry.volume.Parent, entry.volume))
            end
        end)
        if not ok then
            cleanupStaged(plans)
            error("Place all preflight failed (Workspace unchanged): " .. tostring(problem))
        end
        return executePlans(plans, "place_all")
    end

    local function run(command)
        if command.action == "anchors" then return runAnchors(command) end
        if command.action == "place_all" or command.action == "clear_all" then
            return runBatch(command)
        end
        local slug, index = validateIdentity(command)
        local plotFolder, volume = findPlot(index)
        local folder = checkedHousesFolder(plotFolder)
        rejectUnmanagedNameConflict(folder, index, slug)
        if command.action == "clear" then
            local previous = {}
            for _, child in ipairs(managedChildren(folder, index)) do
                if child.Name == slug then table.insert(previous, child) end
            end
            if #previous == 0 then return {status = "already_clear", changed = 0} end
            return executePlans({{kind = "clear", previous = previous}}, "clear")
        end
        if command.action ~= "place" then error("Unknown house placement action") end
        return executePlans({stagePlace(command.placement, slug, index, plotFolder, volume)}, "place")
    end

    return function(command)
        local response = {
            command = "house-placement-preview-v4", schemaVersion = 4,
            project = "game1", operationId = command.operationId,
            houseSlug = command.houseSlug, plotIndex = command.plotIndex,
            action = command.action,
            anchored = command.anchored,
        }
        local ok, result = pcall(function()
            if command.command ~= "house-placement-preview-v4" or command.schemaVersion ~= 4 then
                error("Incompatible house-placement-preview protocol; reinstall Game1Bridge")
            end
            return run(command)
        end)
        if ok then
            for key, value in result do response[key] = value end
        else
            response.error = tostring(result)
        end
        local posted, reply = pcall(HttpService.RequestAsync, HttpService, {
            Url = context.bridgeUrl .. "/house-placement-result", Method = "POST",
            Headers = { ["X-Game1-Token"] = context.bridgeToken,
                        ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(response),
        })
        if not posted or not reply.Success then
            warn("[game1][house placement preview] bridge response failed: "
                .. tostring(posted and reply.StatusCode or reply))
        end
    end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">StudioManagedRigSwap</string>
          <string name="Source"><![CDATA[-- Shared Studio mechanism for replacing AUTHORING-MANAGED child rigs while
-- retaining the placed root Model and its identity. Used by Real Estate and
-- Location Assets. Callers alone choose targets and authoring-space anchors.
local RigSwap = {}

local POSITION_EPSILON = 0.025
local AXIS_DOT = 0.9999

local function sameFrame(a: CFrame, b: CFrame): boolean
    return (a.Position - b.Position).Magnitude <= POSITION_EPSILON
        and a.LookVector:Dot(b.LookVector) >= AXIS_DOT
        and a.UpVector:Dot(b.UpVector) >= AXIS_DOT
end

function RigSwap.AlignToAnchor(rig: Model, sourceAnchor: BasePart, targetPivot: CFrame, label: string)
    if not sourceAnchor:IsDescendantOf(rig) then
        error(label .. ": source anchor is outside its rig")
    end
    rig:PivotTo(targetPivot * sourceAnchor:GetPivot():Inverse() * rig:GetPivot())
    if not sameFrame(sourceAnchor:GetPivot(), targetPivot) then
        error(label .. ": authored anchor shifted after alignment")
    end
end

-- This is a transaction, not a placed-Model clone. Old children remain alive
-- until EVERY target has passed commit. Rollback can reattach them unchanged.
function RigSwap.Prepare(root: Model, outgoing: {Instance}, incoming: {Instance}): any
    if not root:IsA("Model") or root.Parent == nil or #outgoing == 0 or #incoming == 0 then
        error("managed rig replacement requires a placed root and nonempty child lists")
    end
    local outgoingSet = {}
    local incomingNames = {}
    for index, child in ipairs(outgoing) do
        if child.Parent ~= root or outgoingSet[child] then
            error("managed rig replacement: outgoing child is not uniquely owned by placed root")
        end
        outgoingSet[child] = true
        local backupName = "_Game1RigSwapPending_" .. tostring(index)
        if root:FindFirstChild(backupName) then
            error("unresolved managed rig replacement staging: " .. backupName)
        end
    end
    for _, child in ipairs(incoming) do
        if child.Parent == root then
            error("managed rig replacement: staged child requires a separate staging container")
        end
        if child.Name:sub(1, 20) == "_Game1RigSwapPending" then
            error("managed rig replacement: reserved staging name")
        end
        if incomingNames[child.Name] then
            error("managed rig replacement: duplicate incoming child name " .. child.Name)
        end
        incomingNames[child.Name] = true
        local collision = root:FindFirstChild(child.Name)
        if collision and not outgoingSet[collision] then
            error("managed rig replacement would overwrite unmanaged child " .. child.Name)
        end
    end
    local rootPrimary = root.PrimaryPart
    local primaryPath = nil
    if rootPrimary and outgoingSet[rootPrimary] then
        primaryPath = rootPrimary.Name
    elseif rootPrimary then
        for _, child in ipairs(outgoing) do
            if rootPrimary:IsDescendantOf(child) then
                local segments = {}
                local cursor: Instance? = rootPrimary
                while cursor and cursor ~= root do
                    table.insert(segments, 1, cursor.Name)
                    cursor = cursor.Parent
                end
                primaryPath = segments
                break
            end
        end
    end
    local newPrimary: BasePart? = nil
    if primaryPath then
        if typeof(primaryPath) == "string" then
            for _, child in ipairs(incoming) do
                if child.Name == primaryPath and child:IsA("BasePart") then newPrimary = child end
            end
        else
            for _, child in ipairs(incoming) do
                if child.Name == primaryPath[1] then
                    local candidate: Instance? = child
                    for index = 2, #primaryPath do
                        candidate = if candidate then candidate:FindFirstChild(primaryPath[index]) else nil
                    end
                    if candidate and candidate:IsA("BasePart") then newPrimary = candidate end
                end
            end
        end
        if not newPrimary then
            error("managed rig replacement: published rig lacks matching PrimaryPart")
        end
    end
    local old = {}
    for index, child in ipairs(outgoing) do
        table.insert(old, {object = child, name = child.Name,
            pendingName = "_Game1RigSwapPending_" .. tostring(index)})
    end
    return {root = root, parent = root.Parent, pivot = root:GetPivot(),
        scale = root:GetScale(), primary = rootPrimary, newPrimary = newPrimary,
        old = old, incoming = incoming, committed = false, finished = false}
end

function RigSwap.Rollback(plan: any)
    if plan.finished then error("cannot roll back finalized rig replacement") end
    for _, child in ipairs(plan.incoming) do
        if child.Parent == plan.root then child.Parent = nil end
        child:Destroy()
    end
    for _, entry in ipairs(plan.old) do
        if entry.object.Parent == plan.root then entry.object.Name = entry.name end
    end
    plan.root.PrimaryPart = plan.primary
    if not plan.primary then plan.root.WorldPivot = plan.pivot end
    plan.committed = false
end

function RigSwap.Commit(plan: any)
    if plan.finished or plan.committed or plan.root.Parent ~= plan.parent then
        error("managed rig replacement transaction is stale")
    end
    local ok, reason = pcall(function()
        for _, entry in ipairs(plan.old) do
            if entry.object.Parent ~= plan.root or entry.object.Name ~= entry.name then
                error("managed rig changed since preflight")
            end
            entry.object.Name = entry.pendingName
        end
        for _, child in ipairs(plan.incoming) do child.Parent = plan.root end
        if plan.newPrimary then
            plan.root.PrimaryPart = plan.newPrimary
        elseif not plan.primary then
            -- WorldPivot is editor metadata; setting it does not move any part.
            -- Without this, Roblox auto-pivot may change when geometry changes.
            plan.root.WorldPivot = plan.pivot
        end
        if not sameFrame(plan.root:GetPivot(), plan.pivot)
            or math.abs(plan.root:GetScale() - plan.scale) > 0.000001
            or plan.root.Parent ~= plan.parent then
            error("placed root pivot, scale or parent changed; transaction rolled back")
        end
    end)
    if not ok then
        RigSwap.Rollback(plan)
        error(tostring(reason), 2)
    end
    plan.committed = true
end

function RigSwap.Finalize(plan: any)
    if not plan.committed or plan.finished then error("rig replacement is not committed") end
    -- The only destruction is of managed OLD CHILD RIGS, never of a placed root.
    for _, entry in ipairs(plan.old) do entry.object:Destroy() end
    plan.finished = true
end

return table.freeze(RigSwap)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">StudioMarkerVisibility</string>
          <string name="Source"><![CDATA[-- Studio-only presentation toggle. No movement of markers, no metadata edits.
-- Visibility is re-applied from authored marker defaults after Studio restart.
local Visibility = {}
Visibility.__index = Visibility

local SETTING_KEY = "Game1AuthoringMarkersVisible_v1"
local MARKER_TAGS = {"Game1MonsterSpawnMarker", "Game1NpcSpawnMarker", "Game1LocationMarker"}

local function isMarker(instance: Instance): boolean
    if not instance:IsA("Model") then return false end
    for _, name in ipairs(MARKER_TAGS) do
        if instance:GetAttribute(name) == true then return true end
    end
    return false
end

function Visibility.new(plugin: Plugin, toolbar: PluginToolbar, workspace: Workspace)
    local self = setmetatable({
        plugin = plugin, workspace = workspace, connections = {},
        original = setmetatable({}, {__mode = "k"}),
        destroyed = false,
        visible = true,
    }, Visibility)
    local ok, saved = pcall(function() return plugin:GetSetting(SETTING_KEY) end)
    if ok and type(saved) == "boolean" then self.visible = saved end
    self.button = toolbar:CreateButton("Game1AuthoringMarkers", "Show / hide Game1 spawn markers and location boundaries", "", "Markers")
    self.button.ClickableWhenViewportHidden = true
    table.insert(self.connections, self.button.Click:Connect(function() self:SetVisible(not self.visible) end))
    self.button:SetActive(self.visible)
    table.insert(self.connections, plugin.Unloading:Connect(function()
        -- Undo temporary visual overrides before unloading, without replacing
        -- the user's saved show/hide preference for the next Studio session.
        self:Destroy()
    end))
    table.insert(self.connections, workspace.DescendantAdded:Connect(function(instance)
        -- Works for newly restored/reparented markers and parts created in them,
        -- including restoring overrides when a marker re-enters Workspace while visible.
        task.defer(function()
            if not self.destroyed and instance.Parent then self:_apply(instance) end
        end)
    end))
    local count = self:_apply(workspace)
    print(("[game1][studio-markers] toolbar ready · %s · %d marker(s)")
        :format(if self.visible then "shown" else "hidden", count))
    return self
end

-- Markers are created by StudioActorSpawnCommands and LocationCommands.
-- Their visual defaults are LocalTransparencyModifier=0 and Enabled/Visible=true.
-- That fallback is essential: an older plugin instance could save a hidden
-- marker, then forget its in-memory `original` snapshot on Studio restart.
local function visualProperty(instance: Instance): (string?, any, any)
    if instance:IsA("BasePart") then
        return "LocalTransparencyModifier", 1, 0
    elseif instance:IsA("BillboardGui") or instance:IsA("SurfaceGui") then
        return "Enabled", false, true
    elseif instance:IsA("Highlight") then
        return "Enabled", false, true
    elseif instance:IsA("SelectionBox") or instance:IsA("SphereHandleAdornment") or instance:IsA("BoxHandleAdornment") then
        return "Visible", false, true
    end
    return nil, nil, nil
end

function Visibility:_setItem(instance: Instance)
    local property, hiddenValue, defaultVisible = visualProperty(instance)
    if not property then return end
    if not self.visible then
        if self.original[instance] == nil then
            local ok, old = pcall(function() return (instance :: any)[property] end)
            if ok then
                -- Hidden property values cannot be trusted as an original on
                -- startup; normalize them to authored marker defaults.
                self.original[instance] = {
                    property = property,
                    value = if old == hiddenValue then defaultVisible else old,
                }
            end
        end
        pcall(function() (instance :: any)[property] = hiddenValue end)
    else
        local record = self.original[instance]
        local value = if record then record.value else defaultVisible
        pcall(function() (instance :: any)[property] = value end)
        self.original[instance] = nil
    end
end

function Visibility:_apply(instance: Instance): number
    local marker: Instance? = instance
    while marker and marker ~= self.workspace and not isMarker(marker) do
        marker = marker.Parent
    end
    if marker ~= nil and isMarker(marker) then
        self:_setItem(instance)
        for _, child in ipairs(instance:GetDescendants()) do self:_setItem(child) end
        return 1
    elseif instance == self.workspace then
        local count = 0
        for _, child in ipairs(self.workspace:GetDescendants()) do
            if isMarker(child) then
                count += 1
                self:_setItem(child)
                for _, descendant in ipairs(child:GetDescendants()) do self:_setItem(descendant) end
            end
        end
        return count
    end
    return 0
end

function Visibility:SetVisible(value: boolean)
    if self.destroyed then return end
    self.visible = value
    self.button:SetActive(value)
    pcall(function() self.plugin:SetSetting(SETTING_KEY, value) end)
    local count = self:_apply(self.workspace)
    print(("[game1][studio-markers] %s · %d marker(s)")
        :format(if value then "shown" else "hidden", count))
    if count == 0 then
        warn("[game1][studio-markers] no authored marker models in Workspace; "
            .. "check Workspace.Game1Authoring or use Restore markers in Asset Manager "
            .. "(Monster/NPC Population and Locations). In Play, the spawn marker folders are removed by runtime.")
    end
end

function Visibility:Destroy()
    if self.destroyed then return end
    self.destroyed = true
    -- Do not persist 'shown' to plugin settings: the preference survives reload,
    -- but editor-owned marker properties must not remain hidden after unloading.
    self.visible = true
    pcall(function() self:_apply(self.workspace) end)
    for _, connection in ipairs(self.connections) do connection:Disconnect() end
    table.clear(self.connections)
end

return table.freeze(Visibility)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">StudioModelLoadCommands</string>
          <string name="Source"><![CDATA[-- Studio model-sync command: validates and imports Character, Monster/NPC and Weapon models.
-- Transport/AssetService dependencies are passed by the Game1Bridge composition root.
local CharacterTemplate = require(script.Parent.CharacterTemplate)
local StudioRealEstateModel = require(script.Parent.StudioRealEstateModel)
local StudioRealEstatePartSync = require(script.Parent.StudioRealEstatePartSync)
local StudioTextureAppearance = require(script.Parent.StudioTextureAppearance)

return function(services)
    local AssetService = services.AssetService
    local HttpService = services.HttpService
    local ServerStorage = services.ServerStorage
    local BRIDGE_URL = services.bridgeUrl
    local BRIDGE_TOKEN = services.bridgeToken

    local function validSegment(value: any): string
        local segment = tostring(value or "")
        if segment == "" or segment == "." or segment == ".." or segment:find("[/\\]") then
            error("invalid ServerStorage path segment")
        end
        return segment
    end

    local function modelLoadDestination(folders: { any }, created: {Folder}): Instance
        local node: Instance = ServerStorage
        for _, raw in ipairs(folders) do
            local name = validSegment(raw)
            local child = node:FindFirstChild(name)
            if child == nil then
                child = Instance.new("Folder")
                child.Name = name
                child.Parent = node
                table.insert(created, child)
            elseif not child:IsA("Folder") then
                error("ServerStorage destination contains a non-Folder named " .. name)
            end
            node = child
        end
        return node
    end

    local function modelRigStats(root: Instance): any
        local stats = {
            baseParts = 0,
            bones = 0,
            boneNames = {},
            motor6Ds = 0,
            hasRootPart = false,
            rootPartClass = "",
        }
        local instances = { root }
        for _, descendant in root:GetDescendants() do
            table.insert(instances, descendant)
        end
        for _, instance in instances do
            if instance:IsA("BasePart") then
                stats.baseParts += 1
                if instance.Name == "RootPart" then
                    stats.hasRootPart = true
                    stats.rootPartClass = instance.ClassName
                end
            elseif instance:IsA("Bone") then
                stats.bones += 1
                table.insert(stats.boneNames, instance.Name)
            elseif instance:IsA("Motor6D") then
                stats.motor6Ds += 1
            end
        end
        table.sort(stats.boneNames)
        return stats
    end

    local function validateCharacterRig(root: Instance): any
        local stats = modelRigStats(root)
        if stats.baseParts <= 0 then
            error("character model contains no BasePart geometry")
        end
        if stats.bones + stats.motor6Ds <= 0 then
            error("character mode requires an articulated rig with Bone or Motor6D instances")
        end
        return stats
    end

    local function canonicalRigModel(imported: Instance): Model
        if imported:IsA("Model") then
            return imported
        end
        local model = Instance.new("Model")
        model.Name = "ImportedRig"
        imported.Parent = model
        return model
    end

    local function ensureCharacterHost(wrapper: Model, importedRig: Instance): Animator
        local host = wrapper:FindFirstChildOfClass("AnimationController")
        if host == nil then
            host = importedRig:FindFirstChildWhichIsA("AnimationController", true)
            if host ~= nil then
                host.Parent = wrapper
            else
                host = Instance.new("AnimationController")
                host.Name = "AnimationController"
                host.Parent = wrapper
            end
        end

        local duplicateHosts = {}
        for _, descendant in wrapper:GetDescendants() do
            if descendant:IsA("AnimationController") and descendant ~= host then
                table.insert(duplicateHosts, descendant)
            end
        end
        for _, duplicate in duplicateHosts do
            duplicate:Destroy()
        end

        local animator = host:FindFirstChildOfClass("Animator")
        if animator == nil then
            animator = Instance.new("Animator")
            animator.Name = "Animator"
            animator.Parent = host
        end
        local duplicateAnimators = {}
        for _, descendant in host:GetDescendants() do
            if descendant:IsA("Animator") and descendant ~= animator then
                table.insert(duplicateAnimators, descendant)
            end
        end
        for _, duplicate in duplicateAnimators do
            duplicate:Destroy()
        end
        return animator :: Animator
    end

    local function placeCharacterRig(importedRig: Model, destination: Instance, wrapperName: string, assetId: number): (Model, any, any)
        wrapperName = validSegment(wrapperName)
        local stats = validateCharacterRig(importedRig)
        local existing = destination:FindFirstChild(wrapperName)
        if existing ~= nil and not existing:IsA("Model") then
            error("character destination already contains a non-Model instance named " .. wrapperName)
        end
        if existing ~= nil and existing:GetAttribute("Game1CharacterRig") ~= true then
            error("refusing to replace an unmanaged Model named " .. wrapperName)
        end

        local wrapper = existing :: Model?
        if wrapper == nil then
            wrapper = Instance.new("Model")
            wrapper.Name = wrapperName
            wrapper.Parent = destination
        end

        local previousRig = wrapper:FindFirstChild("ImportedRig")
        if previousRig ~= nil then
            previousRig.Name = "ImportedRig_Previous"
        end
        importedRig.Name = "ImportedRig"
        importedRig.Parent = wrapper

        local hostOk, hostError = pcall(function()
            ensureCharacterHost(wrapper :: Model, importedRig)
        end)
        if not hostOk then
            importedRig:Destroy()
            if previousRig ~= nil then
                previousRig.Name = "ImportedRig"
            elseif existing == nil then
                wrapper:Destroy()
            end
            error(hostError)
        end
        if previousRig ~= nil then
            previousRig:Destroy()
        end

        local _, templateInfo = CharacterTemplate.EnsureCanonicalRoot(wrapper :: Model, importedRig)
        stats = modelRigStats(importedRig)

        wrapper:SetAttribute("Game1CharacterRig", true)
        wrapper:SetAttribute("Game1PlacementMode", "character-controller")
        wrapper:SetAttribute("Game1ModelAssetId", tostring(assetId))
        return wrapper :: Model, stats, templateInfo
    end

    local WEAPON_GRIP_NAME = "Game1WeaponGrip"

    local function weaponReferencePart(model: Model): BasePart?
        if model.PrimaryPart then
            return model.PrimaryPart
        end
        local parts = {}
        for _, descendant in model:GetDescendants() do
            if descendant:IsA("BasePart") then
                table.insert(parts, descendant)
            end
        end
        table.sort(parts, function(left, right)
            return left:GetFullName() < right:GetFullName()
        end)
        return parts[1]
    end

    local function ensureWeaponGrip(model: Model): Attachment
        local referencePart = weaponReferencePart(model)
        if not referencePart then
            error("weapon model contains no BasePart for grip reference")
        end

        for _, descendant in model:GetDescendants() do
            if descendant:IsA("Attachment") and descendant.Name == WEAPON_GRIP_NAME then
                descendant:Destroy()
            end
        end

        -- FBX/Model pivots are editor/runtime state and Model.WorldPivot is not
        -- replicated. Persist the actual grip point as an Attachment instead.
        -- Position comes from the imported model pivot; orientation is deliberately
        -- canonical world XYZ so two visually identical FBX weapons cannot equip
        -- differently only because their hidden Model pivot axes differ.
        local importedPivot = model:GetPivot()
        local canonicalGripWorld = CFrame.new(importedPivot.Position)
        local grip = Instance.new("Attachment")
        grip.Name = WEAPON_GRIP_NAME
        grip.CFrame = referencePart.CFrame:ToObjectSpace(canonicalGripWorld)
        grip:SetAttribute("Game1WeaponGrip", true)
        grip.Parent = referencePart
        model:SetAttribute("Game1WeaponGripMode", "attachment-v1")
        return grip
    end

    local function prepareWeaponModel(model: Model)
        for _, descendant in model:GetDescendants() do
            if descendant:IsA("Humanoid") or descendant:IsA("AnimationController") then
                descendant:Destroy()
            elseif descendant:IsA("BasePart") then
                descendant.Anchored = true
                descendant.CanCollide = false
                descendant.CanTouch = false
                descendant.CanQuery = false
                descendant.Massless = true
            end
        end
        ensureWeaponGrip(model)
    end

    local function applyWeaponTextures(model: Model, textures: { any }): any
        local meshParts = {}
        for _, descendant in model:GetDescendants() do
            if descendant:IsA("MeshPart") then
                table.insert(meshParts, descendant)
            end
        end
        table.sort(meshParts, function(left, right)
            return left:GetFullName() < right:GetFullName()
        end)

        local validTextures = {}
        for _, row in ipairs(textures or {}) do
            local assetId = tonumber(row.assetId)
            if assetId and assetId > 0 then
                table.insert(validTextures, {
                    slot = string.lower(tostring(row.slot or "")),
                    assetId = tostring(math.floor(assetId)),
                    usesAlpha = row.usesAlpha,
                })
            end
        end

        local applied = 0
        local unmatched = 0
        if #validTextures == 1 then
            local uri = "rbxassetid://" .. validTextures[1].assetId
            for _, mesh in ipairs(meshParts) do
                StudioTextureAppearance.Apply(mesh, uri, validTextures[1].usesAlpha)
                applied += 1
            end
        elseif #validTextures > 1 then
            for index, texture in ipairs(validTextures) do
                local matched = false
                for _, mesh in ipairs(meshParts) do
                    local meshName = string.lower(mesh.Name)
                    if texture.slot ~= "" and string.find(meshName, texture.slot, 1, true) then
                        StudioTextureAppearance.Apply(mesh, "rbxassetid://" .. texture.assetId, texture.usesAlpha)
                        matched = true
                        applied += 1
                    end
                end
                if not matched and #validTextures == #meshParts and meshParts[index] then
                    StudioTextureAppearance.Apply(meshParts[index], "rbxassetid://" .. texture.assetId, texture.usesAlpha)
                    matched = true
                    applied += 1
                end
                if not matched then
                    unmatched += 1
                end
            end
        end

        return {
            meshParts = #meshParts,
            textureAssets = #validTextures,
            applied = applied,
            unmatched = unmatched,
        }
    end

    -- Reject incomplete imported NPC skeletons before replacing a working Studio template.
    -- Registration owns the expected names; the plugin never encodes NPC-specific bones.
    local function assertExpectedBones(importedRig: Model, expected: any)
        if typeof(expected) ~= "table" or #expected == 0 then
            return
        end
        local present = {}
        for _, object in importedRig:GetDescendants() do
            if object:IsA("Bone") then
                present[object.Name] = true
            end
        end
        local missing = {}
        for _, name in expected do
            if typeof(name) == "string" and name ~= "" and not present[name] then
                table.insert(missing, name)
            end
        end
        if #missing > 0 then
            table.sort(missing)
            error(("Roblox imported an incomplete skeleton: %d of %d bones missing (%s). "
                .. "Republish the NPC model with the updated bone-survival pipeline and sync again.")
                :format(#missing, #expected, table.concat(missing, ", ", 1, math.min(12, #missing))))
        end
    end

    local function placeMonsterRig(importedRig: Model, destination: Instance, wrapperName: string, assetId: number, metadata: any): (Model, any, any, any)
        wrapperName = validSegment(wrapperName)
        local actorKind = if tostring(metadata.entityKind or "monster") == "npc" then "npc" else "monster"
        local managedAttribute = if actorKind == "npc" then "Game1NpcRig" else "Game1MonsterRig"
        local stats = validateCharacterRig(importedRig)
        assertExpectedBones(importedRig, metadata.expectedBones)
        local existing = destination:FindFirstChild(wrapperName)
        if existing ~= nil and not existing:IsA("Model") then
            error(actorKind .. " destination already contains a non-Model instance named " .. wrapperName)
        end
        if existing ~= nil and existing:GetAttribute(managedAttribute) ~= true then
            error("refusing to replace an unmanaged " .. actorKind .. " Model named " .. wrapperName)
        end

        local wrapper = existing :: Model?
        if wrapper == nil then
            wrapper = Instance.new("Model")
            wrapper.Name = wrapperName
            wrapper.Parent = destination
        end

        local previousRig = wrapper:FindFirstChild("ImportedRig")
        if previousRig ~= nil then
            previousRig.Name = "ImportedRig_Previous"
        end
        importedRig.Name = "ImportedRig"
        importedRig.Parent = wrapper

        local hostOk, hostError = pcall(function()
            ensureCharacterHost(wrapper :: Model, importedRig)
        end)
        if not hostOk then
            importedRig:Destroy()
            if previousRig ~= nil then
                previousRig.Name = "ImportedRig"
            elseif existing == nil then
                wrapper:Destroy()
            end
            error(hostError)
        end
        if previousRig ~= nil then
            previousRig:Destroy()
        end

        local _, templateInfo = CharacterTemplate.EnsureCanonicalRoot(wrapper :: Model, importedRig)
        stats = modelRigStats(importedRig)
        local textureStats = applyWeaponTextures(importedRig, metadata.textures or {})

        wrapper:SetAttribute(managedAttribute, true)
        wrapper:SetAttribute("Game1PlacementMode", "monster-rig")
        wrapper:SetAttribute("Game1ModelAssetId", tostring(assetId))
        wrapper:SetAttribute(if actorKind == "npc" then "NpcSlug" else "MonsterSlug", tostring(metadata.monsterSlug or wrapperName))
        return wrapper :: Model, stats, templateInfo, textureStats
    end

    local function placeWeaponModel(imported: Model, destination: Instance, wrapperName: string, assetId: number, metadata: any): (Model, any)
        wrapperName = validSegment(wrapperName)
        local existing = destination:FindFirstChild(wrapperName)
        if existing ~= nil and (not existing:IsA("Model") or existing:GetAttribute("Game1WeaponTemplate") ~= true) then
            error("refusing to replace unmanaged weapon instance named " .. wrapperName)
        end
        if existing then
            existing:Destroy()
        end

        imported.Name = wrapperName
        prepareWeaponModel(imported)
        imported:SetAttribute("Game1WeaponTemplate", true)
        imported:SetAttribute("Game1ModelAssetId", tostring(assetId))
        imported:SetAttribute("WeaponSlug", tostring(metadata.weaponSlug or wrapperName))
        imported:SetAttribute("WeaponType", tostring(metadata.weaponType or ""))
        imported:SetAttribute("WeaponRarity", tostring(metadata.rarity or ""))
        imported.Parent = destination

        local textureStats = applyWeaponTextures(imported, metadata.textures or {})
        return imported, textureStats
    end

    local function postModelLoadResult(payload: any)
        HttpService:RequestAsync({
            Url = BRIDGE_URL .. "/model-load-result",
            Method = "POST",
            Headers = {
                ["X-Game1-Token"] = BRIDGE_TOKEN,
                ["Content-Type"] = "application/json",
            },
            Body = HttpService:JSONEncode(payload),
        })
    end

    local function handleModelLoad(data: any)
        local result = {
            command = "model-load",
            project = "game1",
            schemaVersion = 1,
            assetId = tostring(data.assetId or ""),
        }
        local createdFolders: {Folder} = {}
        local importedSession: Model? = nil
        local ok, operationError = xpcall(function()
            if tostring(data.project or "") ~= "game1" or tonumber(data.schemaVersion) ~= 1 then
                error("invalid game1 model load command")
            end
            local placementMode = tostring(data.placementMode or "")
            if placementMode ~= "character-controller" and placementMode ~= "weapon-pivot" and placementMode ~= "monster-rig" and placementMode ~= "real-estate-rig" then
                error("unsupported game1 model placement mode")
            end
            local assetId = tonumber(data.assetId)
            if assetId == nil or assetId <= 0 then
                error("model load requires a numeric Roblox Asset ID")
            end

            local loaded: Instance? = nil
            local lastError = ""
            for _ = 1, 8 do
                local loadedOk, value = pcall(function()
                    return AssetService:LoadAssetAsync(assetId)
                end)
                if loadedOk and value ~= nil then
                    loaded = value
                    break
                end
                lastError = tostring(value)
                task.wait(2)
            end
            if loaded == nil then
                error("Roblox Model Asset ID " .. tostring(assetId) .. " could not be loaded: " .. lastError)
            end

            -- Same rule as the reference project: strip only the single transport
            -- wrapper returned by AssetService and preserve the uploaded FBX tree.
            local importedRig: Instance = loaded
            local transportChildren = loaded:GetChildren()
            if loaded:IsA("Model") and #transportChildren == 1 then
                importedRig = transportChildren[1]
                importedRig.Parent = nil
                loaded:Destroy()
            end

            local destination = modelLoadDestination(data.destinationFolders or {}, createdFolders)
            local normalizedModel = canonicalRigModel(importedRig)
            importedSession = normalizedModel
            if placementMode == "real-estate-rig" then
                local metadata = data.metadata or {}
                local wrapper, estateStats
                if typeof(metadata.syncPart) == "string" and metadata.syncPart ~= "" then
                    wrapper, estateStats = StudioRealEstatePartSync.Place(
                        normalizedModel, destination, tostring(data.wrapperName or ""), assetId, metadata)
                else
                    wrapper, estateStats = StudioRealEstateModel.Place(
                        normalizedModel, destination, tostring(data.wrapperName or ""), assetId, metadata, AssetService)
                end
                result.destination = wrapper:GetFullName()
                result.wrapperName = wrapper.Name
                result.realEstateStats = estateStats
                result.importedCount = #wrapper:GetDescendants()
            elseif placementMode == "weapon-pivot" then
                local wrapper, textureStats = placeWeaponModel(
                    normalizedModel,
                    destination,
                    tostring(data.wrapperName or ""),
                    assetId,
                    data.metadata or {}
                )
                result.destination = wrapper:GetFullName()
                result.wrapperName = wrapper.Name
                local grip = wrapper:FindFirstChild(WEAPON_GRIP_NAME, true)
                result.weaponStats = {
                    baseParts = modelRigStats(wrapper).baseParts,
                    textures = textureStats,
                    gripAttachment = grip ~= nil and grip:IsA("Attachment"),
                    gripMode = tostring(wrapper:GetAttribute("Game1WeaponGripMode") or ""),
                }
                result.importedCount = #wrapper:GetDescendants()
            elseif placementMode == "monster-rig" then
                local wrapper, stats, templateInfo, textureStats = placeMonsterRig(
                    normalizedModel,
                    destination,
                    tostring(data.wrapperName or ""),
                    assetId,
                    data.metadata or {}
                )
                result.destination = wrapper:GetFullName()
                result.wrapperName = wrapper.Name
                result.rigStats = stats
                result.template = templateInfo
                result.monsterStats = {
                    textures = textureStats,
                    monsterSlug = tostring(wrapper:GetAttribute("MonsterSlug") or wrapper:GetAttribute("NpcSlug") or ""),
                }
                result.importedCount = #wrapper:GetDescendants()
            else
                local wrapper, stats, templateInfo = placeCharacterRig(
                    normalizedModel,
                    destination,
                    tostring(data.wrapperName or ""),
                    assetId
                )
                result.destination = wrapper:GetFullName()
                result.wrapperName = wrapper.Name
                result.rigStats = stats
                result.template = templateInfo
                result.importedCount = #wrapper:GetDescendants()
            end
        end, debug.traceback)

        if not ok then
            -- Do not leave misleading empty ServerStorage paths when an asset
            -- fails validation. Never delete folders that existed beforehand,
            -- folders containing data, or an existing managed template.
            for index = #createdFolders, 1, -1 do
                local folder = createdFolders[index]
                if folder.Parent ~= nil and #folder:GetChildren() == 0 then
                    folder:Destroy()
                end
            end
            if importedSession and importedSession.Parent == nil then
                importedSession:Destroy()
            end
            result.error = tostring(operationError)
        end
        local postOk, postError = pcall(postModelLoadResult, result)
        if not postOk then
            warn("[game1 plugin] failed to report model load result: " .. tostring(postError))
        end
    end


    return handleModelLoad
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">StudioPlotsCatalog</string>
          <string name="Source"><![CDATA[-- Read-only discovery contract for authored Workspace.Plots/01..50.
-- Neither folder creation nor volume/number reparenting belongs to the preview.
local Catalog = {}

function Catalog.Collect(workspace: Workspace): ({any}, number, number)
    local plots = workspace:FindFirstChild("Plots")
    if not plots or not plots:IsA("Folder") then
        return {}, 50, 50
    end

    local numbersFolder = workspace:FindFirstChild("Numbers_1-50")
    local numbersRoot = numbersFolder and numbersFolder:FindFirstChild("Numbers_1_50")
    local entries = {}
    local missingVolumes = 0
    local missingNumbers = 0

    for index = 1, 50 do
        local folderName = string.format("%02d", index)
        local folder = plots:FindFirstChild(folderName)
        local volume = if folder and folder:IsA("Folder")
            then folder:FindFirstChild("plot_" .. folderName .. "_volume")
                or folder:FindFirstChild("plot_" .. tostring(index) .. "_volume")
            else nil
        if not volume or not volume:IsA("BasePart") then
            missingVolumes += 1
            missingNumbers += 1
            continue
        end

        -- The attach-numbers Command Bar script parents each numbered model to
        -- its volume. Keep supporting the original Numbers_1_50 source layout.
        local number = volume:FindFirstChild(tostring(index))
        if not number and numbersRoot then
            number = numbersRoot:FindFirstChild(tostring(index))
        end
        local numberParts = {}
        if number and number:IsA("Model") then
            for _, instance in ipairs(number:GetDescendants()) do
                if instance:IsA("BasePart") then
                    table.insert(numberParts, instance)
                end
            end
        end
        if #numberParts == 0 then missingNumbers += 1 end

        table.insert(entries, {
            index = index,
            volume = volume,
            numberParts = numberParts,
        })
    end

    return entries, missingVolumes, missingNumbers
end

return table.freeze(Catalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">StudioPlotsPartPolicy</string>
          <string name="Source"><![CDATA[-- Reversible, Studio-only properties for Plots visibility and playtest preview.
-- This policy never reparents, destroys, or moves authored instances.
local Policy = {}

function Policy.Capture(part: BasePart): any
    return {
        localTransparency = part.LocalTransparencyModifier,
        transparency = part.Transparency,
        color = part.Color,
        anchored = part.Anchored,
        locked = part.Locked,
        canCollide = part.CanCollide,
        canQuery = part.CanQuery,
        canTouch = part.CanTouch,
        castShadow = part.CastShadow,
    }
end

local function applyInteraction(part: BasePart, saved: any, accessible: boolean, playtest: boolean)
    -- CanQuery=false requires CanCollide=false. Set collision first.
    part.CanCollide = false
    if accessible then
        part.CanQuery = saved.canQuery
        part.CanTouch = saved.canTouch
        part.Locked = saved.locked
        -- In Play these are previews, never solid walls around plots.
        if not playtest then
            part.CanCollide = saved.canCollide
        end
    else
        part.CanQuery = false
        part.CanTouch = false
        part.Locked = true
    end
end

function Policy.Edit(part: BasePart, saved: any, _accessible: boolean)
    -- Viewport selection is independent of Locked/CanQuery. The filter module
    -- handles StudioSelectable while preserving the original interaction state.
    applyInteraction(part, saved, true, false)
    -- Transparency is driven by the preview controller's tweens in Edit mode.
end

function Policy.Play(part: BasePart, saved: any, visible: boolean, isVolume: boolean, tint: Color3, alpha: number)
    applyInteraction(part, saved, visible, true)
    if visible then
        if isVolume then
            part.Anchored = true
            part.Color = tint
            part.Transparency = alpha
            part.CastShadow = false
            part.LocalTransparencyModifier = 0
        else
            part.Transparency = saved.transparency
            part.LocalTransparencyModifier = saved.localTransparency
        end
    else
        -- Hidden parts are visually and physically absent from simulation.
        -- Keeping hierarchy intact avoids destructive edits to authored plots.
        part.Transparency = 1
        part.LocalTransparencyModifier = 1
        part.CastShadow = false
        if isVolume then
            part.Anchored = true
        end
    end
end

function Policy.Restore(part: BasePart, saved: any)
    if not part.Parent then return end
    part.LocalTransparencyModifier = saved.localTransparency
    part.Transparency = saved.transparency
    part.Color = saved.color
    part.Anchored = saved.anchored
    part.CastShadow = saved.castShadow
    applyInteraction(part, saved, true, false)
end

return table.freeze(Policy)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">StudioPlotsSelectionFilter</string>
          <string name="Source"><![CDATA[-- Studio viewport hit-test filter for hidden Plots authoring geometry.
-- Uses Roblox's documented StudioSelectable convention, not Locked/CanQuery.
-- Keeps all parts in Workspace with original CFrame, Size and welds intact.
local Filter = {}
Filter.__index = Filter

local STUDIO_GROUP = "StudioSelectable"
local HIDDEN_GROUP = "Game1PlotsPreviewHidden"
local ORIGINAL_GROUP_ATTRIBUTE = "__Game1PlotsOriginalCollisionGroup"

function Filter.OriginalGroup(part: BasePart): string
    -- An interrupted Studio session might have saved a hidden plot volume.
    -- Recover its previous group rather than treating the preview group as authored.
    local preserved = part:GetAttribute(ORIGINAL_GROUP_ATTRIBUTE)
    if type(preserved) == "string" and preserved ~= "" then
        return preserved
    end
    return part.CollisionGroup
end

function Filter.new(physicsService: any)
    return setmetatable({
        physicsService = physicsService,
        ready = false,
        failed = false,
    }, Filter)
end

function Filter:_configure(): boolean
    if self.ready then return true end
    if self.failed then return false end
    local ok, err = pcall(function()
        if not self.physicsService:IsCollisionGroupRegistered(STUDIO_GROUP) then
            self.physicsService:RegisterCollisionGroup(STUDIO_GROUP)
        end
        if not self.physicsService:IsCollisionGroupRegistered(HIDDEN_GROUP) then
            self.physicsService:RegisterCollisionGroup(HIDDEN_GROUP)
        end
        -- Only Editor selection collides with this group differently.
        -- All gameplay collision pairs retain their default configuration.
        if self.physicsService:CollisionGroupsAreCollidable(STUDIO_GROUP, HIDDEN_GROUP) then
            self.physicsService:CollisionGroupSetCollidable(STUDIO_GROUP, HIDDEN_GROUP, false)
        end
    end)
    if not ok then
        self.failed = true
        warn("[game1][plots] StudioSelectable filter unavailable: " .. tostring(err))
        return false
    end
    self.ready = true
    return true
end

function Filter:Hide(part: BasePart, originalGroup: string): boolean
    if not self:_configure() then return false end
    if part.CollisionGroup == HIDDEN_GROUP then return true end
    local ok, err = pcall(function()
        -- The attribute supports recovery after an unexpected editor shutdown.
        part:SetAttribute(ORIGINAL_GROUP_ATTRIBUTE, originalGroup)
        part.CollisionGroup = HIDDEN_GROUP
    end)
    if not ok then
        warn("[game1][plots] Cannot filter " .. part.Name .. ": " .. tostring(err))
        return false
    end
    return true
end

function Filter:Restore(part: BasePart, originalGroup: string)
    local stored = part:GetAttribute(ORIGINAL_GROUP_ATTRIBUTE)
    if part.CollisionGroup ~= HIDDEN_GROUP and stored == nil then return end
    local restoreTo = if type(stored) == "string" and stored ~= "" then stored else originalGroup
    local ok, err = pcall(function()
        if part.CollisionGroup == HIDDEN_GROUP then
            part.CollisionGroup = restoreTo
        end
        part:SetAttribute(ORIGINAL_GROUP_ATTRIBUTE, nil)
    end)
    if not ok then
        warn("[game1][plots] Cannot restore " .. part.Name .. " collision group: " .. tostring(err))
    end
end

return table.freeze(Filter)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">StudioPlotsVisibility</string>
          <string name="Source"><![CDATA[-- Studio-only Plots preview: hidden -> volumes -> volumes + numbers -> hidden.
-- Edit previews live in CoreGui; Play uses reversible physical appearance.
-- Never change CFrame, Size, constraints or hierarchy.
local StudioPlotsCatalog = require(script.Parent.StudioPlotsCatalog)
local StudioPlotsPartPolicy = require(script.Parent.StudioPlotsPartPolicy)
local StudioPlotsSelectionFilter = require(script.Parent.StudioPlotsSelectionFilter)

local PlotsVisibility = {}
PlotsVisibility.__index = PlotsVisibility

local FADE = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local VOLUME_ALPHA = 0.78
local VOLUME_COLOR = Color3.fromRGB(61, 195, 213)

function PlotsVisibility.new(config: any)
    local self = setmetatable({
        workspace = config.Workspace,
        coreGui = config.CoreGui,
        tweenService = config.TweenService,
        runService = config.RunService,
        state = 0,
        destroyed = false,
        tweens = {},
        overlays = {},
        sizeConnections = {},
        originalProperties = {},
        phase = if config.RunService.RunState == Enum.RunState.Stopped then "edit" else "play",
        selection = config.Selection,
        selectionFilter = StudioPlotsSelectionFilter.new(config.PhysicsService),
        volumeParts = {},
        numberParts = {},
        connections = {},
    }, PlotsVisibility)

    self.button = config.toolbar:CreateButton(
        "Game1Plots", "Plots: volumes → numbers → hidden", "", "Plots"
    )
    self.button.ClickableWhenViewportHidden = true
    self.button:SetActive(false)

    table.insert(self.connections, self.button.Click:Connect(function()
        self:Next()
    end))
    table.insert(self.connections, config.plugin.Unloading:Connect(function()
        self:Destroy()
    end))
    table.insert(self.connections, config.RunService:GetPropertyChangedSignal("RunState"):Connect(function()
        if self.destroyed then return end
        local runState = self.runService.RunState
        -- Paused Play/Run is still the same simulation; do not reset it.
        if runState == Enum.RunState.Paused then return end
        local phase = if runState == Enum.RunState.Stopped then "edit" else "play"
        if phase == self.phase then return end
        self:_release()
        self.phase = phase
        -- The runtime Workspace can be swapped when Play begins. Discover
        -- plots after that transition, not from the old edit-mode collection.
        task.defer(function()
            if self.destroyed or self.phase ~= phase then return end
            self:_refresh()
        end)
    end))

    self:_refresh()
    print("[game1][plots] toolbar ready · button=Game1Plots · initial=hidden")
    return self
end

function PlotsVisibility:_cancel(instance: Instance)
    local tween = self.tweens[instance]
    if tween then
        self.tweens[instance] = nil
        tween:Cancel()
    end
end

function PlotsVisibility:_fade(instance: Instance, property: string, target: number)
    self:_cancel(instance)
    if (instance :: any)[property] == target then return end
    local tween = self.tweenService:Create(instance, FADE, { [property] = target })
    self.tweens[instance] = tween
    tween.Completed:Connect(function()
        if self.tweens[instance] == tween then self.tweens[instance] = nil end
    end)
    tween:Play()
end

function PlotsVisibility:_snapshot(part: BasePart)
    if not self.originalProperties[part] then
        local saved = StudioPlotsPartPolicy.Capture(part)
        saved.collisionGroup = StudioPlotsSelectionFilter.OriginalGroup(part)
        self.originalProperties[part] = saved
    end
    return self.originalProperties[part]
end

function PlotsVisibility:_restore(part: BasePart)
    self:_cancel(part)
    local original = self.originalProperties[part]
    if original then
        self.selectionFilter:Restore(part, original.collisionGroup)
        StudioPlotsPartPolicy.Restore(part, original)
    end
    self.originalProperties[part] = nil
end

function PlotsVisibility:_removeHiddenSelection()
    if self.phase ~= "edit" or not self.selection then return end
    local kept = {}
    local changed = false
    for _, item in ipairs(self.selection:Get()) do
        local hidden = false
        for volume, _ in pairs(self.volumeParts) do
            if item == volume and self.state == 0 then
                hidden = true
                break
            end
        end
        if not hidden then
            for part, _ in pairs(self.numberParts) do
                -- Never deselect a volume or plot folder merely because it
                -- contains a hidden numbered model.
                local isVolumeOrFolder = self.volumeParts[item] == true
                if not isVolumeOrFolder then
                    for volume, _ in pairs(self.volumeParts) do
                        if item:IsAncestorOf(volume) then
                            isVolumeOrFolder = true
                            break
                        end
                    end
                end
                if (item == part or (item:IsAncestorOf(part) and not isVolumeOrFolder))
                    and self.state ~= 2 then
                    hidden = true
                    break
                end
            end
        end
        if hidden then changed = true else table.insert(kept, item) end
    end
    if changed then self.selection:Set(kept) end
end

function PlotsVisibility:_overlay(volume: BasePart)
    local adornment = self.overlays[volume]
    if adornment then return adornment end

    -- CoreGui is not serialized into the place. Adornee follows the volume's
    -- CFrame automatically; Size is mirrored for resizing in Edit mode.
    adornment = Instance.new("BoxHandleAdornment")
    adornment.Name = "Game1PlotsPreview"
    adornment.Adornee = volume
    adornment.Size = volume.Size
    adornment.Color3 = VOLUME_COLOR
    adornment.Transparency = 1
    adornment.AlwaysOnTop = false
    adornment.Parent = self.coreGui
    self.overlays[volume] = adornment
    self.sizeConnections[volume] = volume:GetPropertyChangedSignal("Size"):Connect(function()
        adornment.Size = volume.Size
    end)
    return adornment
end

function PlotsVisibility:_refresh()
    if self.destroyed then return 0, 0, 0 end
    local entries, missingVolumes, missingNumbers = StudioPlotsCatalog.Collect(self.workspace)
    local currentVolumes = {}
    local currentNumbers = {}
    local playtest = self.phase == "play"
    for _, entry in ipairs(entries) do
        local volume = entry.volume
        currentVolumes[volume] = true
        local volumeOriginal = self:_snapshot(volume)
        if playtest then
            self.selectionFilter:Restore(volume, volumeOriginal.collisionGroup)
            StudioPlotsPartPolicy.Play(volume, volumeOriginal,
                self.state ~= 0, true, VOLUME_COLOR, VOLUME_ALPHA)
        else
            -- StudioSelectable filtering makes the invisible volume truly
            -- click-through in the editor, without touching scene geometry.
            StudioPlotsPartPolicy.Edit(volume, volumeOriginal, self.state ~= 0)
            if self.state == 0 then
                self.selectionFilter:Hide(volume, volumeOriginal.collisionGroup)
            else
                self.selectionFilter:Restore(volume, volumeOriginal.collisionGroup)
            end
            volume.LocalTransparencyModifier = 1
            local overlay = self:_overlay(volume)
            self:_fade(overlay, "Transparency", if self.state == 0 then 1 else VOLUME_ALPHA)
        end
        for _, numberPart in ipairs(entry.numberParts) do
            currentNumbers[numberPart] = true
            local fresh = self.originalProperties[numberPart] == nil
            local numberOriginal = self:_snapshot(numberPart)
            if playtest then
                self.selectionFilter:Restore(numberPart, numberOriginal.collisionGroup)
                StudioPlotsPartPolicy.Play(numberPart, numberOriginal,
                    self.state == 2, false, VOLUME_COLOR, VOLUME_ALPHA)
            else
                StudioPlotsPartPolicy.Edit(numberPart, numberOriginal, self.state == 2)
                if self.state == 2 then
                    self.selectionFilter:Restore(numberPart, numberOriginal.collisionGroup)
                else
                    self.selectionFilter:Hide(numberPart, numberOriginal.collisionGroup)
                end
                if fresh then numberPart.LocalTransparencyModifier = 1 end
                self:_fade(numberPart, "LocalTransparencyModifier",
                    if self.state == 2 then numberOriginal.localTransparency else 1)
            end
        end
    end

    for volume, _ in pairs(self.volumeParts) do
        if not currentVolumes[volume] then
            self:_restore(volume)
            local overlay = self.overlays[volume]
            if overlay then
                self:_cancel(overlay)
                overlay:Destroy()
                self.overlays[volume] = nil
            end
            local connection = self.sizeConnections[volume]
            if connection then connection:Disconnect() end
            self.sizeConnections[volume] = nil
        end
    end
    for part, _ in pairs(self.numberParts) do
        if not currentNumbers[part] then self:_restore(part) end
    end
    self.volumeParts = currentVolumes
    self.numberParts = currentNumbers
    if not playtest then self:_removeHiddenSelection() end
    return #entries, missingVolumes, missingNumbers
end

function PlotsVisibility:Next()
    if self.destroyed then return end
    if self.phase ~= "edit" then
        warn("[game1][plots] Plots preview works only in Studio Edit mode")
        return
    end
    local nextState = (self.state + 1) % 3
    local plots = self.workspace:FindFirstChild("Plots")
    if not plots or not plots:IsA("Folder") then
        warn("[game1][plots] Workspace.Plots folder not found")
        return
    end
    self.state = nextState
    self.button:SetActive(nextState ~= 0)
    local volumes, missingVolumes, missingNumbers = self:_refresh()
    if volumes == 0 then
        self.state = 0
        self.button:SetActive(false)
        warn("[game1][plots] No plot volumes found in Workspace.Plots/01..50")
        return
    end
    print(("[game1][plots] %s · volumes=%d · missing volumes=%d · missing numbers=%d")
        :format(({"hidden", "volumes", "volumes + numbers"})[nextState + 1], volumes, missingVolumes, missingNumbers))
end

function PlotsVisibility:_release()
    for instance, tween in pairs(self.tweens) do
        self.tweens[instance] = nil
        tween:Cancel()
    end
    for part, original in pairs(self.originalProperties) do
        self.selectionFilter:Restore(part, original.collisionGroup)
        StudioPlotsPartPolicy.Restore(part, original)
    end
    table.clear(self.originalProperties)
    for _, connection in pairs(self.sizeConnections) do connection:Disconnect() end
    table.clear(self.sizeConnections)
    for _, overlay in pairs(self.overlays) do overlay:Destroy() end
    table.clear(self.overlays)
    table.clear(self.volumeParts)
    table.clear(self.numberParts)
end

function PlotsVisibility:Destroy()
    if self.destroyed then return end
    self.destroyed = true
    self:_release()
    for _, connection in ipairs(self.connections) do connection:Disconnect() end
    table.clear(self.connections)
end

return table.freeze(PlotsVisibility)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">StudioRealEstateCollisionPolicy</string>
          <string name="Source"><![CDATA[-- Real Estate physics layer. Only this module writes MeshPart physics.
-- All authored visual parts are DoubleSided by default; COL_* remains physics-only.
local CollectionService = game:GetService("CollectionService")
local Policy = {}
local COLLIDER_TAG = "Game1RealEstateCollider"

local FIDELITY = {
    Box = Enum.CollisionFidelity.Box,
    Hull = Enum.CollisionFidelity.Hull,
    Default = Enum.CollisionFidelity.Default,
    PreciseConvexDecomposition = Enum.CollisionFidelity.PreciseConvexDecomposition,
}

function Policy.IsCollider(name: string): boolean
    local lower = string.lower(name)
    return lower:sub(1, 4) == "col_" or lower:find("_col_", 1, true) ~= nil
        or lower:sub(-4) == "_col"
end

local function preciseByDefault(name: string): boolean
    local lower = string.lower(name)
    return Policy.IsCollider(name) or lower == "door" or lower:sub(1, 5) == "door_"
        or lower:find("glass", 1, true) ~= nil
end

function Policy.Apply(mesh: MeshPart, name: string, raw: any)
    local collider = Policy.IsCollider(name)
    local settings = if typeof(raw) == "table" then raw else {}
    local preciseDefault = preciseByDefault(name)
    local noCollide = if typeof(settings.noCollide) == "boolean" then settings.noCollide
        else not preciseDefault
    -- The physical shape must be Precise for EVERY collidable part, regardless
    -- of its name or an old saved Default/Box/Hull value.
    local fidelity = if not noCollide then "PreciseConvexDecomposition" else settings.collisionFidelity
    if typeof(fidelity) ~= "string" or FIDELITY[fidelity] == nil then
        fidelity = if preciseDefault then "PreciseConvexDecomposition" else "Box"
    end

    -- Roblox requires CanQuery=true for collidable parts. Touch remains off
    -- (collision physics does not require a Touched event listener).
    mesh.CanCollide = not noCollide
    mesh.CanQuery = not noCollide
    mesh.CanTouch = false
    mesh.CollisionFidelity = FIDELITY[fidelity]
    mesh.DoubleSided = if typeof(settings.doubleSided) == "boolean" then settings.doubleSided else true
    -- Capture the *authoring policy* on the MeshPart itself. Studio copies can
    -- be revalidated without a Host Agent request or a full model reimport.
    -- This metadata is not a second registry: it is the applied snapshot.
    mesh:SetAttribute("Game1RealEstateNoCollide", noCollide)
    mesh:SetAttribute("Game1RealEstateCollisionFidelity", fidelity)
    mesh:SetAttribute("Game1RealEstateDoubleSided", mesh.DoubleSided)

    if collider then
        mesh.Transparency = 1
        mesh.CastShadow = false
        mesh.Anchored = true
        mesh:SetAttribute("Game1RealEstatePhysicsOnly", true)
        mesh:SetAttribute("Game1RealEstateDestructible", settings.destructible == true)
        CollectionService:AddTag(mesh, COLLIDER_TAG)
    else
        -- Houses are static buildings. Published MeshParts may be unanchored.
        if string.lower(name) == "house" then
            mesh.Anchored = true
        end
        mesh:SetAttribute("Game1RealEstatePhysicsOnly", nil)
        mesh:SetAttribute("Game1RealEstateDestructible", nil)
        if CollectionService:HasTag(mesh, COLLIDER_TAG) then
            CollectionService:RemoveTag(mesh, COLLIDER_TAG)
        end
    end
end

-- Studio copy/paste does not pass through Model.Place/PartSync. Reassert the
-- imported physical shape after a managed house enters Workspace, preserving
-- the explicit mesh settings recorded by Apply. Older templates (before this
-- snapshot existed) fall back to their copied collision toggles.
function Policy.RestoreCopiedMesh(mesh: MeshPart): boolean
    local noCollide = mesh:GetAttribute("Game1RealEstateNoCollide")
    if typeof(noCollide) ~= "boolean" then
        noCollide = not mesh.CanCollide
    end
    local fidelity = mesh:GetAttribute("Game1RealEstateCollisionFidelity")
    if typeof(fidelity) ~= "string" or FIDELITY[fidelity] == nil then
        fidelity = mesh.CollisionFidelity.Name
    end
    local doubleSided = mesh:GetAttribute("Game1RealEstateDoubleSided")
    if typeof(doubleSided) ~= "boolean" then
        doubleSided = mesh.DoubleSided
    end
    local expected = if noCollide then (FIDELITY[fidelity] or FIDELITY.Box)
        else FIDELITY.PreciseConvexDecomposition
    local needsRestore = mesh.CollisionFidelity ~= expected
        or mesh.CanCollide ~= not noCollide
        or mesh.CanQuery ~= not noCollide
        or mesh.CanTouch ~= false
        or mesh.DoubleSided ~= doubleSided
    if not needsRestore then return false end
    Policy.Apply(mesh, mesh.Name, {
        noCollide = noCollide,
        collisionFidelity = fidelity,
        doubleSided = doubleSided,
        destructible = mesh:GetAttribute("Game1RealEstateDestructible") == true,
    })
    return true
end

return table.freeze(Policy)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">StudioRealEstateHouseFrame</string>
          <string name="Source"><![CDATA[-- Author-space transform for all Real Estate Studio sync paths.
-- The MeshPart CFrame tracks its geometry centre, which can shift after an
-- FBX revision. The authored import pivot (CFrame * PivotOffset) is the
-- stable registration frame. Never match replacements by CFrame alone.
local RigSwap = require(script.Parent.StudioManagedRigSwap)
local HouseFrame = {}

function HouseFrame.Find(root: Instance): MeshPart?
    local match: MeshPart? = nil
    for _, instance in root:GetDescendants() do
        if instance:IsA("MeshPart") and instance.Name == "house" then
            if match then return nil end
            match = instance
        end
    end
    return match
end

function HouseFrame.Relative(source: MeshPart, target: MeshPart): CFrame
    return target:GetPivot() * source:GetPivot():Inverse()
end

function HouseFrame.Align(rig: Model, sourceAnchor: MeshPart, targetPivot: CFrame, context: string)
    RigSwap.AlignToAnchor(rig, sourceAnchor, targetPivot, context)
end

return table.freeze(HouseFrame)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">StudioRealEstateModel</string>
          <string name="Source"><![CDATA[-- Studio assembly for any number of independent Real Estate MeshPart rigs.
-- This adapter validates the complete template before touching ServerStorage.
local HttpService = game:GetService("HttpService")
local StudioTextureAppearance = require(script.Parent.StudioTextureAppearance)
local StudioRealEstateRigValidation = require(script.Parent.StudioRealEstateRigValidation)
local StudioRealEstateCollisionPolicy = require(script.Parent.StudioRealEstateCollisionPolicy)
local StudioRealEstatePlacedCollisionSync = require(script.Parent.StudioRealEstatePlacedCollisionSync)
local StudioRealEstatePlacedVisualSync = require(script.Parent.StudioRealEstatePlacedVisualSync)
local PlacedTargets = require(script.Parent.StudioRealEstatePlacedTargets)
local HouseFrame = require(script.Parent.StudioRealEstateHouseFrame)
local PartPlacement = require(script.Parent.StudioRealEstatePartPlacement)
local StudioRealEstateModel = {}

-- Every authored bone must survive publication before a template is replaced.
local DOOR_HINGE = "door_01_hinge_socket"

local function loadIndependentRig(assetService: any, assetId: number, part: string): Model
    local lastError = ""
    for _ = 1, 8 do
        local ok, loaded = pcall(function()
            return assetService:LoadAssetAsync(assetId)
        end)
        if ok and loaded ~= nil then
            if loaded:IsA("Model") then
                return loaded
            end
            local container = Instance.new("Model")
            loaded.Parent = container
            return container
        end
        lastError = tostring(loaded)
        task.wait(2)
    end
    error("Real Estate " .. part .. " Model Asset ID " .. tostring(assetId)
        .. " could not be loaded: " .. lastError)
end

local function orderedParts(manifests: any): {string}
    if typeof(manifests) ~= "table" or typeof(manifests.house) ~= "table" then
        error("Real Estate requires an authored house mesh and its bone manifest")
    end
    local result = {"house"}
    for part, manifest in manifests do
        if typeof(part) ~= "string" or typeof(manifest) ~= "table" then
            error("Invalid Real Estate mesh manifest")
        end
        if part ~= "house" then
            table.insert(result, part)
        end
    end
    table.sort(result, function(a, b)
        if a == "house" then return true end
        if b == "house" then return false end
        return a:lower() < b:lower()
    end)
    return result
end

-- Texture-only refresh for managed Estate copies already placed in Workspace.
-- Never replace models or touch pivots/part transforms during atlas selection.
local function setGlassAppearance(mesh: MeshPart, enabled: boolean)
    if enabled then
        mesh.Transparency = 0.02
        mesh:SetAttribute('Game1RealEstateGlassApplied', true)
    elseif mesh:GetAttribute('Game1RealEstateGlassApplied') == true then
        mesh.Transparency = 0
        mesh:SetAttribute('Game1RealEstateGlassApplied', nil)
    end
end

local function refreshPlaced(slug: string, imageAssets: {[string]: string}, imageAlpha: {[string]: any}, meshOptions: any, placedTargets: {Model}): (number,number)
    local changed = 0
    local found = 0
    for _, instance in placedTargets do
        found += 1
        local applied = false
        for _, child in instance:GetDescendants() do
            if child:IsA("MeshPart") then
                local part = string.lower(child.Name)
                local settings = meshOptions[part]
                if imageAssets[part] then
                    StudioTextureAppearance.Apply(child, "rbxassetid://" .. imageAssets[part], imageAlpha[part])
                    setGlassAppearance(child, typeof(settings) == 'table' and settings.glass == true)
                end
                if imageAssets[part] or StudioRealEstateCollisionPolicy.IsCollider(part) then
                    StudioRealEstateCollisionPolicy.Apply(child, part, settings)
                    applied = true
                end
            end
        end
        if applied then
            instance:SetAttribute("Game1TextureAssetIds", HttpService:JSONEncode(imageAssets))
            changed += 1
        end
    end
    return changed, found
end

function StudioRealEstateModel.Place(imported: Model, destination: Instance, slug: string,
    assetId: number, metadata: any, assetService: any): (Model, any)
    if slug == "" or slug == "." or slug == ".." or slug:find("[/\\]") then
        error("Invalid Real Estate slug")
    end
    local manifests = metadata.expectedMeshes
    local parts = orderedParts(manifests)
    local rigIds = metadata.rigAssetIds
    if typeof(rigIds) ~= "table" or tonumber(rigIds.house) ~= assetId then
        error("Studio Sync requires published Model Asset IDs for every Real Estate mesh")
    end
    local authoredPlacements = typeof(metadata.authoredPlacements) == "table" and metadata.authoredPlacements or {}
    local meshOptions = typeof(metadata.meshOptions) == 'table' and metadata.meshOptions or {}
    local imageAssets = {}
    local imageAlpha = {}
    for _, entry in metadata.textures or {} do
        local part = tostring(entry.slot or "")
        local id = tonumber(entry.assetId)
        if id and id > 0 and manifests[part] ~= nil then
            imageAssets[part] = tostring(math.floor(id))
            imageAlpha[part] = entry.usesAlpha
        end
    end
    local seenModels = {}
    for _, part in parts do
        local id = tonumber(rigIds[part])
        if not id or id <= 0 or seenModels[id]
            or (not StudioRealEstateCollisionPolicy.IsCollider(part) and not imageAssets[part]) then
            error("Real Estate " .. part .. " requires a published Model Asset"
                .. (StudioRealEstateCollisionPolicy.IsCollider(part) and "" or " and Image Asset"))
        end
        seenModels[id] = true
    end
    local previous = destination:FindFirstChild(slug)
    if previous and (not previous:IsA("Model") or previous:GetAttribute("Game1RealEstateTemplate") ~= true) then
        error("refusing to overwrite unmanaged Real Estate instance: " .. slug)
    end

    -- Stage and verify ALL meshes before changing the existing template.
    local staged = {}
    local meshes = {}
    local bones = 0
    local rigWarnings = {}
    local missingSockets = {}
    local socketCount = 0
    local placementsRestored = 0
    local textureCount = 0
    local activePart = "house"
    local ok, problem = pcall(function()
        for _, part in parts do
            activePart = part
            local rig = part == "house" and imported
                or loadIndependentRig(assetService, tonumber(rigIds[part]) :: number, part)
            table.insert(staged, {part = part, rig = rig})
            local mesh, inspection = StudioRealEstateRigValidation.Verify(rig, part, manifests[part])
            meshes[part] = mesh
            if part ~= "house" then
                if PartPlacement.Align(rig, mesh, meshes.house,
                    authoredPlacements[part], authoredPlacements.house, part) then
                    placementsRestored += 1
                elseif authoredPlacements.house ~= nil then
                    table.insert(rigWarnings, part .. ": no authored placement for this mesh revision")
                end
            end
            bones += inspection.boneCount
            socketCount += inspection.socketCount
            for _, name in inspection.missingSockets do
                table.insert(missingSockets, part .. "/" .. name)
            end
            for _, warning in inspection.warnings do
                table.insert(rigWarnings, warning)
            end
        end
    end)
    if not ok then
        for _, entry in staged do
            if entry.rig ~= imported then
                entry.rig:Destroy()
            end
        end
        local detail = tostring(problem)
        error("Real Estate " .. activePart .. " Model Asset " .. tostring(rigIds[activePart])
            .. ": " .. detail, 0)
    end

    table.sort(missingSockets)
    local wrapper = Instance.new("Model")
    wrapper.Name = slug
    for _, entry in staged do
        local part = entry.part
        local rigName = part:sub(1, 1):upper() .. part:sub(2) .. "Rig"
        entry.rig.Name = rigName
        if StudioRealEstateCollisionPolicy.IsCollider(part) then
            entry.rig:SetAttribute("Game1RealEstatePhysicsRig", true)
            entry.rig:SetAttribute("Game1RealEstatePhysicsMeshName", part)
        end
        -- DoorAssembly is the only moving unit. Do not edit Bone.Transform:
        -- the hinge Bone identifies the world-space pivot for Model:PivotTo().
        if part == "door" and meshes[part]:FindFirstChild(DOOR_HINGE, true) then
            local hinge = meshes[part]:FindFirstChild(DOOR_HINGE, true) :: Bone
            local assembly = Instance.new("Model")
            assembly.Name = "DoorAssembly"
            assembly.Parent = wrapper
            entry.rig.Parent = assembly
            -- New Model has no PrimaryPart: WorldPivot sets the pivot without
            -- displacing any MeshPart or changing an authored bone pose.
            assembly.WorldPivot = hinge.TransformedWorldCFrame
            assembly:SetAttribute("Game1DoorHingeSocket", DOOR_HINGE)
            assembly:SetAttribute("Game1DoorPivotMode", "rigid_model")
            local closedLocal = meshes.house.CFrame:ToObjectSpace(assembly:GetPivot())
            assembly:SetAttribute("Game1DoorClosedLocalPivot",
                HttpService:JSONEncode({closedLocal:GetComponents()}))
        else
            entry.rig.Parent = wrapper
        end
        local settings = meshOptions[part]
        if not StudioRealEstateCollisionPolicy.IsCollider(part) then
            StudioTextureAppearance.Apply(meshes[part], "rbxassetid://" .. imageAssets[part], imageAlpha[part])
            setGlassAppearance(meshes[part], typeof(settings) == 'table' and settings.glass == true)
            textureCount += 1
        end
        StudioRealEstateCollisionPolicy.Apply(meshes[part], part, settings)
    end
    -- Align the new complete assembly to the previously registered house
    -- origin before swapping templates. A changed house geometry centre must
    -- not move the entire estate relative to existing placed copies.
    if previous then
        local previousHouse = HouseFrame.Find(previous)
        if not previousHouse then
            wrapper:Destroy()
            error("Full house sync: existing template house anchor is missing or ambiguous")
        end
        HouseFrame.Align(wrapper, meshes.house, previousHouse:GetPivot(), "full template house")
    end
    wrapper:SetAttribute("Game1RealEstateSocketContractComplete", #missingSockets == 0)
    wrapper:SetAttribute("Game1MissingRealEstateSockets", HttpService:JSONEncode(missingSockets))
    wrapper:SetAttribute("Game1RealEstateTemplate", true)
    wrapper:SetAttribute("Game1ModelAssetId", tostring(assetId))
    wrapper:SetAttribute("Game1HouseModelAssetId", tostring(assetId))
    if rigIds.door then
        wrapper:SetAttribute("Game1DoorModelAssetId", tostring(rigIds.door))
    end
    wrapper:SetAttribute("Game1RigAssetIds", HttpService:JSONEncode(rigIds))
    wrapper:SetAttribute("Game1TextureAssetIds", HttpService:JSONEncode(imageAssets))
    wrapper:SetAttribute("Game1RealEstateSlug", slug)
    wrapper:SetAttribute("Game1HouseLevel", tonumber(metadata.houseLevel) or 1)
    wrapper:SetAttribute("Game1PurchasePrice", tonumber(metadata.purchasePrice) or 1)
    wrapper:SetAttribute("Game1MinimumLevel", tonumber(metadata.minLevel) or 1)
    wrapper:SetAttribute("Game1SalePrice", tonumber(metadata.salePrice) or 1)
    wrapper.Parent = destination
    if previous then
        previous:Destroy()
    end
    -- Retrofit managed physics rigs into existing placed houses, preserving
    -- their CFrame and all user-owned models / furnishings.
    local placedTargets = PlacedTargets.List(slug)
    local collisionUpdated, collisionWarnings = StudioRealEstatePlacedCollisionSync.Update(wrapper, slug, placedTargets)
    for _, warning in collisionWarnings do
        table.insert(rigWarnings, warning)
    end
    local visualUpdated, visualFound, visualWarnings = StudioRealEstatePlacedVisualSync.Update(wrapper, slug, placedTargets)
    for _, warning in visualWarnings do
        table.insert(rigWarnings, warning)
    end
    -- Apply appearance independently; visual replacement may have been skipped
    -- safely for an incomplete/unmanaged placed house.
    local textureUpdated = select(1, refreshPlaced(slug, imageAssets, imageAlpha, meshOptions, placedTargets))
    return wrapper, {bonesValidated = true, rigsValidated = #parts,
        alignment = "authored-house-pivot",
        texturesApplied = textureCount, placedSyncVersion = 2, workspaceModelsUpdated = visualUpdated,
        workspaceModelsFound = visualFound,
        workspaceTextureModelsUpdated = textureUpdated,
        workspaceCollisionRigsUpdated = collisionUpdated,
        boneCount = bones, socketCount = socketCount,
        authoredPlacementsRestored = placementsRestored,
        socketContractComplete = #missingSockets == 0,
        missingSockets = missingSockets, rigWarnings = rigWarnings}
end

return table.freeze(StudioRealEstateModel)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">StudioRealEstatePartPlacement</string>
          <string name="Source"><![CDATA[-- Restore source-FBX mesh centres after independent Model Asset import.
-- One authored house coordinate frame; never apply hand-tuned part offsets.
-- Legacy manifests without placement data are left untouched.
local Placement = {}

local function triple(value: any, label: string): Vector3
    if typeof(value) ~= "table" or #value ~= 3 then
        error("Real Estate " .. label .. ": expected three numeric coordinates")
    end
    local components = {}
    for i = 1, 3 do
        local number = value[i]
        if typeof(number) ~= "number" or number ~= number or math.abs(number) == math.huge then
            error("Real Estate " .. label .. ": invalid numeric coordinate")
        end
        components[i] = number
    end
    return Vector3.new(components[1], components[2], components[3])
end

local function frame(raw: any, label: string): (Vector3, Vector3)
    if typeof(raw) ~= "table" or (raw.version ~= 1 and raw.version ~= 2) then
        error("Real Estate " .. label .. ": unsupported authored placement contract")
    end
    local center = triple(raw.centerInHouse, label .. " center")
    -- M184 v1 assumed (x,z,-y). Our actual FBX -> Roblox asset convention
    -- is (-x,z,y). Convert stored v1 offsets without rewriting SQLite.
    if raw.version == 1 then
        center = Vector3.new(-center.X, center.Y, -center.Z)
    end
    local size = triple(raw.size, label .. " size")
    if size.X <= 0 or size.Y <= 0 or size.Z <= 0 then
        error("Real Estate " .. label .. ": invalid authored size")
    end
    return center, size
end

local function close(a: number, b: number, tolerance: number): boolean
    return math.abs(a - b) <= tolerance
end

function Placement.Align(rig: Model, mesh: MeshPart, house: MeshPart,
    authored: any, authoredHouse: any, part: string): boolean
    -- Old houses and standalone mesh revisions cannot be assigned guessed
    -- transforms. Their existing placement behaviour is deliberately retained.
    if authored == nil or authoredHouse == nil then
        return false
    end
    local center, size = frame(authored, part)
    local _, houseSize = frame(authoredHouse, "house")
    local ratio = house.Size.X / houseSize.X
    if ratio <= 0 or not close(house.Size.Y / houseSize.Y, ratio, ratio * 0.04)
        or not close(house.Size.Z / houseSize.Z, ratio, ratio * 0.04) then
        error("Real Estate " .. part .. ": published house dimensions differ from FBX proportions; refusing placement")
    end
    local tolerance = math.max(0.04, ratio * 0.04)
    if not close(mesh.Size.X, size.X * ratio, tolerance * size.X)
        or not close(mesh.Size.Y, size.Y * ratio, tolerance * size.Y)
        or not close(mesh.Size.Z, size.Z * ratio, tolerance * size.Z) then
        error("Real Estate " .. part .. ": published mesh dimensions differ from authored FBX; refusing placement")
    end
    local targetPosition = house.CFrame:PointToWorldSpace(center * ratio)
    local delta = targetPosition - mesh.Position
    local placementMode = "already-aligned"
    if delta.Magnitude > 0.025 then
        -- The Roblox FBX importer may shift a skinned MeshPart origin while
        -- retaining the correct world rest frame of its root Bone. Moving the
        -- entire rig would then move an already-correct hinge and sockets.
        -- Instead rebase the mesh origin and its direct root attachments so
        -- bone world-rest frames remain unchanged, including all child sockets.
        local roots = {}
        local boneCount = 0
        for _, descendant in rig:GetDescendants() do
            if descendant:IsA("Bone") then
                boneCount += 1
            elseif descendant:IsA("BasePart") and descendant ~= mesh then
                error("Real Estate " .. part .. ": cannot rebase a multi-part skinned rig")
            end
        end
        for _, child in mesh:GetChildren() do
            if child:IsA("Attachment") then
                table.insert(roots, {attachment = child, world = child.WorldCFrame})
            end
        end
        if boneCount > 0 then
            placementMode = "skinned-root-rebase"
            if #roots == 0 then
                error("Real Estate " .. part .. ": skinned mesh has no root attachments to rebase")
            end
            local oldMesh = mesh.CFrame
            mesh.CFrame = CFrame.new(delta) * oldMesh
            for _, entry in roots do
                entry.attachment.CFrame = mesh.CFrame:ToObjectSpace(entry.world)
            end
            for _, entry in roots do
                if (entry.attachment.WorldCFrame.Position - entry.world.Position).Magnitude > 0.001
                    or (entry.attachment.WorldCFrame.LookVector - entry.world.LookVector).Magnitude > 0.001
                    or (entry.attachment.WorldCFrame.UpVector - entry.world.UpVector).Magnitude > 0.001 then
                    error("Real Estate " .. part .. ": root attachment moved during mesh origin recovery")
                end
            end
        else
            placementMode = "static-model-pivot"
            -- Static parts have no bone rest frames to protect.
            rig:PivotTo(CFrame.new(delta) * rig:GetPivot())
        end
    end
    if (mesh.Position - targetPosition).Magnitude > 0.025 then
        error("Real Estate " .. part .. ": authored mesh position not restored")
    end
    -- Visible in the existing Studio house diagnostic without extra scripts.
    rig:SetAttribute("Game1AuthoredPlacementMode", placementMode)
    rig:SetAttribute("Game1AuthoredPlacementDelta", delta)
    rig:SetAttribute("Game1AuthoredPlacementVersion", authored.version)
    return true
end

return table.freeze(Placement)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">StudioRealEstatePartSync</string>
          <string name="Source"><![CDATA[-- Atomic, single-rig refresh of a managed Real Estate template.
-- Other rigs, their Asset IDs, and their placed transforms are never rebuilt.
local HttpService = game:GetService("HttpService")
local Validation = require(script.Parent.StudioRealEstateRigValidation)
local Collision = require(script.Parent.StudioRealEstateCollisionPolicy)
local Texture = require(script.Parent.StudioTextureAppearance)
local PlacedTargets = require(script.Parent.StudioRealEstatePlacedTargets)
local HouseFrame = require(script.Parent.StudioRealEstateHouseFrame)
local PartPlacement = require(script.Parent.StudioRealEstatePartPlacement)

local PartSync = {}

local function rigName(part: string): string
    return part:sub(1, 1):upper() .. part:sub(2) .. "Rig"
end

local function decodeMap(value: any): any
    if typeof(value) ~= "string" then return {} end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(value) end)
    return if ok and typeof(decoded) == "table" then decoded else {}
end

local function existingPart(root: Model, part: string): Model?
    local name = if part == "door" and root:FindFirstChild("DoorAssembly")
        then "DoorAssembly" else rigName(part)
    local child = root:FindFirstChild(name)
    if child ~= nil and not child:IsA("Model") then
        error("refusing to replace a non-Model part " .. name)
    end
    return child :: Model?
end

local function applyGlass(mesh: MeshPart, enabled: boolean)
    if enabled then
        mesh.Transparency = 0.02
        mesh:SetAttribute("Game1RealEstateGlassApplied", true)
    end
end

function PartSync.Place(imported: Model, destination: Instance, slug: string,
    assetId: number, metadata: any): (Model, any)
    local part = tostring(metadata.syncPart or "")
    local manifests = metadata.expectedMeshes
    local rigs = metadata.rigAssetIds
    if typeof(manifests) ~= "table" or typeof(rigs) ~= "table"
        or typeof(manifests[part]) ~= "table" or tonumber(rigs[part]) ~= assetId then
        error("targeted Real Estate Sync requires a registered mesh and its published Model Asset")
    end
    local template = destination:FindFirstChild(slug)
    if not template or not template:IsA("Model")
        or template:GetAttribute("Game1RealEstateTemplate") ~= true then
        error("No managed Real Estate template exists; run full Sync Studio first")
    end
    local wrapper = template :: Model
    local old = existingPart(wrapper, part)
    if not old then
        error("Targeted rig " .. part .. " not found in template; run full Sync Studio first")
    end
    local mesh, check = Validation.Verify(imported, part, manifests[part])
    local imageId, usesAlpha = nil, nil
    for _, entry in metadata.textures or {} do
        if tostring(entry.slot) == part then
            imageId = tonumber(entry.assetId)
            usesAlpha = entry.usesAlpha
        end
    end
    if not Collision.IsCollider(part) and (not imageId or imageId <= 0) then
        error("Targeted Real Estate rig " .. part .. " has no published Image Asset")
    end
    local settings = (typeof(metadata.meshOptions) == "table" and metadata.meshOptions[part]) or {}
    if imageId then
        Texture.Apply(mesh, "rbxassetid://" .. tostring(math.floor(imageId)), usesAlpha)
        applyGlass(mesh, typeof(settings) == "table" and settings.glass == true)
    end
    Collision.Apply(mesh, part, settings)
    -- A revised FBX can move the MeshPart geometry centre, but its authored
    -- pivot is the house-space origin. Keep that origin fixed in ServerStorage.
    local authoredPlacementRestored = false
    if part ~= "house" then
        local anchor = HouseFrame.Find(wrapper)
        if not anchor then
            error("Targeted Real Estate Sync: existing house anchor missing or ambiguous")
        end
        local placements = typeof(metadata.authoredPlacements) == "table" and metadata.authoredPlacements or {}
        authoredPlacementRestored = PartPlacement.Align(imported, mesh, anchor,
            placements[part], placements.house, part)
    end
    if part == "house" then
        local oldHouse = HouseFrame.Find(old)
        if not oldHouse then
            error("Targeted house sync: existing template house anchor is missing or ambiguous")
        end
        HouseFrame.Align(imported, mesh, oldHouse:GetPivot(), "template house")
    end
    local replacement: Model = imported
    imported.Name = rigName(part)
    if Collision.IsCollider(part) then
        imported:SetAttribute("Game1RealEstatePhysicsRig", true)
        imported:SetAttribute("Game1RealEstatePhysicsMeshName", part)
    end
    imported:SetAttribute("Game1RealEstateManagedPart", part)
    if part == "door" then
        local hinge = mesh:FindFirstChild("door_01_hinge_socket", true)
        if hinge and hinge:IsA("Bone") then
            local assembly = Instance.new("Model")
            assembly.Name = "DoorAssembly"
            imported.Parent = assembly
            assembly.WorldPivot = hinge.TransformedWorldCFrame
            assembly:SetAttribute("Game1DoorHingeSocket", "door_01_hinge_socket")
            assembly:SetAttribute("Game1DoorPivotMode", "rigid_model")
            local anchor = HouseFrame.Find(wrapper)
            if not anchor then error("house anchor missing; target rig not replaced") end
            local localPivot = anchor.CFrame:ToObjectSpace(assembly:GetPivot())
            assembly:SetAttribute("Game1DoorClosedLocalPivot", HttpService:JSONEncode({localPivot:GetComponents()}))
            replacement = assembly
        end
    end
    -- Validate and prepare before replacing anything; name collision is
    -- transient only after the staged assembly is accepted.
    local oldName = old.Name
    local stagedName = oldName .. "_m140_old"
    if wrapper:FindFirstChild(stagedName) then
        error("Unresolved previous targeted sync staging: " .. stagedName)
    end
    old.Name = stagedName
    local ok, problem = pcall(function()
        replacement.Name = oldName
        replacement.Parent = wrapper
    end)
    if not ok then
        old.Name = oldName
        replacement:Destroy()
        error("Real Estate targeted rig swap failed: " .. tostring(problem))
    end
    old:Destroy()
    local savedIds = decodeMap(wrapper:GetAttribute("Game1RigAssetIds"))
    savedIds[part] = tostring(assetId)
    wrapper:SetAttribute("Game1RigAssetIds", HttpService:JSONEncode(savedIds))
    if part == "house" then
        wrapper:SetAttribute("Game1HouseModelAssetId", tostring(assetId))
        wrapper:SetAttribute("Game1ModelAssetId", tostring(assetId))
    elseif part == "door" then
        wrapper:SetAttribute("Game1DoorModelAssetId", tostring(assetId))
    end
    if imageId then
        local savedTextures = decodeMap(wrapper:GetAttribute("Game1TextureAssetIds"))
        savedTextures[part] = tostring(math.floor(imageId))
        wrapper:SetAttribute("Game1TextureAssetIds", HttpService:JSONEncode(savedTextures))
    end
    -- Only this mesh is updated on author-managed placed houses. Use the house
    -- anchor to preserve each house's existing world transform; never rebuild
    -- unrelated meshes or player-owned furniture.
    local placedCount = 0
    local placedFound = 0
    local warnings = {}
    local referenceHouse = HouseFrame.Find(wrapper)
    if not referenceHouse then
        table.insert(warnings, "Template house anchor missing or ambiguous; placed rigs not updated")
    end
    for _, root in PlacedTargets.List(slug) do
        placedFound += 1
        local placed = HouseFrame.Find(root)
        local placedOld = existingPart(root, part)
        if not referenceHouse or not placed or not placedOld then
            table.insert(warnings, root:GetFullName() .. ": target rig or house anchor missing")
            continue
        end
        local transform = HouseFrame.Relative(referenceHouse, placed)
        local cloned: Model? = nil
        local success, cause = pcall(function()
            local staged = replacement:Clone()
            cloned = staged
            -- Preserve the placed door's current pivot/open state. Do not
            -- introduce new socket offsets or rewrite Blender-authored poses.
            if part == "house" then
                local stagedHouse = HouseFrame.Find(staged)
                local oldHouse = HouseFrame.Find(placedOld)
                if not stagedHouse or not oldHouse then
                    error("placed house anchor missing or ambiguous")
                end
                HouseFrame.Align(staged, stagedHouse, oldHouse:GetPivot(), "placed house")
            else
                local target = if part == "door" then placedOld:GetPivot()
                    else transform * replacement:GetPivot()
                staged:PivotTo(target)
            end
            local originalName = placedOld.Name
            local backupName = originalName .. "_M152_Previous"
            if root:FindFirstChild(backupName) then
                error("Unresolved previous staged rig: " .. backupName)
            end
            placedOld.Name = backupName
            staged.Name = originalName
            local attached, attachError = pcall(function() staged.Parent = root end)
            if not attached then
                placedOld.Name = originalName
                error(attachError)
            end
        end)
        if success then
            placedOld:Destroy()
            PlacedTargets.MarkPlaced(root)
            local placedIds = decodeMap(root:GetAttribute("Game1RigAssetIds"))
            placedIds[part] = tostring(assetId)
            root:SetAttribute("Game1RigAssetIds", HttpService:JSONEncode(placedIds))
            if part == "door" then
                root:SetAttribute("Game1DoorModelAssetId", tostring(assetId))
            elseif part == "house" then
                root:SetAttribute("Game1HouseModelAssetId", tostring(assetId))
                root:SetAttribute("Game1ModelAssetId", tostring(assetId))
            end
            placedCount += 1
        else
            if cloned then cloned:Destroy() end
            table.insert(warnings, root:GetFullName() .. ": " .. tostring(cause))
        end
    end
    return wrapper, {bonesValidated = true, rigsValidated = 1,
        texturesApplied = if imageId then 1 else 0,
        partialSync = true, part = part, placedSyncVersion = 2, workspaceModelsUpdated = placedCount,
        workspaceModelsFound = placedFound,
        alignment = "authored-house-pivot",
        boneCount = check.boneCount,
        authoredPlacementsRestored = if authoredPlacementRestored then 1 else 0,
        missingSockets = check.missingSockets, rigWarnings = warnings}
end

return table.freeze(PartSync)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">StudioRealEstatePlacedCollisionSync</string>
          <string name="Source"><![CDATA[-- Repair *only* authoring-managed collision rigs of already placed Estates.
-- A Studio sync of a new COL_* Model Asset must not leave older placed
-- buildings walking on the obsolete visual-mesh collision approximation.
-- No repositioning / replacement of visual house, door, or edited props.
local CollisionPolicy = require(script.Parent.StudioRealEstateCollisionPolicy)
local Targets = require(script.Parent.StudioRealEstatePlacedTargets)
local HouseFrame = require(script.Parent.StudioRealEstateHouseFrame)
local Sync = {}

local function authoredRigs(template: Model): {[string]: Model}
    local result = {}
    for _, rig in template:GetChildren() do
        if rig:IsA("Model") and rig:GetAttribute("Game1RealEstatePhysicsRig") == true then
            local part = rig:GetAttribute("Game1RealEstatePhysicsMeshName")
            if typeof(part) == "string" and CollisionPolicy.IsCollider(part) then
                result[part] = rig
            end
        end
    end
    return result
end

function Sync.Update(template: Model, slug: string, placedTargets: {Model}?): (number, {string})
    local physicsRigs = authoredRigs(template)
    if next(physicsRigs) == nil then return 0, {} end
    local referenceHouse = HouseFrame.Find(template)
    if not referenceHouse then
        return 0, {"collision sync skipped: template house anchor missing or ambiguous"}
    end
    local changed = 0
    local warnings = {}
    local targets = placedTargets or Targets.List(slug)
    for _, root in targets do
        local placedHouse = HouseFrame.Find(root)
        if not placedHouse then
            table.insert(warnings, "collision sync skipped for " .. root:GetFullName()
                .. ": placed house anchor missing or ambiguous")
            continue
        end
        local relative = HouseFrame.Relative(referenceHouse, placedHouse)
        for part, source in physicsRigs do
            local old = root:FindFirstChild(source.Name)
            if old and (not old:IsA("Model") or old:GetAttribute("Game1RealEstatePhysicsRig") ~= true
                or old:GetAttribute("Game1RealEstatePhysicsMeshName") ~= part) then
                table.insert(warnings, "collision rig " .. source.Name
                    .. " already exists but is not managed in " .. root:GetFullName())
                continue
            end
            local clone: Model? = nil
            local ok, problem = pcall(function()
                local staged = source:Clone()
                clone = staged
                staged:PivotTo(relative * source:GetPivot())
                staged.Parent = root
            end)
            if not ok then
                if clone then clone:Destroy() end
                table.insert(warnings, "collision rig " .. part .. " could not be staged in "
                    .. root:GetFullName() .. ": " .. tostring(problem))
                continue
            end
            if old then old:Destroy() end
            changed += 1
        end
    end
    return changed, warnings
end

return table.freeze(Sync)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">StudioRealEstatePlacedPhysicsGuard</string>
          <string name="Source"><![CDATA[-- Studio Edit Mode: normalize a managed Estate pasted or dragged from
-- ServerStorage into Workspace. The normal Sync path already normalizes its
-- staged MeshParts; manual copy/paste does not call that path.
-- One event-driven pass per newly inserted managed root; no Workspace polling.
local CollisionPolicy = require(script.Parent.StudioRealEstateCollisionPolicy)
local PlacedTargets = require(script.Parent.StudioRealEstatePlacedTargets)
local Guard = {}

function Guard.Start(Workspace: any, RunService: any): () -> ()
    local pending = setmetatable({}, {__mode = "k"})
    local enabled = true

    local function onAdded(instance: Instance)
        if not enabled or RunService:IsRunning() or not instance:IsA("Model") then
            return
        end
        local slug = instance:GetAttribute("Game1RealEstateSlug")
        if typeof(slug) ~= "string" or slug == "" or pending[instance] then
            return
        end
        -- A nested managed model is not another house. The attribute belongs
        -- to the top-level template/placed root, not its individual rigs.
        local ancestor = instance.Parent
        while ancestor and ancestor ~= Workspace do
            if ancestor:IsA("Model") and ancestor:GetAttribute("Game1RealEstateSlug") == slug then
                return
            end
            ancestor = ancestor.Parent
        end
        pending[instance] = true
        task.delay(0.1, function()
            pending[instance] = nil
            if not enabled or RunService:IsRunning() or not instance:IsDescendantOf(Workspace) then
                return
            end
            local restored = 0
            for _, descendant in instance:GetDescendants() do
                if descendant:IsA("MeshPart") then
                    if CollisionPolicy.RestoreCopiedMesh(descendant) then
                        restored += 1
                    end
                end
            end
            -- Cloned ServerStorage templates must not masquerade as templates
            -- once they are placed in Workspace.
            PlacedTargets.MarkPlaced(instance)
            if restored > 0 then
                print(("[game1 plugin] repaired %d copied Estate MeshPart physics settings: %s")
                    :format(restored, instance:GetFullName()))
            end
        end)
    end

    local connection = Workspace.DescendantAdded:Connect(onAdded)
    -- Also repair copies that were placed before the plugin was installed or
    -- reloaded. This scan runs once on plugin startup, not on every frame.
    for _, instance in Workspace:GetDescendants() do
        onAdded(instance)
    end
    return function()
        enabled = false
        connection:Disconnect()
    end
end

return table.freeze(Guard)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">StudioRealEstatePlacedTargets</string>
          <string name="Source"><![CDATA[-- One authoritative definition of a placed Real Estate instance.
-- ServerStorage owns the publishing template. Any matching Model *inside*
-- Workspace is a placed copy, even when cloned with the template flag intact.
-- Run only on explicit Studio Sync commands, never per frame.
local Targets = {}

function Targets.List(slug: string): {Model}
    local matches = {}
    if slug == "" then return matches end
    for _, instance in workspace:GetDescendants() do
        if instance:IsA("Model") and instance:GetAttribute("Game1RealEstateSlug") == slug then
            -- Do not count nested models with a duplicate slug twice.
            local ancestor = instance.Parent
            local nested = false
            while ancestor and ancestor ~= workspace do
                if ancestor:IsA("Model") and ancestor:GetAttribute("Game1RealEstateSlug") == slug then
                    nested = true
                    break
                end
                ancestor = ancestor.Parent
            end
            if not nested then
                table.insert(matches, instance)
            end
        end
    end
    table.sort(matches, function(a, b) return a:GetFullName() < b:GetFullName() end)
    return matches
end

function Targets.MarkPlaced(root: Model)
    -- A template clone moved to Workspace must no longer claim to be the
    -- ServerStorage template. Do this only after a successful model swap.
    if root:GetAttribute("Game1RealEstateTemplate") == true then
        root:SetAttribute("Game1RealEstateTemplate", nil)
    end
end

return table.freeze(Targets)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">StudioRealEstatePlacedVisualSync</string>
          <string name="Source"><![CDATA[-- Full Real Estate sync: refresh visual rigs on *all managed placed* houses.
-- Preserve the house transform, existing door opening pivot, and any unmanaged
-- player-owned objects. Collision rigs have an independent synchronizer.
local Targets = require(script.Parent.StudioRealEstatePlacedTargets)
local HouseFrame = require(script.Parent.StudioRealEstateHouseFrame)
local RigSwap = require(script.Parent.StudioManagedRigSwap)
local VisualSync = {}

local function visuals(template: Model): {Model}
    local result = {}
    for _, child in template:GetChildren() do
        if child:IsA("Model") and child:GetAttribute("Game1RealEstatePhysicsRig") ~= true then
            table.insert(result, child)
        end
    end
    table.sort(result, function(a, b)
        if a.Name == "HouseRig" then return true end
        if b.Name == "HouseRig" then return false end
        return a.Name < b.Name
    end)
    return result
end

function VisualSync.Update(template: Model, slug: string, placedTargets: {Model}?): (number, number, {string})
    local targets = placedTargets or Targets.List(slug)
    local sourceHouse = HouseFrame.Find(template)
    if not sourceHouse then return 0, #targets, {"Full visual sync skipped: template house anchor missing or ambiguous"} end
    local sources = visuals(template)
    local changed = 0
    local found = 0
    local warnings = {}
    for _, root in targets do
        found += 1
        local placedHouse = HouseFrame.Find(root)
        if not placedHouse then
            table.insert(warnings, root:GetFullName() .. ": house anchor missing or ambiguous")
            continue
        end
        local frame = HouseFrame.Relative(sourceHouse, placedHouse)
        local stages = {}
        local complete = true
        for _, source in sources do
            local old = root:FindFirstChild(source.Name)
            if not old or not old:IsA("Model") then
                complete = false
                table.insert(warnings, root:GetFullName() .. ": unmanaged/missing " .. source.Name)
                break
            end
            local staged: Model? = nil
            local ok, problem = pcall(function()
                local candidate = source:Clone()
                staged = candidate
                -- Keep an already-open door at its previous pivot; all other
                -- visual meshes follow the authored relative house transform.
                local target = if source.Name == "DoorAssembly"
                    then (old :: Model):GetPivot() else frame * source:GetPivot()
                candidate:PivotTo(target)
                if source.Name == "HouseRig" then
                    local candidateHouse = HouseFrame.Find(candidate)
                    if not candidateHouse then error("staged house anchor missing or ambiguous") end
                    -- Exact author pivot check, even when the MeshPart's
                    -- geometry centre differs from the published template.
                    local actual = candidateHouse:GetPivot()
                    local desired = placedHouse:GetPivot()
                    if (actual.Position - desired.Position).Magnitude > 0.025
                        or actual.LookVector:Dot(desired.LookVector) < 0.9999
                        or actual.UpVector:Dot(desired.UpVector) < 0.9999 then
                        error("placed visual house origin would shift")
                    end
                end
            end)
            if not ok or not staged then
                complete = false
                if staged then staged:Destroy() end
                table.insert(warnings, root:GetFullName() .. ": " .. tostring(problem))
                break
            end
            table.insert(stages, {old = old :: Model, staged = staged :: Model, name = source.Name})
        end
        if not complete then
            for _, stage in stages do stage.staged:Destroy() end
            continue
        end
        local oldRigs, newRigs = {}, {}
        for _, stage in ipairs(stages) do
            table.insert(oldRigs, stage.old)
            table.insert(newRigs, stage.staged)
        end
        local transaction = nil
        local ok, problem = pcall(function()
            transaction = RigSwap.Prepare(root, oldRigs, newRigs)
            RigSwap.Commit(transaction)
        end)
        if not ok then
            if transaction then RigSwap.Rollback(transaction) end
            for _, stage in ipairs(stages) do stage.staged:Destroy() end
            table.insert(warnings, root:GetFullName() .. ": update rolled back: " .. tostring(problem))
            continue
        end
        RigSwap.Finalize(transaction)
        Targets.MarkPlaced(root)
        -- Keep published IDs on the placed instance consistent with its
        -- actual copied rigs; do not touch player-owned children or pivots.
        root:SetAttribute("Game1RigAssetIds", template:GetAttribute("Game1RigAssetIds"))
        root:SetAttribute("Game1HouseModelAssetId", template:GetAttribute("Game1HouseModelAssetId"))
        root:SetAttribute("Game1DoorModelAssetId", template:GetAttribute("Game1DoorModelAssetId"))
        root:SetAttribute("Game1ModelAssetId", template:GetAttribute("Game1ModelAssetId"))
        changed += 1
    end
    return changed, found, warnings
end

return table.freeze(VisualSync)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">StudioRealEstateRigValidation</string>
          <string name="Source"><![CDATA[-- Validate an already-published Real Estate Model Asset as actually loaded by Roblox.
-- Blender/FBX manifests are authoring expectations, not proof of what survived
-- publication. All authored bones are required, including unweighted source sockets.
local Validation = {}

local DOOR_HINGE = "door_01_hinge_socket"
local DOOR_CHILD_SOCKETS = {
    door_01_handle_inside_socket = true,
    door_01_handle_outside_socket = true,
    door_01_padlock_01_socket = true,
}

function Validation.FindMesh(root: Model, expected: string): MeshPart
    local match: MeshPart? = nil
    for _, instance in root:GetDescendants() do
        if instance:IsA("MeshPart") then
            if instance.Name:lower() ~= expected:lower() then
                error("Real Estate " .. expected .. " rig contains unexpected mesh " .. instance.Name)
            end
            if match then
                error("Real Estate rig contains duplicate mesh " .. expected)
            end
            match = instance
        end
    end
    if not match then
        error("Published Real Estate rig is missing mesh " .. expected)
    end
    return match :: MeshPart
end

function Validation.Verify(root: Model, part: string, expected: any): (MeshPart, any)
    if typeof(expected) ~= "table" then
        error("Missing registered mesh manifest for " .. part)
    end

    local mesh = Validation.FindMesh(root, part)
    local authored: {[string]: boolean} = {}
    local socketCount = 0
    for _, name in expected do
        if typeof(name) ~= "string" or name == "" or authored[name] then
            error(part .. ": invalid registered bone manifest")
        end
        authored[name] = true
        if name:sub(-7) == "_socket" then
            socketCount += 1
        end
    end

    local imported: {[string]: Bone} = {}
    local boneNames = {}
    local boneCount = 0
    for _, instance in root:GetDescendants() do
        if instance:IsA("Bone") then
            boneCount += 1
            table.insert(boneNames, instance.Name)
        end
        if instance:IsA("Bone") and authored[instance.Name] then
            if not instance:IsDescendantOf(mesh) then
                error(part .. ": bone outside expected mesh " .. instance.Name)
            end
            if imported[instance.Name] then
                error(part .. ": duplicate imported marker " .. instance.Name)
            end
            imported[instance.Name] = instance
        end
    end
    table.sort(boneNames)
    -- Empty manifest means a deliberately static published mesh. Older
    -- publications may still contain copies of house socket bones; require
    -- a clean republish instead of silently accepting their unstable rig.
    if #expected == 0 and boneCount > 0 then
        error(part .. ": static mesh Model Asset contains redundant Bones ("
            .. table.concat(boneNames, ", ")
            .. "); republish this mesh Model Asset before Studio Sync")
    end
    local missing = {}
    for name in authored do
        if not imported[name] then
            table.insert(missing, name)
        end
    end
    table.sort(missing)

    if #missing > 0 then
        error(part .. ": published Model Asset lost authored Bones: " .. table.concat(missing, ", ")
            .. "; republish the model before Studio Sync")
    end
    local warnings = {}
    -- Hinge is structural: without the imported Bone, PivotTo would use a
    -- fabricated origin. Never replace a working template in that situation.
    if part == "door" and authored[DOOR_HINGE] then
        local hinge = imported[DOOR_HINGE]
        if not hinge or not hinge:IsA("Bone") then
            error("door: required hinge Bone " .. DOOR_HINGE
                .. " is absent in the published Roblox Model Asset (imported Bones: "
                .. table.concat(boneNames, ", ") .. ")")
        end
        if not hinge:IsDescendantOf(mesh) then
            error("door hinge must be a descendant of the door MeshPart")
        end
        if hinge.Parent and hinge.Parent:IsA("Bone") then
            error("door hinge must be a root bone")
        end
        for name in DOOR_CHILD_SOCKETS do
            local socket = imported[name]
            if authored[name] and socket and socket.Parent ~= hinge then
                error("door socket " .. name .. " must be a child of " .. DOOR_HINGE)
            end
        end
    elseif part == "door" then
        table.insert(warnings, "door: no authored hinge pivot; DoorAssembly not created")
    end

    return mesh, {
        boneCount = boneCount,
        socketCount = socketCount,
        missingSockets = missing,
        warnings = warnings,
    }
end

return table.freeze(Validation)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">StudioTextureAppearance</string>
          <string name="Source"><![CDATA[-- Shared Studio-side material binding for all authored MeshParts.
-- Keep TextureID even when SurfaceAppearance owns ColorMap: imported skinned
-- rigs in the previous project required this compatibility invariant.
local StudioTextureAppearance = {}

function StudioTextureAppearance.Apply(mesh: MeshPart, uri: string, usesAlpha: any, idsOnly: boolean?): boolean
    if uri == "" then
        return false
    end
    local surface = mesh:FindFirstChildOfClass("SurfaceAppearance")
    if idsOnly == true then
        -- M216 placed Location Asset sync. Only existing Asset ID fields are
        -- mutable; do not create SurfaceAppearance or rewrite AlphaMode/physics.
        if mesh.TextureID == uri and (surface == nil or surface.ColorMap == uri) then
            return false
        end
        local previousTexture = mesh.TextureID
        local previousMap = if surface then surface.ColorMap else nil
        local applied, reason = pcall(function()
            mesh.TextureID = uri
            if surface ~= nil then
                surface.ColorMap = uri
            end
        end)
        if not applied then
            pcall(function()
                mesh.TextureID = previousTexture
                if surface ~= nil and previousMap ~= nil then
                    surface.ColorMap = previousMap
                end
            end)
            error("ID-only appearance binding failed for " .. mesh:GetFullName() .. ": " .. tostring(reason), 2)
        end
        return true
    end
    local desiredMode = if usesAlpha == true then Enum.AlphaMode.Transparency else Enum.AlphaMode.Overlay
    local modeKnown = typeof(usesAlpha) == "boolean"
    local alreadyCurrent = mesh.TextureID == uri
        and surface ~= nil and surface.ColorMap == uri
        and (not modeKnown or surface.AlphaMode == desiredMode)
    if alreadyCurrent then
        return false
    end

    -- Do not change normals, roughness, metalness, mesh geometry or physics.
    -- Parent a new appearance only after its properties have been set.
    local created = false
    if surface == nil then
        surface = Instance.new("SurfaceAppearance")
        surface.Name = "SurfaceAppearance"
        created = true
    end
    local previousTexture = mesh.TextureID
    local previousMap = surface.ColorMap
    local previousMode = surface.AlphaMode
    local ok, reason = pcall(function()
        mesh.TextureID = uri
        surface.ColorMap = uri
        if modeKnown then
            surface.AlphaMode = desiredMode
        end
        if created then
            surface.Parent = mesh
        end
    end)
    if not ok then
        pcall(function()
            mesh.TextureID = previousTexture
            if created then
                surface:Destroy()
            else
                surface.ColorMap = previousMap
                surface.AlphaMode = previousMode
            end
        end)
        error("SurfaceAppearance binding failed for " .. mesh:GetFullName() .. ": " .. tostring(reason), 2)
    end
    return true
end

return table.freeze(StudioTextureAppearance)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">StudioTimelineEditorCommands</string>
          <string name="Source"><![CDATA[-- Timeline authoring session: validates requests, binds UI events and reports results.
-- No gameplay state is mutated; all previews live inside the plugin WorldModel.
local StudioTimelineWidget = require(script.Parent.StudioTimelineWidget)
local StudioTimelinePreview = require(script.Parent.StudioTimelinePreview)
local StudioTimelinePoseSampler = require(script.Parent.StudioTimelinePoseSampler)
local StudioTimelineTransport = require(script.Parent.StudioTimelineTransport)

return function(services)
    local UserInputService = services.UserInputService
    local view = StudioTimelineWidget.new(services.plugin)
    local timelineWidget = view.widget
    local timelineTitle = view.title
    local timelineHint = view.hint
    local timelineTime = view.time
    local timelineBar = view.bar
    local timelineFill = view.fill
    local timelineThumb = view.thumb
    local timelineEventButtons = view.eventButtons
    local timelineMarkers = view.markers
    local timelineConfirm = view.confirm
    local timelineStatus = view.status
    local timelineButton = view.makeButton
    local poseSampler = StudioTimelinePoseSampler.new(services.TweenService)
    local previewService = StudioTimelinePreview.new({
        AssetService = services.AssetService,
        AnimationClipProvider = services.AnimationClipProvider,
        UserInputService = UserInputService,
        viewport = view.viewport,
        world = view.world,
        camera = view.camera,
        empty = view.empty,
    })
    local transport = StudioTimelineTransport.new({
        HttpService = services.HttpService,
        agentBaseUrl = services.agentBaseUrl,
        agentToken = services.agentToken,
        bridgeUrl = services.bridgeUrl,
        bridgeToken = services.bridgeToken,
    })
    local postTimelineAgent = transport.PostAgent
    local postTimelineEditorResult = transport.PostResult
    local loadTimelinePreviewModel = previewService.LoadModel
    local loadTimelineSequence = previewService.LoadSequence
    local timelineSequenceDuration = previewService.SequenceDuration
    local timelineEditor = {
        sessionId = "",
        clipId = "",
        clipName = "",
        subjectName = "",
        duration = 0,
        normalized = 0,
        selectedEvent = "Hit",
        eventCatalog = {},
        events = {},
        poseTracks = {},
        preview = nil,
    }
    local destroyTimelinePreview = function()
        timelineEditor.poseTracks = {}
        timelineEditor.preview = nil
        previewService.DestroyPreview()
    end
    local timelineDragging = false
    local TIMELINE_PREVIEW_NAME = "Game1TimelinePreview"

    local function timelineEventDefinition(eventName: string): any?
        for _, definition in ipairs(timelineEditor.eventCatalog) do
            if tostring(definition.name or "") == eventName then
                return definition
            end
        end
        return nil
    end

    local function timelineRefreshMarkers()
        local rows = {}
        for _, definition in ipairs(timelineEditor.eventCatalog) do
            local eventName = tostring(definition.name or "")
            local event = timelineEditor.events[eventName]
            if type(event) == "table" then
                table.insert(rows, ("%s %.1f%%"):format(eventName, (tonumber(event.normalizedTime) or 0) * 100))
            end
        end
        timelineMarkers.Text = if #rows > 0 then table.concat(rows, "  ·  ") else "No event points"
    end

    local function timelineSetNormalized(value: number)
        local normalized = math.clamp(tonumber(value) or 0, 0, 1)
        timelineEditor.normalized = normalized
        timelineFill.Size = UDim2.new(normalized, 0, 1, 0)
        timelineThumb.Position = UDim2.new(normalized, 0, 0.5, 0)
        local duration = math.max(0, tonumber(timelineEditor.duration) or 0)
        timelineTime.Text = ("%.3f s · %.1f%%"):format(duration * normalized, normalized * 100)
        if duration > 0 and #timelineEditor.poseTracks > 0 then
            local ok, err = pcall(function()
                poseSampler.Apply(timelineEditor.poseTracks, duration * normalized)
            end)
            if not ok then
                timelineStatus.Text = "Pose preview failed: " .. tostring(err)
            end
        end
    end

    local function timelineSelectEvent(eventName: string)
        if timelineEventDefinition(eventName) == nil then
            return
        end
        timelineEditor.selectedEvent = eventName
        for _, child in ipairs(timelineEventButtons:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = if child.Name == eventName then Color3.fromRGB(49, 112, 96) else Color3.fromRGB(47, 51, 58)
            end
        end
        local existing = timelineEditor.events[eventName]
        if type(existing) == "table" and tonumber(existing.normalizedTime) ~= nil then
            timelineSetNormalized(tonumber(existing.normalizedTime) or 0)
        end
    end

    local function timelineBuildEventButtons()
        for _, child in ipairs(timelineEventButtons:GetChildren()) do
            child:Destroy()
        end
        local count = math.max(1, #timelineEditor.eventCatalog)
        local gap = 6
        local widthScale = 1 / math.min(count, 3)
        for index, definition in ipairs(timelineEditor.eventCatalog) do
            local eventName = tostring(definition.name or "")
            if eventName ~= "" then
                local buttonInstance = timelineButton(eventName, tostring(definition.label or eventName), timelineEventButtons)
                local column = (index - 1) % 3
                local row = math.floor((index - 1) / 3)
                buttonInstance.Position = UDim2.new(column * widthScale, column == 0 and 0 or gap, 0, row * 36)
                buttonInstance.Size = UDim2.new(widthScale, -gap, 0, 30)
                buttonInstance.MouseButton1Click:Connect(function()
                    timelineSelectEvent(eventName)
                end)
            end
        end
        if timelineEventDefinition(timelineEditor.selectedEvent) == nil and #timelineEditor.eventCatalog > 0 then
            timelineEditor.selectedEvent = tostring(timelineEditor.eventCatalog[1].name or "")
        end
        timelineSelectEvent(timelineEditor.selectedEvent)
    end

    local function timelineNormalizedFromInput(input: InputObject): number
        local width = math.max(1, timelineBar.AbsoluteSize.X)
        return math.clamp((input.Position.X - timelineBar.AbsolutePosition.X) / width, 0, 1)
    end

    timelineBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            timelineDragging = true
            timelineSetNormalized(timelineNormalizedFromInput(input))
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if timelineDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            timelineSetNormalized(timelineNormalizedFromInput(input))
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            timelineDragging = false
        end
    end)

    local function handleTimelineEditor(data: any)
        local result = {
            command = "timeline-editor",
            project = "game1",
            schemaVersion = 1,
            sessionId = tostring(data.sessionId or ""),
            clipId = tostring(data.clipId or ""),
        }
        local ok, operationError = xpcall(function()
            if tostring(data.project or "") ~= "game1" or tonumber(data.schemaVersion) ~= 1 then
                error("invalid game1 timeline editor command")
            end
            local sessionId = tostring(data.sessionId or "")
            local modelAssetId = tonumber(data.modelAssetId)
            local animationAssetId = tonumber(data.animationAssetId)
            if sessionId == "" or modelAssetId == nil or modelAssetId <= 0 or animationAssetId == nil or animationAssetId <= 0 then
                error("timeline editor command is missing published asset ids")
            end
            destroyTimelinePreview()

            timelineEditor.sessionId = sessionId
            timelineEditor.clipId = tostring(data.clipId or "")
            timelineEditor.clipName = tostring(data.clipName or timelineEditor.clipId)
            timelineEditor.subjectName = tostring(data.subjectName or data.subjectId or "")
            timelineEditor.duration = math.max(0, tonumber(data.duration) or 0)
            timelineEditor.normalized = 0
            timelineEditor.eventCatalog = if type(data.eventCatalog) == "table" then data.eventCatalog else {}
            timelineEditor.events = if type(data.events) == "table" then data.events else {}
            timelineEditor.selectedEvent = "Hit"

            local preview = loadTimelinePreviewModel(modelAssetId)
            timelineEditor.preview = preview
            local sequence = loadTimelineSequence(animationAssetId)
            local sequenceDuration = timelineSequenceDuration(sequence)
            if sequenceDuration <= 0 then
                sequence:Destroy()
                error("selected attack animation contains no timed keyframes")
            end
            timelineEditor.duration = sequenceDuration
            timelineEditor.poseTracks = poseSampler.Build(preview, sequence)
            sequence:Destroy()
            if #timelineEditor.poseTracks == 0 then
                error("selected attack has no Pose targets matching the preview rig")
            end

            timelineTitle.Text = timelineEditor.subjectName .. " · " .. timelineEditor.clipName
            timelineHint.Text = "Preview is rendered inside this plugin. Scrub, choose an event, then Confirm point."
            timelineStatus.Text = ("Ready · %.3f s · %d animated target(s)"):format(
                timelineEditor.duration,
                #timelineEditor.poseTracks
            )
            timelineBuildEventButtons()
            timelineRefreshMarkers()
            timelineSetNormalized(0)
            timelineWidget.Enabled = true

            postTimelineAgent({
                sessionId = timelineEditor.sessionId,
                action = "ready",
                duration = timelineEditor.duration,
            })
            result.duration = timelineEditor.duration
            result.preview = "ViewportFrame/TimelinePreviewWorld/" .. TIMELINE_PREVIEW_NAME
            result.animatedTargets = #timelineEditor.poseTracks
        end, debug.traceback)

        if not ok then
            result.error = tostring(operationError)
            timelineStatus.Text = "Timeline editor error: " .. tostring(operationError)
            warn("[game1 plugin] timeline editor failed: " .. tostring(operationError))
        end
        local postOk, postError = pcall(postTimelineEditorResult, result)
        if not postOk then
            warn("[game1 plugin] failed to report timeline editor result: " .. tostring(postError))
        end
    end

    timelineConfirm.MouseButton1Click:Connect(function()
        if timelineEditor.sessionId == "" or timelineEditor.selectedEvent == "" then
            return
        end
        local eventName = timelineEditor.selectedEvent
        local normalized = timelineEditor.normalized
        local definition = timelineEventDefinition(eventName)
        local event = { normalizedTime = normalized }
        if definition and tostring(definition.result or "") ~= "" then
            event.result = tostring(definition.result)
        end
        timelineEditor.events[eventName] = event
        timelineRefreshMarkers()
        timelineStatus.Text = ("Sending %s = %.1f%% to Asset Manager…"):format(eventName, normalized * 100)
        local ok, err = pcall(function()
            postTimelineAgent({
                sessionId = timelineEditor.sessionId,
                action = "set-event",
                eventName = eventName,
                normalizedTime = normalized,
                duration = timelineEditor.duration,
            })
        end)
        if ok then
            timelineStatus.Text = ("Confirmed %s = %.3f s (%.1f%%)"):format(
                eventName,
                timelineEditor.duration * normalized,
                normalized * 100
            )
        else
            timelineStatus.Text = "Confirm failed: " .. tostring(err)
            warn("[game1 plugin] timeline confirm failed: " .. tostring(err))
        end
    end)


    return handleTimelineEditor
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">StudioTimelinePoseSampler</string>
          <string name="Source"><![CDATA[-- Offline pose extraction and interpolation for a preview rig. No UI or HTTP dependencies.
local StudioTimelinePoseSampler = {}

function StudioTimelinePoseSampler.new(TweenService)
    local function addTimelineTarget(targetMap: any, name: string, target: Instance)
        if name == "" then
            return
        end
        local bucket = targetMap[name]
        if bucket == nil then
            bucket = {}
            targetMap[name] = bucket
        end
        if table.find(bucket, target) == nil then
            table.insert(bucket, target)
        end
    end

    local function collectTimelineTargets(preview: Model): any
        local targetMap = {}
        for _, descendant in ipairs(preview:GetDescendants()) do
            if descendant:IsA("Bone") then
                addTimelineTarget(targetMap, descendant.Name, descendant)
            elseif descendant:IsA("Motor6D") then
                addTimelineTarget(targetMap, descendant.Name, descendant)
                if descendant.Part1 ~= nil then
                    addTimelineTarget(targetMap, descendant.Part1.Name, descendant)
                end
            end
        end
        return targetMap
    end

    local function timelineTargetTransform(target: Instance): CFrame
        if target:IsA("Bone") or target:IsA("Motor6D") then
            return target.Transform
        end
        return CFrame.new()
    end

    local function setTimelineTargetTransform(target: Instance, transform: CFrame)
        if target:IsA("Bone") or target:IsA("Motor6D") then
            target.Transform = transform
        end
    end

    local function timelinePoseTarget(pose: Pose, targetMap: any): Instance?
        local bucket = targetMap[pose.Name]
        if bucket == nil or #bucket == 0 then
            return nil
        end
        if #bucket == 1 then
            return bucket[1]
        end
        local parentPose = pose.Parent
        if parentPose and parentPose:IsA("Pose") then
            for _, candidate in ipairs(bucket) do
                if candidate:IsA("Bone") then
                    local candidateParent = candidate.Parent
                    if candidateParent and candidateParent.Name == parentPose.Name then
                        return candidate
                    end
                elseif candidate:IsA("Motor6D") and candidate.Part0 and candidate.Part0.Name == parentPose.Name then
                    return candidate
                end
            end
        end
        return bucket[1]
    end

    local function buildTimelinePoseTracks(preview: Model, sequence: KeyframeSequence): any
        local targetMap = collectTimelineTargets(preview)
        local tracksByTarget = {}
        local keyframes = sequence:GetKeyframes()
        table.sort(keyframes, function(a, b)
            return a.Time < b.Time
        end)
        for _, keyframe in ipairs(keyframes) do
            for _, descendant in ipairs(keyframe:GetDescendants()) do
                if descendant:IsA("Pose") then
                    local target = timelinePoseTarget(descendant, targetMap)
                    if target ~= nil then
                        local track = tracksByTarget[target]
                        if track == nil then
                            track = {
                                target = target,
                                defaultTransform = timelineTargetTransform(target),
                                samples = {},
                            }
                            tracksByTarget[target] = track
                        end
                        table.insert(track.samples, {
                            time = keyframe.Time,
                            cframe = descendant.CFrame,
                            style = descendant.EasingStyle.Name,
                            direction = descendant.EasingDirection.Name,
                        })
                    end
                end
            end
        end
        local tracks = {}
        for _, track in pairs(tracksByTarget) do
            table.sort(track.samples, function(a, b)
                return a.time < b.time
            end)
            table.insert(tracks, track)
        end
        return tracks
    end

    local easingStyles = {}
    for _, item in ipairs(Enum.EasingStyle:GetEnumItems()) do
        easingStyles[item.Name] = item
    end
    local easingDirections = {}
    for _, item in ipairs(Enum.EasingDirection:GetEnumItems()) do
        easingDirections[item.Name] = item
    end

    local function timelineEasingAlpha(alpha: number, styleName: string, directionName: string): number
        alpha = math.clamp(alpha, 0, 1)
        if styleName == "Constant" then
            return if alpha >= 1 then 1 else 0
        end
        local style = easingStyles[styleName] or Enum.EasingStyle.Linear
        local direction = easingDirections[directionName] or Enum.EasingDirection.Out
        local ok, value = pcall(function()
            return TweenService:GetValue(alpha, style, direction)
        end)
        return if ok then value else alpha
    end

    local function sampleTimelineTrack(track: any, timePosition: number): CFrame
        local samples = track.samples
        if #samples == 0 then
            return track.defaultTransform
        end
        if timePosition <= samples[1].time then
            if samples[1].time <= 0.0005 then
                return samples[1].cframe
            end
            local alpha = timelineEasingAlpha(timePosition / samples[1].time, "Linear", "Out")
            return track.defaultTransform:Lerp(samples[1].cframe, alpha)
        end
        for index = 1, #samples - 1 do
            local current = samples[index]
            local following = samples[index + 1]
            if timePosition <= following.time then
                local span = math.max(following.time - current.time, 0.000001)
                local alpha = timelineEasingAlpha((timePosition - current.time) / span, current.style, current.direction)
                return current.cframe:Lerp(following.cframe, alpha)
            end
        end
        return samples[#samples].cframe
    end

    local function applyTimelinePose(poseTracks: any, timePosition: number)
        for _, track in ipairs(poseTracks) do
            if track.target.Parent ~= nil then
                setTimelineTargetTransform(track.target, sampleTimelineTrack(track, timePosition))
            end
        end
    end


    return {
        Build = buildTimelinePoseTracks,
        Apply = applyTimelinePose,
    }
end

return table.freeze(StudioTimelinePoseSampler)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">StudioTimelinePreview</string>
          <string name="Source"><![CDATA[-- Owns the isolated ViewportFrame rig, camera interaction and animation-asset retrieval.
local StudioTimelinePreview = {}

function StudioTimelinePreview.new(services)
    local AssetService = services.AssetService
    local AnimationClipProvider = services.AnimationClipProvider
    local UserInputService = services.UserInputService
    local timelineViewport = services.viewport
    local timelineWorld = services.world
    local timelineCamera = services.camera
    local timelineViewportEmpty = services.empty
    local TIMELINE_PREVIEW_NAME = "Game1TimelinePreview"
    local activePreview: Model? = nil
    local timelinePreviewDragging = false
    local timelineCameraTarget = Vector3.zero
    local timelineCameraYaw = math.pi
    local timelineCameraPitch = 0
    local timelineCameraDistance = 8
    local timelineCameraMinDistance = 2
    local timelineCameraMaxDistance = 24

    local function updateTimelinePreviewCamera()
        timelineCameraDistance = math.clamp(timelineCameraDistance, timelineCameraMinDistance, timelineCameraMaxDistance)
        timelineCameraPitch = math.clamp(timelineCameraPitch, math.rad(-70), math.rad(70))
        local cosPitch = math.cos(timelineCameraPitch)
        local offset = Vector3.new(
            math.sin(timelineCameraYaw) * cosPitch,
            math.sin(timelineCameraPitch),
            math.cos(timelineCameraYaw) * cosPitch
        ) * timelineCameraDistance
        timelineCamera.CFrame = CFrame.lookAt(timelineCameraTarget + offset, timelineCameraTarget, Vector3.yAxis)
    end

    local function frameTimelinePreview(preview: Model)
        preview:PivotTo(CFrame.new())
        local boundsCFrame, boundsSize = preview:GetBoundingBox()
        local radius = math.max(boundsSize.X, boundsSize.Y, boundsSize.Z, 1)
        local rootPart = preview:FindFirstChild("RootPart", true)
            or preview:FindFirstChild("HumanoidRootPart", true)
            or preview:FindFirstChildWhichIsA("BasePart", true)
        local front = Vector3.new(0, 0, -1)
        if rootPart and rootPart:IsA("BasePart") then
            front = rootPart.CFrame.LookVector
        end
        local horizontalFront = Vector3.new(front.X, 0, front.Z)
        if horizontalFront.Magnitude < 0.01 then
            horizontalFront = Vector3.new(0, 0, -1)
        else
            horizontalFront = horizontalFront.Unit
        end
        timelineCameraTarget = boundsCFrame.Position + Vector3.new(0, boundsSize.Y * 0.02, 0)
        timelineCameraMinDistance = math.max(radius * 0.55, 0.75)
        timelineCameraMaxDistance = math.max(radius * 4.5, timelineCameraMinDistance + 1)
        local initialOffset = horizontalFront * radius * 1.8 + Vector3.new(0, boundsSize.Y * 0.03, 0)
        timelineCameraDistance = math.clamp(initialOffset.Magnitude, timelineCameraMinDistance, timelineCameraMaxDistance)
        if initialOffset.Magnitude > 0.001 then
            timelineCameraYaw = math.atan2(initialOffset.X, initialOffset.Z)
            timelineCameraPitch = math.asin(math.clamp(initialOffset.Y / initialOffset.Magnitude, -1, 1))
        else
            timelineCameraYaw = math.pi
            timelineCameraPitch = 0
        end
        updateTimelinePreviewCamera()
    end

    timelineViewport.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and activePreview ~= nil then
            timelinePreviewDragging = true
        end
    end)

    timelineViewport.InputChanged:Connect(function(input)
        if activePreview == nil then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement and timelinePreviewDragging then
            timelineCameraYaw -= input.Delta.X * 0.010
            timelineCameraPitch = math.clamp(timelineCameraPitch - input.Delta.Y * 0.008, math.rad(-70), math.rad(70))
            updateTimelinePreviewCamera()
        elseif input.UserInputType == Enum.UserInputType.MouseWheel then
            local wheel = input.Position.Z
            if math.abs(wheel) > 0.001 then
                local step = math.max(timelineCameraDistance * 0.12, 0.15)
                timelineCameraDistance = math.clamp(
                    timelineCameraDistance - wheel * step,
                    timelineCameraMinDistance,
                    timelineCameraMaxDistance
                )
                updateTimelinePreviewCamera()
            end
        end
    end)

    timelineViewport.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            timelinePreviewDragging = false
        end
    end)


        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                timelinePreviewDragging = false
            end
        end)

    local function destroyTimelinePreview()
        if activePreview ~= nil then
            pcall(function()
                activePreview:Destroy()
            end)
            activePreview = nil
        end
        for _, child in ipairs(timelineWorld:GetChildren()) do
            child:Destroy()
        end
        timelineViewportEmpty.Visible = true
    end

    local function prepareTimelinePreviewModel(preview: Model)
        for _, descendant in ipairs(preview:GetDescendants()) do
            if descendant:IsA("BasePart") then
                descendant.Anchored = true
                descendant.CanCollide = false
                descendant.CanTouch = false
                descendant.CanQuery = false
                descendant.Massless = true
            elseif descendant:IsA("Script") or descendant:IsA("LocalScript") then
                descendant:Destroy()
            end
        end
    end

    local function loadTimelinePreviewModel(assetId: number): Model
        local loaded: Instance? = nil
        local lastError = ""
        for _ = 1, 6 do
            local loadedOk, value = pcall(function()
                return AssetService:LoadAssetAsync(assetId)
            end)
            if loadedOk and value ~= nil then
                loaded = value
                break
            end
            lastError = tostring(value)
            task.wait(0.5)
        end
        if loaded == nil then
            error("could not load preview model asset " .. tostring(assetId) .. ": " .. lastError)
        end

        local imported: Instance = loaded
        local children = loaded:GetChildren()
        if loaded:IsA("Model") and #children == 1 then
            imported = children[1]
            imported.Parent = nil
            loaded:Destroy()
        end

        local preview = Instance.new("Model")
        preview.Name = TIMELINE_PREVIEW_NAME
        preview:SetAttribute("Game1TimelinePreview", true)
        imported.Name = "ImportedRig"
        imported.Parent = preview
        prepareTimelinePreviewModel(preview)
        preview.Parent = timelineWorld
        frameTimelinePreview(preview)
        timelineViewportEmpty.Visible = false
        activePreview = preview
        return preview
    end

    local function loadTimelineSequence(animationAssetId: number): KeyframeSequence
        local contentId = "rbxassetid://" .. tostring(math.floor(animationAssetId))
        local lastError = ""
        for _ = 1, 4 do
            local ok, clip = pcall(function()
                return AnimationClipProvider:GetAnimationClipAsync(contentId)
            end)
            if ok and clip ~= nil then
                if not clip:IsA("KeyframeSequence") then
                    clip:Destroy()
                    error("Attack Timeline requires a KeyframeSequence animation asset")
                end
                return clip
            end
            lastError = tostring(clip)
            task.wait(0.4)
        end
        error("could not load animation clip " .. tostring(animationAssetId) .. ": " .. lastError)
    end

    local function timelineSequenceDuration(sequence: KeyframeSequence): number
        local duration = 0
        for _, keyframe in ipairs(sequence:GetKeyframes()) do
            duration = math.max(duration, keyframe.Time)
        end
        return duration
    end


    return {
        DestroyPreview = destroyTimelinePreview,
        LoadModel = loadTimelinePreviewModel,
        LoadSequence = loadTimelineSequence,
        SequenceDuration = timelineSequenceDuration,
    }
end

return table.freeze(StudioTimelinePreview)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">StudioTimelineTransport</string>
          <string name="Source"><![CDATA[-- HTTP boundary for the Timeline editor. No UI, animation or Studio model access.
local StudioTimelineTransport = {}

function StudioTimelineTransport.new(services)
    local HttpService = services.HttpService
    local AGENT_BASE_URL = services.agentBaseUrl
    local AGENT_TOKEN = services.agentToken
    local BRIDGE_URL = services.bridgeUrl
    local BRIDGE_TOKEN = services.bridgeToken

    local function postTimelineAgent(payload: any): any
        local response = HttpService:RequestAsync({
            Url = AGENT_BASE_URL .. "/api/timelines/editor-event",
            Method = "POST",
            Headers = {
                ["X-Control-Token"] = AGENT_TOKEN,
                ["Content-Type"] = "application/json",
            },
            Body = HttpService:JSONEncode(payload),
        })
        if not response.Success then
            error(("Asset Manager rejected timeline update (HTTP %d): %s"):format(response.StatusCode, response.Body))
        end
        local ok, decoded = pcall(HttpService.JSONDecode, HttpService, response.Body)
        if ok then
            return decoded
        end
        return nil
    end

    local function postTimelineEditorResult(payload: any)
        local response = HttpService:RequestAsync({
            Url = BRIDGE_URL .. "/timeline-editor-result",
            Method = "POST",
            Headers = {
                ["X-Game1-Token"] = BRIDGE_TOKEN,
                ["Content-Type"] = "application/json",
            },
            Body = HttpService:JSONEncode(payload),
        })
        if not response.Success then
            error("game1 timeline editor bridge rejected response: " .. tostring(response.StatusCode))
        end
    end

    return {
        PostAgent = postTimelineAgent,
        PostResult = postTimelineEditorResult,
    }
end

return table.freeze(StudioTimelineTransport)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">StudioTimelineWidget</string>
          <string name="Source"><![CDATA[-- Timeline editor view. Builds the dock widget and exposes only its controls.
local StudioTimelineWidget = {}

function StudioTimelineWidget.new(plugin)
    local timelineWidgetInfo = DockWidgetPluginGuiInfo.new(
        Enum.InitialDockState.Right,
        false,
        false,
        560,
        640,
        440,
        620
    )
    local timelineWidget = plugin:CreateDockWidgetPluginGui("Game1AttackTimeline_v2", timelineWidgetInfo)
    timelineWidget.Title = "game1 · Attack Timeline"

    local timelineEditor = {
        sessionId = "",
        clipId = "",
        clipName = "",
        subjectName = "",
        duration = 0,
        normalized = 0,
        selectedEvent = "Hit",
        eventCatalog = {},
        events = {},
        poseTracks = {},
        preview = nil,
    }
    local timelineDragging = false
    local timelinePreviewDragging = false
    local timelineCameraTarget = Vector3.zero
    local timelineCameraYaw = math.pi
    local timelineCameraPitch = 0
    local timelineCameraDistance = 8
    local timelineCameraMinDistance = 2
    local timelineCameraMaxDistance = 24

    local timelineRoot = Instance.new("Frame")
    timelineRoot.Name = "Root"
    timelineRoot.BackgroundColor3 = Color3.fromRGB(32, 34, 39)
    timelineRoot.BorderSizePixel = 0
    timelineRoot.Size = UDim2.fromScale(1, 1)
    timelineRoot.Parent = timelineWidget

    local function timelineLabel(name: string, text: string, y: number, height: number, size: number): TextLabel
        local label = Instance.new("TextLabel")
        label.Name = name
        label.BackgroundTransparency = 1
        label.Position = UDim2.new(0, 12, 0, y)
        label.Size = UDim2.new(1, -24, 0, height)
        label.Font = Enum.Font.SourceSans
        label.Text = text
        label.TextColor3 = Color3.fromRGB(232, 236, 240)
        label.TextSize = size
        label.TextWrapped = true
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextYAlignment = Enum.TextYAlignment.Center
        label.Parent = timelineRoot
        return label
    end

    local function timelineButton(name: string, text: string, parent: Instance): TextButton
        local buttonInstance = Instance.new("TextButton")
        buttonInstance.Name = name
        buttonInstance.AutoButtonColor = true
        buttonInstance.BackgroundColor3 = Color3.fromRGB(47, 51, 58)
        buttonInstance.BorderSizePixel = 0
        buttonInstance.Font = Enum.Font.SourceSansSemibold
        buttonInstance.Text = text
        buttonInstance.TextColor3 = Color3.fromRGB(230, 234, 239)
        buttonInstance.TextSize = 14
        buttonInstance.Parent = parent
        return buttonInstance
    end

