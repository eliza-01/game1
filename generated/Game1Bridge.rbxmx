    <Item class="Folder" referent="2">
      <Properties>
        <string name="Name">modules</string>
      </Properties>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">CharacterTemplate</string>
          <string name="Source"><![CDATA[local CharacterTemplate = {}

local function chooseRigAnchor(importedRig: Model): BasePart?
    local fallback: BasePart? = nil
    for _, descendant in importedRig:GetDescendants() do
        if descendant:IsA("BasePart") then
            fallback = fallback or descendant
            if descendant:IsA("MeshPart") and descendant:FindFirstChildWhichIsA("Bone", true) then
                return descendant
            end
        end
    end
    return fallback
end

local function clearLegacyOrientationMetadata(wrapper: Model, importedRig: Model)
    -- game1 used to infer a body "up" vector from head/spine/feet bones and
    -- rotate the imported rig to world Y. That is deliberately forbidden now:
    -- authored FBX/model basis is the animation basis and must stay untouched.
    for _, attributeName in {
        "Game1TemplateOrientationSource",
        "Game1TemplateOrientationDegrees",
        "Game1TemplateOrientationNormalized",
    } do
        importedRig:SetAttribute(attributeName, nil)
    end
    for _, attributeName in {
        "Game1CharacterOrientationSource",
        "Game1CharacterOrientationDegrees",
    } do
        wrapper:SetAttribute(attributeName, nil)
    end

    importedRig:SetAttribute("Game1TemplateBasisMode", "authored")
    wrapper:SetAttribute("Game1RigBasisMode", "authored")
end

local function authoredBasisInfo(): any
    return {
        source = "authored_basis",
        basisMode = "authored",
        normalized = false,
        correctionDegrees = 0,
    }
end

function CharacterTemplate.EnsureCanonicalRoot(wrapper: Model, importedRig: Model): (BasePart, any)
    clearLegacyOrientationMetadata(wrapper, importedRig)

    local existing = importedRig:FindFirstChild("RootPart", true)
    if existing and existing:IsA("BasePart") then
        wrapper.PrimaryPart = existing
        importedRig.PrimaryPart = existing
        wrapper:SetAttribute("Game1CharacterRootSource", "asset")
        wrapper:SetAttribute("Game1CharacterTemplateSchema", 2)
        return existing, authoredBasisInfo()
    end

    -- Build only the gameplay/root helper. Never infer pitch/roll from anatomy and
    -- never PivotTo the imported visual rig here. The FBX authored basis is shared
    -- by the rest skeleton and every animation clip, so changing it at sync time
    -- makes otherwise-correct animation tracks lean or rotate as a whole.
    local anchor = chooseRigAnchor(importedRig)
    if not anchor then
        error("character rig has no BasePart anchor")
    end

    local boxCFrame, boxSize = importedRig:GetBoundingBox()
    local root = Instance.new("Part")
    root.Name = "RootPart"
    root.Size = Vector3.new(0.35, 0.03, 0.35)
    root.CFrame = CFrame.new(
        boxCFrame.Position.X,
        boxCFrame.Position.Y - boxSize.Y * 0.5,
        boxCFrame.Position.Z
    )
    root.Transparency = 1
    root.CastShadow = false
    root.Anchored = false
    root.CanCollide = false
    root.CanTouch = false
    root.CanQuery = false
    root.Massless = true
    root:SetAttribute("Game1GeneratedCharacterRoot", true)
    root.Parent = importedRig

    local weld = Instance.new("WeldConstraint")
    weld.Name = "ImportedRigRootWeld"
    weld.Part0 = root
    weld.Part1 = anchor
    weld.Parent = root

    importedRig.PrimaryPart = root
    wrapper.PrimaryPart = root
    wrapper:SetAttribute("Game1CharacterRootSource", "generated")
    wrapper:SetAttribute("Game1CharacterTemplateSchema", 2)
    return root, authoredBasisInfo()
end

return CharacterTemplate
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">DecoAssetLoader</string>
          <string name="Source"><![CDATA[local DecoAssetLoader = {}
DecoAssetLoader.__index = DecoAssetLoader

local function canonicalModel(loaded: Instance): Model
    local imported: Instance = loaded
    local children = loaded:GetChildren()
    if loaded:IsA("Model") and #children == 1 then
        imported = children[1]
        imported.Parent = nil
        loaded:Destroy()
    end
    if imported:IsA("Model") then
        return imported
    end
    local model = Instance.new("Model")
    model.Name = "ImportedDeco"
    imported.Parent = model
    return model
end

local function sanitize(model: Model)
    -- Location assets are static decoration. Animation runtime objects and the
    -- importer-generated InitialPoses cache are not part of the authored asset
    -- and make transient placement clones unnecessarily fragile. Keep Bones,
    -- because a skinned MeshPart can still need its bind skeleton for rendering.
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("AnimationController") or descendant:IsA("Animator") then
            descendant:Destroy()
        elseif descendant:IsA("Folder") and descendant.Name == "InitialPoses" then
            descendant:Destroy()
        elseif descendant:IsA("BasePart") then
            descendant.Anchored = true
            descendant.CanTouch = false
        end
    end
end

local function applyTexture(model: Model, textureAssetId: string)
    local numericId = tonumber(textureAssetId)
    if numericId == nil or numericId <= 0 then
        return 0
    end
    local uri = "rbxassetid://" .. tostring(math.floor(numericId))
    local applied = 0
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("MeshPart") then
            descendant.TextureID = uri
            applied += 1
        end
    end
    return applied
end

function DecoAssetLoader.new(config: any)
    return setmetatable({
        HttpService = config.HttpService,
        AssetService = config.AssetService,
        agentBaseUrl = config.agentBaseUrl,
        agentToken = config.agentToken,
    }, DecoAssetLoader)
end

function DecoAssetLoader:fetchRegistry(): any
    local response = self.HttpService:RequestAsync({
        Url = self.agentBaseUrl .. "/api/location-assets",
        Method = "GET",
        Headers = { ["X-Control-Token"] = self.agentToken },
    })
    if not response.Success then
        error(("Location Assets registry HTTP %d: %s"):format(response.StatusCode, response.Body))
    end
    local decoded = self.HttpService:JSONDecode(response.Body)
    if type(decoded) ~= "table" or type(decoded.items) ~= "table" then
        error("Location Assets registry returned an invalid payload")
    end
    return decoded
end

function DecoAssetLoader:loadPublished(row: any): Model
    if type(row) ~= "table" or tostring(row.status or "") ~= "PUBLISHED" then
        error("DecoManager can load only PUBLISHED location assets")
    end
    local assetId = tonumber(row.model_asset_id)
    if assetId == nil or assetId <= 0 then
        error("selected location asset has no published model Asset ID")
    end

    local loaded: Instance? = nil
    local lastError = ""
    for _ = 1, 6 do
        local ok, value = pcall(function()
            return self.AssetService:LoadAssetAsync(assetId)
        end)
        if ok and value ~= nil then
            loaded = value
            break
        end
        lastError = tostring(value)
        task.wait(0.4)
    end
    if loaded == nil then
        error("could not load location asset " .. tostring(assetId) .. ": " .. lastError)
    end

    local model = canonicalModel(loaded)
    model.Name = tostring(row.slug or "deco_asset")
    sanitize(model)
    applyTexture(model, tostring(row.texture_asset_id or ""))
    return model
end

return DecoAssetLoader
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">DecoManager</string>
          <string name="Source"><![CDATA[local DecoAssetLoader = require(script.Parent.DecoAssetLoader)
local DecoPlacement = require(script.Parent.DecoPlacement)
local DecoTransform = require(script.Parent.DecoTransform)
local DecoPlacedAssetSync = require(script.Parent.DecoPlacedAssetSync)

local DecoManager = {}
DecoManager.__index = DecoManager

local CATEGORY_ORDER = { "tree", "bush", "rock", "light", "fence", "decoration" }
local CATEGORY_LABELS = {
    tree = "Trees",
    bush = "Bushes",
    rock = "Rocks",
    light = "Lights",
    fence = "Fences",
    decoration = "Decorations",
}

local function newLabel(parent: Instance, text: string, size: UDim2, position: UDim2, textSize: number, bold: boolean?): TextLabel
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(232, 239, 244)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Font = if bold then Enum.Font.GothamBold else Enum.Font.Gotham
    label.TextSize = textSize
    label.Text = text
    label.Size = size
    label.Position = position
    label.Parent = parent
    return label
end

local function newButton(parent: Instance, text: string, size: UDim2, position: UDim2): TextButton
    local button = Instance.new("TextButton")
    button.AutoButtonColor = true
    button.BackgroundColor3 = Color3.fromRGB(37, 45, 55)
    button.BorderSizePixel = 0
    button.TextColor3 = Color3.fromRGB(232, 239, 244)
    button.Font = Enum.Font.GothamSemibold
    button.TextSize = 13
    button.Text = text
    button.Size = size
    button.Position = position
    button.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = button
    return button
end

local function prepareViewportModel(model: Model)
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.Anchored = true
            descendant.CanCollide = false
            descendant.CanTouch = false
            descendant.CanQuery = false
        end
    end
end

function DecoManager.new(config: any)
    local self = setmetatable({}, DecoManager)
    self.plugin = config.plugin
    self.toolbar = config.toolbar
    self.HttpService = config.HttpService
    self.AssetService = config.AssetService
    self.Workspace = config.Workspace
    self.ChangeHistoryService = config.ChangeHistoryService
    self.UserInputService = config.UserInputService
    self.registry = nil
    self.category = "tree"
    self.index = 1
    self.currentRow = nil
    self.template = nil
    self.preview = nil
    self.loader = DecoAssetLoader.new({
        HttpService = self.HttpService,
        AssetService = self.AssetService,
        agentBaseUrl = config.agentBaseUrl,
        agentToken = config.agentToken,
    })
    self.placement = DecoPlacement.new({
        plugin = self.plugin,
        Workspace = self.Workspace,
        HttpService = self.HttpService,
        ChangeHistoryService = self.ChangeHistoryService,
    })
    self.agentBaseUrl = config.agentBaseUrl
    self.agentToken = config.agentToken
    self:_buildUI()
    self:_wire()
    return self
end

function DecoManager:_buildUI()
    local info = DockWidgetPluginGuiInfo.new(
        Enum.InitialDockState.Right,
        false,
        false,
        390,
        680,
        330,
        650
    )
    self.widget = self.plugin:CreateDockWidgetPluginGui("Game1DecoManager_v1", info)
    self.widget.Title = "game1 · DecoManager"

    local root = Instance.new("Frame")
    root.BackgroundColor3 = Color3.fromRGB(17, 24, 33)
    root.BorderSizePixel = 0
    root.Size = UDim2.fromScale(1, 1)
    root.Parent = self.widget

    newLabel(root, "DECOMANAGER", UDim2.new(1, -24, 0, 22), UDim2.new(0, 12, 0, 10), 11, true).TextColor3 = Color3.fromRGB(66, 214, 177)
    self.title = newLabel(root, "Location assets", UDim2.new(1, -24, 0, 28), UDim2.new(0, 12, 0, 31), 18, true)

    local categoryHost = Instance.new("Frame")
    categoryHost.BackgroundTransparency = 1
    categoryHost.Size = UDim2.new(1, -24, 0, 70)
    categoryHost.Position = UDim2.new(0, 12, 0, 68)
    categoryHost.Parent = root
    self.categoryButtons = {}
    for index, category in ipairs(CATEGORY_ORDER) do
        local column = (index - 1) % 3
        local row = math.floor((index - 1) / 3)
        local button = newButton(categoryHost, CATEGORY_LABELS[category], UDim2.new(1 / 3, -5, 0, 32), UDim2.new(column / 3, 0, 0, row * 36))
        button.TextSize = 11
        self.categoryButtons[category] = button
    end

    local navHost = Instance.new("Frame")
    navHost.BackgroundTransparency = 1
    navHost.Size = UDim2.new(1, -24, 0, 40)
    navHost.Position = UDim2.new(0, 12, 0, 145)
    navHost.Parent = root
    self.previous = newButton(navHost, "‹", UDim2.new(0, 44, 1, 0), UDim2.new(0, 0, 0, 0))
    self.next = newButton(navHost, "›", UDim2.new(0, 44, 1, 0), UDim2.new(1, -44, 0, 0))
    self.counter = newLabel(navHost, "0 / 0", UDim2.new(1, -100, 1, 0), UDim2.new(0, 50, 0, 0), 12, false)
    self.counter.TextXAlignment = Enum.TextXAlignment.Center

    self.viewport = Instance.new("ViewportFrame")
    self.viewport.BackgroundColor3 = Color3.fromRGB(11, 16, 22)
    self.viewport.BorderSizePixel = 0
    self.viewport.Size = UDim2.new(1, -24, 0, 276)
    self.viewport.Position = UDim2.new(0, 12, 0, 193)
    self.viewport.Ambient = Color3.fromRGB(180, 180, 180)
    self.viewport.LightColor = Color3.fromRGB(255, 255, 255)
    self.viewport.LightDirection = Vector3.new(-1, -1, -1)
    self.viewport.Parent = root
    local viewportCorner = Instance.new("UICorner")
    viewportCorner.CornerRadius = UDim.new(0, 8)
    viewportCorner.Parent = self.viewport
    self.world = Instance.new("WorldModel")
    self.world.Name = "DecoPreviewWorld"
    self.world.Parent = self.viewport
    self.camera = Instance.new("Camera")
    self.camera.Name = "DecoPreviewCamera"
    self.camera.FieldOfView = 35
    self.camera.Parent = self.viewport
    self.viewport.CurrentCamera = self.camera
    self.empty = newLabel(self.viewport, "No published assets in this category", UDim2.new(1, -28, 0, 30), UDim2.new(0, 14, 0.5, -15), 12, false)
    self.empty.TextColor3 = Color3.fromRGB(143, 161, 173)
    self.empty.TextXAlignment = Enum.TextXAlignment.Center
    self.cameraTarget = Vector3.zero
    self.cameraDistance = 8
    self.cameraMinDistance = 1
    self.cameraMaxDistance = 40
    self.cameraYaw = math.rad(35)
    self.cameraPitch = math.rad(18)
    self.previewDragging = false

    self.assetName = newLabel(root, "—", UDim2.new(1, -24, 0, 24), UDim2.new(0, 12, 0, 478), 14, true)
    self.assetMeta = newLabel(root, "published registry", UDim2.new(1, -24, 0, 20), UDim2.new(0, 12, 0, 502), 10, false)
    self.assetMeta.TextColor3 = Color3.fromRGB(143, 161, 173)

    self.place = newButton(root, "Place", UDim2.new(0.5, -17, 0, 38), UDim2.new(0, 12, 0, 532))
    self.place.BackgroundColor3 = Color3.fromRGB(66, 214, 177)
    self.place.TextColor3 = Color3.fromRGB(6, 39, 31)
    self.save = newButton(root, "Save Assets Data", UDim2.new(0.5, -17, 0, 38), UDim2.new(0.5, 5, 0, 532))
    self.refresh = newButton(root, "Refresh registry", UDim2.new(1, -24, 0, 32), UDim2.new(0, 12, 0, 578))
    self.status = newLabel(root, "Open DecoManager to load published assets.", UDim2.new(1, -24, 0, 38), UDim2.new(0, 12, 0, 614), 10, false)
    self.status.TextColor3 = Color3.fromRGB(143, 161, 173)
    self.status.TextWrapped = true

    self.widget:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        -- Dock widgets can be shorter than the preferred height. Keep the status visible at the bottom.
        local height = self.widget.AbsoluteSize.Y
        if height > 0 then
            self.status.Position = UDim2.new(0, 12, 1, -42)
        end
    end)
end

function DecoManager:_rows(): { any }
    local rows = {}
    if self.registry and type(self.registry.items) == "table" then
        for _, row in ipairs(self.registry.items) do
            if tostring(row.category or "") == self.category and tostring(row.status or "") == "PUBLISHED" then
                if tonumber(row.model_asset_id) and tonumber(row.texture_asset_id) then
                    table.insert(rows, row)
                end
            end
        end
    end
    table.sort(rows, function(left, right)
        return tostring(left.name_en or left.slug) < tostring(right.name_en or right.slug)
    end)
    return rows
end

function DecoManager:_setStatus(message: string)
    self.status.Text = message
end

function DecoManager:_clearPreview()
    if self.preview then
        self.preview:Destroy()
        self.preview = nil
    end
    if self.template then
        self.template:Destroy()
        self.template = nil
    end
    for _, child in ipairs(self.world:GetChildren()) do
        child:Destroy()
    end
    self.currentRow = nil
    self.empty.Visible = true
    self.assetName.Text = "—"
    self.assetMeta.Text = CATEGORY_LABELS[self.category]
    self.place.Active = false
    self.place.AutoButtonColor = false
    self.place.BackgroundColor3 = Color3.fromRGB(49, 57, 67)
    self.place.TextColor3 = Color3.fromRGB(143, 161, 173)
end

function DecoManager:_updatePreviewCamera()
    self.cameraDistance = math.clamp(self.cameraDistance, self.cameraMinDistance, self.cameraMaxDistance)
    self.cameraPitch = math.clamp(self.cameraPitch, math.rad(-70), math.rad(70))
    local cosPitch = math.cos(self.cameraPitch)
    local offset = Vector3.new(
        math.sin(self.cameraYaw) * cosPitch,
        math.sin(self.cameraPitch),
        math.cos(self.cameraYaw) * cosPitch
    ) * self.cameraDistance
    self.camera.CFrame = CFrame.lookAt(self.cameraTarget + offset, self.cameraTarget, Vector3.yAxis)
end

function DecoManager:_framePreview(model: Model)
    model:PivotTo(DecoTransform.previewPivot(model))
    local boundsCFrame, boundsSize = model:GetBoundingBox()
    local radius = math.max(boundsSize.X, boundsSize.Y, boundsSize.Z, 1)
    self.cameraTarget = boundsCFrame.Position
    self.cameraMinDistance = math.max(radius * 0.55, 0.75)
    self.cameraMaxDistance = math.max(radius * 5, self.cameraMinDistance + 1)
    self.cameraDistance = math.clamp(radius * 1.9, self.cameraMinDistance, self.cameraMaxDistance)
    self.cameraYaw = math.rad(35)
    self.cameraPitch = math.rad(15)
    self:_updatePreviewCamera()
end

function DecoManager:_showCurrent()
    self.placement:cancel()
    local rows = self:_rows()
    if #rows == 0 then
        self.index = 1
        self.counter.Text = "0 / 0"
        self:_clearPreview()
        self:_setStatus("No published " .. string.lower(CATEGORY_LABELS[self.category]) .. ". Publish one in Asset Manager.")
        return
    end
    self.index = math.clamp(self.index, 1, #rows)
    local row = rows[self.index]
    self.counter.Text = tostring(self.index) .. " / " .. tostring(#rows)
    self:_clearPreview()
    self:_setStatus("Loading " .. tostring(row.name_en or row.slug) .. "…")
    local ok, result = pcall(function()
        return self.loader:loadPublished(row)
    end)
    if not ok then
        self:_setStatus("Preview failed · " .. tostring(result))
        warn("[game1 DecoManager] " .. tostring(result))
        return
    end
    self.template = result
    self.currentRow = row
    self.preview = result:Clone()
    prepareViewportModel(self.preview)
    self.preview.Parent = self.world
    self:_framePreview(self.preview)
    self.empty.Visible = false
    self.assetName.Text = tostring(row.name_en or row.slug)
    self.assetMeta.Text = CATEGORY_LABELS[self.category] .. " · model " .. tostring(row.model_asset_id) .. " · texture " .. tostring(row.texture_asset_id)
    self.place.Active = true
    self.place.AutoButtonColor = true
    self.place.BackgroundColor3 = Color3.fromRGB(66, 214, 177)
    self.place.TextColor3 = Color3.fromRGB(6, 39, 31)
    self:_setStatus("Ready · Place starts surface-snapped placement in the 3D viewport.")
end

function DecoManager:_setCategory(category: string)
    if CATEGORY_LABELS[category] == nil then
        return
    end
    self.category = category
    self.index = 1
    for key, button in pairs(self.categoryButtons) do
        button.BackgroundColor3 = if key == category then Color3.fromRGB(49, 112, 96) else Color3.fromRGB(37, 45, 55)
    end
    self:_showCurrent()
end

function DecoManager:refreshRegistry()
    self:_setStatus("Refreshing Location Assets registry…")
    local ok, result = pcall(function()
        return self.loader:fetchRegistry()
    end)
    if not ok then
        self.registry = nil
        self:_clearPreview()
        self:_setStatus("Asset Manager unavailable · " .. tostring(result))
        return
    end
    self.registry = result
    local syncResult = DecoPlacedAssetSync.RefreshTextures(self.Workspace, result)
    if syncResult.parts > 0 then
        self.ChangeHistoryService:SetWaypoint("Refresh Deco Asset Textures")
    end
    self:_setCategory(self.category)
    if syncResult.parts > 0 then
        self:_setStatus(("Registry refreshed · updated texture on %d placed asset(s) / %d MeshPart(s)"):format(
            syncResult.models,
            syncResult.parts
        ))
    end
end

function DecoManager:_placeCurrent()
    if self.template == nil or self.currentRow == nil then
        return
    end
    self.placement:start(self.template, self.currentRow, function(message)
        self:_setStatus(message)
    end)
end

function DecoManager:_postLayout(records: { any }): any
    local response = self.HttpService:RequestAsync({
        Url = self.agentBaseUrl .. "/api/location-assets/layout",
        Method = "POST",
        Headers = {
            ["X-Control-Token"] = self.agentToken,
            ["Content-Type"] = "application/json",
        },
        Body = self.HttpService:JSONEncode({
            schemaVersion = 1,
            project = "game1",
            placeId = game.PlaceId,
            placeName = game.Name,
            records = records,
        }),
    })
    if not response.Success then
        error(("Asset Manager backup HTTP %d: %s"):format(response.StatusCode, response.Body))
    end
    return self.HttpService:JSONDecode(response.Body)
end

function DecoManager:_saveAssetsData()
    self.placement:cancel()
    local records = self.placement:serialize()
    self:_setStatus(("Saving %d placed asset(s)…"):format(#records))
    local ok, backup = pcall(function()
        return self:_postLayout(records)
    end)
    if not ok then
        self:_setStatus("Assets data save failed · " .. tostring(backup))
        warn("[game1 DecoManager] " .. tostring(backup))
        return
    end
    local studioSave = backup.studioSave or {}
    if studioSave.requested == true then
        self:_setStatus(("Saved · %d asset(s) · %s · Studio save requested"):format(#records, tostring(backup.backupPath or "backup")))
    else
        self:_setStatus(("Backup saved (%s), but Studio save was not requested"):format(tostring(backup.backupPath or "backup")))
    end
end

function DecoManager:_wire()
    self.button = self.toolbar:CreateButton(
        "Game1DecoManager",
        "Browse and place published game1 location assets",
        "",
        "DecoManager"
    )
    self.button.ClickableWhenViewportHidden = true
    self.button.Click:Connect(function()
        self.widget.Enabled = not self.widget.Enabled
    end)
    self.widget:GetPropertyChangedSignal("Enabled"):Connect(function()
        self.button:SetActive(self.widget.Enabled)
        if self.widget.Enabled then
            task.defer(function()
                self:refreshRegistry()
            end)
        else
            self.placement:cancel()
        end
    end)
    for category, categoryButton in pairs(self.categoryButtons) do
        categoryButton.MouseButton1Click:Connect(function()
            self:_setCategory(category)
        end)
    end
    self.previous.MouseButton1Click:Connect(function()
        local rows = self:_rows()
        if #rows == 0 then return end
        self.index = ((self.index - 2) % #rows) + 1
        self:_showCurrent()
    end)
    self.next.MouseButton1Click:Connect(function()
        local rows = self:_rows()
        if #rows == 0 then return end
        self.index = (self.index % #rows) + 1
        self:_showCurrent()
    end)
    self.viewport.MouseLeave:Connect(function()
        self.previewDragging = false
    end)
    self.viewport.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and self.preview ~= nil then
            self.previewDragging = true
        end
    end)
    self.viewport.InputChanged:Connect(function(input)
        if self.preview == nil then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement and self.previewDragging then
            self.cameraYaw -= input.Delta.X * 0.010
            self.cameraPitch -= input.Delta.Y * 0.008
            self:_updatePreviewCamera()
        elseif input.UserInputType == Enum.UserInputType.MouseWheel then
            local wheel = input.Position.Z
            if math.abs(wheel) > 0.001 then
                local step = math.max(self.cameraDistance * 0.12, 0.15)
                self.cameraDistance -= wheel * step
                self:_updatePreviewCamera()
            end
        end
    end)
    self.viewport.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self.previewDragging = false
        end
    end)
    self.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self.previewDragging = false
        end
    end)
    self.place.MouseButton1Click:Connect(function()
        self:_placeCurrent()
    end)
    self.refresh.MouseButton1Click:Connect(function()
        self:refreshRegistry()
    end)
    self.save.MouseButton1Click:Connect(function()
        self:_saveAssetsData()
    end)
    self.plugin.Deactivation:Connect(function()
        self.placement:cancel()
    end)
    self.plugin.Unloading:Connect(function()
        self.placement:cancel()
        self:_clearPreview()
    end)
    self:_setCategory("tree")
end

return DecoManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">DecoPlacedAssetSync</string>
          <string name="Source"><![CDATA[local DecoPlacedAssetSync = {}

local ROOT_NAME = "Game1DecoAssets"
local ASSET_SLUG_ATTRIBUTE = "Game1DecoAssetSlug"

local function rowsBySlug(registry: any): { [string]: any }
    local result = {}
    if type(registry) ~= "table" or type(registry.items) ~= "table" then
        return result
    end
    for _, row in ipairs(registry.items) do
        local slug = tostring(row.slug or "")
        if slug ~= "" then
            result[slug] = row
        end
    end
    return result
end

function DecoPlacedAssetSync.RefreshTextures(workspace: Workspace, registry: any): any
    local root = workspace:FindFirstChild(ROOT_NAME)
    if root == nil then
        return { models = 0, parts = 0 }
    end

    local registryRows = rowsBySlug(registry)
    local changedModels = 0
    local changedParts = 0
    for _, descendant in ipairs(root:GetDescendants()) do
        if descendant:IsA("Model") then
            local slug = tostring(descendant:GetAttribute(ASSET_SLUG_ATTRIBUTE) or "")
            local row = registryRows[slug]
            local numericId = row and tonumber(row.texture_asset_id) or nil
            if row and tostring(row.status or "") == "PUBLISHED" and numericId and numericId > 0 then
                local uri = "rbxassetid://" .. tostring(math.floor(numericId))
                local modelChanged = false
                for _, part in ipairs(descendant:GetDescendants()) do
                    if part:IsA("MeshPart") and part.TextureID ~= uri then
                        part.TextureID = uri
                        changedParts += 1
                        modelChanged = true
                    end
                end
                if modelChanged then
                    changedModels += 1
                end
            end
        end
    end
    return { models = changedModels, parts = changedParts }
end

return DecoPlacedAssetSync
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">DecoPlacement</string>
          <string name="Source"><![CDATA[local DecoTransform = require(script.Parent.DecoTransform)

local DecoPlacement = {}
DecoPlacement.__index = DecoPlacement

local ROOT_NAME = "Game1DecoAssets"
local CATEGORY_FOLDERS = {
    tree = "Trees",
    bush = "Bushes",
    rock = "Rocks",
    light = "Lights",
    fence = "Fences",
    decoration = "Decorations",
}

local function prepareGhost(model: Model)
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.Anchored = true
            descendant.CanCollide = false
            descendant.CanTouch = false
            descendant.CanQuery = false
            descendant.CastShadow = false
            descendant.Transparency = math.max(descendant.Transparency, 0.45)
        end
    end
end

local function preparePlaced(model: Model)
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            -- Placement ghosts are anchored, authored decorations are not. Keep the
            -- placed asset editable with the normal Studio transform tools.
            descendant.Anchored = false
            descendant.CanTouch = false
        end
    end
end

function DecoPlacement.new(config: any)
    local self = setmetatable({
        plugin = config.plugin,
        Workspace = config.Workspace,
        HttpService = config.HttpService,
        ChangeHistoryService = config.ChangeHistoryService,
        mouse = config.plugin:GetMouse(),
        sourceTemplate = nil,
        row = nil,
        ghost = nil,
        supportOffset = 0,
        authoredPivotRotation = CFrame.identity,
        moveConnection = nil,
        clickConnection = nil,
        statusCallback = nil,
        committing = false,
    }, DecoPlacement)
    return self
end

function DecoPlacement:_root(): Folder
    local root = self.Workspace:FindFirstChild(ROOT_NAME)
    if root and not root:IsA("Folder") then
        error("Workspace." .. ROOT_NAME .. " exists but is not a Folder")
    end
    if root == nil then
        root = Instance.new("Folder")
        root.Name = ROOT_NAME
        root.Parent = self.Workspace
    end
    return root :: Folder
end

function DecoPlacement:_categoryFolder(category: string): Folder
    local root = self:_root()
    local name = CATEGORY_FOLDERS[category]
    if name == nil then
        error("unsupported deco category: " .. category)
    end
    local folder = root:FindFirstChild(name)
    if folder and not folder:IsA("Folder") then
        error(root:GetFullName() .. "." .. name .. " exists but is not a Folder")
    end
    if folder == nil then
        folder = Instance.new("Folder")
        folder.Name = name
        folder.Parent = root
    end
    return folder :: Folder
end

function DecoPlacement:_status(message: string)
    if self.statusCallback then
        self.statusCallback(message)
    end
end

function DecoPlacement:_raycast(): RaycastResult?
    local unitRay = self.mouse.UnitRay
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = {}
    if self.ghost ~= nil then
        table.insert(excluded, self.ghost)
    end
    local authoring = self.Workspace:FindFirstChild("Game1Authoring")
    if authoring ~= nil then
        table.insert(excluded, authoring)
    end
    params.FilterDescendantsInstances = excluded
    params.IgnoreWater = false
    return self.Workspace:Raycast(unitRay.Origin, unitRay.Direction * 10000, params)
end

function DecoPlacement:_updateGhost()
    if self.ghost == nil then
        return
    end
    local hit = self:_raycast()
    if hit == nil then
        self:_status("Placement · point at a surface")
        return
    end
    local camera = self.Workspace.CurrentCamera
    local cameraLook = if camera then camera.CFrame.LookVector else Vector3.new(0, 0, -1)
    local normal = if hit.Normal.Magnitude > 0.001 then hit.Normal.Unit else Vector3.yAxis
    local targetPosition = hit.Position + normal * self.supportOffset
    self.ghost:PivotTo(DecoTransform.placementPivot(
        self.authoredPivotRotation,
        targetPosition,
        normal,
        cameraLook
    ))
    self:_status("Placement · click to place on " .. hit.Instance:GetFullName())
end

function DecoPlacement:_detachSession(): Model?
    if self.moveConnection then
        self.moveConnection:Disconnect()
        self.moveConnection = nil
    end
    if self.clickConnection then
        self.clickConnection:Disconnect()
        self.clickConnection = nil
    end
    local ghost = self.ghost
    self.ghost = nil
    self.sourceTemplate = nil
    self.row = nil
    self.supportOffset = 0
    self.authoredPivotRotation = CFrame.identity
    return ghost
end

function DecoPlacement:cancel()
    local ghost = self:_detachSession()
    if ghost ~= nil then
        ghost:Destroy()
    end
    self.committing = false
end

function DecoPlacement:_commit()
    if self.committing or self.ghost == nil or self.sourceTemplate == nil or self.row == nil then
        return
    end
    self.committing = true

    local ghost = self.ghost
    local sourceTemplate = self.sourceTemplate
    local row = self.row
    local statusCallback = self.statusCallback
    local pivot = ghost:GetPivot()

    local placed = sourceTemplate:Clone()
    preparePlaced(placed)
    local instanceId = self.HttpService:GenerateGUID(false)
    placed.Name = tostring(row.slug or "deco") .. "__" .. string.sub(instanceId, 1, 8)
    -- Studio placement stores identity, not gameplay policy. Runtime resolves the
    -- current LocationAssetRegistry definition from this stable asset key.
    placed:SetAttribute("Game1DecoInstanceId", instanceId)
    placed:SetAttribute("Game1DecoAssetSlug", tostring(row.slug or ""))
    placed.Parent = self:_categoryFolder(tostring(row.category or ""))
    placed:PivotTo(pivot)

    -- Detach the session before deactivating the plugin. Deactivation is re-entrant
    -- and must never be able to destroy an instance that the active call still uses.
    local staleGhost = self:_detachSession()
    if staleGhost ~= nil then
        staleGhost:Destroy()
    end
    self.plugin:Deactivate()
    self.ChangeHistoryService:SetWaypoint("Place Deco Asset")

    self.committing = false
    if statusCallback then
        statusCallback("Placed · " .. placed.Name)
    end
end

function DecoPlacement:start(template: Model, row: any, statusCallback: (string) -> ())
    self:cancel()

    -- Activate before creating the new transient session. Studio may fire
    -- Plugin.Deactivation while tool ownership changes; there is nothing fresh to
    -- destroy until Activate has completed.
    self.plugin:Activate(true)

    self.sourceTemplate = template
    self.row = row
    self.statusCallback = statusCallback
    self.supportOffset = DecoTransform.supportOffset(template)
    self.authoredPivotRotation = DecoTransform.authoredPivotRotation(template)

    local ghost = template:Clone()
    ghost.Name = "Game1DecoPlacementGhost"
    prepareGhost(ghost)
    self.ghost = ghost

    -- Keep the placement preview out of the authored Workspace tree and change
    -- history. Camera descendants still render in Studio and use world CFrames.
    local camera = self.Workspace.CurrentCamera
    ghost.Parent = if camera ~= nil then camera else self.Workspace

    self:_updateGhost()
    self.moveConnection = self.mouse.Move:Connect(function()
        self:_updateGhost()
    end)
    self.clickConnection = self.mouse.Button1Down:Connect(function()
        if self:_raycast() ~= nil then
            self:_updateGhost()
            self:_commit()
        end
    end)
end

function DecoPlacement:serialize(): { any }
    local root = self.Workspace:FindFirstChild(ROOT_NAME)
    if root == nil then
        return {}
    end
    local records = {}
    for _, descendant in ipairs(root:GetDescendants()) do
        if descendant:IsA("Model") and tostring(descendant:GetAttribute("Game1DecoAssetSlug") or "") ~= "" then
            local pivot = descendant:GetPivot()
            local cframe = { pivot:GetComponents() }
            local scale = 1
            pcall(function()
                scale = descendant:GetScale()
            end)
            table.insert(records, {
                instanceId = tostring(descendant:GetAttribute("Game1DecoInstanceId") or ""),
                name = descendant.Name,
                locationAssetId = tostring(descendant:GetAttribute("Game1DecoAssetSlug") or ""),
                cframe = cframe,
                scale = scale,
            })
        end
    end
    table.sort(records, function(left, right)
        return tostring(left.instanceId) < tostring(right.instanceId)
    end)
    return records
end

return DecoPlacement
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">DecoTransform</string>
          <string name="Source"><![CDATA[local DecoTransform = {}

local WORLD_UP = Vector3.yAxis

local function rotationOnly(cframe: CFrame): CFrame
    return CFrame.fromMatrix(Vector3.zero, cframe.XVector, cframe.YVector, cframe.ZVector)
end

local function surfaceFrame(normal: Vector3, cameraLook: Vector3): CFrame
    local up = if normal.Magnitude > 0.001 then normal.Unit else WORLD_UP
    local forward = cameraLook - up * cameraLook:Dot(up)
    if forward.Magnitude < 0.01 then
        local fallback = if math.abs(up.Y) < 0.95 then WORLD_UP else Vector3.zAxis
        forward = fallback - up * fallback:Dot(up)
    end
    return CFrame.lookAt(Vector3.zero, forward.Unit, up)
end

function DecoTransform.authoredPivotRotation(model: Model): CFrame
    return rotationOnly(model:GetPivot())
end

function DecoTransform.previewPivot(model: Model): CFrame
    -- Re-center the model without replacing the imported FBX basis. Roblox can
    -- encode FBX axis conversion in the model/part pivot; forcing identity here
    -- makes otherwise-correct Z-up source assets appear rotated in the viewport.
    return DecoTransform.authoredPivotRotation(model)
end

function DecoTransform.supportOffset(model: Model): number
    -- Measure the lowest rendered part point against Roblox world-up in the
    -- asset's authored pose. This is independent of the model pivot's local axes.
    -- The same offset remains valid after surfaceFrame rotates the whole authored
    -- pose from world-up onto the hit normal.
    local pivot = model:GetPivot()
    local minimum = math.huge
    local hasPart = false

    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            hasPart = true
            local half = descendant.Size * 0.5
            for _, x in ipairs({ -1, 1 }) do
                for _, y in ipairs({ -1, 1 }) do
                    for _, z in ipairs({ -1, 1 }) do
                        local point = descendant.CFrame:PointToWorldSpace(Vector3.new(
                            half.X * x,
                            half.Y * y,
                            half.Z * z
                        ))
                        local height = (point - pivot.Position):Dot(WORLD_UP)
                        minimum = math.min(minimum, height)
                    end
                end
            end
        end
    end

    if not hasPart then
        error("location asset model contains no BasePart geometry")
    end
    return math.max(0, -minimum)
end

function DecoTransform.placementPivot(
    authoredPivotRotation: CFrame,
    targetPosition: Vector3,
    surfaceNormal: Vector3,
    cameraLook: Vector3
): CFrame
    -- surfaceFrame is a delta from canonical Roblox world-up to the requested
    -- surface. authoredPivotRotation is multiplied afterwards so importer-authored
    -- FBX basis compensation is preserved instead of overwritten.
    return CFrame.new(targetPosition) * surfaceFrame(surfaceNormal, cameraLook) * authoredPivotRotation
end

return DecoTransform
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">LocationCommands</string>
          <string name="Source"><![CDATA[-- Polygon Location authoring commands for game1 Asset Manager.
return function(Context)
    local HttpService = Context.HttpService
    local Selection = Context.Selection
    local Workspace = Context.Workspace
    local UserInputService = Context.UserInputService
    local BRIDGE_URL = Context.BRIDGE_URL
    local BRIDGE_TOKEN = Context.BRIDGE_TOKEN
    local plugin = Context.plugin

    local AUTHORING_ROOT = "Game1Authoring"
    local LOCATION_FOLDER = "Locations"

    local function postResult(payload: any)
        local response = HttpService:RequestAsync({
            Url = BRIDGE_URL .. "/location-authoring-result",
            Method = "POST",
            Headers = {
                ["X-Game1-Token"] = BRIDGE_TOKEN,
                ["Content-Type"] = "application/json",
            },
            Body = HttpService:JSONEncode(payload),
        })
        if not response.Success then
            error("game1 Location authoring result bridge rejected response: " .. tostring(response.StatusCode))
        end
    end

    local function locationFolder(): Folder
        local root = Workspace:FindFirstChild(AUTHORING_ROOT)
        if root and not root:IsA("Folder") then
            error("Workspace." .. AUTHORING_ROOT .. " exists but is not a Folder")
        end
        if not root then
            root = Instance.new("Folder")
            root.Name = AUTHORING_ROOT
            root:SetAttribute("Game1Authoring", true)
            root.Parent = Workspace
        end
        local folder = root:FindFirstChild(LOCATION_FOLDER)
        if folder and not folder:IsA("Folder") then
            error(root:GetFullName() .. "." .. LOCATION_FOLDER .. " exists but is not a Folder")
        end
        if not folder then
            folder = Instance.new("Folder")
            folder.Name = LOCATION_FOLDER
            folder.Parent = root
        end
        return folder :: Folder
    end

    local function findLocationMarker(locationId: string): Model?
        local root = Workspace:FindFirstChild(AUTHORING_ROOT)
        local folder = root and root:FindFirstChild(LOCATION_FOLDER)
        if not folder then
            return nil
        end
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Model") and tostring(child:GetAttribute("LocationId") or "") == locationId then
                return child
            end
        end
        return nil
    end

    local function safeName(value: any): string
        local name = tostring(value or "Location"):gsub("[^%w]+", "_"):gsub("^_+", ""):gsub("_+$", "")
        return name ~= "" and name or "Location"
    end

    local function markerName(data: any): string
        local shortId = tostring(data.locationId or "location"):gsub("^location%-", ""):sub(1, 8)
        return string.format("%s_%s", safeName(data.name), shortId)
    end

    local function pointFromData(value: any): Vector3
        if typeof(value) ~= "table" then
            error("Location point is invalid")
        end
        local x = tonumber(value.x)
        local y = tonumber(value.y)
        local z = tonumber(value.z)
        if not x or not y or not z then
            error("Location point coordinates are invalid")
        end
        return Vector3.new(x, y, z)
    end

    local function markerPart(
        parent: Instance,
        name: string,
        size: Vector3,
        cframe: CFrame,
        color: Color3,
        transparency: number
    ): Part
        local item = Instance.new("Part")
        item.Name = name
        item.Anchored = true
        item.CanCollide = false
        item.CanTouch = false
        item.CanQuery = false
        item.CastShadow = false
        item.Material = Enum.Material.Neon
        item.Color = color
        item.Transparency = transparency
        item.Size = size
        item.CFrame = cframe
        item.Parent = parent
        return item
    end

    local function linePart(
        parent: Instance,
        name: string,
        a: Vector3,
        b: Vector3,
        color: Color3,
        transparency: number
    ): Part?
        local delta = b - a
        local length = delta.Magnitude
        if length < 0.02 then
            return nil
        end
        return markerPart(
            parent,
            name,
            Vector3.new(0.16, 0.16, length),
            CFrame.lookAt((a + b) * 0.5, b),
            color,
            transparency
        )
    end

    local function addLabel(marker: Model, adornee: BasePart, data: any, preview: boolean)
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "Label"
        billboard.Adornee = adornee
        billboard.AlwaysOnTop = true
        billboard.LightInfluence = 0
        billboard.Size = UDim2.fromOffset(260, 52)
        billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.4, 0)
        billboard.Parent = marker

        local text = Instance.new("TextLabel")
        text.BackgroundColor3 = Color3.fromRGB(17, 22, 30)
        text.BackgroundTransparency = 0.1
        text.BorderSizePixel = 0
        text.Size = UDim2.fromScale(1, 1)
        text.Font = Enum.Font.GothamSemibold
        text.TextColor3 = Color3.fromRGB(246, 248, 251)
        text.TextSize = 14
        text.TextWrapped = true
        text.Text = string.format("%s\nLocation%s", tostring(data.name or "Location"), preview and " · DRAW" or "")
        text.Parent = billboard

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 7)
        corner.Parent = text
    end

    local function clearCopies(locationId: string, preview: boolean)
        for _, child in ipairs(locationFolder():GetChildren()) do
            if child:IsA("Model") then
                local registered = not preview and tostring(child:GetAttribute("LocationId") or "") == locationId
                local previewCopy = tostring(child:GetAttribute("PreviewForLocationId") or "") == locationId
                if registered or previewCopy then
                    child:Destroy()
                end
            end
        end
    end

    local function createLocationMarker(data: any, preview: boolean): Model
        local locationId = tostring(data.locationId or "")
        if not locationId:match("^location%-%w[%w%-]+$") then
            error("Location command has invalid locationId")
        end
        local values = typeof(data.points) == "table" and data.points or {}
        if #values < 3 then
            error("Registered Location polygon must contain at least 3 points")
        end
        clearCopies(locationId, preview)

        local marker = Instance.new("Model")
        marker.Name = markerName(data)
        marker:SetAttribute("Game1LocationMarker", true)
        marker:SetAttribute("LocationId", preview and "" or locationId)
        if preview then
            marker:SetAttribute("PreviewForLocationId", locationId)
        end
        marker:SetAttribute("LocationName", tostring(data.name or "Location"))
        marker:SetAttribute("PlaceId", tonumber(data.placeId) or game.PlaceId)
        marker.Parent = locationFolder()

        local color = preview and Color3.fromRGB(255, 161, 84) or Color3.fromRGB(66, 214, 177)
        local points = {}
        for index, raw in ipairs(values) do
            local world = pointFromData(raw)
            table.insert(points, world)
            local vertex = markerPart(
                marker,
                string.format("Point_%03d", index),
                Vector3.new(0.75, 0.75, 0.75),
                CFrame.new(world),
                color,
                0.08
            )
            vertex.Shape = Enum.PartType.Ball
            vertex:SetAttribute("LocationVertexIndex", index)
        end
        for index = 1, #points do
            local nextIndex = index == #points and 1 or index + 1
            linePart(marker, string.format("Edge_%03d", index), points[index], points[nextIndex], color, 0.08)
        end
        local first = marker:FindFirstChild("Point_001")
        if first and first:IsA("BasePart") then
            marker.PrimaryPart = first
            addLabel(marker, first, data, preview)
        end
        Selection:Set({ marker })
        return marker
    end

    local function createDrawPreview(data: any): (Model, Part)
        local locationId = tostring(data.locationId or "")
        clearCopies(locationId, true)
        local marker = Instance.new("Model")
        marker.Name = "DRAW_" .. markerName(data)
        marker:SetAttribute("Game1LocationMarker", true)
        marker:SetAttribute("PreviewForLocationId", locationId)
        marker:SetAttribute("LocationName", tostring(data.name or "Location"))
        marker.Parent = locationFolder()
        local liveEdge = markerPart(
            marker,
            "LiveEdge",
            Vector3.new(0.1, 0.1, 0.1),
            CFrame.new(),
            Color3.fromRGB(255, 161, 84),
            0.2
        )
        return marker, liveEdge
    end

    local function updateLiveEdge(liveEdge: Part, a: Vector3?, b: Vector3?)
        if not a or not b or (b - a).Magnitude < 0.02 then
            liveEdge.Transparency = 1
            return
        end
        local length = (b - a).Magnitude
        liveEdge.Size = Vector3.new(0.12, 0.12, length)
        liveEdge.CFrame = CFrame.lookAt((a + b) * 0.5, b)
        liveEdge.Transparency = 0.22
    end

    local function drawResult(data: any): any
        local mouse = plugin:GetMouse()
        local marker, liveEdge = createDrawPreview(data)
        local color = Color3.fromRGB(255, 161, 84)
        local points: { Vector3 } = {}
        local finished = false
        local cancelled = false
        local firstVertex: Part? = nil

        plugin:Activate(true)
        local moveConnection = mouse.Move:Connect(function()
            if #points > 0 and mouse.Target then
                updateLiveEdge(liveEdge, points[#points], mouse.Hit.Position)
            end
        end)
        local clickConnection = mouse.Button1Down:Connect(function()
            if not mouse.Target then
                return
            end
            if firstVertex and mouse.Target == firstVertex then
                if #points >= 3 then
                    finished = true
                end
                return
            end
            if mouse.Target:IsDescendantOf(marker) then
                return
            end
            local world = mouse.Hit.Position
            table.insert(points, world)
            local index = #points
            local vertex = markerPart(
                marker,
                string.format("Point_%03d", index),
                Vector3.new(1.05, 1.05, 1.05),
                CFrame.new(world),
                color,
                0.04
            )
            vertex.Shape = Enum.PartType.Ball
            vertex:SetAttribute("LocationVertexIndex", index)
            if index == 1 then
                firstVertex = vertex
                vertex.CanQuery = true
                addLabel(marker, vertex, data, true)
            elseif index > 1 then
                linePart(marker, string.format("Edge_%03d", index - 1), points[index - 1], world, color, 0.08)
            end
        end)
        local inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
            if not processed and input.KeyCode == Enum.KeyCode.Escape then
                cancelled = true
            end
        end)

        local deadline = os.clock() + 295
        repeat
            task.wait(0.05)
        until finished or cancelled or os.clock() >= deadline
        moveConnection:Disconnect()
        clickConnection:Disconnect()
        inputConnection:Disconnect()
        plugin:Deactivate()

        if not finished then
            marker:Destroy()
            error(cancelled and "Location drawing was cancelled" or "Location drawing timed out")
        end
        liveEdge:Destroy()
        if firstVertex then
            firstVertex.CanQuery = false
        end
        linePart(marker, string.format("Edge_%03d", #points), points[#points], points[1], color, 0.08)

        local resultPoints = {}
        for _, world in ipairs(points) do
            table.insert(resultPoints, { x = world.X, y = world.Y, z = world.Z })
        end
        Selection:Set({ marker })
        return {
            points = resultPoints,
            placeId = game.PlaceId,
            markerPath = marker:GetFullName(),
            closed = true,
        }
    end

    local function validatePlace(data: any)
        local expectedPlaceId = tonumber(data.placeId) or 0
        if expectedPlaceId > 0 and game.PlaceId > 0 and expectedPlaceId ~= game.PlaceId then
            error(string.format("Open PlaceId %d does not match Location PlaceId %d", game.PlaceId, expectedPlaceId))
        end
    end

    local function handle(data: any)
        local payload = {
            schemaVersion = 1,
            project = "game1",
            command = "location-authoring",
            action = tostring(data.action or ""),
            operationId = tostring(data.operationId or ""),
            locationId = tostring(data.locationId or ""),
            placeId = game.PlaceId,
            placeName = game.Name,
        }

        local ok, resultOrError = xpcall(function()
            if tostring(data.project or "") ~= "game1" or tonumber(data.schemaVersion) ~= 1 then
                error("invalid game1 Location command")
            end
            validatePlace(data)
            local action = tostring(data.action or "")
            if action == "draw" then
                return drawResult(data)
            elseif action == "upsert" then
                local marker = createLocationMarker(data, false)
                return { markerPath = marker:GetFullName(), synchronized = true }
            elseif action == "select" then
                local marker = findLocationMarker(tostring(data.locationId or ""))
                if not marker then
                    error("Registered Location marker was not found in Studio")
                end
                Selection:Set({ marker })
                local root = marker.PrimaryPart
                local camera = Workspace.CurrentCamera
                if root and camera then
                    camera.CFrame = CFrame.lookAt(root.Position + Vector3.new(18, 16, 18), root.Position)
                end
                return { markerPath = marker:GetFullName(), synchronized = true }
            elseif action == "delete" then
                local marker = findLocationMarker(tostring(data.locationId or ""))
                if marker then
                    marker:Destroy()
                end
                for _, child in ipairs(locationFolder():GetChildren()) do
                    if child:IsA("Model")
                        and tostring(child:GetAttribute("PreviewForLocationId") or "") == tostring(data.locationId or "") then
                        child:Destroy()
                    end
                end
                return { deleted = marker ~= nil, synchronized = true }
            elseif action == "sync" then
                local folder = locationFolder()
                for _, child in ipairs(folder:GetChildren()) do
                    if child:IsA("Model") and child:GetAttribute("Game1LocationMarker") == true then
                        child:Destroy()
                    end
                end
                local created = 0
                local skipped = 0
                local syncedLocationIds = {}
                for _, record in ipairs(typeof(data.records) == "table" and data.records or {}) do
                    local recordPlaceId = tonumber(record.placeId) or 0
                    if recordPlaceId == 0 or game.PlaceId == 0 or recordPlaceId == game.PlaceId then
                        createLocationMarker(record, false)
                        created += 1
                        table.insert(syncedLocationIds, tostring(record.locationId or ""))
                    else
                        skipped += 1
                    end
                end
                return {
                    synchronized = true,
                    created = created,
                    skipped = skipped,
                    syncedLocationIds = syncedLocationIds,
                }
            end
            error("Unsupported Location action: " .. action)
        end, debug.traceback)

        if ok then
            for key, value in pairs(resultOrError) do
                payload[key] = value
            end
        else
            payload.error = tostring(resultOrError)
        end

        local postOk, postError = pcall(postResult, payload)
        if not postOk then
            warn("[game1 plugin] failed to report Location result: " .. tostring(postError))
        end
    end

    return {
        handle = handle,
    }
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>