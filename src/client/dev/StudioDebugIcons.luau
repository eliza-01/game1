function Icons.Mount(id: string, launcher: TextButton): (Color3) -> ()
    local glyph = assert(glyphs[id], "Unknown debug glyph " .. id)
    launcher.Text = ""
    local canvas = Instance.new("Frame")
    canvas.Name = "DebugGlyph"
    canvas.BackgroundTransparency = 1
    canvas.Active = false
    canvas.AnchorPoint = Vector2.new(0.5, 0.5)
    canvas.Position = UDim2.fromScale(0.5, 0.5)
    canvas.Size = UDim2.fromOffset(24, 24)
    canvas.ZIndex = launcher.ZIndex + 1
    canvas.Parent = launcher
    local runs = {}
    for y, row in ipairs(glyph.rows) do
        local x = 1
        while x <= #row do
            if row:sub(x, x) == "#" then
                local first = x
                repeat x += 1 until x > #row or row:sub(x, x) ~= "#"
                local run = Instance.new("Frame")
                run.BorderSizePixel = 0
                run.Active = false
                run.Position = UDim2.fromOffset(first - 1, y - 1)
                run.Size = UDim2.fromOffset(x - first, 1)
                run.ZIndex = canvas.ZIndex
                run.Parent = canvas
                table.insert(runs, run)
            else
                x += 1
            end
        end
    end
    local tip = Instance.new("TextLabel")
    tip.Name = "DebugTooltip"
    tip.Text = glyph.label
    tip.Font = Enum.Font.GothamMedium
    tip.TextSize = 12
    tip.TextColor3 = Color3.fromRGB(239, 244, 248)
    tip.BackgroundColor3 = Color3.fromRGB(22, 28, 36)
    tip.BorderSizePixel = 0
    tip.Size = UDim2.fromOffset(146, 25)
    tip.Position = UDim2.fromOffset(0, -28)
    tip.Visible = false
    tip.Active = false
    tip.ZIndex = launcher.ZIndex + 4
    tip:SetAttribute("WorldInputPassthrough", true)
    tip.Parent = launcher
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = tip
    launcher.MouseEnter:Connect(function()
        local screen = launcher:FindFirstAncestorWhichIsA("ScreenGui")
        if screen then
            local x = math.min(0, screen.AbsoluteSize.X - launcher.AbsolutePosition.X - 146 - 8)
            local y = if launcher.AbsolutePosition.Y >= 28 then -28 else 47
            tip.Position = UDim2.fromOffset(x, y)
        end
        tip.Visible = true
    end)
    launcher.MouseLeave:Connect(function() tip.Visible = false end)
    return function(color: Color3)
        for _, run in ipairs(runs) do run.BackgroundColor3 = color end
    end
end
return table.freeze(Icons)
