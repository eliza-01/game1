-- Runtime-friendly, read-only Location Asset surface classification.
-- Sound/impact systems may consume soundFamily without depending on authoring tools.
-- The authoritative material and alias tables are generated by LocationAssetStore.
local Registry = require(script.Parent.LocationAssetRegistry)
local Resolver = {}

function Resolver.ForSlug(slug: string?): any?
    if type(slug) ~= "string" or slug == "" then return nil end
    local canonical = (Registry.aliases or {})[slug] or slug
    local entry = Registry.assets[canonical]
    if not entry then return nil end
    return table.freeze({
        slug = canonical,
        material = entry.surfaceMaterial or "default",
        robloxMaterial = entry.robloxMaterial or "", -- visual only, not an audio category
        visualMaterial = entry.visualMaterial or "SmoothPlastic",
        visualColor = entry.visualColor or "#FFFFFF",
        soundFamily = entry.soundFamily or "generic",
    })
end

function Resolver.ForHit(part: BasePart?): any?
    if not part then return nil end
    local ancestor: Instance? = part
    while ancestor do
        local slug = ancestor:GetAttribute("Game1DecoAssetSlug")
        if type(slug) == "string" then
            return Resolver.ForSlug(slug)
        end
        ancestor = ancestor.Parent
    end
    return nil -- Unregistered world geometry is deliberately not classified.
end

return table.freeze(Resolver)
