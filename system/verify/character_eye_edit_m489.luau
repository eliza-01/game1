local Edit = require("../../src/client/character/CharacterCreationEyeEdit")
local function pair(p, l, r)
    assert(p.l == l and p.r == r, tostring(p.l) .. "/" .. tostring(p.r))
end
local original = {l = "#112233", r = "#445566"}
local state = Edit.New(original)
assert(not state.locked)
local synced = Edit.Toggle(state, original, "r")
assert(state.locked)
pair(synced, "#445566", "#445566")
local preview = Edit.Paint(synced, "l", "#FFFFFF", state.locked)
pair(preview, "#FFFFFF", "#FFFFFF")
pair(synced, "#445566", "#445566")
local restored = Edit.Toggle(state, preview, "l")
assert(not state.locked)
pair(restored, "#112233", "#445566")
restored = Edit.Paint(restored, "l", "#ABCDEF", state.locked)
pair(restored, "#ABCDEF", "#445566")
synced = Edit.Toggle(state, restored, "l")
pair(synced, "#ABCDEF", "#ABCDEF")
pair(Edit.Toggle(state, synced, "r"), "#ABCDEF", "#445566")
pair(original, "#112233", "#445566")
local equal = {l = "#000000", r = "#000000"}
local separate = Edit.New(equal)
assert(separate.locked)
pair(Edit.Toggle(separate, Edit.Paint(equal, "r", "#FF0000", true), "r"), "#000000", "#000000")
assert(not separate.locked)
print("m489 eye edit behavior: ok")
