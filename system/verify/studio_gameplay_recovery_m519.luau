-- Run on the server Command Bar during Studio Play, in an active GP session.
local Players = game:GetService("Players")
local Healing = require(game:GetService("ServerScriptService").Game1Server.character.CharacterHealing)
local player = assert(Players:GetPlayers()[1])
local character = assert(player.Character)
assert(character:GetAttribute("GameplayTestKind") == "player", "Enter GP first")
assert(character:GetAttribute("LifeState") == "Alive")
local max = character:GetAttribute("MaxHP")
local hp = character:GetAttribute("HP")
local oldRate = character:GetAttribute("GameplayTestVampiric")
local target = Instance.new("Model")
target:SetAttribute("Game1GameplayTestOwner", player.UserId)
target:SetAttribute("GameplayTestKind", "line")
character:SetAttribute("HP", max - 30)
character:SetAttribute("GameplayTestVampiric", 25)
Healing.OnDamage(character, target, 20)
assert(character:GetAttribute("HP") == max - 25, "25% of 20 actual HP")
assert(Healing.Restore(character, 10000) == 25)
assert(character:GetAttribute("HP") == max)
assert(not Healing.ValidateTestRates(-1, 0))
assert(not Healing.ValidateTestRates(0, 101))
assert(not Healing.ValidateTestRates(0/0, 0))
character:SetAttribute("HP", hp)
character:SetAttribute("GameplayTestVampiric", oldRate)
target:Destroy()
print("M519 recovery checks passed")
