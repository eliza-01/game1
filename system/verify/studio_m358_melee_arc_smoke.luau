-- M358 quick manual Luau smoke test. Paste into Studio Command Bar in Edit
-- (with Rojo-synced Game1Shared) or during Play. Does not change Place.
local Geometry = require(game:GetService("ReplicatedStorage"):WaitForChild("Game1Shared")
    :WaitForChild("combat"):WaitForChild("MeleeArcGeometry"))
local origin, look = Vector3.zero, Vector3.new(0, 0, -1)
local function box(x, y, z, width, height, depth, angle)
    return CFrame.new(x, y, z) * CFrame.Angles(0, angle or 0, 0), Vector3.new(width, height, depth)
end
local function hit(name, frame, size, reach, arc, low, high, shouldHit)
    local result = Geometry.Contact(frame, size, origin, look, reach, arc, low, high)
    assert((result ~= nil) == shouldHit, name .. ': expected ' .. tostring(shouldHit) .. ', got ' .. tostring(result))
    print('[M358 smoke] PASS', name)
end
local cf, sz = box(0, 0, -5, 2, 3, 2)
hit('108 forward', cf, sz, 7, 108, -3, 3, true)
hit('60 forward', cf, sz, 7, 60, -3, 3, true)
cf, sz = box(0, 0, 5, 2, 3, 2)
hit('108 behind', cf, sz, 7, 108, -3, 3, false)
hit('360 behind', cf, sz, 7, 360, -3, 3, true)
cf, sz = box(5, 0, -3, 2, 3, 2)
hit('108 near arc boundary', cf, sz, 7, 108, -3, 3, true)
hit('60 outside arc', cf, sz, 7, 60, -3, 3, false)
cf, sz = box(0, 0, -9, 1, 3, 1)
hit('out of reach', cf, sz, 7, 108, -3, 3, false)
cf, sz = box(0, 0, -10, 4, 3, 8)
hit('big target crossing reach', cf, sz, 7, 108, -3, 3, true)
cf, sz = box(0, 7, -5, 2, 2, 2)
hit('high target outside vertical zone', cf, sz, 7, 108, -3, 3, false)
hit('height overlap', cf, sz, 7, 108, -3, 8, true)
print('[M358 smoke] 10/10 geometry assertions passed')
