-- Run in Studio Server Command Bar after Rojo Sync. No persistent changes.
local shared=game:GetService("ReplicatedStorage"):WaitForChild("Game1Shared")
local combat=shared:WaitForChild("combat")
local config=require(combat.AttackConfig)
local aim=require(combat.AttackAimGeometry)
local geometry=require(combat.MeleeArcGeometry)
local fallback=require(combat.GameplayAttackFallback)
local hitPlan=require(combat.MeleeHitPlan)
local root=Vector3.zero
local head=Vector3.new(0,4,-2.5)
local camera=Vector3.new(0,4,12)
local ray,direction=aim.HeadshotSegment(root,camera,head-camera)
assert(config.MeleeHeadshotRayDistance==32)
assert(ray and direction and (head-ray).Magnitude<config.MeleeHeadshotRayDistance)
assert(not aim.HitWithinAttackRadius(root,head,3)) -- former gate incorrectly rejected head
assert(geometry.Contact(CFrame.new(0,0,-2.5),Vector3.new(1,3,1),root,Vector3.new(0,0,-1),3,80,-3,3))
assert(not geometry.Contact(CFrame.new(0,0,-7),Vector3.new(1,3,1),root,Vector3.new(0,0,-1),3,80,-3,3))
local model=Instance.new("Model")
model:SetAttribute("EquippedWeaponType","bigsword")
model:SetAttribute("AttackSpeed",154)
assert(not fallback.Resolve(model))
model:SetAttribute("GameplayTestKind","player")
local timing=assert(fallback.Resolve(model)); assert(math.abs(timing.duration-300/154)<1e-6)
assert(#assert(hitPlan.Resolve(timing,false,false))==1)
model:SetAttribute("EquippedWeaponType","dualswords")
local plan=assert(hitPlan.Resolve(assert(fallback.Resolve(model)),true,false)); assert(#plan==2 and plan[1].time<plan[2].time)
model:SetAttribute("EquippedWeaponType","bow"); assert(not fallback.Resolve(model))
model:Destroy()
print("[M532 smoke] geometry and fallback assertions PASS; live hit and GP UI still need manual tests")
